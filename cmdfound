_after_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #$1 => a list, $2 => one of its items. A loop, because awk is a process:
    #    _after_in "aqua pkgx am" pkgx  =>  am
    #    _after_in "aqua pkgx am" am    =>
    _after_in__out=""
    _ai__seen=""
    for _ai__item in ${1}; do
        [ -n "${_ai__seen}" ] && \
            _after_in__out="${_after_in__out:+${_after_in__out} }${_ai__item}"
        [ X"${_ai__item}" = X"${2}" ] && _ai__seen="1"
    done
    return 0
}

_index2oneline_in() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => its key=value lines. A loop, because awk is a process:
    #    packages=41231 updated=2026-09-01  =>  41231 packages, 2026-09-01 updated
    _index2oneline_in__out=""
    _i2o__rest="${1}"
    while [ -n "${_i2o__rest}" ]; do
        _i2o__line="${_i2o__rest%%${NL}*}"
        case "${_i2o__line}" in
            #the bytes were said before the fetch, and a line with a second = is
            #a value whose shape only the channel knows
            bytes=*|*=*=*) ;;
            *=*) _i2o__pair="${_i2o__line#*=} ${_i2o__line%%=*}"
                 _index2oneline_in__out="${_index2oneline_in__out:+${_index2oneline_in__out}, }${_i2o__pair}" ;;
        esac
        [ X"${_i2o__line}" = X"${_i2o__rest}" ] && break
        _i2o__rest="${_i2o__rest#*${NL}}"
    done
    return 0
}

_pause_others() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => _probe2route status, then the fetches still in flight. Stops each
    #and keeps whatever arrived, so the next run does not fetch it again.

    #When the channel winner is dockerized, the native channels are not paused,
    #otherwise it stops as a native bin wins always
    #  WINNER             native (0)    dockerized (2)
    #                 ┌──────────────┬───────────────┐
    #  this channel   │    paused    │  left going   │
    #  is native      │              │               │
    #                 ├──────────────┼───────────────┤
    #  this channel   │    paused    │    paused     │
    #  confines       │              │               │
    #                 └──────────────┴───────────────┘
    _pause_others__paused=""; _pause_others__going=""; _pause_others__native=""
    _po__had="${1}"; shift
    for _po__entry in "${@}"; do
        _catalog_fetch_in "${_po__entry}"
        _po__channel="${_catalog_fetch_in__channel}"
        _po__pid="${_catalog_fetch_in__pid}"
        _po__started="${_catalog_fetch_in__started}"
        if [ "${_po__had}" -eq "2" ] && ! _confines "${_po__channel}"; then
            _pause_others__going="${_pause_others__going:+${_pause_others__going} }${_po__entry}"
            _pause_others__native="${_pause_others__native:+${_pause_others__native} }${_po__channel}"
            continue
        fi
        if kill -0 "${_po__pid}" 2>/dev/null; then
            kill "${_po__pid}" 2>/dev/null
            wait "${_po__pid}" 2>/dev/null
            _pause_others__paused="${_pause_others__paused:+${_pause_others__paused}, }${_po__channel}"
        elif wait "${_po__pid}" 2>/dev/null; then
            #one that arrived meanwhile is kept, and what it took written down
            _po__said="$(cat "${g_home}/tmp/index.$$.${_po__channel}" 2>/dev/null)"
            _api_value_in bytes "${_po__said}"
            _add_timing "${_po__channel}" "catalog" "${_api_value_in__out}" \
                "$(( $(_util_now_ms) - ${_po__started} ))"
        fi
        rm -f "${g_home}/tmp/index.$$.${_po__channel}"
    done
    return 0
}

_race_catalogs() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => package, $2 => version, then channels whose catalogs can be fetched now
    #    a native catalog had the name     =>  0
    #    only one that confines had it     =>  2
    #    none of them had it               =>  1
    _rc__pkg="${1}"; _rc__version="${2}"; shift 2
    _util_mkdir_p "${g_home}/tmp" || return 1
    _rc__confined=""

    #every catalog is asked for at once, each writing into a slot of its own
    _rc__run=""
    for _rc__channel in "${@}"; do
        #the channel itself runs in the background, not a shell around it, so
        #that stopping it stops the download
        PATH="$(_channel_home "${_rc__channel}")/needs:${PATH}" \
            _api_channel "${_rc__channel}" index > "${g_home}/tmp/index.$$.${_rc__channel}" 2>/dev/null &
        _rc__run="${_rc__run} ${_rc__channel}:${!}:$(_util_now_ms)"
    done

    #and they are read in whatever order they arrive
    while [ -n "${_rc__run}" ]; do
        _rc__left=""
        for _rc__entry in ${_rc__run}; do
            _catalog_fetch_in "${_rc__entry}"
            _rc__channel="${_catalog_fetch_in__channel}"
            _rc__pid="${_catalog_fetch_in__pid}"
            _rc__started="${_catalog_fetch_in__started}"
            if kill -0 "${_rc__pid}" 2>/dev/null; then
                _rc__left="${_rc__left} ${_rc__entry}"
                continue
            fi

            wait "${_rc__pid}"; _rc__rc="${?}"
            _rc__said="$(cat "${g_home}/tmp/index.$$.${_rc__channel}" 2>/dev/null)"
            rm -f "${g_home}/tmp/index.$$.${_rc__channel}"
            if [ "${_rc__rc}" -ne "0" ]; then
                _api_value_in unreachable "${_rc__said}"; _rc__why="${_api_value_in__out}"
                _msg "${PROGNAME}: ${_rc__channel}'s catalog was not fetched, ${_rc__why:-it gave no reason}"
                printf "~unreachable %s %s\\n" "${_rc__channel}" "${_rc__why:-its catalog could not be fetched}"
                continue
            fi

            #what the catalog cost is kept for the estimator alone: by the time
            #there is a question those bytes are gone either way
            _api_value_in bytes "${_rc__said}"; _rc__bytes="${_api_value_in__out}"
            _add_timing "${_rc__channel}" "catalog" "${_rc__bytes}" "$(( $(_util_now_ms) - ${_rc__started} ))"
            _index2oneline_in "${_rc__said}"
            _msg "${PROGNAME}: ${_rc__channel}: ${_index2oneline_in__out}"

            #${?} is the probe's own status, which tells a channel that said no
            #from one that could not be asked, so nothing comes between the two
            _rc__probe="$(_api_channel "${_rc__channel}" probe "${_rc__pkg}" "${_rc__version}" 2>/dev/null)"
            _probe2route "${_rc__channel}" "${_rc__probe}" "${?}" "${_rc__pkg}"
            _rc__had="${?}"
            case "${_rc__had}" in
                1)  _msg "${PROGNAME}: ${_rc__channel} has nothing called '${_rc__pkg}'"
                    continue ;;
                #a catalog that has it with nothing here to run it is no answer either
                3)  _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}', and nothing here can run it"
                    continue ;;
            esac

            #the answer is here: the ones this pass passed over and the ones it
            #has not reached yet are stopped, keeping what arrived
            _after_in "${_rc__run}" "${_rc__entry}"
            _pause_others "${_rc__had}" ${_rc__left} ${_after_in__out}
            _rc__paused="${_pause_others__paused}"
            _rc__native="${_pause_others__native}"
            if [ "${_rc__had}" -eq "0" ]; then
                [ -n "${_rc__paused}" ] && \
                    _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}'; ${_rc__paused} paused, to go on when needed"
                return 0
            fi
            _and_in ${_rc__native}
            _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}', dockerized${_rc__paused:+; ${_rc__paused} paused, to go on when needed}${_rc__native:+; reading the native ${_and_in__out} first}"
            #what is left is native; the ones not read this time are read the next
            _rc__confined="1"
            _rc__left="${_pause_others__going}"
            break
        done
        _rc__run="${_rc__left}"
        [ -n "${_rc__run}" ] && { sleep 0.1 2>/dev/null || sleep 1; }
    done
    [ -n "${_rc__confined}" ] && return 2
    return 1
}

_runtime_spec_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
