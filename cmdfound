_list() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => part of a package name (optional), all of them
    #Three kinds of row. A placement is what was asked for. A tool is what
    #installed it, was never asked for, and stays when the placement goes. A
    #channel is those two and the catalog and whatever else it keeps, and is
    #the only row that says where the size of a home really went
    #    _list      =>  pkgx, its tool, v2.11.0             9.8 MB  tool
    #                   pkgx:stedolan.github.io/jq@1.8.2    3.3 MB  native  …/jq
    #                   pkgx, all of it                    33.0 MB  channel
    #    _list jq   =>  those three, with aqua and the rest left out
    #    _list zzz  =>  nothing at all
    #
    #A channel row is the whole channel and not what the rows above leave over:
    #a channel that counts a placement itself answers with bytes and not with
    #where they are, so a remainder would count those twice. It is what purging
    #the channel gives back, and more where its tool holds a store elsewhere
    [ -d "${g_home}/channels" ] || { _msg "${PROGNAME}: nothing placed yet"; return 0; }

    _remembered_programs_in
    _list__programs="${_remembered_programs_in__out}"

    for _list__home in "${g_home}"/channels/*; do
        [ -d "${_list__home}" ] || continue
        _list__channel="${_list__home##*/}"
        _list__kind="native"
        _confines "${_list__channel}" && _list__kind="dockerized"

        #the links are read before the tool row and not after: a tool is listed
        #where its channel has a placement to list, and $1 may leave it none
        _list__links="$(find "${_list__home}/by" -type l 2>/dev/null | sort)"
        _list__shows=""
        [ -n "${1}" ] || _list__shows="1"
        _list__left="${_list__links}${NL}"
        while [ -z "${_list__shows}" ] && [ -n "${_list__left}" ]; do
            _list__link="${_list__left%%${NL}*}"; _list__left="${_list__left#*${NL}}"
            #quoted in the braces: a home holding * ? or [ is not a pattern
            _list__rest="${_list__link#"${_list__home}"/by/}"
            case "${_list__rest%/*}" in *"${1}"*) _list__shows="1" ;; esac
        done
        [ -n "${_list__shows}" ] || continue

        #a current pointing at a version that is gone reaches no tool, and no row
        if [ -L "${_list__home}/tool/current" ] && [ -e "${_list__home}/tool/current" ]; then
            #empty, not 0: what du could not read is unknown, and is shown so
            _list__tool_bytes=""
            _du_bytes "${_list__home}/tool" "" && _list__tool_bytes="${g_du_bytes}"
            printf "  %-34s %10s  %s\\n" "${_list__channel}, its tool, $(_tool_version "${_list__channel}")" \
                "$(_bytes2human "${_list__tool_bytes}")" "tool"
        fi

        #channels/pkgx/by/stedolan.github.io/jq/1.8.2
        #         └─┬┘    └─────────┬─────────┘ └─┬─┘
        #           │               │             └── _list__version
        #           │               └──────────────── _list__package, slashes and all
        #           └──────────────────────────────── _list__channel
        #
        #read back as pkgx:stedolan.github.io/jq@1.8.2

        printf "%s\\n" "${_list__links}" | while read -r _list__link; do
            [ -n "${_list__link}" ] || continue
            #quoted in the braces: a home holding * ? or [ is not a pattern
            _list__rest="${_list__link#"${_list__home}"/by/}"
            _list__version="${_list__rest##*/}"
            _list__package="${_list__rest%/*}"
            [ -n "${1}" ] && case "${_list__package}" in *"${1}"*) ;; *) continue ;; esac
            _list__points="$(readlink "${_list__link}" 2>/dev/null)"

            _placement_bytes_in "${_list__channel}" "${_list__package}" "${_list__version}" \
                "${_list__points}"
            _programs_under_in "${_list__points}" "${_list__programs}"
            printf "  %-34s %10s  %-10s  %s\\n" "${_list__channel}:${_list__package}@${_list__version}" \
                "$(_bytes2human "${_placement_bytes_in__out}")" "${_list__kind}" \
                "${_programs_under_in__out:--}"
        done

        #why the whole channel and not a remainder: see the head of this function
        _du_bytes "${_list__home}" "" || continue
        printf "  %-34s %10s  %s\\n" "${_list__channel}, all of it" \
            "$(_bytes2human "${g_du_bytes}")" "channel"
    done
}

