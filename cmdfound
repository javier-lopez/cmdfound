_spec_in() { #reviewed
    #$1 => a spec, eg: aqua:jq@1.7
    _spec_in__channel=""
    _spec_in__package="${1}"
    case "${1}" in
        [a-z0-9]*:*)
            _spec_in__channel="${1%%:*}"
            case "${_spec_in__channel}" in
                *[!a-z0-9-]*) _spec_in__channel="" ;;
                           *) _spec_in__package="${1#*:}" ;;
            esac ;;
    esac

    #aqua:jq@1.7
    #└─┬┘ └┬┘└┬┘
    #  │   │  └── _spec_in__version
    #  │   └───── _spec_in__package
    #  └───────── _spec_in__channel

    _spec_in__version=""
    case "${_spec_in__package}" in
        *@*) _spec_in__version="${_spec_in__package##*@}" ;;
    esac
    _spec_in__package="${_spec_in__package%%@*}"
    return 0
}

