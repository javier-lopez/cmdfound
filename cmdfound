    #$1 => what another run is installing (optional): its entry is written and
    #not linked yet, so any value here calls the whole sweep off
    #    _free_store ""           =>  __kept 1, __freed 8192, huerfana removed
    #    _free_store aqua:jq@1.7  =>  __kept 2, __freed 0, nothing removed
    _free_store__kept="0"; _free_store__freed="0"
    _fst__linked=""
    while IFS= read -r _fst__link; do
        [ -n "${_fst__link}" ] || continue
        _fst__to="$(readlink "${_fst__link}" 2>/dev/null)" || continue
        _has_line "${_fst__linked}" "${_fst__to}" && continue
        _fst__linked="${_fst__linked}${_fst__to}${NL}"
    done <<EOF
$(find "${g_home}"/channels/*/by -type l 2>/dev/null)
EOF
    #a link's target is absolute: an entry is named when a target is its path
    _fst__doomed=""
    for _fst__dir in "${g_home}"/channels/*/store/*; do
