#json is read with awk and not matched with patterns, so these read a string
#the way json writes one: \uXXXX becomes utf-8, a surrogate pair included, and
#a control escape becomes a space, the output being one line a record
JSON_STRINGS='
 function hex(h,   i, n) {
    n = 0; h = tolower(h)
    for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
    return n
 }
 function utf8(n) {
    if (n < 128) return sprintf("%c", n)
    if (n < 2048) return sprintf("%c%c", 192 + int(n / 64), 128 + n % 64)
    if (n < 65536) return sprintf("%c%c%c", 224 + int(n / 4096), 128 + int(n / 64) % 64, 128 + n % 64)
    return sprintf("%c%c%c%c", 240 + int(n / 262144), 128 + int(n / 4096) % 64, 128 + int(n / 64) % 64, 128 + n % 64)
 }
 function unesc(s,   out, i, c, n, lo) {
    if (index(s, "\\") == 0) return s
    out = ""
    while ((i = index(s, "\\")) > 0) {
        out = out substr(s, 1, i - 1)
        c = substr(s, i + 1, 1)
        if (c == "u") {
            n = hex(substr(s, i + 2, 4)); s = substr(s, i + 6)
            if (n >= 55296 && n < 56320 && substr(s, 1, 2) == "\\u") {
                lo = hex(substr(s, 3, 4))
                if (lo >= 56320 && lo < 57344) { n = 65536 + (n - 55296) * 1024 + (lo - 56320); s = substr(s, 7) }
            }
            out = out utf8(n)
            continue
        }
        if (c == "n" || c == "t" || c == "r" || c == "f" || c == "b") out = out " "
        else out = out c
        s = substr(s, i + 2)
    }
    return out s
 }'

_util_json() { #@reviewed 2026-10-25 m@javier.io 2e226ed
#$1 => the deepest level worth printing (99), $2 => any value to also print
#an object or array that opens above it. Reads json on stdin and prints a
#line per value: its path, keys and array positions joined by /, a tab, and
#the value
#    {"a":{"b":1}}   with 9     =>  a/b<TAB>1
#    {"a":{}}        with 9     =>  nothing: the object is empty
#    {"a":{}}        with 9 on  =>  a<TAB>{   , which is how a docker login
#                                   a credential helper keeps is still seen
    LC_ALL=C awk -v maxd="${1:-99}" -v shown="${2}" "${JSON_STRINGS}"'
    function path(   p, i) {
        p = ""
        for (i = 1; i <= depth; i++) p = p (i > 1 ? "/" : "") (kind[i] == "o" ? key[i] : idx[i])
        return p
    }
    function flush() {
        if (tok != "") { if (depth <= maxd) printf("%s\t%s\n", path(), tok); tok = "" }
    }
    function structure(seg,   i, n, c) {
        n = length(seg)
        for (i = 1; i <= n; i++) {
            c = substr(seg, i, 1)
            if (c == "{" || c == "[") {
                if (shown != "" && depth >= 1 && depth < maxd) printf("%s\t%s\n", path(), c)
                depth++; kind[depth] = (c == "{") ? "o" : "a"; idx[depth] = 0; key[depth] = ""
                expect = (c == "{") ? "key" : "value"
            }
            else if (c == "}" || c == "]") { flush(); depth--; expect = "" }
            else if (c == ":") expect = "value"
            else if (c == ",") { flush(); if (kind[depth] == "o") expect = "key"; else { idx[depth]++; expect = "value" } }
            else if (c != " " && c != "\t" && c != "\n" && c != "\r") tok = tok c
        }
    }
    BEGIN { RS = "\""; depth = 0; instr = 0; buf = ""; tok = "" }
    {
        if (!instr) { structure($0); instr = 1; buf = ""; next }
        buf = buf $0
        if (match(buf, /\\+$/) && RLENGTH % 2 == 1) { buf = buf "\""; next }
        instr = 0
        if (expect == "key") { key[depth] = unesc(buf); next }
        if (depth <= maxd) printf("%s\t%s\n", path(), unesc(buf))
    }'
}

