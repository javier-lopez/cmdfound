_probe_all() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #_probe_all jq 1.7 aqua
    #           └┬┘└┬┘ └─┬┘
    #             │  │    └── ask only this one, empty to ask every channel
    #             │  └─────── version
    #             └────────── package

    #the group is piped into sort, so it is a subshell: what is exported in it
    #reaches the probes below and nothing after this function
    _pa__package="${1}"; _pa__version="${2}"; _pa__only="${3}"
    {
        #udocker:alpine/jq is run by that runtime and no other. Cleared
        #otherwise, so no variable left in the environment narrows a resolution
        unset CMDFOUND_RUNTIME
        _runtime_spec_in "${_pa__only}" "${_pa__package}"
        if [ -n "${_runtime_spec_in__runtime}" ]; then
            CMDFOUND_RUNTIME="${_runtime_spec_in__runtime}"; export CMDFOUND_RUNTIME
            _pa__only="${_runtime_spec_in__channel}"
            _pa__package="${_runtime_spec_in__package}"
        fi

        #a channel is told when the spec named it: conda-forge, with no map from
        #a command to its package, answers only then
        if [ -n "${_pa__only}" ]; then
            CMDFOUND_NAMED="${_pa__only}"; export CMDFOUND_NAMED
        else
            unset CMDFOUND_NAMED
        fi

        #each channel in turn, and what it answered handed to _probe2route
        _pa__catalog=""; _pa__native=""; _pa__confined=""; _pa__missing=""
        for _pa__channel in $(_channels); do
            [ -n "${_pa__only}" ] && \
                [ X"${_pa__only}" != X"${_pa__channel}" ] && continue
            #a runtime was named, so only the catalogs it can run are worth asking
            if [ -n "${CMDFOUND_RUNTIME}" ]; then
                _channel_meta_in "${_pa__channel}" kind
                [ X"${_channel_meta_in__out}" = X"catalog" ] || continue
                _pa__catalog="1"
            fi
            _pa__said="$(_api_channel "${_pa__channel}" probe \
                "${_pa__package}" "${_pa__version}" 2>/dev/null)"
            _pa__rc="${?}"

            #read in the shell alone: a grep here is two more processes for
            #every channel with no catalog
            if [ "${_pa__rc}" -eq "2" ] && \
               _has_line "${_pa__said}" "needs=index"; then
                _pa__missing="${_pa__missing} ${_pa__channel}"
                continue
            fi

            _probe2route "${_pa__channel}" "${_pa__said}" "${_pa__rc}" \
                "${_pa__package}"
            case "${?}" in
                0) _pa__native="1" ;;
                2) _pa__confined="1" ;;
            esac
        done

        #a catalog the spec named that is not here is nothing to ask, not a failed ask
        if [ -n "${CMDFOUND_RUNTIME}" ] && [ -z "${_pa__catalog}" ]; then
            printf "~nocatalog %s %s\\n" "${CMDFOUND_RUNTIME}" "${_pa__only}"
        fi

        #the catalogs with no index race for one, each an argument of its own,
        #and only where nothing native turned up: an index costs to fetch
        if [ -z "${_pa__native}" ] && [ -n "${_pa__missing}" ]; then
            _first_catalogs "${_pa__package}" "${_pa__version}" \
                "${_pa__confined}" ${_pa__missing}
        fi
    } | LC_ALL=C sort
}

