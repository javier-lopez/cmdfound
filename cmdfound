_obtain_needs() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => runtime
    #check if a channel meta needs= parameter is locally available, if not
    #uses cmdfound to retrieve it. eg: nix-portable needs=sqlite3
    if [ X"${2}" = X"runtime" ]; then
        _obn__uses="runs programs with"; _obn__not="so it is not asked"
        _obn__cannot="so it cannot run anything"
    else
        _obn__uses="reads its catalog with"; _obn__not="so its catalog is not read"
        _obn__cannot="so its catalog cannot be read"
    fi
    for _obn__need in $(_needs "${1}"); do
        if ! _api_is_program_name "${_obn__need}"; then
            _msg "${PROGNAME}: ${1} needs '${_obn__need}', which is not a program's name"
            return 1
        fi
        _obn__link="$(_channel_home "${1}")/needs/${_obn__need}"
        [ -x "${_obn__link}" ] && continue
        command -v "${_obn__need}" >/dev/null 2>&1 && continue
        #one already got, for this channel or by name, is taken without a word
        _obn__program="$(_remembered_program "${_obn__need}" "${_obn__need}")" || _obn__program=""
        if [ -z "${_obn__program}" ]; then
            _msg "${PROGNAME}: ${1} ${_obn__uses} ${_obn__need}, which is not here"
            if [ -n "${g_dry_run}" ]; then
