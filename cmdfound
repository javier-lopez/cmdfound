#!/bin/sh
#description: cmdfound channel - rust crates' prebuilt programs, asked for by name and installed by cargo-binstall
#usage: binstall meta | binstall index | binstall search WORDS...
#       binstall probe CRATE [VER] | binstall locate CRATE VER [PROGRAM]
#       binstall obtain CRATE VER [PROGRAM]

INDEX="${CMDFOUND_CRATES_INDEX:-https://index.crates.io}"
DL="${CMDFOUND_CRATES_DL:-https://static.crates.io/crates}"
QUICKINSTALL="${CMDFOUND_QUICKINSTALL:-https://github.com/cargo-bins/cargo-quickinstall/releases/download}"
RELEASES="${CMDFOUND_BINSTALL_RELEASES:-https://github.com/cargo-bins/cargo-binstall/releases}"
GITHUB="${CMDFOUND_BINSTALL_GITHUB:-https://github.com}"
#github's api, asked only how many of its questions are left
API="https://api.github.com"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"
TOOL_NAME="cargo-binstall"
#how many of a crate's newest versions are tried before the answer is none:
#QuickInstall builds a release some days after it is out, and not every one
TRIES="5"

#a cd that CDPATH sends somewhere prints where it went, into whatever reads it
unset CDPATH

_heads() {
    #$1... => urls or paths, a line each
    #    _heads https://x/build.tar.gz  =>  200 3600000
    #    _heads https://x/missing.tgz   =>  404 -
    #    _heads https://unreachable/    =>  000 -
    for _hd__u in "${@}"; do
        if _util_is_local "${_hd__u}"; then
            _hd__n="$(_api_fetcher_head_size "${_hd__u}")"
            if [ -n "${_hd__n}" ]; then
                printf "200 %s\\n" "${_hd__n}"
            else
                printf "%s\\n" "404 -"
            fi
            continue
        fi
        _api_fetcher_head_in "${_hd__u}" content-length follow
        _hd__n="-"
        [ X"${_api_fetcher_head_in__code}" = X"200" ] && _util_is_number "${_api_fetcher_head_in__out}" && \
            _hd__n="${_api_fetcher_head_in__out}"
        printf "%s %s\\n" "${_api_fetcher_head_in__code:-000}" "${_hd__n}"
    done
}

_platform() {
    _util_machine_in
    case "${_util_machine_in__os}/${_util_machine_in__cpu}" in
        Linux/x86_64|Linux/amd64)  printf "%s\\n" "x86_64" ;;
        Linux/aarch64|Linux/arm64) printf "%s\\n" "aarch64" ;;
        *) return 1 ;;
    esac
}

_targets() {
    #    _targets  =>  x86_64-unknown-linux-musl
    #                  x86_64-unknown-linux-gnu

    #here too: _platform runs in a $( ), a subshell that inherits it
    _util_machine_in
    if [ -n "${CARGO_BUILD_TARGET}" ]; then
        printf "%s\\n" "${CARGO_BUILD_TARGET}" | tr ',' '\n' | awk 'NF'
        return 0
    fi
    _tg__arch="$(_platform)" || return 1
    printf "%s\\n" "${_tg__arch}-unknown-linux-musl"
    getconf GNU_LIBC_VERSION >/dev/null 2>&1 && printf "%s\\n" "${_tg__arch}-unknown-linux-gnu"
    return 0
}

_valid() {
    #$1 => a crate's name, $2 => a version
    #    _valid ripgrep 14.1.0  =>  0
    #    _valid ripgrep ^14     =>  1
    case "${1}" in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
    esac
    [ "${#1}" -le "64" ] || return 1
    #a digit first, or cargo-binstall reads it as a range
    case "${2}" in
        '') ;;
        [!0-9]*) return 1 ;;
        *) _api_is_version "${2}" || return 1 ;;
    esac
    return 0
}

_index_path() {
    #$1 => a crate's name, lower case
    #    _index_path jq       =>  2/jq
    #    _index_path syn      =>  3/s/syn
    #    _index_path ripgrep  =>  ri/pg/ripgrep
    case "${#1}" in
        1) printf "1/%s\\n" "${1}" ;;
        2) printf "2/%s\\n" "${1}" ;;
        3) printf "3/%s/%s\\n" "${1%"${1#?}"}" "${1}" ;;
        *) _ip__rest="${1#??}"
           printf "%s/%s/%s\\n" "${1%"${1#??}"}" "${_ip__rest%"${_ip__rest#??}"}" "${1}" ;;
    esac
}

_entries() {
    #$1 => a crate's name, its index file left in entries; 2 when it could not be asked
    #    _entries ripgrep    =>  0
    #    _entries no-such-x  =>  1
    _en__name="$(_util_lower "${1}")"
    entries="${CH}/cache/index/${_en__name}"
    _api_is_fresh "${entries}" && return 0
    _util_mkdir_p "${entries%/*}" || return 2
    _api_fetcher_answered "${INDEX}/$(_index_path "${_en__name}")" "${entries}.$$"
    case "${?}" in
        0) mv "${entries}.$$" "${entries}" && return 0
           return 2 ;;
        1) rm -f "${entries}"; return 1 ;;
    esac
    #yesterday's versions still exist
    [ -s "${entries}" ] && return 0
    return 2
}

_versions() {
    #$1 => a crate's index file, $2 => a version. None yanked
    #    _versions "${entries}"         =>  14.1.1
    #                                       14.1.0
    #    _versions "${entries}" 14.1.0  =>  14.1.0

    #a pattern, not _util_json: no other key holds "vers" or "yanked"
    awk -v want="${2}" '
        {
            v = ""; y = ""
            if (match($0, /"vers":"[^"]*"/)) v = substr($0, RSTART + 8, RLENGTH - 9)
            if (match($0, /"yanked":(true|false)/)) y = substr($0, RSTART + 9, RLENGTH - 9)
            if (v == "" || y != "false") next
            if (want != "") { if (v == want) print "0\t" v; next }
            #three numbers and nothing else, which leaves out a prerelease
            core = v; sub(/\+.*$/, "", core)
            if (split(core, p, ".") != 3) next
            if (p[1] !~ /^[0-9]+$/ || p[2] !~ /^[0-9]+$/ || p[3] !~ /^[0-9]+$/) next
            printf("%012d%012d%012d\t%s\n", p[1], p[2], p[3], v)
        }' "${1}" | LC_ALL=C sort -r | awk -F'\t' '!seen[$2]++ {print $2}'
}

_name_of() {
    #$1 => a crate's index file. The name it was published under
    #    _name_of "${entries}"  =>  fd-find
    awk 'match($0, /^\{"name":"[^"]*"/) {print substr($0, 10, RLENGTH - 10); exit}' "${1}"
}

_build() {
    #$1 => crate, $2 => version. bytes counts build, .sig and .crate; 2 leaves why
    #    _build hyperfine 1.20.0  =>  0, target x86_64-unknown-linux-musl, bytes 1834000
    #    _build no-builds 1.0.0   =>  1

    #a build found is kept: an earlier target built later is not asked (owner, 2026-10-19)
    _bd__crate="${1}"; _bd__version="${2}"
    why=""; target=""; bytes=""
    _bd__urls=""; _bd__base="${QUICKINSTALL}/${_bd__crate}-${_bd__version}/${_bd__crate}-${_bd__version}"
    for _bd__t in $(_targets); do
        _bd__kept="${CH}/cache/builds/${_bd__crate}/${_bd__version}/${_bd__t}"
        if [ -s "${_bd__kept}" ]; then
            IFS= read -r bytes < "${_bd__kept}"
            if _util_is_number "${bytes}"; then
                target="${_bd__t}"; return 0
            fi
        fi
        _bd__urls="${_bd__urls} ${_bd__base}-${_bd__t}.tar.gz"
    done
    _bd__answers="$(_heads ${_bd__urls})"
    for _bd__t in $(_targets); do
        _bd__answer="$(printf "%s\\n" "${_bd__answers}" | awk 'NR == 1')"
        _bd__answers="$(printf "%s\\n" "${_bd__answers}" | awk 'NR > 1')"
        case "${_bd__answer%% *}" in
            200) ;;
            404|410) continue ;;
            *) why="QuickInstall could not be asked whether it built ${_bd__crate} ${_bd__version} for ${_bd__t}"
               return 2 ;;
        esac
        _bd__url="${_bd__base}-${_bd__t}.tar.gz"
        _bd__build="${_bd__answer#* }"
        _bd__sig="$(_heads "${_bd__url}.sig")"
        _bd__dl="$(_heads "${DL}/${_bd__crate}/${_bd__crate}-${_bd__version}.crate")"
        case "${_bd__sig%% *}/${_bd__dl%% *}" in
            200/200) ;;
            404/*|410/*) continue ;;
            *) why="QuickInstall and crates.io could not be asked what ${_bd__crate} ${_bd__version} weighs"
               return 2 ;;
        esac
        case "${_bd__build}/${_bd__sig#* }/${_bd__dl#* }" in
            */-/*|*/-|-/*) why="QuickInstall or crates.io did not say what ${_bd__crate} ${_bd__version} weighs"
                           return 2 ;;
        esac
        target="${_bd__t}"; bytes="$((${_bd__build} + ${_bd__sig#* } + ${_bd__dl#* }))"
        _bd__kept="${CH}/cache/builds/${_bd__crate}/${_bd__version}/${_bd__t}"
        _util_mkdir_p "${_bd__kept%/*}" && printf "%s\\n" "${bytes}" > "${_bd__kept}"
        return 0
    done
    return 1
}

_manifest() {
    #$1 => crate, $2 => version. Leaves repo, program, pkgurl, subdir, signed
    #    _manifest fd-find 10.5.0  =>  0, repo sharkdp/fd, program fd
    _mf__crate="${1}"; _mf__version="${2}"
    repo=""; program=""; pkgurl=""; subdir=""; signed=""
    _mf__kept="${CH}/cache/manifests/${_mf__crate}/${_mf__version}"
    if [ ! -f "${_mf__kept}" ]; then
        _util_mkdir_p "${_mf__kept%/*}" || return 2
        _mf__url="${DL}/${_mf__crate}/${_mf__crate}-${_mf__version}.crate"; _mf__part="${_mf__kept}.$$"
        _mf__one=""
        TAR_OPTIONS= tar --version 2>/dev/null | grep 'GNU tar' >/dev/null && _mf__one="--occurrence=1"
        { _api_fetcher "${_mf__url}" 2>/dev/null; printf "%s\\n" "${?}" > "${_mf__part}.rc"; } | \
            TAR_OPTIONS= GZIP= gzip -dc 2>/dev/null | \
            TAR_OPTIONS= tar -xOf - ${_mf__one} "${_mf__crate}-${_mf__version}/Cargo.toml" > "${_mf__part}" 2>/dev/null
        _mf__rc=""; IFS= read -r _mf__rc < "${_mf__part}.rc"
        rm -f "${_mf__part}.rc"
        #a download cut short once Cargo.toml is out still counts
        if [ ! -s "${_mf__part}" ]; then
            rm -f "${_mf__part}"
            if [ X"${_mf__rc}" = X"0" ]; then
                : > "${_mf__part}"
            else
                case "$(_heads "${_mf__url}")" in
                    404*|410*) return 1 ;;
                    *) return 2 ;;
                esac
            fi
        fi
        awk '
            function value(l) { sub(/^[^=]*=[ \t]*/, "", l); sub(/[ \t]*$/, "", l); gsub(/^["\047]|["\047]$/, "", l); return l }
            /^[ \t]*\[/ { t = $0; gsub(/[ \t]/, "", t); next }
            t == "[package]" && /^[ \t]*repository[ \t]*=/ { r = value($0) }
            t == "[[bin]]" && /^[ \t]*name[ \t]*=/ { n++; b = value($0) }
            t == "[package.metadata.binstall]" && /^[ \t]*pkg-url[ \t]*=/ { u = 1 }
            t == "[package.metadata.binstall.signing]" || (t == "[package.metadata.binstall]" && /^[ \t]*signing[ \t]*=/) { g = 1 }
            END {
                if (match(r, /^https?:\/\/(www\.)?github\.com\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+/)) {
                    rest = substr(r, RSTART + RLENGTH)
                    r = substr(r, RSTART, RLENGTH); sub(/^https?:\/\/(www\.)?github\.com\//, "", r); sub(/\.git$/, "", r)
                    print "repo=" r
                    sub(/^\/+$/, "", rest)
                    if (rest != "") print "subdir=1"
                }
                if (n == 1) print "program=" b
                if (u) print "pkgurl=1"
                if (g) print "signed=1"
            }' "${_mf__part}" > "${_mf__part}.read" && mv "${_mf__part}.read" "${_mf__kept}"
        rm -f "${_mf__part}" "${_mf__part}.read"
    fi
    repo="$(awk -F= '$1 == "repo" {print $2; exit}' "${_mf__kept}")"
    program="$(awk -F= '$1 == "program" {print $2; exit}' "${_mf__kept}")"
    pkgurl="$(awk -F= '$1 == "pkgurl" {print $2; exit}' "${_mf__kept}")"
    subdir="$(awk -F= '$1 == "subdir" {print $2; exit}' "${_mf__kept}")"
    signed="$(awk -F= '$1 == "signed" {print $2; exit}' "${_mf__kept}")"
    return 0
}

_quota() {
    #$1 => questions installing asks github's api, $2 => what, and from where
    #    _quota 2 "fd-find 10.5.0 from QuickInstall"   =>  0  enough left, or no answer
    #    _quota 99 "fd-find 10.5.0 from QuickInstall"  =>  1  why says how many are
    _qt__asks="${1}"; _qt__what="${2}"
    why=""
    _api_fetcher_bin || return 0
    _api_github_token_in; _qt__token="${_api_github_token_in__out}"
    #wget is sent no token, so it would be told about another quota
    [ -n "${_qt__token}" ] && [ X"${g_fetcher_bin}" != X"curl" ] && return 0
    #with a token cargo-binstall asks through graphql
    _qt__quota="rate"; [ -n "${_qt__token}" ] && _qt__quota="graphql"
    _util_mkdir_p "${CH}/tmp" || return 0
    _qt__f="${CH}/tmp/rate_limit.$$"
    _api_fetcher_github_in "${API}/rate_limit" "${_qt__f}"
    _qt__rate=""
    [ X"${_api_fetcher_github_in__out}" = X"200" ] && _qt__rate="$(tr -d ' \t\r\n' < "${_qt__f}" | awk -v q="${_qt__quota}" '
            {
                if (!match($0, "\"" q "\":\\{[^}]*\\}")) exit
                r = substr($0, RSTART, RLENGTH)
                if (match(r, /"limit":[0-9]+/)) limit = substr(r, RSTART + 8, RLENGTH - 8)
                if (match(r, /"remaining":[0-9]+/)) left = substr(r, RSTART + 12, RLENGTH - 12)
                if (match(r, /"reset":[0-9]+/)) reset = substr(r, RSTART + 8, RLENGTH - 8)
            }
            END { if (limit != "" && left != "" && reset != "") print left, limit, reset }')"
    rm -f "${_qt__f}"
    [ -n "${_qt__rate}" ] || return 0
    _qt__left="${_qt__rate%% *}"; _qt__reset="${_qt__rate##* }"
    _qt__limit="${_qt__rate#* }"; _qt__limit="${_qt__limit%% *}"
    [ "${_qt__left}" -ge "${_qt__asks}" ] && return 0
    _qt__minutes="$(( (${_qt__reset} - $(date +%s) + 59) / 60 ))"
    [ "${_qt__minutes}" -ge "1" ] || _qt__minutes="1"
    if [ -n "${_qt__token}" ]; then
        why="github's api has ${_qt__left} of its questions left for the exported token, for about ${_qt__minutes} more minutes, and cargo-binstall asks it ${_qt__asks} to install ${_qt__what}"
    else
        why="github's api has ${_qt__left} of the ${_qt__limit} questions an hour it allows this address left, for about ${_qt__minutes} more minutes, and cargo-binstall asks it ${_qt__asks} to install ${_qt__what}; exporting GITHUB_TOKEN or GH_TOKEN raises the limit to 5000 an hour"
    fi
    return 1
}

_matching() {
    #$1 => a release's page, $2 => tag, $3 => version, $4 => names, $5 => targets
    #    _matching "${page}" v10.5.0 10.5.0 "fd-find fd" "${t}"  =>  fd-v10.5.0-x86_64-unknown-linux-musl.tar.gz

    #the patterns are cargo-binstall 1.23.0's own
    _ma__page="${1}"; _ma__tag="${2}"; _ma__ver="${3}"; _ma__names="${4}"; _ma__targets="${5}"
    awk -v tag="${_ma__tag}" -v ver="${_ma__ver}" -v names="${_ma__names}" -v targets="${_ma__targets}" '
        {
            s = $0
            while (match(s, /releases\/download\/[^"\/]+\/[^"\/]+"/)) {
                f = substr(s, RSTART + 18, RLENGTH - 19); s = substr(s, RSTART + RLENGTH)
                if (substr(f, 1, length(tag) + 1) == tag "/") files[substr(f, length(tag) + 2)] = 1
            }
        }
        END {
            nt = split(targets, t, " "); nn = split(names, n, " ")
            ns = split(".tar .tbz2 .tar.bz2 .tbz .tar.bz .tgz .tar.gz .txz .tar.xz .tzstd .tzst .tar.zst .zip .bin", x, " ")
            x[++ns] = ""
            for (i = 1; i <= nt; i++) for (j = 1; j <= nn; j++) {
                a = n[j]; g = t[i]; v = ver
                k = 0
                p[++k] = a "-" g "-v" v; p[++k] = a "-" g "-" v; p[++k] = a "-" v "-" g; p[++k] = a "-v" v "-" g
                p[++k] = a "_" g "_v" v; p[++k] = a "_" g "_" v; p[++k] = a "_" v "_" g; p[++k] = a "_v" v "_" g
                p[++k] = a "-" g; p[++k] = a "_" g
                for (m = 1; m <= k; m++) for (e = 1; e <= ns; e++) if ((p[m] x[e]) in files) { print p[m] x[e]; exit }
            }
        }' "${_ma__page}"
}

_author() {
    #$1 => crate, $2 => version, $3 => the newest version when walking, else empty
    #    _author fd-find 10.5.0 ""  =>  0, repo sharkdp/fd, tag v10.5.0, asset fd-v10.5.0-x86_64-unknown-linux-musl.tar.gz

    #read from github's pages, never its api
    _au__crate="${1}"; _au__version="${2}"; _au__newest="${3}"
    why=""; tag=""; asset=""
    _au__kept="${CH}/cache/authors/${_au__crate}/${_au__version}"
    if [ -s "${_au__kept}" ]; then
        read -r repo tag asset < "${_au__kept}"
        [ -n "${asset}" ] && return 0
    fi
    _manifest "${_au__crate}" "${_au__newest:-${_au__version}}"
    case "${?}" in
        0) ;;
        1) return 1 ;;
        *) why="the crate ${_au__crate} ${_au__newest:-${_au__version}} could not be read from crates.io for the repository it names"; return 2 ;;
    esac
    [ -n "${repo}" ] || return 1
    if [ -n "${_au__newest}" ]; then
        _api_latest_tag_in "${GITHUB}/${repo}/releases" "${CH}/cache/releases/${repo}/latest"
        case "${?}" in
            0) ;;
            1) return 1 ;;
            *) why="github could not be asked for the newest release of ${repo}"; return 2 ;;
        esac
        _au__latest="${_api_latest_tag_in__out}"
        case "${_au__latest}" in
            "v${_au__version}"|"${_au__version}") set -- "${_au__latest}" ;;
            *) return 1 ;;
        esac
    else
        set -- "v${_au__version}" "${_au__version}"
    fi
    _au__names="${_au__crate}"
    [ -n "${program}" ] && [ X"${program}" != X"${_au__crate}" ] && _au__names="${_au__crate} ${program}"
    _au__page="${CH}/tmp/release.$$"
    _util_mkdir_p "${CH}/tmp" || { why="${CH}/tmp could not be made"; return 2; }
    for _au__tag in "${@}"; do
        _api_fetcher_answered "${GITHUB}/${repo}/releases/expanded_assets/${_au__tag}" "${_au__page}"
        case "${?}" in
            0) ;;
            1) continue ;;
            *) rm -f "${_au__page}"
               why="github could not be asked what the release ${_au__tag} of ${repo} has"; return 2 ;;
        esac
        asset="$(_matching "${_au__page}" "${_au__tag}" "${_au__version}" "${_au__names}" "$(_targets | tr '\n' ' ')")"
        rm -f "${_au__page}"
        if [ -n "${asset}" ]; then
            tag="${_au__tag}"
            _util_mkdir_p "${_au__kept%/*}" && printf "%s %s %s\\n" "${repo}" "${tag}" "${asset}" > "${_au__kept}"
            return 0
        fi
    done
    return 1
}

_path() {
    #$1 => crate, $2 => version, $3 => the source probe chose, kept when given
    #    _path hyperfine 1.20.0  =>  quickinstall x86_64-unknown-linux-musl
    #    _path fd-find 10.5.0    =>  author sharkdp/fd v10.5.0
    _pt__f="${CH}/cache/paths/${1}/${2}"
    if [ -n "${3}" ]; then
        _util_mkdir_p "${_pt__f%/*}" && printf "%s\\n" "${3}" > "${_pt__f}"
        return 0
    fi
    [ -s "${_pt__f}" ] && cat "${_pt__f}"
}

_decided() {
    #$1 => crate, $2 => version. The source probe chose, or chosen again as probe does
    #    _decided fd-find 10.5.0  =>  0, source author, repo sharkdp/fd, tag v10.5.0
    source=""
    _dc__path="$(_path "${1}" "${2}")"; _dc__rest="${_dc__path#* }"
    case "${_dc__path%% *}" in
        quickinstall) source="quickinstall"; target="${_dc__rest}"; return 0 ;;
        author) source="author"; repo="${_dc__rest%% *}"; tag="${_dc__rest#* }"; return 0 ;;
    esac
    _build "${1}" "${2}"
    case "${?}" in
        0) source="quickinstall"; _path "${1}" "${2}" "quickinstall ${target}"; return 0 ;;
        2) return 2 ;;
    esac
    _author "${1}" "${2}" ""
    case "${?}" in
        0) source="author"; _path "${1}" "${2}" "author ${repo} ${tag}"; return 0 ;;
        2) return 2 ;;
    esac
    return 1
}

_release_file() {
    #$1 => a tag
    #    _release_file v1.23.0  =>  ${RELEASES}/download/v1.23.0/cargo-binstall-x86_64-unknown-linux-musl.tgz
    printf "%s\\n" "${RELEASES}/download/${1}/${TOOL_NAME}-$(_platform)-unknown-linux-musl.tgz"
}

_release_digest() {
    #$1 => version. The sha256 github shows beside cargo-binstall's file
    _rd__page="${CH}/tmp/assets.$$"
    _util_mkdir_p "${CH}/tmp" || return 2
    _api_fetcher_answered "${RELEASES}/expanded_assets/v${1}" "${_rd__page}"
    case "${?}" in
        0) ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
    _rd__file="$(_release_file "v${1}")"
    awk -v want="releases/download/v${1}/${_rd__file##*/}\"" '
        {
            s = $0
            while (match(s, /releases\/download\/[^"]*"|sha256:[0-9a-f]+/)) {
                t = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
                if (substr(t, 1, 7) != "sha256:") { here = (t == want); continue }
                if (here && length(t) == 71) { print substr(t, 8); exit }
            }
        }' "${_rd__page}"
    rm -f "${_rd__page}"
}

_run_tool() {
    #$1... => cargo-binstall's arguments, run with the channel's HOME and CARGO_HOME
    _util_mkdir_p "${CH}/cargo"
    (
        _api_tool_home
        CARGO_HOME="${CH}/cargo"; CARGO_INSTALL_ROOT="${root}"
        export CARGO_HOME CARGO_INSTALL_ROOT
        exec "${tool}" "${@}" </dev/null
    )
}

_programs() {
    for _pg__p in "${1}"/bin/*; do
        [ -f "${_pg__p}" ] && [ -x "${_pg__p}" ] && printf "%s\\n" "${_pg__p##*/}"
    done
}

_installed() {
    #$1 => a root, $2 => crate, $3 => version
    #    _installed "${root}" fd-find 10.5.0  =>  0

    #cargo's record is written last
    grep -F "\"${2} ${3} (" "${1}/.crates.toml" >/dev/null 2>&1
}

_undo() {
    #obtain's EXIT trap: removes an unfinished root
    [ -n "${made}" ] || return 0
    rm -rf "${made}"; rmdir "${made%/*}" 2>/dev/null
}

_meta() {
    printf "%s\\n" "kind=artifact" "confines=no" "describes=self" "manager=${SELF_NAME}:${TOOL_NAME}"
    exit 0
}

_probe() {
    #$1 => a crate, $2 => a version when one was asked for
    crate="${1}"; ver="${2}"
    #a bare name is a command's, and nobody publishes which crate builds which
    [ X"${CMDFOUND_NAMED}" = X"${SELF_NAME}" ] || exit 1
    [ -z "${crate}" ] && exit 1
    _valid "${crate}" "${ver}" || exit 1
    _targets >/dev/null || exit 1
    if [ X"${crate}" = X"${TOOL_NAME}" ]; then
        _platform >/dev/null || exit 1
        version="${ver}"
        if [ -z "${version}" ]; then
            version="$(_api_latest_release)" || {
                _api_answer_unreachable "the newest cargo-binstall release could not be read from ${RELEASES}"
            }
        fi
        sizef="${CH}/cache/${TOOL_NAME}-${version}-$(_platform).bytes"
        if [ ! -s "${sizef}" ]; then
            answer="$(_heads "$(_release_file "v${version}")")"
            case "${answer%% *}" in
                200) ;;
                404|410) exit 1 ;;
                *) printf "unreachable=%s\\n" "cargo-binstall ${version} could not be weighed at ${RELEASES}"
                   exit 2 ;;
            esac
            if ! _util_is_number "${answer#* }"; then
                _api_answer_unreachable "cargo-binstall ${version} could not be weighed at ${RELEASES}"
            fi
            _util_mkdir_p "${sizef%/*}" && printf "%s\\n" "${answer#* }" > "${sizef}"
        fi
        printf "version=%s\\n" "${version}"
        IFS= read -r bytes < "${sizef}"; printf "bytes=%s\\n" "${bytes}"
        exit 0
    fi
    _util_has_word "${CMDFOUND_NO_MANAGER}" "${SELF_NAME}" && exit 1

    _entries "${crate}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_unreachable "crates.io's index could not be asked about ${crate}" ;;
    esac
    name="$(_name_of "${entries}")"
    [ -n "${name}" ] || name="${crate}"
    _valid "${name}" "" || exit 1
    versions="$(_versions "${entries}" "${ver}")"
    newest=""
    [ -z "${ver}" ] && newest="$(printf "%s\\n" "${versions}" | awk 'NR == 1')"
    tries="0"
    for version in ${versions}; do
        [ "${tries}" -ge "${TRIES}" ] && break
        tries="$((${tries} + 1))"
        _build "${name}" "${version}"
        case "${?}" in
            0) _path "${name}" "${version}" "quickinstall ${target}"
               printf "version=%s\\n" "${version}"
               printf "bytes=%s\\n" "${bytes}"
               printf "package=%s\\n" "${name}"
               printf "badge=%s\\n" "via:${SELF_NAME}"
               printf "requires=%s\\n" "${SELF_NAME}:${TOOL_NAME}"
               exit 0 ;;
            2) _api_answer_unreachable "${why}" ;;
        esac
        _author "${name}" "${version}" "${newest}"
        case "${?}" in
            #no bytes: cargo-binstall picks the file only as it installs
            0) _path "${name}" "${version}" "author ${repo} ${tag}"
               _manifest "${name}" "${newest:-${version}}" >/dev/null 2>&1 || signed=""
               printf "version=%s\\n" "${version}"
               printf "package=%s\\n" "${name}"
               if [ -n "${signed}" ]; then
                   printf "badge=%s\\n" "via:${SELF_NAME}"
               else
                   printf "badge=%s\\n" "none"
               fi
               printf "requires=%s\\n" "${SELF_NAME}:${TOOL_NAME}"
               exit 0 ;;
            2) _api_answer_unreachable "${why}" ;;
        esac
    done
    exit 1
}

_locate() {
    #$1 => a crate, $2 => a version, $3 => the program asked for
    name="${1}"; ver="${2}"; want="${3}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    _valid "${name}" "${ver}" || exit 1
    _targets >/dev/null || exit 1
    if [ X"${name}" = X"${TOOL_NAME}" ]; then
        _platform >/dev/null || exit 1
        sum="$(_release_digest "${ver}")"
        if ! _util_is_sha256 "${sum}"; then
            _api_answer_unreachable "the sha256 github shows for cargo-binstall ${ver} could not be read from ${RELEASES}"
        fi
        printf "url=%s\\n" "$(_release_file "v${ver}")"
        printf "%s\\n" "format=tar.gz" "bin=${TOOL_NAME}" "sha256=${sum}"
        exit 0
    fi
    _decided "${name}" "${ver}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_unreachable "${why}" ;;
    esac
    if [ X"${source}" = X"quickinstall" ]; then
        printf "url=%s\\n" "${QUICKINSTALL}/${name}-${ver}/${name}-${ver}-${target}.tar.gz"
    else
        printf "url=%s\\n" "${GITHUB}/${repo}/releases/tag/${tag}"
    fi
    [ -n "${want}" ] && printf "bin=%s\\n" "${want}"
    exit 0
}

_obtain() {
    #$1 => a crate, $2 => a version, $3 => the program asked for, the crate's name when none
    name="${1}"; ver="${2}"; want="${3:-${1}}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    if ! _valid "${name}" "${ver}"; then
        _api_answer_failed "'${name}' '${ver}' is not a crate and version this channel will install"
    fi
    tool="${CMDFOUND_REQUIRED}"
    if [ ! -x "${tool}" ]; then
        _api_answer_unreachable "cargo-binstall is not available to install ${name}"
    fi
    _api_is_program_name "${want}" || \
        _api_answer_failed "'${want}' is not a program's name"

    root="${CH}/crates/${name}/${ver}"
    made=""
    _util_trap_exit '_undo'
    if ! _installed "${root}" "${name}" "${ver}"; then
        _decided "${name}" "${ver}"
        case "${?}" in
            0) ;;
            1) _api_answer_failed "neither QuickInstall nor the author of ${name} has a build of ${ver} for this machine" ;;
            *) _api_answer_unreachable "${why}" ;;
        esac
        made="${root}"
        rm -rf "${root}"
        _util_mkdir_p "${root}" && _util_mkdir_p "${CH}/log" || exit 1
        log="${CH}/log/${name}.log"
        #the questions cargo-binstall 1.23.0 asks github's api, counted through a proxy
        if [ X"${source}" = X"quickinstall" ]; then
            asks="1"; from="QuickInstall"
        else
            _ob__repo="${repo}"
            _manifest "${name}" "${ver}" || { pkgurl=""; subdir=""; }
            repo="${_ob__repo}"
            asks="2"
            [ -n "${subdir}" ] && asks="4"
            [ -n "${pkgurl}" ] && asks="1"
            _api_github_token_in && asks="$((${asks} + 1))"
            from="the releases of ${repo}"
        fi
        if ! _quota "${asks}" "${name} ${ver} from ${from}"; then
            _api_answer_unreachable "${why}"
        fi
        #one strategy only: given two, a failed signature falls through to the next
        if [ X"${source}" = X"quickinstall" ]; then
            set -- --strategies quick-install --only-signed --targets "${target}"
            about="QuickInstall's build of ${name} ${ver}"
        else
            #one --targets each: cargo-binstall refuses a comma list
            set -- --strategies crate-meta-data
            for t in $(_targets); do set -- "${@}" --targets "${t}"; done
            about="the releases of ${repo}"
        fi
        set -- --root "${root}" --no-confirm --disable-telemetry --no-discover-github-token "${@}" "${name}@${ver}"
        if [ -t 2 ]; then
            { _run_tool "${@}" 2>&1; printf "%s\\n" "${?}" > "${log}.rc"; } | tee "${log}" >&2
        else
            _run_tool "${@}" > "${log}" 2>&1
            printf "%s\\n" "${?}" > "${log}.rc"
        fi
        rc=""; IFS= read -r rc 2>/dev/null < "${log}.rc"; rm -f "${log}.rc"
        if [ X"${rc}" != X"0" ] || ! _installed "${root}" "${name}" "${ver}"; then
            if grep 'api\.github\.com' "${log}" >/dev/null 2>&1; then
                _api_answer_unreachable "cargo-binstall could not ask api.github.com about ${about}, which it does before it downloads; its account is in ${log}"
            fi
            _api_answer_failed "cargo-binstall could not install ${name} ${ver}; its account is in ${log}"
        fi
    fi

    programs="$(_programs "${root}")"
    _api_program_in "${programs}" "${want}" || _api_answer_failed "${name} ${why}"
    program="${_api_program_in__out}"
    made=""

    printf "program=%s\\n" "${root}/bin/${program}"
    _decided "${name}" "${ver}" >/dev/null 2>&1
    if [ X"${source}" = X"author" ]; then
        printf "asset=%s\\n" "${repo}@${tag}"
    else
        target="$(awk 'match($0, /"target":"[^"]*"/) {print substr($0, RSTART + 10, RLENGTH - 11); exit}' \
            "${root}/binstall/crates-v1.json" 2>/dev/null)"
        printf "asset=%s\\n" "${name}-${ver}-${target:-unknown}.tar.gz"
    fi
    printf "member=%s\\n" "crates/${name}/${ver}"
    exit 0
}

case "${1}" in
    meta)   _meta ;;

    index)
        #the sparse index is read a crate at a time, when that crate is asked
        #for, so there is no catalog to keep
        exit 1
        ;;

    search)
        #and none to search: crates.io's search is its api, which asks every
        #caller for a way to reach them
        exit 0
        ;;

    probe)  _probe "${2}" "${3}" ;;
    locate) _locate "${2}" "${3}" "${4}" ;;
    obtain) _obtain "${2}" "${3}" "${4}" ;;

    *) printf "%s\\n" "usage: ${SELF_NAME} meta|index|search|probe|locate|obtain" >&2; exit 1 ;;
esac
__CMDFOUND_FILE__ 755 conda-forge
#!/bin/sh
#description: cmdfound channel - conda-forge, asked for by name and installed by micromamba
#usage: conda-forge meta | conda-forge index [bytes]
#       conda-forge search WORDS... | conda-forge probe PACKAGE [VER]
#       conda-forge locate PACKAGE VER [PROGRAM]
#       conda-forge obtain PACKAGE VER [PROGRAM] | conda-forge reclaim

CHANNEL="${CMDFOUND_CONDA_FORGE_CHANNEL:-https://conda.anaconda.org/conda-forge}"
RELEASES="${CMDFOUND_MICROMAMBA_RELEASES:-https://github.com/mamba-org/micromamba-releases/releases}"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"
INDEX="${CH}/index/packages.tsv"
TOOL_NAME="micromamba"
#what micromamba 2.9 reads a configuration or a place for its things from,
#MAMBARC and CONDARC even beside --rc-file, and MAMBA_DRY_RUN and
#MAMBA_DOWNLOAD_ONLY, each of which leaves an install silently installing
#nothing (owner, 2026-09-16)
MM_KEPT_FROM="MAMBARC CONDARC MAMBA_OVERRIDE_RC_FILES CONDA_PKGS_DIRS CONDA_ENVS_DIRS CONDA_ENVS_PATH MAMBA_DEFAULT_ROOT_PREFIX MAMBA_TARGET_PREFIX MAMBA_DRY_RUN MAMBA_DOWNLOAD_ONLY"

_platform() {
    _util_machine_in
    case "${_util_machine_in__os}/${_util_machine_in__cpu}" in
        Linux/x86_64|Linux/amd64)   printf "%s\\n" "linux-64" ;;
        Linux/aarch64|Linux/arm64)  printf "%s\\n" "linux-aarch64" ;;
        Linux/ppc64le)              printf "%s\\n" "linux-ppc64le" ;;
        Darwin/x86_64)              printf "%s\\n" "osx-64" ;;
        Darwin/arm64)               printf "%s\\n" "osx-arm64" ;;
        *) return 1 ;;
    esac
}

_indexer() {
    #channeldata.json on stdin, a line per package
    #    _indexer < channeldata.json  =>  ripgrep<TAB>linux-64,osx-arm64<TAB>a line-oriented search tool
    LC_ALL=C awk "${JSON_STRINGS}"'
    function squeeze(v) { gsub(/[ \t\n\r]+/, " ", v); sub(/^ /, "", v); sub(/ $/, "", v); return v }
    function structure(seg,   i, n, c) {
        n = length(seg)
        for (i = 1; i <= n; i++) {
            c = substr(seg, i, 1)
            if (c == "{") { depth++; kind[depth] = "o"; expect = "key" }
            else if (c == "[") { depth++; kind[depth] = "a"; expect = "elem" }
            else if (c == "}" || c == "]") {
                if (c == "}" && depth == 3 && name != "")
                    printf("%s\t%s\t%s\n", name, subdirs, squeeze(summary))
                depth--; expect = ""
            }
            else if (c == ":") expect = "value"
            else if (c == ",") expect = (kind[depth] == "o") ? "key" : "elem"
        }
    }
    BEGIN { RS = "\""; instr = 0; depth = 0; buf = "" }
    {
        #most of what lies between two strings is a colon or a comma alone
        if (!instr) {
            if ($0 == ":") expect = "value"
            else if ($0 == ",") expect = (kind[depth] == "o") ? "key" : "elem"
            else structure($0)
            instr = 1; buf = ""; next
        }
        buf = buf $0
        if (substr(buf, length(buf)) == "\\" && match(buf, /\\+$/) && RLENGTH % 2 == 1) { buf = buf "\""; next }
        instr = 0
        if (expect == "key") {
            key[depth] = buf
            if (depth == 2) {
                name = (key[1] == "packages") ? unesc(buf) : ""
                subdirs = ""; summary = ""
            }
            next
        }
        if (depth == 3 && key[3] == "summary") summary = unesc(buf)
        else if (depth == 4 && kind[4] == "a" && key[3] == "subdirs") subdirs = subdirs (subdirs == "" ? "" : ",") unesc(buf)
    }'
}

_known() {
    #$1 => package, built for this platform or noarch
    #    _known ripgrep  =>  0
    #    _known nosuch   =>  1
    awk -F'\t' -v n="${1}" -v s="$(_platform)" '
        $1 == n {
            k = split($2, a, ",")
            for (i = 1; i <= k; i++) if (a[i] == s || a[i] == "noarch") { f = 1; exit }
            exit
        }
        END { exit !f }' "${INDEX}"
}

_micromamba_here() {
    [ -x "${CH}/tool/current" ] || return 1
    printf "%s\\n" "${CH}/tool/current"
}

_release_file() {
    #$1 => a release tag
    #    _release_file 2.3.0-0  =>  ${RELEASES}/download/2.3.0-0/micromamba-linux-64
    printf "%s\\n" "${RELEASES}/download/${1}/${TOOL_NAME}-$(_platform)"
}

_run_tool() {
    #$1... => what ${tool}, a micromamba, is asked, writing only in this channel
    [ -f "${CH}/mambarc" ] || : > "${CH}/mambarc"
    (
        unset ${MM_KEPT_FROM} CONDA_PREFIX CONDA_DEFAULT_ENV
        #micromamba ignores curl's SSL_CERT_FILE, so it gets the user's certificates here
        case "${MAMBA_CACERT_PATH}:${MAMBA_SSL_VERIFY}" in
            :|:true|:1|':<true>'|':<system>')
                _rt__ca="${SSL_CERT_FILE:-${CURL_CA_BUNDLE}}"
                [ -n "${_rt__ca}" ] && { MAMBA_CACERT_PATH="${_rt__ca}"; export MAMBA_CACERT_PATH; } ;;
        esac
        _api_tool_home
        MAMBA_ROOT_PREFIX="${CH}/root"; export MAMBA_ROOT_PREFIX
        exec "${tool}" --rc-file "${CH}/mambarc" -r "${CH}/root" "${@}"
    )
}

_plan_rows() {
    #micromamba's --json dry run on stdin, link rows then fetch rows: kind, name,
    #version, build, subdir, fn, url, sha256, md5, size, a tab apart
    #    _plan_rows < plan.json  =>  link<TAB>ripgrep<TAB>14.1.1<TAB>h5ef7bb8_0<TAB>linux-64<TAB>...
    #                                fetch<TAB>ripgrep<TAB>14.1.1<TAB>h5ef7bb8_0<TAB>linux-64<TAB>...
    _util_json 4 | awk -F'\t' '
        {
            n = split($1, p, "/")
            if (n != 4 || p[1] != "actions" || (p[2] != "LINK" && p[2] != "FETCH")) next
            v[p[2], p[3], p[4]] = $2
            if (p[3] + 1 > count[p[2]]) count[p[2]] = p[3] + 1
        }
        END {
            split("LINK FETCH", lists, " ")
            for (l = 1; l <= 2; l++) {
                a = lists[l]
                for (i = 0; i < count[a]; i++)
                    printf("%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", tolower(a), v[a, i, "name"], v[a, i, "version"],
                        v[a, i, "build"], v[a, i, "subdir"], v[a, i, "fn"], v[a, i, "url"], v[a, i, "sha256"],
                        v[a, i, "md5"], v[a, i, "size"])
            }
        }'
}

_solve() {
    #$1 => package, $2 => version or latest. The plan in plan_rows, the reason in why
    #    _solve ripgrep latest  =>  0, plan_rows has ripgrep and what it needs
    #    _solve ripgrep 99      =>  1
    #    _solve ripgrep latest  =>  2 offline, why says what micromamba said
    _sv__name="${1}"; _sv__ver="${2}"
    why=""; plan_rows=""
    _sv__spec="${_sv__name}"
    [ X"${_sv__ver}" != X"latest" ] && [ -n "${_sv__ver}" ] && _sv__spec="${_sv__name}=${_sv__ver}"
    _sv__out="${CH}/tmp/solve.$$"
    if ! _util_mkdir_p "${CH}/tmp"; then
        why="${CH}/tmp could not be made to keep micromamba's answer in"
        return 2
    fi
    rm -rf "${_sv__out}" "${_sv__out}.prefix"
    _run_tool create --dry-run --json -y -p "${_sv__out}.prefix" -c "${CHANNEL}" --override-channels \
        "${_sv__spec}" > "${_sv__out}" 2>/dev/null
    _sv__rc="${?}"
    rm -rf "${_sv__out}.prefix"
    if [ "${_sv__rc}" -eq "0" ]; then
        plan_rows="$(_plan_rows < "${_sv__out}")"
        rm -f "${_sv__out}"
        [ -n "${plan_rows}" ] && return 0
        why="micromamba solved ${_sv__spec} and said nothing this channel could read"
        return 2
    fi
    _sv__log="$(_util_json 3 < "${_sv__out}" | awk -F'\t' '
        { n = split($1, p, "/") }
        n == 3 && p[1] == "log_history" && p[3] == "level" { level[p[2]] = $2 }
        n == 3 && p[1] == "log_history" && p[3] == "message" { msg[p[2]] = $2; if (p[2] + 1 > count) count = p[2] + 1 }
        END { for (i = 0; i < count; i++) if (level[i] == "error" || level[i] == "critical") print msg[i] }')"
    rm -f "${_sv__out}"
    if printf "%s\\n" "${_sv__log}" | grep -E 'does not exist|Could not solve|cannot be installed|nothing provides' >/dev/null; then
        return 1
    fi
    why="micromamba could not solve ${_sv__spec}: $(printf "%s\\n" "${_sv__log}" | \
        awk 'NF {l = $0} END {gsub(/  +/, " ", l); print (l != "" ? l : "it gave no reason")}')"
    return 2
}

_conda_meta_record() {
    #$1 => an environment, $2 => package
    #    _conda_meta_record "${env}" ripgrep  =>  ${env}/conda-meta/ripgrep-14.1.1-h5ef7bb8_0.json
    for _cmr__f in "${1}"/conda-meta/*.json; do
        [ -f "${_cmr__f}" ] || continue
        _cmr__n="${_cmr__f##*/}"; _cmr__n="${_cmr__n%.json}"; _cmr__n="${_cmr__n%-*}"; _cmr__n="${_cmr__n%-*}"
        [ X"${_cmr__n}" = X"${2}" ] && { printf "%s\\n" "${_cmr__f}"; return 0; }
    done
    return 1
}

_linked_from() {
    #$1 => an environment, what it was linked from, relative to this channel
    #    _linked_from "${env}"  =>  root/pkgs/ripgrep-14.1.1-h5ef7bb8_0
    #                               root/pkgs/ripgrep-14.1.1-h5ef7bb8_0.conda
    _lf__chp="$(cd "${CH}" && pwd -P)" || _lf__chp="${CH}"
    for _lf__f in "${1}"/conda-meta/*.json; do
        [ -f "${_lf__f}" ] || continue
        _util_json 1 < "${_lf__f}" | awk -F'\t' -v ch="${CH}/" -v chp="${_lf__chp}/" '
            $1 == "extracted_package_dir" {d = $2}
            $1 == "fn" {fn = $2}
            END {
                if (d == "") exit
                if (index(d, ch) == 1) d = substr(d, length(ch) + 1)
                else if (index(d, chp) == 1) d = substr(d, length(chp) + 1)
                else exit
                if (d ~ /(^|\/)\.\.(\/|$)/) exit
                print d
                if (fn != "" && fn !~ /\//) { sub(/\/[^\/]*$/, "", d); print d "/" fn }
            }'
    done
}

_run_by_micromamba() {
    #prints the launcher lines that hand ${program} in ${env} to micromamba run,
    #HOME, TMPDIR and MM_KEPT_FROM given back to the program as the user had them
    printf 'set -- "%s" "$@"; _argc="${#}"\n' "${program}"
    printf '%s\n' "for _n in HOME XDG_CACHE_HOME TMPDIR ${MM_KEPT_FROM}; do"
    printf '%s\n' '    eval "_k=\"\${${_n}+1}\"; _v=\"\${${_n}}\""; set -- "$@" "${_n}=${_k:-0}${_v}"' 'done'
    printf '%s\n' 'while [ "${_argc}" -gt "0" ]; do set -- "$@" "${1}"; shift; _argc="$((_argc - 1))"; done'
    printf '%s\n' "unset ${MM_KEPT_FROM}"
    printf 'HOME="%s/home"; XDG_CACHE_HOME="%s/home/.cache"; TMPDIR="%s/tmp"\n' "${CH}" "${CH}" "${CH}"
    printf '%s\n' 'export HOME XDG_CACHE_HOME TMPDIR' '[ -d "${TMPDIR}" ] || mkdir -p "${TMPDIR}"'
    printf 'exec "%s" --rc-file "%s/mambarc" run -r "%s/root" -p "%s" /bin/sh -c ' "${tool}" "${CH}" "${CH}" "${env}"
    printf '%s' "'"
    _rbm__n="3"; for _rbm__v in ${MM_KEPT_FROM}; do _rbm__n="$((_rbm__n + 1))"; done
    printf '%s' "_i=0; while [ \"\${_i}\" -lt \"${_rbm__n}\" ]; do "
    printf '%s' '_f="${1#*=}"; case "${_f}" in 0) unset "${1%%=*}" ;; *) export "${1%%=*}=${_f#1}" ;; esac; shift; _i="$((_i + 1))"; done; exec "$@"'
    printf '%s\n' "' cmdfound \"\$@\""
}

_valid() {
    #$1 => package, $2 => version
    #    _valid ripgrep 14.1.0  =>  0
    #    _valid -rf 1.0         =>  1
    #    _valid .rg 1.0         =>  1
    case "${1}" in
        ''|[!a-z0-9]*|*[!a-z0-9._-]*) return 1 ;;
    esac
    #conda writes an epoch with a !
    case "${2}" in
        '') ;;
        *) _api_is_version "${2}" "!" || return 1 ;;
    esac
    return 0
}

_undo() {
    #an obtain's EXIT trap: removes what made and explicit still name
    [ -n "${explicit}" ] && rm -f "${explicit}"
    [ -n "${made}" ] || return 0
    rm -rf "${made}"; rmdir "${made%/*}" 2>/dev/null
}

_meta() {
    printf "%s\\n" "kind=artifact" "confines=no" "describes=self" "manager=${SELF_NAME}:${TOOL_NAME}" "reclaims=yes"
    exit 0
}

_index() {
    #$1 => bytes, to only say what channeldata.json weighs
    mode="${1}"
    if [ X"${mode}" = X"bytes" ]; then
        _api_answer_bytes_of "${CHANNEL}/channeldata.json"
    fi
    _util_mkdir_p "${CH}/index" || exit 1
    kept="${CH}/index/channeldata.json.part"; part="${kept}.$$"; new="${INDEX}.$$"
    _api_catalog_fetch "${CHANNEL}/channeldata.json" "${kept}" conda-forge
    bytes="$(wc -c < "${part}" | awk '{print $1}')"
    #not cut short from here: the old index could be left half replaced
    trap '' TERM INT HUP
    _indexer < "${part}" | LC_ALL=C sort -u > "${new}"
    rm -f "${part}"
    _api_catalog_keep "${new}" "${INDEX}" "$(awk 'END {print NR}' "${new}")" "conda-forge's catalog"
    printf "packages=%s\\n" "$(awk 'END {print NR}' "${INDEX}")"
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_search() {
    #$1... => the words looked for
    #    _search ripgrep  =>  conda-forge:ripgrep<TAB>-<TAB>a line-oriented search tool
    [ -s "${INDEX}" ] || _api_answer_no_index
    #the catalog does not say which program a package gives, hence the dash
    search_words="${*}" awk -F'\t' -v ch="${SELF_NAME}" "${SEARCH_AWK}"'
        words_in($1 " " $3) { printf("%s:%s\t-\t%s\n", ch, $1, $3) }' "${INDEX}"
    exit 0
}

_probe() {
    #$1 => a package, $2 => a version
    #    _probe ripgrep  =>  version=14.1.1
    #                        bytes=1712345
    #                        requires=conda-forge:micromamba

    #only when a spec named this channel: nothing maps a command to a package
    name="${1}"; ver="${2}"
    [ X"${CMDFOUND_NAMED}" = X"${SELF_NAME}" ] || exit 1
    [ -z "${name}" ] && exit 1
    _platform >/dev/null || exit 1
    _valid "${name}" "${ver}" || exit 1
    if [ X"${name}" = X"${TOOL_NAME}" ]; then
        version="${ver}"
        if [ -z "${version}" ]; then
            version="$(_api_latest_release)" || {
                _api_answer_unreachable "the newest micromamba release could not be read from ${RELEASES}"
            }
        fi
        sizef="${CH}/cache/${TOOL_NAME}-${version}-$(_platform).bytes"
        if [ ! -s "${sizef}" ]; then
            bytes="$(_api_fetcher_head_size "$(_release_file "${version}")")"
            if [ -z "${bytes}" ]; then
                _api_answer_unreachable "micromamba ${version} could not be weighed at ${RELEASES}"
            fi
            _util_mkdir_p "${sizef%/*}" && printf "%s\\n" "${bytes}" > "${sizef}"
        fi
        printf "version=%s\\n" "${version}"
        IFS= read -r bytes < "${sizef}"; printf "bytes=%s\\n" "${bytes}"
        exit 0
    fi
    [ -s "${INDEX}" ] || _api_answer_no_index
    _known "${name}" || exit 1
    _util_has_word "${CMDFOUND_NO_MANAGER}" "${SELF_NAME}" && exit 1

    if ! tool="$(_micromamba_here)"; then
        printf "version=%s\\n" "${ver:-latest}"
        printf "requires=%s\\n" "${SELF_NAME}:${TOOL_NAME}"
        exit 0
    fi
    _solve "${name}" "${ver}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_unreachable "${why}" ;;
    esac
    version="$(printf "%s\\n" "${plan_rows}" | awk -F'\t' -v n="${name}" '$1 == "link" && $2 == n {print $3; exit}')"
    [ -z "${version}" ] && exit 1
    _valid "${name}" "${version}" || exit 1
    #kept for obtain, to install exactly what was solved
    plan="${CH}/cache/plans/${name}/${version}"
    _util_mkdir_p "${plan%/*}" && \
        printf "%s\\n" "${plan_rows}" | awk -F'\t' '$1 == "link"' | _util_write_aside "${plan}"
    printf "version=%s\\n" "${version}"
    printf "bytes=%s\\n" "$(printf "%s\\n" "${plan_rows}" | awk -F'\t' '$1 == "fetch" {t += $10} END {print t + 0}')"
    printf "requires=%s\\n" "${SELF_NAME}:${TOOL_NAME}"
    exit 0
}

_locate() {
    #$1 => a package, $2 => a version, $3 => the program asked for
    #    _locate ripgrep 14.1.1 rg  =>  url=https://conda.anaconda.org/conda-forge
    #                                   bin=rg
    name="${1}"; ver="${2}"; want="${3}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    _platform >/dev/null || exit 1
    _valid "${name}" "${ver}" || exit 1
    if [ X"${name}" = X"${TOOL_NAME}" ]; then
        url="$(_release_file "${ver}")"
        sumf="${CH}/tmp/${TOOL_NAME}.sha256.$$"
        _util_mkdir_p "${sumf%/*}"
        _api_fetcher_answered "${url}.sha256" "${sumf}"
        sum="$(awk 'NR == 1 {print tolower($1)}' "${sumf}" 2>/dev/null)"; rm -f "${sumf}"
        if ! _util_is_sha256 "${sum}"; then
            _api_answer_unreachable "the sha256 published beside micromamba ${ver} could not be had"
        fi
        printf "url=%s\\n" "${url}"
        printf "%s\\n" "format=raw" "bin=${TOOL_NAME}" "sha256=${sum}"
        exit 0
    fi
    [ -s "${INDEX}" ] || _api_answer_no_index
    _known "${name}" || exit 1
    printf "url=%s\\n" "${CHANNEL}"
    [ -n "${want}" ] && printf "bin=%s\\n" "${want}"
    exit 0
}

_obtain() {
    #$1 => a package, $2 => a version, $3 => the program asked for
    name="${1}"; ver="${2}"; want="${3:-${name}}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    if ! _valid "${name}" "${ver}"; then
        _api_answer_failed "'${name}' '${ver}' is not a conda package and version this channel will install"
    fi
    tool="${CMDFOUND_REQUIRED}"
    if [ ! -x "${tool}" ]; then
        _api_answer_unreachable "micromamba is not available to install ${name}"
    fi
    _api_is_program_name "${want}" || \
        _api_answer_failed "'${want}' is not a program's name"
    if _api_is_unsafe "${CH}" || _api_is_unsafe "${tool}" || _api_is_unsafe "${want}"; then
        _api_answer_failed "${LAUNCHER_UNSAFE}"
    fi

    env="${CH}/envs/${name}/${ver}"
    _util_mkdir_p "${CH}/log" && _util_mkdir_p "${CH}/tmp" || exit 1
    log="${CH}/log/${name}.log"
    made=""; explicit=""
    _util_trap_exit '_undo'
    if ! _conda_meta_record "${env}" "${name}" >/dev/null; then
        made="${env}"
        rm -rf "${env}"
        _util_mkdir_p "${env%/*}" || exit 1
        #probe's plan of the last hour; a line without a sum would install unchecked
        plan="${CH}/cache/plans/${name}/${ver}"
        if [ -s "${plan}" ] && [ -z "${CMDFOUND_REFRESH}" ] && \
           [ -n "$(find "${plan}" -mmin -60 2>/dev/null)" ] && \
           awk -F'\t' '$8 == "" && $9 == "" {unsummed = 1} END {exit unsummed}' "${plan}"; then
            explicit="${CH}/tmp/explicit.$$"
            { printf "%s\\n" "@EXPLICIT"; awk -F'\t' '{printf("%s#%s\n", $7, ($8 != "" ? $8 : $9))}' "${plan}"; } > "${explicit}"
            set -- create -y -p "${env}" --file "${explicit}"
        else
            explicit=""
            spec="${name}"; [ X"${ver}" != X"latest" ] && spec="${name}=${ver}"
            set -- create -y -p "${env}" -c "${CHANNEL}" --override-channels "${spec}"
        fi
        : > "${log}"
        _api_shown "${log}" _run_tool "${@}"
        rc="${?}"
        [ -n "${explicit}" ] && rm -f "${explicit}"
        if [ "${rc}" -ne "0" ]; then
            _api_answer_failed "micromamba could not install ${name} ${ver}$(_api_log_hint "${log}")"
        fi
    fi
    top="$(_conda_meta_record "${env}" "${name}")" || {
        _api_answer_failed "micromamba installed ${name} ${ver} but left no record of ${name}"
    }

    record="$(_util_json 2 < "${top}")"
    programs="$(printf "%s\\n" "${record}" | awk -F'\t' '$1 ~ /^files\/[0-9]+$/ && $2 ~ /^bin\/[^\/]+$/ {sub(/^bin\//, "", $2); print $2}' | \
        while read -r p; do [ -x "${env}/bin/${p}" ] && printf "%s\\n" "${p}"; done)"
    _api_program_in "${programs}" "${want}" || _api_answer_failed "${name} ${why}"
    program="${_api_program_in__out}"
    if ! _api_is_program_name "${program}"; then
        _api_answer_failed "${name} names a program this channel will not write into a launcher"
    fi

    run="${CH}/run/${name}/${ver}"
    _util_mkdir_p "${run}" || exit 1
    activates=""
    for d in "${env}/etc/conda/activate.d" "${env}/etc/conda/env_vars.d"; do
        _util_is_empty_but "${d}" "" || activates="1"
    done
    [ -f "${env}/conda-meta/state" ] && activates="1"
    {
        printf "%s\\n" "#!/bin/sh"
        if [ -z "${activates}" ]; then
            printf "%s\\n" "#written by cmdfound: ${program}, from conda-forge ${name} ${ver}, in its environment"
            printf 'if [ -z "${CONDA_PREFIX}" ] || [ X"${CONDA_PREFIX}" = X"%s" ]; then\n' "${env}"
            printf '    CONDA_PREFIX="%s"; PATH="%s/bin${PATH:+:${PATH}}"; export CONDA_PREFIX PATH\n' "${env}" "${env}"
            printf '    exec "%s/bin/%s" "$@"\n' "${env}" "${program}"
            printf '%s\n' 'fi'
            _run_by_micromamba
        else
            printf "%s\\n" "#written by cmdfound: ${program}, from conda-forge ${name} ${ver}, run by micromamba"
            _run_by_micromamba
        fi
    } | _util_write_aside "${run}/${program}" 755 || exit 1
    made=""

    printf "program=%s\\n" "${run}/${program}"
    printf "asset=%s\\n" "$(printf "%s\\n" "${record}" | awk -F'\t' '$1 == "subdir" {s = $2} $1 == "fn" {f = $2} END {print s "/" f}')"
    printf "member=%s\\n" "envs/${name}/${ver}"
    _linked_from "${env}" | while read -r m; do
        [ -e "${CH}/${m}" ] && printf "member=%s\\n" "${m}"
    done
    exit 0
}

_reclaim() {
    #not micromamba clean: it misses these environments, kept beside its root
    if [ X"${CMDFOUND_RECLAIM}" = X"all" ]; then
        printf "freed=%s\\n" "0"
        exit 0
    fi
    pkgs="root/pkgs"
    if [ ! -d "${CH}/${pkgs}" ]; then
        printf "freed=%s\\n" "0"
        exit 0
    fi
    _util_mkdir_p "${CH}/tmp" || exit 1
    work="${CH}/tmp/reclaim.$$"
    _util_trap_exit 'rm -f "${work}".*'
    {
        find "${CH}/members" -type f -exec cat {} + 2>/dev/null
        for env in "${CH}"/envs/*/*; do
            [ -d "${env}/conda-meta" ] && _linked_from "${env}"
        done
    } | awk 'NF' | LC_ALL=C sort -u > "${work}.kept"
    (cd "${CH}" && find "${pkgs}" -path "${pkgs}/cache" -prune -o -type f \
        \( -name index.json -o -name '*.conda' -o -name '*.tar.bz2' \) -print) 2>/dev/null | \
        LC_ALL=C awk '
            /\/info\/index\.json$/ { d = $0; sub(/\/info\/index\.json$/, "", d); dir[d] = 1; next }
            /\.(conda|tar\.bz2)$/ { file[++n] = $0 }
            function inside(p,   q) {
                q = p
                while (sub(/\/[^\/]*$/, "", q)) if (q in dir) return 1
                return 0
            }
            END {
                for (d in dir) if (!inside(d)) print d
                for (i = 1; i <= n; i++) if (!inside(file[i])) print file[i]
            }' | LC_ALL=C sort -u > "${work}.cache"
    LC_ALL=C comm -23 "${work}.cache" "${work}.kept" > "${work}.doomed"
    if [ ! -s "${work}.doomed" ]; then
        printf "freed=%s\\n" "0"
        exit 0
    fi
    (cd "${CH}" && for env in envs/*/*; do [ -d "${env}" ] && printf "%s\\n" "${env}"; done) > "${work}.held"
    freed=""
    if (cd "${CH}" && IFS='
' && set -f && exec du -sk $(cat "${work}.held" "${work}.doomed")) > "${work}.du" 2>/dev/null; then
        freed="$(awk -F'\t' -v list="${work}.doomed" '
            BEGIN { while ((getline p < list) > 0) doomed[p] = 1 }
            $2 in doomed { t += $1 }
            END { printf("%.0f\n", t * 1024) }' "${work}.du")"
    fi
    (cd "${CH}" && IFS='
' && set -f && exec rm -rf $(cat "${work}.doomed"))
    [ -n "${freed}" ] && printf "freed=%s\\n" "${freed}"
    exit 0
}

case "${1}" in
    meta)    _meta ;;
    index)   _index "${2}" ;;
    search)  shift; _search "${@}" ;;
    probe)   _probe "${2}" "${3}" ;;
    locate)  _locate "${2}" "${3}" "${4}" ;;
    obtain)  _obtain "${2}" "${3}" "${4}" ;;
    reclaim) _reclaim ;;

    #no size: the resolver asks one of a channel with reclaims=yes, and this 1
    #is "count it here", one du over the placement's members, which counts
    #once a file the environment links from the cache
    *) printf "%s\\n" "usage: ${SELF_NAME} meta|index|search|probe|locate|obtain|reclaim" >&2; exit 1 ;;
esac
__CMDFOUND_FILE__ 644 confined-launch
#description: cmdfound library - the rules a program in a container runs by
#usage: . confined-launch, from the launchers of docker and udocker, which run
#       where cmdfound's api is not, and from those channels when they build
#a launcher already written sources the copy each obtain refreshes: renaming
#a function here breaks the launchers on disk

#where a build finds the user's CA file, copied in and removed before the commit
CONFINED_CA="/etc/cmdfound/ca.pem"

#ALNUM's alphabet and _, written out: a letter some locale counts in [A-Za-z]
#is no name to the shell, and eval of it would end the launcher
_launch_alpha="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
_launch_alnum="${_launch_alpha}0123456789"
_launch_quote="'"
_launch_nl="
"

_launch_say() {
    printf "%s\\n" "cmdfound: ${*}" >&2
}

_launch_word() {
    #$1... => words, appended to _launch_out quoted for eval set --
    #    _launch_word -v "/home/user/a dir"  =>  -v '/home/user/a dir'
    #    _launch_word "it's"                 =>  'it'\''s'
    #    _launch_word ""                     =>  ''
    for _lw__w in "${@}"; do
        case "${_lw__w}" in
            ''|*[!${_launch_alnum}./:=@%+,-]*) ;;
            *) _launch_out="${_launch_out}${_lw__w} "; continue ;;
        esac
        _lw__q=""
        while :; do
            case "${_lw__w}" in
                *"${_launch_quote}"*)
                    _lw__q="${_lw__q}${_lw__w%%"${_launch_quote}"*}'\\''"
                    _lw__w="${_lw__w#*"${_launch_quote}"}" ;;
                *) break ;;
            esac
        done
        _launch_out="${_launch_out}'${_lw__q}${_lw__w}' "
    done
}

_launch_under() {
    #$1 => an absolute path, $2 => dirs to leave the sockets out; 0 when it is mounted
    #    _launch_under /home/user/x             =>  0, HOME being /home/user
    #    _launch_under /run/user/1000/bus       =>  0, a mounted socket
    #    _launch_under /run/user/1000/bus dirs  =>  1
    for _lu__m in "${_launch_home}" "${_launch_cwd}"; do
        [ -n "${_lu__m}" ] || continue
        case "${1}" in
            "${_lu__m}"|"${_lu__m}"/*) return 0 ;;
        esac
    done
    [ -z "${2}" ] && [ -n "${_launch_sockets}" ] && [ -S "${1}" ] && \
        _launch_socket_mounted "${1}"
}

_launch_socket_mounted() {
    _lsm__path="${1}"
    eval "set -- ${_launch_sockets}"
    for _lsm__m in "${@}"; do
        [ X"${_lsm__m}" = X"${_lsm__path}" ] && return 0
    done
    return 1
}

_launch_within() {
    #$1 => a path, $2 => a directory
    #    _launch_within /tmp/x /tmp   =>  0
    #    _launch_within /tmpfoo /tmp  =>  1
    #    _launch_within /x /          =>  1
    case "${2}" in
        ''|/) return 1 ;;
    esac
    case "${1}" in
        "${2}"|"${2}"/*) return 0 ;;
    esac
    return 1
}

_launch_reach() {
    #$1 => the physical cwd, $2 => HOME or /tmp; its path under $2 in _launch_workdir
    #    _launch_reach /data/user/proj /home/user  =>  0, /home/user/proj  (/home/user -> /data/user)
    #    _launch_reach /etc /home/user             =>  1
    [ -n "${2}" ] || return 1
    if _launch_within "${1}" "${2}"; then
        _launch_workdir="${1}"
        return 0
    fi
    _lrc__physical=""
    cd -P "${2}" 2>/dev/null && _lrc__physical="${PWD}"
    cd -P "${1}" 2>/dev/null || return 1
    _launch_within "${1}" "${_lrc__physical}" || return 1
    _launch_workdir="${2}${1#"${_lrc__physical}"}"
}

_launch_volumes() {
    #$1 => pair for docker, nothing for udocker
    #    _launch_volumes pair  =>  -v /home/user:/home/user
    #    _launch_volumes       =>  -v /home/user
    _lv__pair="${1}"
    eval "set -- ${_launch_sockets}"
    for _lv__m in "${_launch_home}" "${_launch_cwd}" "${@}"; do
        [ -n "${_lv__m}" ] || continue
        if [ -n "${_lv__pair}" ]; then
            _launch_word -v "${_lv__m}:${_lv__m}"
        else
            _launch_word -v "${_lv__m}"
        fi
    done
}

_launch_reachable() {
    #$1 => a value; 1 when it is a path, or a : list of them, not all mounted
    #    _launch_reachable /home/user/bin:/usr/bin  =>  1
    #    _launch_reachable /home/user/bin           =>  0, HOME being /home/user
    #    _launch_reachable :0                       =>  0, a DISPLAY and no path
    case "${1}" in
        /*|:*) ;;
        *) return 0 ;;
    esac
    _lr__rest="${1}:"; _lr__outside=""
    while [ -n "${_lr__rest}" ]; do
        _lr__element="${_lr__rest%%:*}"; _lr__rest="${_lr__rest#*:}"
        case "${_lr__element}" in
            '') ;;
            /*) _launch_under "${_lr__element}" || _lr__outside="1" ;;
            *)  return 0 ;;
        esac
    done
    [ -z "${_lr__outside}" ]
}

_launch_ids() {
    #$1 => a file laid out as /proc/self/status, the ids in _launch_uid, _gid, _groups
    #    _launch_ids /proc/self/status  =>  1000, 1000, 4 24 27
    _li__file="${1}"
    _launch_uid=""; _launch_gid=""; _li__groups=""
    if [ -r "${_li__file}" ]; then
        while IFS=" 	" read -r _li__key _li__real _li__effective _li__rest; do
            case "${_li__key}" in
                Uid:) _launch_uid="${_li__effective}" ;;
                Gid:) _launch_gid="${_li__effective}" ;;
                Groups:) _li__groups="${_li__real} ${_li__effective} ${_li__rest}"; break ;;
            esac
        done < "${_li__file}"
    fi
    case "${_launch_uid}:${_launch_gid}" in
        :*|*:|*[!0-9:]*)
            _launch_uid="$(id -u)" && _launch_gid="$(id -g)" && \
                _li__groups="$(id -G)" || return 1
            case "${_launch_uid}:${_launch_gid}" in
                :*|*:|*[!0-9:]*) return 1 ;;
            esac ;;
    esac
    _launch_groups=""; _li__rest="${_li__groups} "
    while [ -n "${_li__rest}" ]; do
        _li__g="${_li__rest%% *}"; _li__rest="${_li__rest#* }"
        case "${_li__g}" in
            ''|*[!0-9]*|"${_launch_gid}") continue ;;
        esac
        case " ${_launch_groups} " in
            *" ${_li__g} "*) continue ;;
        esac
        _launch_groups="${_launch_groups}${_launch_groups:+ }${_li__g}"
    done
    return 0
}

_launch_sets() {
    #$1 => a file laid out as /proc/self/status, that one when not given
    #sets the _launch_ variables, 1 when the ids cannot be read
    _ls__file="${1}"
    _launch_ids "${_ls__file:-/proc/self/status}" || return 1

    _launch_tty=""
    [ -t 0 ] && [ -t 1 ] && [ -t 2 ] && _launch_tty="1"

    _launch_home=""; _launch_cwd=""; _launch_sockets=""; _launch_workdir=""

    #trailing slashes off; / ends as '', no home to mount
    _ls__home="${HOME}"
    while :; do
        case "${_ls__home}" in
            */) _ls__home="${_ls__home%/}" ;;
            *) break ;;
        esac
    done
    case "${_ls__home}" in
        /*) [ -d "${_ls__home}" ] && _launch_home="${_ls__home}" ;;
    esac

    #cd -P . and not $(pwd), a fork on every run
    _ls__cwd=""
    cd -P . 2>/dev/null && _ls__cwd="${PWD}"
    if [ -z "${_ls__cwd}" ]; then
        _launch_workdir="/"
        _launch_say "the working directory was deleted, so it is not mounted; the program runs in /"
    elif _launch_reach "${_ls__cwd}" "${_launch_home}"; then
        :
    elif _launch_reach "${_ls__cwd}" /tmp; then
        _launch_under "${_launch_workdir}" dirs || _launch_cwd="${_launch_workdir}"
    else
        _launch_workdir="/"
        _launch_say "${_ls__cwd} is outside your home and /tmp, so it is not mounted; the program runs in /"
    fi

    #a value's newline can fake an "export X=" line: only a set name is kept
    _launch_names=""
    _ls__env="$(export -p)"
    _ls__ifs="${IFS}"; _ls__ifs_set="${IFS+x}"
    case "$-" in
        *f*) _ls__glob="" ;;
          *) _ls__glob="1"; set -f ;;
    esac
    IFS="
"
    for _ls__line in ${_ls__env}; do
        case "${_ls__line}" in
            "export "*)     _ls__name="${_ls__line#export }" ;;
            "declare -x "*) _ls__name="${_ls__line#declare -x }" ;;
            *) continue ;;
        esac
        _ls__name="${_ls__name%%=*}"
        case "${_ls__name}" in
            ''|[!${_launch_alpha}]*|*[!${_launch_alnum}]*) continue ;;
            PATH|LD_*|SHELL|PWD|OLDPWD|SHLVL|_|HOSTNAME|MAIL|TERMINFO|TERMINFO_DIRS|\
            MANPATH|INFOPATH|XDG_DATA_DIRS|XDG_CONFIG_DIRS|XDG_RUNTIME_DIR|\
            PKG_CONFIG_PATH|LIBRARY_PATH|CPATH|C_INCLUDE_PATH|CPLUS_INCLUDE_PATH|\
            LOCPATH|GCONV_PATH|NLSPATH|PYTHONPATH|PYTHONHOME|PYTHONUSERBASE|\
            VIRTUAL_ENV|CONDA_*|MAMBA_*|PERL5LIB|PERLLIB|PERL_LOCAL_LIB_ROOT|\
            RUBYLIB|RUBYOPT|GEM_HOME|GEM_PATH|NODE_PATH|LUA_PATH|LUA_CPATH|\
            CLASSPATH|JAVA_HOME|GOROOT|GIO_MODULE_DIR|GTK_PATH|QT_PLUGIN_PATH|\
            SSL_CERT_FILE|SSL_CERT_DIR|CURL_CA_BUNDLE|REQUESTS_CA_BUNDLE|\
            NODE_EXTRA_CA_CERTS) continue ;;
        esac
        case " ${_launch_names} " in
            *" ${_ls__name} "*) continue ;;
        esac
        eval "_ls__set=\"\${${_ls__name}+x}\" _ls__value=\"\${${_ls__name}}\""
        [ -n "${_ls__set}" ] || continue
        case "${_ls__value}" in
            /*:*|:*) _launch_reachable "${_ls__value}" || continue ;;
            /*) if ! _launch_under "${_ls__value}" dirs; then
                    [ -S "${_ls__value}" ] || continue
                    if ! _launch_socket_mounted "${_ls__value}"; then
                        _launch_out="${_launch_sockets}"; _launch_word "${_ls__value}"
                        _launch_sockets="${_launch_out}"
                    fi
                fi ;;
        esac
        _launch_names="${_launch_names}${_launch_names:+ }${_ls__name}"
    done
    if [ -n "${_ls__ifs_set}" ]; then IFS="${_ls__ifs}"; else unset IFS; fi
    [ -n "${_ls__glob}" ] && set +f
    return 0
}

_launch_env() {
    #$1... => the variables passed by value; every other one goes by name
    #    _launch_env TERM  =>  -e TERM=xterm -e HOME -e LANG
    _le__names=" ${_launch_names} "
    for _le__name in "${@}"; do
        case "${_le__name}" in
            ''|*[!${_launch_alnum}]*) continue ;;
        esac
        case "${_le__names}" in
            *" ${_le__name} "*)
                _le__names="${_le__names%%" ${_le__name} "*} ${_le__names#*" ${_le__name} "}"
                eval "_le__value=\"\${${_le__name}}\""
                _launch_word -e "${_le__name}=${_le__value}" ;;
        esac
    done
    _le__rest="${_le__names# }"
    while [ -n "${_le__rest}" ]; do
        _le__name="${_le__rest%% *}"; _le__rest="${_le__rest#* }"
        [ -n "${_le__name}" ] && _launch_out="${_launch_out}-e ${_le__name} "
    done
}

_launch_docker() {
    #$1... => the variables passed by value
    #    _launch_docker  =>  -t -u 1000:1000 --group-add 27 ... -w /home/user/proj -e HOME ...
    _launch_out=""
    [ -n "${_launch_tty}" ] && _launch_word -t
    _launch_word -u "${_launch_uid}:${_launch_gid}"
    _ld__rest="${_launch_groups} "
    while [ -n "${_ld__rest}" ]; do
        _ld__g="${_ld__rest%% *}"; _ld__rest="${_ld__rest#* }"
        [ -n "${_ld__g}" ] && _launch_word --group-add "${_ld__g}"
    done
    _launch_word -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro
    _launch_volumes pair
    _launch_word -w "${_launch_workdir}"
    _launch_env "${@}"
    printf "%s\\n" "${_launch_out}"
}

_launch_udocker() {
    #$1... => the variables passed by value
    #    _launch_udocker  =>  --hostauth --user=1000 -v /home/user -w /home/user/proj -e HOME ...

    #no supplementary groups: proot checks files against the process's own
    _launch_out=""
    _launch_word --hostauth "--user=${_launch_uid}"
    _launch_volumes
    _launch_word -w "${_launch_workdir}"
    _launch_env "${@}"
    printf "%s\\n" "${_launch_out}"
}

_launch_next_flag() {
    #the next word of _launch_flags into _launch_flag, split as the shell does
    #    _launch_flags="-v 'a b'"  =>  -v, then a b, then 1
    #    _launch_flags="-v 'a"     =>  -v, then 1 with ' in _launch_open
    _lnf__in=""; _launch_flag=""; _launch_open=""
    while [ -n "${_launch_flags}" ]; do
        _lnf__next="${_launch_flags#?}"; _lnf__c="${_launch_flags%"${_lnf__next}"}"; _launch_flags="${_lnf__next}"
        case "${_launch_open}" in
            "'")
                case "${_lnf__c}" in
                    "'") _launch_open="" ;;
                    *) _launch_flag="${_launch_flag}${_lnf__c}" ;;
                esac
                continue ;;
            '"')
                case "${_lnf__c}" in
                    '"') _launch_open="" ;;
                    '\')
                        _lnf__next="${_launch_flags#?}"; _lnf__e="${_launch_flags%"${_lnf__next}"}"
                        case "${_lnf__e}" in
                            '$'|'`'|'"'|'\') _launch_flag="${_launch_flag}${_lnf__e}"; _launch_flags="${_lnf__next}" ;;
                            "${_launch_nl}") _launch_flags="${_lnf__next}" ;;
                            *) _launch_flag="${_launch_flag}${_lnf__c}" ;;
                        esac ;;
                    *) _launch_flag="${_launch_flag}${_lnf__c}" ;;
                esac
                continue ;;
        esac
        case "${_lnf__c}" in
            ' '|'	'|"${_launch_nl}")
                [ -z "${_lnf__in}" ] || return 0 ;;
            "'"|'"') _launch_open="${_lnf__c}"; _lnf__in="1" ;;
            '\')
                _lnf__next="${_launch_flags#?}"; _lnf__e="${_launch_flags%"${_lnf__next}"}"; _launch_flags="${_lnf__next}"
                case "${_lnf__e}" in
                    "${_launch_nl}") ;;
                    '') _launch_flag="${_launch_flag}${_lnf__c}"; _lnf__in="1" ;;
                    *) _launch_flag="${_launch_flag}${_lnf__e}"; _lnf__in="1" ;;
                esac ;;
            *) _launch_flag="${_launch_flag}${_lnf__c}"; _lnf__in="1" ;;
        esac
    done
    [ -z "${_launch_open}" ] && [ -n "${_lnf__in}" ]
}

_launch_flags_read() {
    #$1 => the user's flags, counted into _launch_flags_left
    #    _launch_flags_read "-v 'a b'"  =>  2
    _launch_flags_value="${1}"; _launch_flags_left="0"; _launch_flags="${1}"
    while _launch_next_flag; do
        _launch_flags_left="$((_launch_flags_left + 1))"
    done
}

_launch_prev_flag() {
    #the last word of the user's flags not taken yet into _launch_flag
    #    "-v 'a b'"  =>  a b, then -v, then 1

    #last first, so a launcher prepends them in order without a quadratic copy
    [ "${_launch_flags_left}" -gt "0" ] || return 1
    _launch_flags="${_launch_flags_value}"; _lpf__n="${_launch_flags_left}"
    while [ "${_lpf__n}" -gt "0" ]; do
        _launch_next_flag
        _lpf__n="$((_lpf__n - 1))"
    done
    _launch_flags_left="$((_launch_flags_left - 1))"
    return 0
}

_launch_flags_closed() {
    #$1 => docker or udocker; 1, said, when the user's flags leave a quote open
    [ -n "${_launch_open}" ] || return 0
    case "${1}" in
        docker)  _lfc__var="CMDFOUND_DOCKER_FLAGS" ;;
        udocker) _lfc__var="CMDFOUND_UDOCKER_FLAGS" ;;
    esac
    _launch_say "${_lfc__var} leaves a ${_launch_open} open; ${1} was not run"
    return 1
}

_build_network() {
    #prints the CA file to copy in, or '', then -e for each proxy and SSL_CERT_FILE
    #    a CA file, https_proxy  =>  /etc/ssl/ca.pem -e https_proxy -e SSL_CERT_FILE=/etc/cmdfound/ca.pem
    #    neither                 =>  ''
    _bn__ca=""; _launch_out=""
    for _bn__v in SSL_CERT_FILE CURL_CA_BUNDLE; do
        eval "_bn__file=\"\${${_bn__v}}\""
        if [ -n "${_bn__file}" ] && [ -f "${_bn__file}" ] && [ -r "${_bn__file}" ]; then
            _bn__ca="${_bn__file}"
            break
        fi
    done
    _launch_word "${_bn__ca}"
    for _bn__v in http_proxy https_proxy no_proxy all_proxy \
                  HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY; do
        eval "_bn__set=\"\${${_bn__v}+x}\""
        [ -n "${_bn__set}" ] && _launch_word -e "${_bn__v}"
    done
    [ -n "${_bn__ca}" ] && _launch_word -e "SSL_CERT_FILE=${CONFINED_CA}"
    printf "%s\\n" "${_launch_out}"
}
__CMDFOUND_FILE__ 755 docker
#!/bin/sh
#description: cmdfound channel - a catalog's programs installed and run in docker, an image each
#usage: docker meta | docker probe CATALOG/PACKAGE VER
#       docker obtain CATALOG/PACKAGE VER | docker size CATALOG/PACKAGE VER
#       docker reclaim

LOWER="abcdefghijklmnopqrstuvwxyz0123456789"
HEX="0123456789abcdef"
LABEL="io.cmdfound"
#what a run costs before the program starts, until this machine has timed one:
#docker creates, starts and removes a container every time
RUN_MS="1200"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#docker runs with the user's own HOME, logins and DOCKER_* (owner, 2026-09-16),
#so its output is read through --format: no psFormat or imagesFormat reaches it
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"

_placement() {
    #$1 => catalog/package, $2 => version. Sets catalog, package and version
    #    _placement alpine/figlet 2.2.5-r3  =>  0, catalog alpine, package figlet
    #    _placement Alpine/figlet 2.2.5-r3  =>  1
    case "${1}" in
        ?*/?*) ;;
        *) return 1 ;;
    esac
    catalog="${1%%/*}"; package="${1#*/}"; version="${2}"
    case "${catalog}" in
        [!${LOWER}]*|*[!${LOWER}-]*) return 1 ;;
    esac
    _api_is_version "${package}" || return 1
    _api_is_version "${version}" || return 1
    return 0
}

_image_ref() {
    #$1 => repository[:tag][@sha256:<hex>]. Sets image_name, image_digest, image_pull
    #    _image_ref alpine:3@sha256:<hex>  =>  0, image_name alpine:3, image_pull alpine@sha256:<hex>
    #    _image_ref alpine:3               =>  0, image_pull empty
    #    _image_ref -rf                    =>  1
    _api_is_image_ref "${1}" || return 1
    image_name="${1%%@*}"; image_digest=""; image_pull=""
    case "${1}" in
        *@*) image_digest="${1#*@}"
             _util_is_digest "${image_digest}" || return 1 ;;
    esac
    _ir__last="${image_name##*/}"
    [ -n "${image_digest}" ] && \
        image_pull="${image_name%"${_ir__last}"}${_ir__last%%:*}@${image_digest}"
    return 0
}

_daemon() {
    #0 when docker here can build and run for this user, else prints unreachable=
    #    _daemon  =>  0
    #    _daemon  =>  1, unreachable=docker is not installed here

    #a call that failed is made again for its stderr, its stdout read the first time
    if ! command -v docker >/dev/null 2>&1; then
        printf "unreachable=%s\\n" "docker is not installed here"
        return 1
    fi
    if ! _dm__host="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null)"; then
        printf "unreachable=%s\\n" "$(_util_first_line "$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>&1 >/dev/null)" \
            "docker could not say which daemon it uses")"
        return 1
    fi
    _dm__host="${_dm__host%%"${NL}"*}"
    case "${_dm__host}" in
        unix://?*|tcp://127.[0-9]*|tcp://localhost|tcp://localhost:*|"tcp://[::1]"|"tcp://[::1]:"*) ;;
        *) printf "unreachable=%s\\n" "the daemon at ${_dm__host:-no endpoint docker names} does not see this machine's files"
           return 1 ;;
    esac
    if ! _dm__options="$(docker info --format '{{json .SecurityOptions}}' 2>/dev/null)"; then
        _dm__why="$(_util_first_line "$(docker info --format '{{json .SecurityOptions}}' 2>&1 >/dev/null)" \
            "docker could not reach its daemon")"
        case "${_dm__why}" in
            *"permission denied"*) _dm__why="${_dm__why}: this user cannot reach the daemon, and cmdfound does not use sudo" ;;
        esac
        printf "unreachable=%s\\n" "${_dm__why}"
        return 1
    fi
    case "${_dm__options}" in
        *'"name=rootless'*)
            printf "unreachable=%s\\n" "docker is rootless: files the program writes in your home would not be yours"
            return 1 ;;
    esac
    return 0
}

_recorded() {
    #$1 => a record, image id and base a tab apart. Sets recorded_id, recorded_base
    #    _recorded "${CH}/images/alpine/figlet/2.2.5-r3"  =>  0, recorded_id sha256:<hex>,
    #                                                         recorded_base alpine@sha256:<hex>
    recorded_id=""; recorded_base=""
    [ -f "${1}" ] || return 1
    IFS="${TAB}" read -r recorded_id recorded_base < "${1}" 2>/dev/null
    _util_is_digest "${recorded_id}"
}

_home_label() {
    home_label="$(cd -P "${CMDFOUND_HOME:-/tmp}" 2>/dev/null && pwd)" && [ -n "${home_label}" ]
}

_pid_namespace() {
    #sets pidns to this process's pid namespace inode, or none
    #    /proc/self/ns/pid -> pid:[4026531836]  =>  pidns 4026531836
    #    no /proc                               =>  pidns none
    pidns="none"
    _pn__link="$(readlink /proc/self/ns/pid 2>/dev/null)" || return 0
    case "${_pn__link}" in
        "pid:["*"]") _pn__inode="${_pn__link#pid:\[}"; _pn__inode="${_pn__inode%\]}" ;;
        *) return 0 ;;
    esac
    _util_is_number "${_pn__inode}" && pidns="${_pn__inode}"
    return 0
}

_stale_builds() {
    #$1 => mine or all. Removes this home's stopped cmdfound-build-<pidns>-<pid> containers
    #mine spares those of a live pid, or of another pid namespace
    _sb__whose="${1}"
    _sb__list="$(docker ps -a --no-trunc --filter "label=${LABEL}.home=${home_label}" \
        --filter status=exited --filter status=created --format '{{.ID}} {{.Names}}' 2>/dev/null)" || return 1
    while read -r _sb__id _sb__name; do
        case "${_sb__id}" in ''|*[!${HEX}]*) continue ;; esac
        case "${_sb__name}" in
            cmdfound-build-?*) ;;
            *) continue ;;
        esac
        if [ X"${_sb__whose}" = X"mine" ]; then
            _sb__rest="${_sb__name#cmdfound-build-}"
            _sb__pid="${_sb__rest##*-}"
            [ X"${_sb__rest%-*}" = X"${pidns}" ] || continue
            _util_is_number "${_sb__pid}" || continue
            [ X"${_sb__pid}" != X"$$" ] && kill -0 "${_sb__pid}" 2>/dev/null && continue
        fi
        docker rm "${_sb__id}" >/dev/null
    done <<EOF
${_sb__list}
EOF
    return 0
}

_launcher() {
    #$1 => launcher path, $2 => image id, $3 => program, $4 => what it is
    _l__path="${1}"; _l__image="${2}"; _l__program="${3}"; _l__what="${4}"
    {
        printf "%s\\n" "#!/bin/sh" "#written by cmdfound: ${_l__what}"
        printf '_dl__ch="%s"\n_dl__image="%s"\n_dl__program="%s"\n_dl__spec="%s"\n' \
            "${CH}" "${_l__image}" "${_l__program}" "${SELF_NAME}:${catalog}/${package}"
        cat <<'LAUNCHER'
#CMDFOUND_DOCKER_FLAGS, when set, are the user's own flags for docker run,
#split as the shell splits words - 'single', "double", back\slash - with
#nothing expanded, and given after cmdfound's. A flag there can undo what
#cmdfound's are for: -u (the files the program writes would not be the
#user's), -w (where it starts), --rm (containers left behind), -i and -t
#(stdin, or stderr kept apart from stdout), --init (Ctrl-C ending in 130),
#--entrypoint (the program not being run) and -d (its output and status lost)
. "${_dl__ch}/lib/confined-launch" || exit 127
if ! _launch_sets; then
    printf "%s\n" "cmdfound: the ids of this user could not be read, and ${_dl__program##*/} is not run without them" >&2
    exit 127
fi
_dl__args="$(_launch_docker)" || exit 127
#cmdfound's flags, then confined-launch's
_dl__run="run --rm -i --init --log-driver=none --network=host --pull=never ${_dl__args}"
#then the user's, split by confined-launch for the launchers of both runtimes,
#and a quote left open runs nothing. All of it goes before the program's
#arguments: with no word, in one set; with words, the image and the program
#first, then each word, the last first, then cmdfound's and
#confined-launch's flags, a set each, which none of costs more than the
#arguments are many
_launch_flags_read "${CMDFOUND_DOCKER_FLAGS}"
_launch_flags_closed docker || exit 127
if [ "${_launch_flags_left}" -eq "0" ]; then
    eval "set -- ${_dl__run} \"\${_dl__image}\" \"\${_dl__program}\" \"\$@\""
else
    set -- "${_dl__image}" "${_dl__program}" "$@"
    while _launch_prev_flag; do
        set -- "${_launch_flag}" "$@"
    done
    eval "set -- ${_dl__run} \"\$@\""
fi
if docker image inspect --format "{{.Id}}" "${_dl__image}" >/dev/null 2>&1; then
    exec docker "$@"
fi
docker "$@"
_dl__status="$?"
[ "${_dl__status}" -eq "125" ] || exit "${_dl__status}"
docker image inspect --format "{{.Id}}" "${_dl__image}" >/dev/null 2>&1 && exit 125
printf "%s\n" "cmdfound: the docker image for ${_dl__program##*/} is gone; cmdfound --latest ${_dl__spec} makes it again" >&2
exit 127
LAUNCHER
    } | _util_write_aside "${_l__path}" 755
}

_undo() {
    #obtain's EXIT trap: removes what an unfinished obtain left
    [ -n "${ctr}" ] && docker rm -f "${ctr}" >/dev/null 2>&1
    [ -n "${made}" ] && docker rmi "${made}" >/dev/null 2>&1
    rm -rf "${work}"
}

_meta() {
    printf "%s\\n" "kind=runtime" "confines=yes" "reclaims=yes"
    exit 0
}

_probe() {
    #$1 => catalog/package, $2 => a version
    spec="${1}"; ver="${2}"
    [ -n "${CMDFOUND_IMAGE}" ] || exit 1
    _placement "${spec}" "${ver}" || exit 1
    if [ -n "${CMDFOUND_EPHEMERAL}" ]; then
        _api_answer_unreachable "--ephemeral does not use docker: its images would outlive the throwaway root"
    fi
    _image_ref "${CMDFOUND_IMAGE}" || exit 1
    _daemon || exit 2

    once=""
    if _recorded "${CH}/images/${catalog}/${package}/${version}" && \
       docker image inspect --format '{{.Id}}' "${recorded_id}" >/dev/null 2>&1; then
        :
    elif ! docker image inspect --format '{{.Id}}' "${image_pull:-${image_name}}" >/dev/null 2>&1; then
        if [ -z "${image_pull}" ]; then
            _api_answer_unreachable "no digest is known for ${image_name}, and docker pulls an image here only by its digest"
        fi
        bytes="${CMDFOUND_IMAGE_BYTES}"
        if ! _util_is_number "${bytes}"; then
            bytes="-"
        else
            _pb__f="${CH}/cache/${image_digest#sha256:}.bytes"
            if [ ! -f "${_pb__f}" ]; then
                _util_mkdir_p "${CH}/cache"
                printf "%s\\n" "${bytes}" > "${_pb__f}" 2>/dev/null
            fi
        fi
        once="image|${CMDFOUND_IMAGE}|${bytes}|via docker"
    fi
    printf "run_ms=%s\\n" "${RUN_MS}"
    [ -z "${once}" ] || printf "once=%s\\n" "${once}"
    exit 0
}

_obtain() {
    #$1 => catalog/package, $2 => a version
    spec="${1}"; ver="${2}"
    _placement "${spec}" "${ver}" || _api_answer_failed "'${spec}' '${ver}' is not a package this channel will install"
    _api_value_in image "${CMDFOUND_RECIPE}"; image="${_api_value_in__out}"
    _api_value_in install "${CMDFOUND_RECIPE}"; install="${_api_value_in__out}"
    _api_value_in bin "${CMDFOUND_RECIPE}"; program="${_api_value_in__out}"
    [ -n "${install}" ] || _api_answer_failed "no recipe to install ${spec} with"
    _image_ref "${image}" || _api_answer_failed "'${image}' is not an image this channel will run"
    _api_is_program_name "${program}" || \
        _api_answer_failed "'${program}' is not a program this channel will write a launcher for"
    _api_is_unsafe "${CH}" && _api_answer_failed "${CH} cannot be written into a launcher safely: it has a quote, a \$, a backquote, a backslash or a newline"
    command -v docker >/dev/null 2>&1 || _api_answer_failed "docker is not installed here"
    lib="$(_api_launch_source)"
    [ -f "${lib}" ] && . "${lib}" || _api_answer_failed "confined-launch is not in ${lib%/*}"

    ctr=""; made=""; work="${CH}/tmp/obtain.$$"; timings=""
    _util_trap_exit '_undo'
    _util_mkdir_p "${work}" && _util_mkdir_p "${CH}/lib" || _api_answer_failed "${CH} could not be written"
    _home_label || _api_answer_failed "${CMDFOUND_HOME} cannot be named"
    _pid_namespace
    _stale_builds mine

    record="${CH}/images/${catalog}/${package}/${version}"
    id=""
    if _recorded "${record}" && docker image inspect --format '{{.Id}}' "${recorded_id}" >/dev/null 2>&1; then
        id="${recorded_id}"
    fi

    if [ -z "${id}" ]; then
        base="${image_pull:-${image_name}}"
        base_id="$(docker image inspect --format '{{.Id}}' "${base}" 2>/dev/null)" || base_id=""
        if ! _util_is_digest "${base_id}"; then
            [ -n "${image_pull}" ] || _api_answer_failed "no digest is known for ${image_name}, and docker pulls an image here only by its digest"
            t0="$(_util_now_ms)"
            docker pull "${image_pull}" >&2 || _api_answer_failed "docker could not pull ${image_pull}"
            bytes="-"
            [ -f "${CH}/cache/${image_digest#sha256:}.bytes" ] && \
                read -r bytes 2>/dev/null < "${CH}/cache/${image_digest#sha256:}.bytes"
            _util_is_number "${bytes}" || bytes="-"
            timings="${timings}timing=image:${bytes}:$(( $(_util_now_ms) - t0 ))${NL}"
            _util_mkdir_p "${CH}/pulled" && _util_mkdir_p "${CH}/cache" && \
                printf "%s\\n" "${image_pull}" > "${CH}/cache/pulled.$$" && \
                mv "${CH}/cache/pulled.$$" "${CH}/pulled/${image_digest#sha256:}" || \
                rm -f "${CH}/cache/pulled.$$"
            base_id="$(docker image inspect --format '{{.Id}}' "${image_pull}" 2>/dev/null)"
            _util_is_digest "${base_id}" || _api_answer_failed "docker pulled ${image_pull} and does not have it"
        fi

