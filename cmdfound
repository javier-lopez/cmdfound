    _resolve__channel="${_spec_in__channel}"
    _resolve__package="${_spec_in__package}"
    _resolve__version="${_spec_in__version}"

    #the channels, asked again when a shared name turned out to mean one program
    _resolve__probed="$(_probe_all "${_resolve__package}" "${_resolve__version}" "${_resolve__channel}")"
    _resolve__picked="$(_pick_program "${_resolve__package}" "${_resolve__probed}")" || return 1
    if [ -n "${_resolve__picked}" ]; then
