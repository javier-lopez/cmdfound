#two runs in one home have one thing to fight over: installing the same package,
#of the same channel, at the same version. Anything else is another directory.

_lock_path() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version. Sets g_lock_path to the directory
    #that stands for that placement, see _key_in. A package with a slash is one
    #directory, and no name can reach out of locks/
    _key_in "${1}:${2}@${3}"
    g_lock_path="${g_home}/locks/${_key_in__out}"
}

_lock_pid() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a lock. Sets g_lock_pid to the pid it names
    g_lock_pid=""
    [ -f "${1}/pid" ] || return 1
    IFS= read -r g_lock_pid 2>/dev/null < "${1}/pid"
    #a pid half written, or a file something else left there, holds nobody
    _util_is_number "${g_lock_pid}" || { g_lock_pid=""; return 1; }
    return 0
}

_is_lock_held() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => a lock. Sets g_lock_pid to the run it found:
    #    a pid still there  =>  0
    #    a pid gone         =>  1, g_lock_pid still naming that run
    #    no pid at all      =>  1, g_lock_pid empty
    _lock_pid "${1}" && kill -0 "${g_lock_pid}" 2>/dev/null
}

_lock_steal() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => a lock whose pid names a run that is gone. Takes it over, and answers
    #1 where another run got there first. $$ is this run's own pid inside the
    #subshell, which POSIX says a subshell does not change
    #
    #Where there is a flock, the kernel decides which of two runs that both
    #found it dead goes on, and the one that loses sees the winner's pid on the
    #next look. Where there is none, the directory is moved out of its name,
    #which is narrower than removing it and still two steps. flock is not POSIX
    #and is missing from some busybox builds; it is there on Linux and on alpine
    #
    #What is flocked is the locks directory itself, read-only, so the takeover
    #leaves no file of its own and a steal cannot delete what another run holds.
    #The descriptor is opened by the subshell and not by exec: exec is a special
    #builtin, and a redirection that fails on one ends a posix shell, as _tty says
    if command -v flock >/dev/null 2>&1; then
        ( flock -n 9 || exit 1
          #asked again inside the lock: the answer that brought this run here was
          #read before waiting for it, and another run may have taken over since
          _is_lock_held "${1}" && exit 1
          rm -rf "${1}" && mkdir "${1}" 2>/dev/null && printf "%s\\n" "$$" > "${1}/pid"
        ) 9<"${g_home}/locks" 2>/dev/null
        return "${?}"
    fi
    _is_lock_held "${1}" && return 1
    mv "${1}" "${1}.dead.$$" 2>/dev/null && rm -rf "${1}.dead.$$" && \
        mkdir "${1}" 2>/dev/null
}

_lock_take() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version
    #    the lock is free       =>  0, g_lock_held naming it
    #    another run holds it   =>  1, g_lock_pid naming that run
    #    this home cannot lock  =>  1, g_lock_pid empty, so install without one

    #mkdir is what POSIX gives that two runs cannot both do. A lock whose pid is gone
    #is a lock nobody holds, and the next run takes it over: see _sweep_ephemeral
    _lock_path "${1}" "${2}" "${3}"
    _lt__lock="${g_lock_path}"
    g_lock_pid=""
    if mkdir "${_lt__lock}" 2>/dev/null; then
        :
    elif [ ! -d "${g_home}/locks" ] && _util_mkdir_p "${g_home}/locks" && \
         mkdir "${_lt__lock}" 2>/dev/null; then
        #never mkdir -p on the lock itself: -p answers 0 for a directory already there
        :
    elif _is_lock_held "${_lt__lock}"; then
        return 1
    elif _lock_steal "${_lt__lock}"; then
        :
    else
        #another run took the dead one's over first, and there is nobody to wait for
        _is_lock_held "${_lt__lock}" || g_lock_pid=""
        return 1
    fi

    #a lock that cannot say its pid is given back
    printf "%s\\n" "$$" > "${_lt__lock}/pid" 2>/dev/null || {
        rm -rf "${_lt__lock}"
        return 1
    }
    printf "%s\\n" "${1}:${2}@${3}" > "${_lt__lock}/placement" 2>/dev/null
    g_lock_held="${_lt__lock}"

    #and it goes however this run ends, Ctrl-C included: see _lock_free
    trap '_lock_free' EXIT
    trap '_lock_free; exit 130' INT
    trap '_lock_free; exit 143' TERM HUP
    return 0
}

_lock_free() { #@frozen 2026-10-05 m@javier.io 2e226ed
    [ -n "${g_lock_held}" ] || return 0
    _lf__lock="${g_lock_held}"; g_lock_held=""
    rm -rf "${_lf__lock}"
    return 0
}

_lock_wait() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => what the run in g_lock_pid is installing
    _msg "${PROGNAME}: ${1} is being installed by pid ${g_lock_pid}, waiting for it"
    while kill -0 "${g_lock_pid}" 2>/dev/null; do
        #a tenth of a second, and a whole one where sleep takes no fraction
        sleep 0.1 2>/dev/null || sleep 1
    done
    return 0
}

_lock_live() { #@frozen 2026-10-09 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version (all optional), and
    #$4 => a placement taken whatever the other three say:
    #    _lock_live "" jq "" ""            =>  4172  aqua:mikefarah/jq@1.7.1
    #    _lock_live nix-portable "" "" ""  =>  1

    #Shell built-ins only: a home installing nothing starts no process
    _ll__found=""
    for _ll__lock in "${g_home}"/locks/*; do
        [ -d "${_ll__lock}" ] || continue
        _is_lock_held "${_ll__lock}" || continue
        _ll__placement=""
        [ -f "${_ll__lock}/placement" ] && \
            IFS= read -r _ll__placement 2>/dev/null < "${_ll__lock}/placement"
        [ -n "${_ll__placement}" ] || continue

        #$4 names one placement outright, whatever its package is called there
        if [ -z "${4}" ] || [ X"${4}" != X"${_ll__placement}" ]; then
            _spec_in "${_ll__placement}"
            [ -z "${1}" ] || [ X"${1}" = X"${_spec_in__channel}" ] || continue
            [ -z "${3}" ] || [ X"${3}" = X"${_spec_in__version}" ] || continue
            [ -z "${2}" ] || [ X"${2}" = X"${_spec_in__package}" ] || \
                [ X"${2}" = X"${_spec_in__package##*/}" ] || continue
        fi
        printf "%s\\t%s\\n" "${g_lock_pid}" "${_ll__placement}"
        _ll__found="1"
    done
    [ -n "${_ll__found}" ] || return 1
    return 0
}

