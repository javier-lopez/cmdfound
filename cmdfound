            "${install}" 'status=$?' "rm -rf ${cadir}" 'exit ${status}' > "${files}/build" && \
            { [ -z "${ca}" ] || cp "${ca}" "${files}/${CONFINED_CA##*/}"; } || \
            _api_answer_failed "the build of ${package} ${version} could not be written"
        #--entrypoint "" here: a commit cannot clear it
        t0="$(_util_now_ms)"
        ctr="$(docker create --name "cmdfound-build-${pidns}-$$" \
            --label "${LABEL}.home=${home_label}" --label "${LABEL}.catalog=${catalog}" \
            --label "${LABEL}.package=${package}" --label "${LABEL}.version=${version}" \
            --network=host --pull=never --user=0:0 --entrypoint "" "${base_id}" \
            /bin/sh "${cadir}/build")" || ctr=""
        case "${ctr}" in
            ''|*[!${HEX}]*) ctr=""; _api_answer_failed "docker could not make a container to install ${package} ${version} in" ;;
        esac
        docker cp "${files}" "${ctr}:${cadir%/*}/" >&2 || \
            _api_answer_failed "the build of ${package} ${version} could not be copied into its container"
        rm -rf "${files}"
        #start -a may answer 0 mid-install: docker wait says how it ended
        docker start -a "${ctr}" >&2
        status="$(docker wait "${ctr}" 2>/dev/null)" || status=""
        _util_is_number "${status}" || _api_answer_failed "docker could not say how installing ${package} ${version} ended"
        [ "${status}" -eq "0" ] || _api_answer_failed "installing ${package} ${version} in ${image_name} ended with status ${status}"
        #a docker tag cannot hold a +
        _util_replace_in "${package}-${version}" "+" "_"
        made="$(docker commit --change 'CMD ["/bin/sh"]' "${ctr}" "cmdfound/${catalog}:${_util_replace_in__out}")" || made=""
        _util_is_digest "${made}" || { made=""; _api_answer_failed "docker could not keep ${package} ${version} as an image"; }
        docker rm -f "${ctr}" >/dev/null 2>&1 && ctr=""
        bytes="${CMDFOUND_BYTES:--}"
        _util_is_number "${bytes}" || bytes="-"
        timings="${timings}timing=install:${bytes}:$(( $(_util_now_ms) - t0 ))${NL}"
        id="${made}"
    fi

    _util_write_aside "${CH}/lib/confined-launch" < "${lib}" || \
        _api_answer_failed "confined-launch could not be copied into ${CH}/lib"
    _launcher "${work}/check" "${id}" /bin/sh "whether ${program} is in the image" || _api_answer_failed "no launcher could be written"
    t0="$(_util_now_ms)"
    found="$(unset CMDFOUND_DOCKER_FLAGS; cd /tmp && "${work}/check" -c "command -v ${program}" < /dev/null)"
    status="${?}"
    [ "${status}" -eq "0" ] && [ -n "${found}" ] || _api_answer_failed "${package} installed no program called ${program}"
    timings="${timings}timing=run:-:$(( $(_util_now_ms) - t0 ))${NL}"

    run="run/${catalog}/${package}/${version}"
    _util_mkdir_p "${CH}/${run}" && \
        _launcher "${CH}/${run}/${program}" "${id}" "${program}" "${program}, ${catalog}'s ${package} ${version}, run in docker" || \
        _api_answer_failed "no launcher could be written"
    if [ -n "${made}" ]; then
        _util_mkdir_p "${record%/*}" && printf "%s\\t%s\\n" "${made}" "${base}" | _util_write_aside "${record}" || \
            _api_answer_failed "the image of ${package} ${version} could not be recorded"
        made=""
    fi

    printf "%s\\n" "program=${CH}/${run}/${program}" "asset=${id}" \
        "member=${run}" "member=images/${catalog}/${package}/${version}"
    printf "%s" "${timings}"
    exit 0
}

_size() {
    #$1 => catalog/package, $2 => a version
    spec="${1}"; ver="${2}"
    _placement "${spec}" "${ver}" || exit 1
    if ! _recorded "${CH}/images/${catalog}/${package}/${version}"; then
        _api_answer_unreachable "no image of ${package} ${version} is recorded"
    fi
    command -v docker >/dev/null 2>&1 || _api_answer_unreachable "docker is not installed here"
    if ! sizes="$(docker image inspect --format '{{.Size}} {{.Parent}}' "${recorded_id}" 2>/dev/null)"; then
        _api_answer_unreachable "docker does not have the image of ${package} ${version}"
    fi
    bytes="${sizes%% *}"; parent="${sizes#* }"
    [ -n "${parent}" ] || parent="${recorded_base}"
    base_bytes=""
    [ -n "${parent}" ] && base_bytes="$(docker image inspect --format '{{.Size}}' "${parent}" 2>/dev/null)"
    case "${bytes}:${base_bytes}" in
        *[!0-9:]*|:*|*:)
            printf "unreachable=%s\\n" "what the image of ${package} ${version} holds beyond the one it was built from is not known"
            exit 2 ;;
    esac
    bytes="$((bytes - base_bytes))"
    [ "${bytes}" -ge "0" ] || bytes="0"
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_reclaim() {
    _daemon || exit 2
    _home_label || _api_answer_unreachable "${CMDFOUND_HOME} cannot be named"
    named=" "; bases=" "
    if [ X"${CMDFOUND_RECLAIM}" != X"all" ]; then
        for f in "${CH}"/images/*/*/*; do
            _recorded "${f}" || continue
            named="${named}${recorded_id} "; bases="${bases}${recorded_base} "
        done
    fi
    freed="0"

    if ! _stale_builds all; then
        _api_answer_unreachable "docker could not list the containers of this home"
    fi

    if ! images="$(docker image ls -a --no-trunc --filter "label=${LABEL}.home=${home_label}" \
            --format '{{.ID}}' 2>/dev/null)"; then
        _api_answer_unreachable "docker could not list the images of this home"
    fi
    seen=" "
    for i in ${images}; do
        _util_is_digest "${i}" || continue
        case "${named}${seen}" in *" ${i} "*) continue ;; esac
        seen="${seen}${i} "
        sizes="$(docker image inspect --format '{{.Size}} {{.Parent}}' "${i}" 2>/dev/null)" || sizes=""
        bytes="${sizes%% *}"; parent="${sizes#* }"; base_bytes=""
        [ -n "${parent}" ] && base_bytes="$(docker image inspect --format '{{.Size}}' "${parent}" 2>/dev/null)"
        docker rmi "${i}" >/dev/null || continue
        case "${bytes}:${base_bytes}:${freed}" in
            *[!0-9:]*|:*|*::*) freed="-" ;;
            *) [ "${bytes}" -gt "${base_bytes}" ] && freed="$((freed + bytes - base_bytes))" ;;
        esac
    done

    for f in "${CH}"/pulled/*; do
        [ -f "${f}" ] || continue
        hex="${f##*/}"; ref=""
        read -r ref 2>/dev/null < "${f}"
        case "${bases}" in *"@sha256:${hex} "*) continue ;; esac
        case "${ref}" in
            *"@sha256:${hex}") _image_ref "${ref}" || { rm -f "${f}"; continue; } ;;
            *) rm -f "${f}"; continue ;;
        esac
        if ! sizes="$(docker image inspect --format '{{.Id}} {{.Size}}' "${ref}" 2>/dev/null)"; then
            rm -f "${f}"
            continue
        fi
        docker rmi "${ref}" >/dev/null || continue
        rm -f "${f}"
        #an image another name still holds freed nothing
        docker image inspect --format '{{.Id}}' "${sizes%% *}" >/dev/null 2>&1 && continue
        case "${sizes#* }:${freed}" in
            *[!0-9:]*|:*|*:) freed="-" ;;
            *) freed="$((freed + ${sizes#* }))" ;;
        esac
    done
    [ X"${freed}" = X"-" ] || printf "freed=%s\\n" "${freed}"
    exit 0
}

case "${1}" in
    meta)    _meta ;;
    probe)   _probe "${2}" "${3}" ;;
    obtain)  _obtain "${2}" "${3}" ;;
    size)    _size "${2}" "${3}" ;;
    reclaim) _reclaim ;;
    *) printf "%s\\n" "usage: ${SELF_NAME} meta|probe|obtain|size|reclaim" >&2; exit 1 ;;
esac
