#!/bin/sh
#description: cmdfound channel - nixpkgs, installed by nix through nix-portable, without root
#usage: nix-portable meta | nix-portable index [bytes] | nix-portable reclaim
#       nix-portable search WORDS... | nix-portable size nixpkgs.ATTR VER
#       nix-portable probe NAME|nixpkgs.ATTR [VER]
#       nix-portable locate NAME|nixpkgs.ATTR VER [PROGRAM]
#       nix-portable obtain NAME|nixpkgs.ATTR VER [PROGRAM]
#covers: mise - 120 commands not in nixpkgs (2026-09)

CHANNEL="${CMDFOUND_NIX_PORTABLE_CHANNEL:-https://channels.nixos.org/nixos-unstable}"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"
INDEX="${CH}/index/programs.tsv"
RELEASE="${CH}/index/release"
NP="${CH}/.nix-portable"
TOOL_SPEC="github:DavHau/nix-portable"

#what the user's environment sets for nix reaches it, but for where nix keeps
#state, which is this channel's directory, and three more: NP_RUN replaces how
#nix-portable confines nix, root included; NP_DEBUG writes the environment into
#/tmp; BASH_ENV runs before nix-portable, a bash script, its output landing in
#front of the store paths read back. A store in NIX_CONFIG made nix-portable's
#nix open one elsewhere and fail to start. require-sigs = false reaches nix:
#fetching unsigned is the user's to decide (owner, 2026-09-16)
unset NIX_REMOTE NIX_STORE NIX_STORE_DIR NIX_STATE_DIR NIX_LOG_DIR NIX_DATA_DIR NIX_CONF_DIR \
    NIX_DAEMON_SOCKET_PATH NIX_BIN_DIR NIX_LIBEXEC_DIR NP_CONF_STORE NP_DEBUG NP_RUN BASH_ENV
if [ -n "${NIX_CONFIG}" ]; then
    NIX_CONFIG="$(printf "%s\\n" "${NIX_CONFIG}" | awk '{k = $0; sub(/^[ \t]+/, "", k); sub(/[ \t]*=.*$/, "", k)} k != "store"')"
    export NIX_CONFIG
fi

_platform() {
    _util_machine_in
    case "${_util_machine_in__os}/${_util_machine_in__cpu}" in
        Linux/x86_64|Linux/amd64)  printf "%s\\n" "x86_64-linux" ;;
        Linux/aarch64|Linux/arm64) printf "%s\\n" "aarch64-linux" ;;
        *) return 1 ;;
    esac
}

_release_of() {
    #$1 => the channel. Its release, then the url of that release's nixexprs.tar.xz
    #    _release_of https://channels.nixos.org/nixos-unstable  =>  nixos-25.11pre869843.4c8cdd5b1a63
    #                                                               https://releases.nixos.org/nixos/unstable/nixos-25.11pre869843.4c8cdd5b1a63/nixexprs.tar.xz
    if _util_is_local "${1}"; then
        _ro__url="${1#file://}/nixexprs.tar.xz"
        [ -f "${_ro__url}" ] || return 1
        _ro__release="$(TAR_OPTIONS= tar -tJf "${_ro__url}" 2>/dev/null | awk -F/ 'NR == 1 {print $1; exit}')"
    else
        _api_fetcher_head_in "${1}/nixexprs.tar.xz" location "" || return 1
        _ro__url="${_api_fetcher_head_in__out}"
        case "${_ro__url}" in
            http://*/nixexprs.tar.xz|https://*/nixexprs.tar.xz) ;;
            *) return 1 ;;
        esac
        _ro__release="${_ro__url%/nixexprs.tar.xz}"; _ro__release="${_ro__release##*/}"
    fi
    _api_is_version "${_ro__release}" || return 1
    printf "%s\\n%s\\n" "${_ro__release}" "${_ro__url}"
}

_counts() {
    printf "packages=%s\\n" "$(awk -F'\t' '!seen[$2]++' "${INDEX}" | awk 'END {print NR}')"
    printf "names=%s\\n" "$(awk -F'\t' '!seen[$1]++' "${INDEX}" | awk 'END {print NR}')"
}

_resolve() {
    #$1 => a program's name or nixpkgs.ATTR, $2 => the program asked for
    #    _resolve figlet figlet          =>  0, attr figlet, cmd figlet
    #    _resolve htop htop              =>  3, cands htop and htop-vim
    #    _resolve nixpkgs.htop-vim htop  =>  0, attr htop-vim, cmd htop
    _resolve__name="${1}"; _resolve__want="${2}"
    why=""; attr=""; cmd=""; cands=""; noindex=""
    if [ ! -s "${INDEX}" ] || [ ! -s "${RELEASE}" ]; then
        why="${NO_INDEX}"; noindex="1"
        return 2
    fi
    case "${_resolve__name}" in
        nixpkgs.?*)
            cmd="$(LC_ALL=C awk -F'\t' -v a="${_resolve__name#nixpkgs.}" -v want="${_resolve__want}" '
                $2 == a {
                    if (first == "") first = $1
                    if ($1 == want) hit = $1
                    n = split(a, p, "."); if ($1 == p[n]) own = $1
                }
                END { if (hit != "") print hit; else if (own != "") print own
                      else if (first != "") print first }' "${INDEX}")"
            [ -z "${cmd}" ] && return 1
            attr="${_resolve__name#nixpkgs.}"
            return 0 ;;
    esac
    cands="$(LC_ALL=C awk -F'\t' -v n="${_resolve__name}" '$1 == n {print $2}' "${INDEX}")"
    [ -z "${cands}" ] && return 1
    _util_is_one_line "${cands}" || return 3
    attr="${cands}"; cmd="${_resolve__name}"; return 0
}

_run_tool() {
    #$1... => a nix command, run with nix-portable's state in this channel
    _rt__tool="$(readlink "${CMDFOUND_REQUIRED}" 2>/dev/null)" || _rt__tool="${CMDFOUND_REQUIRED}"
    #this machine's git, or nix-portable fetches its own on first start, 22 MB
    if [ -z "${NP_GIT}" ] && _rt__git="$(command -v git 2>/dev/null)"; then
        NP_GIT="${_rt__git}"; export NP_GIT
    fi
    (
        _api_tool_home
        exec env NP_LOCATION="${CH}" PROOT_TMP_DIR="${CH}/tmp" "${_rt__tool}" "${@}"
    )
}

_in_store() {
    #$1 => a /nix path, its links followed as the program's namespace would
    #    _in_store /nix/store/0f7…-htop-3.4.1/bin/htop  =>  0
    #    _in_store /nix/store/0f7…-htop-3.4.1/share     =>  1
    _is__path="${1}"; _is__rest="${_is__path#/}"; _is__done=""; _is__hops="0"
    while [ -n "${_is__rest}" ]; do
        case "${_is__rest}" in
            */*) _is__part="${_is__rest%%/*}"; _is__rest="${_is__rest#*/}" ;;
              *) _is__part="${_is__rest}"; _is__rest="" ;;
        esac
        case "${_is__part}" in
            ''|.) continue ;;
            ..) _is__done="${_is__done%/*}"; continue ;;
        esac
        case "${_is__done}/${_is__part}" in
            /nix|/nix/*) _is__host="${NP}${_is__done}/${_is__part}" ;;
                      *) _is__host="${_is__done}/${_is__part}" ;;
        esac
        if [ -L "${_is__host}" ]; then
            _is__hops="$((_is__hops + 1))"
            [ "${_is__hops}" -gt "40" ] && return 1
            _is__link="$(readlink "${_is__host}")" || return 1
            case "${_is__link}" in
                /*) _is__done=""; _is__rest="${_is__link#/}${_is__rest:+/${_is__rest}}" ;;
                 *) _is__rest="${_is__link}${_is__rest:+/${_is__rest}}" ;;
            esac
            continue
        fi
        _is__done="${_is__done}/${_is__part}"
    done
    case "${_is__done}" in
        /nix|/nix/*) _is__host="${NP}${_is__done}" ;;
                  *) _is__host="${_is__done}" ;;
    esac
    [ -f "${_is__host}" ] && [ -x "${_is__host}" ]
}

_closure_bytes() {
    #$1 => a placement's root directory, the bytes its roots keep in the store
    #    _closure_bytes "${CH}/.nix-portable/nix/var/nix/gcroots/cmdfound/htop/${release}"  =>  41943040
    _cb__out="$(_run_tool nix path-info --recursive --size "${1}"/result*)" || return 1
    printf "%s\\n" "${_cb__out}" | awk '
        $1 ~ /^\/nix\/store\/[^\/]+$/ && $NF ~ /^[0-9]+$/ { size[$1] = $NF }
        END { for (p in size) { t += size[p]; n++ } if (!n) exit 1; printf("%.0f\n", t) }'
}

_sweep() {
    #removes the work directories whose process died halfway
    for _sw__dir in "${CH}"/nixpkgs/.[!.]* "${CH}"/index/work.*; do
        [ -d "${_sw__dir}" ] || continue
        _sw__pid="${_sw__dir##*.}"
        _util_is_number "${_sw__pid}" || continue
        kill -0 "${_sw__pid}" 2>/dev/null && continue
        _util_removable "${_sw__dir}"; rm -rf "${_sw__dir}"
    done
}

_tree() {
    #$1 => a release, its nixpkgs unpacked on first use
    #    _tree nixos-25.11pre869843.4c8cdd5b1a63  =>  ${CH}/nixpkgs/nixos-25.11pre869843.4c8cdd5b1a63
    _tr__tree="${CH}/nixpkgs/${1}"
    [ -f "${_tr__tree}/default.nix" ] && { printf "%s\\n" "${_tr__tree}"; return 0; }
    _tr__tarball="${CH}/index/${1}.tar.xz"
    [ -f "${_tr__tarball}" ] || return 1
    _sweep
    printf "%s\\n" "${SELF_NAME}: unpacking the nixpkgs of ${1}, once for this release" >&2
    _tr__work="${CH}/nixpkgs/.${1}.$$"
    rm -rf "${_tr__work}"; _util_mkdir_p "${_tr__work}" || return 1
    if ! TAR_OPTIONS= tar -xJf "${_tr__tarball}" -C "${_tr__work}" || [ ! -f "${_tr__work}/${1}/default.nix" ]; then
        rm -rf "${_tr__work}"
        return 1
    fi
    #another install may have unpacked it meanwhile
    mv "${_tr__work}/${1}" "${_tr__tree}" 2>/dev/null
    rm -rf "${_tr__work}"
    [ -f "${_tr__tree}/default.nix" ] || return 1
    rm -f "${_tr__tarball}"
    printf "%s\\n" "${_tr__tree}"
}

_namespaces() {
    #leaves in namespaces what decides whether bwrap may run here, builtins only

    #_launcher's sed copies this into every launcher, by its first line as written
    _ns__boot=""; _ns__max=""; _ns__clone=""; _ns__apparmor=""; _ns__map=""; _ns__seccomp=""
    { read -r _ns__boot < /proc/sys/kernel/random/boot_id; } 2>/dev/null
    { read -r _ns__max < /proc/sys/user/max_user_namespaces; } 2>/dev/null
    { read -r _ns__clone < /proc/sys/kernel/unprivileged_userns_clone; } 2>/dev/null
    { read -r _ns__apparmor < /proc/sys/kernel/apparmor_restrict_unprivileged_userns; } 2>/dev/null
    { read -r _ns__map < /proc/self/uid_map; } 2>/dev/null
    { while IFS=: read -r _ns__key _ns__value; do
          case "${_ns__key}" in Seccomp) _ns__seccomp="${_ns__value}"; break ;; esac
      done < /proc/self/status; } 2>/dev/null
    namespaces="${_ns__boot} ${_ns__max} ${_ns__clone} ${_ns__apparmor} ${_ns__map} ${_ns__seccomp}"
}

_launcher() {
    #$1 => the launcher, $2 => the program's /nix path, $3 => what it is
    #1, writing nothing, when neither bwrap nor proot runs here
    _l__path="${1}"; _l__program="${2}"; _l__what="${3}"
    _l__bwrap=""; _l__proot=""
    if [ -x "${NP}/bin/bwrap" ] && [ -d "${NP}/emptyroot" ] && [ -d "${NP}/nix/store" ] && \
       "${NP}/bin/bwrap" --dev-bind / / true 2>/dev/null; then
        _l__bwrap="1"
        _namespaces; printf "%s\\n" "${namespaces}" > "${CH}/run/.bwrap" 2>/dev/null
    fi
    if [ -x "${NP}/bin/proot" ] && [ -d "${NP}/emptyroot" ] && [ -d "${NP}/nix/store" ] && \
       PROOT_NO_SECCOMP="1" PROOT_TMP_DIR="${CH}/tmp" "${NP}/bin/proot" -r / true 2>/dev/null; then
        _l__proot="1"
    fi
    [ -n "${_l__bwrap}${_l__proot}" ] || return 1
    {
        printf "%s\\n" "#!/bin/sh" "#written by cmdfound: ${_l__what}, run from nix-portable's store"
        printf 'np="%s"\nch="%s"\nprogram="%s"\n' "${NP}" "${CH}" "${_l__program}"
        sed -n '/^_namespaces() {$/,/^}$/p' "${SELF}"
        cat <<'LAUNCHER'

#bwrap, where this machine let it make a namespace in the same circumstances. It
#is told to take the program with it when it dies: it does not pass signals on,
#and a SIGTERM sent to it would otherwise leave the program running
if [ -x "${np}/bin/bwrap" ] && [ -d "${np}/emptyroot" ] && [ -d "${np}/nix/store" ]; then
    _namespaces; here="${namespaces}"
    known=""; { read -r known < "${ch}/run/.bwrap"; } 2>/dev/null
    if [ X"${known}" != X"${here}" ] && "${np}/bin/bwrap" --dev-bind / / true 2>/dev/null; then
        printf "%s\n" "${here}" > "${ch}/run/.bwrap" 2>/dev/null; known="${here}"
    fi
    if [ X"${known}" = X"${here}" ]; then
        unset CMDFOUND_NIX_PORTABLE_STARTED
        set -- -- "${program}" "$@"
        for top in /*; do
            case "${top}" in /nix|/dev) continue ;; esac
            [ -e "${top}" ] && set -- --bind "${top}" "${top}" "$@"
        done
        exec "${np}/bin/bwrap" --die-with-parent --bind "${np}/emptyroot" / --dev-bind /dev /dev --bind "${np}/nix" /nix "$@"
    fi
fi
#proot, nix-portable's way where a namespace cannot be made: slower, and nothing
#it keeps goes to /tmp
if [ -x "${np}/bin/proot" ] && [ -d "${np}/emptyroot" ] && [ -d "${np}/nix/store" ]; then
    unset CMDFOUND_NIX_PORTABLE_STARTED
    [ -d "${ch}/tmp" ] || mkdir -p "${ch}/tmp"
    set -- "${program}" "$@"
    for top in /*; do
        case "${top}" in /nix|/dev|*:*) continue ;; esac
        [ -e "${top}" ] && set -- -b "${top}:${top}" "$@"
    done
    PROOT_NO_SECCOMP="1"; PROOT_TMP_DIR="${ch}/tmp"; export PROOT_NO_SECCOMP PROOT_TMP_DIR
    exec "${np}/bin/proot" -r "${np}/emptyroot" -b /dev:/dev -b "${np}/nix:/nix" -w "${PWD:-/}" "$@"
fi
#neither is where nix-portable unpacks them, as after nix-portable was updated:
#nix-portable unpacks what it needs when it starts, and then this runs again, once
tool="$(readlink "${ch}/tool/current" 2>/dev/null)"
if [ -z "${CMDFOUND_NIX_PORTABLE_STARTED}" ] && [ -x "${tool}" ]; then
    mkdir -p "${ch}/home" "${ch}/tmp" 2>/dev/null
    env NP_LOCATION="${ch}" HOME="${ch}/home" TMPDIR="${ch}/tmp" PROOT_TMP_DIR="${ch}/tmp" \
        XDG_CACHE_HOME="${ch}/home/.cache" XDG_CONFIG_HOME="${ch}/home/.config" \
        XDG_DATA_HOME="${ch}/home/.local/share" XDG_STATE_HOME="${ch}/home/.local/state" \
        "${tool}" nix --version > /dev/null 2>&1
    CMDFOUND_NIX_PORTABLE_STARTED="1"; export CMDFOUND_NIX_PORTABLE_STARTED
    exec "${0}" "$@"
fi
#nothing here can run it. The launcher goes, so that cmdfound, which
#remembered it, installs the program again the next time it is asked for
printf "%s\n" "${0##*/}: nix-portable cannot run ${program##*/} from ${np} any more; cmdfound installs it again the next time" >&2
rm -f "${0}"
exit 127
LAUNCHER
    } | _util_write_aside "${_l__path}" 755
}

_undo() {
    #an obtain's EXIT trap: removes what made and made_run still name
    [ -n "${made_run}" ] && rmdir "${made_run}" "${made_run%/*}" 2>/dev/null
    [ -n "${made}" ] || return 0
    rm -rf "${made}"; rmdir "${made%/*}" 2>/dev/null
}

_meta() {
    printf "%s\\n" "kind=artifact" "confines=no" "describes=self" "manager=${TOOL_SPEC}" "needs=sqlite3" "reclaims=yes"
    exit 0
}

_index() {
    #$1 => bytes, to only say what fetching the catalog downloads
    mode="${1}"
    system="$(_platform)" || _api_answer_unreachable "nixpkgs has no catalog for ${_util_machine_in__os}/${_util_machine_in__cpu}"
    if [ X"${mode}" = X"bytes" ]; then
        _ib__answer="$(_release_of "${CHANNEL}")" || exit 0
        _api_answer_bytes_of "${_ib__answer#*${NL}}"
    fi
    if ! command -v sqlite3 >/dev/null 2>&1; then
        _api_answer_unreachable "sqlite3 is not here to read the catalog with"
    fi
    _util_mkdir_p "${CH}/index" || exit 1
    answer="$(_release_of "${CHANNEL}")" || {
        _api_answer_unreachable "which release ${CHANNEL} is at could not be read"
    }
    release="${answer%%${NL}*}"; url="${answer#*${NL}}"

    have=""; IFS= read -r have 2>/dev/null < "${RELEASE}"
    if [ X"${have}" = X"${release}" ] && [ -s "${INDEX}" ] && \
       { [ -f "${CH}/index/${release}.tar.xz" ] || [ -f "${CH}/nixpkgs/${release}/default.nix" ]; }; then
        _counts
        exit 0
    fi

    kept="${CH}/index/${release}.tar.xz.part"; part="${kept}.$$"
    for old in "${CH}"/index/*.part; do
        [ -f "${old}" ] && [ X"${old}" != X"${kept}" ] && rm -f "${old}"
    done
    _api_fetcher_resumable "${url}" "${kept}"
    case "${?}" in
        0) ;;
        1) _api_answer_unreachable "there is no catalog at ${url}" ;;
        *) _api_answer_unreachable "the catalog of ${release} ${CATALOG_STOPPED}" ;;
    esac
    bytes="$(wc -c < "${part}" | awk '{print $1}')"
    #not cut short from here: the old index could be left half replaced
    trap '' TERM INT HUP

    work="${CH}/index/work.$$"
    rm -rf "${work}"; _util_mkdir_p "${work}" || exit 1
    if ! TAR_OPTIONS= tar -xJf "${part}" -C "${work}" "${release}/programs.sqlite" 2>/dev/null || \
       [ ! -s "${work}/${release}/programs.sqlite" ]; then
        rm -rf "${work}" "${part}"
        _api_answer_unreachable "the catalog of ${release} came without its programs.sqlite, and is not kept"
    fi
    #-init /dev/null, or sqlite3 reads ~/.sqliterc first
    if ! sqlite3 -batch -init /dev/null -noheader -separator "$(printf '\t')" "${work}/${release}/programs.sqlite" \
         "SELECT name, package FROM Programs WHERE system = '${system}';" > "${work}/rows" 2>/dev/null; then
        rm -rf "${work}"
        _api_answer_unreachable "sqlite3 could not read the programs.sqlite of ${release}"
    fi
    LC_ALL=C awk -F'\t' '
        NF == 2 && $1 != "." && $1 != ".." && $1 !~ /^nixpkgs\./ &&
        $1 !~ /[^!-~]/ && $1 !~ /[\/:@"$`\\'\'']/ && $2 ~ /^[A-Za-z0-9_+-][A-Za-z0-9._+-]*$/
    ' "${work}/rows" | LC_ALL=C sort -u > "${work}/programs.tsv"

    _api_catalog_keep "${work}/programs.tsv" "${INDEX}" "$(awk -F'\t' '!seen[$1]++' "${work}/programs.tsv" | awk 'END {print NR}')" \
        "the catalog of ${release}" "${work}" "${part}"
    printf "%s\\n" "${release}" | _util_write_aside "${RELEASE}"
    printf "%s\\n" "${url}" | _util_write_aside "${CH}/index/source"
    mv "${part}" "${CH}/index/${release}.tar.xz"
    rm -rf "${work}"
    _sweep
    for old in "${CH}"/index/*.tar.xz; do
        [ -f "${old}" ] && [ X"${old}" != X"${CH}/index/${release}.tar.xz" ] && rm -f "${old}"
    done
    for old in "${CH}"/nixpkgs/*; do
        [ -d "${old}" ] && [ X"${old##*/}" != X"${release}" ] && rm -rf "${old}"
    done
    _counts
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_search() {
    #$1... => the words looked for
    #    _search vim  =>  nix-portable:nixpkgs.htop-vim<TAB>htop<TAB>provides htop
    [ -s "${INDEX}" ] || _api_answer_no_index
    search_words="${*}" LC_ALL=C awk -F'\t' "${SEARCH_AWK}"'
        { progs[$2] = progs[$2] " " $1; if (!($2 in first)) first[$2] = $1 }
        END {
            for (a in first)
                if (words_in(a progs[a])) printf("nix-portable:nixpkgs.%s\t%s\tprovides%s\n", a, first[a], progs[a])
        }' "${INDEX}" | LC_ALL=C sort
    exit 0
}

_probe() {
    #$1 => a program's name or nixpkgs.ATTR, $2 => a release
    #    _probe figlet  =>  version=nixos-25.11pre869843.4c8cdd5b1a63
    #                       package=nixpkgs.figlet
    #                       requires=github:DavHau/nix-portable
    [ -z "${1}" ] && exit 1
    _platform >/dev/null || exit 1
    _resolve "${1}" "${1}"; _api_answer_unresolved "${?}" "nixpkgs."
    _util_has_word "${CMDFOUND_NO_MANAGER}" "${SELF_NAME}" && exit 1
    IFS= read -r release < "${RELEASE}"
    [ -n "${2}" ] && [ X"${2}" != X"${release}" ] && exit 1
    printf "version=%s\\n" "${release}"
    #no size: nix cannot tell one without evaluating nixpkgs
    printf "package=nixpkgs.%s\\n" "${attr}"
    printf "requires=%s\\n" "${TOOL_SPEC}"
    exit 0
}

_locate() {
    #$1 => a program's name or nixpkgs.ATTR, $2 => a release, $3 => the program asked for
    #    _locate figlet "${release}" figlet  =>  url=https://releases.nixos.org/nixos/unstable/${release}/nixexprs.tar.xz
    #                                            bin=figlet
    [ -z "${1}" ] || [ -z "${2}" ] && exit 1
    _platform >/dev/null || exit 1
    _resolve "${1}" "${3}"; _api_answer_unresolved "${?}" "nixpkgs."
    IFS= read -r url 2>/dev/null < "${CH}/index/source" && \
        printf "url=%s\\n" "${url}"
    printf "bin=%s\\n" "${cmd}"
    exit 0
}

_obtain() {
    #$1 => a program's name or nixpkgs.ATTR, $2 => a release, $3 => the program asked for
    name="${1}"; ver="${2}"; want="${3}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    _resolve "${name}" "${want}"; _api_answer_unresolved "${?}" "nixpkgs."
    if [ ! -x "${CMDFOUND_REQUIRED}" ]; then
        _api_answer_unreachable "nix-portable is not available to install nixpkgs.${attr}"
    fi
    IFS= read -r release < "${RELEASE}"
    if [ X"${ver}" != X"${release}" ]; then
        _api_answer_failed "the local catalog is ${release} now, not ${ver}; asking again installs from it"
    fi
    _api_is_unsafe "${CH}" && _api_answer_failed "${LAUNCHER_UNSAFE}"
    _api_is_program_name "${cmd}" || \
        _api_answer_failed "'${cmd}' is not a program this channel will write a launcher for"
    made=""; made_run=""
    _util_trap_exit '_undo; _util_removable "${NP}/nix/store"'
    [ -x "${NP}/bin/bwrap" ] || \
        printf "%s\\n" "${SELF_NAME}: starting for the first time here, which takes a minute or two" >&2
    tree="$(_tree "${release}")" || {
        _api_answer_failed "the nixpkgs of ${release} is not here to install from, --index-update nix-portable fetches it again"
    }

    paths="$(_run_tool nix eval --read-only --max-jobs 0 --raw -f "${tree}" --arg config '{}' --arg overlays '[]' "${attr}" \
        --apply 'p: builtins.concatStringsSep "\n" (map (o: builtins.unsafeDiscardStringContext p.${o}.outPath) (p.meta.outputsToInstall or [ "out" ]))')"
    if [ "${?}" -ne "0" ] || [ -z "${paths}" ]; then
        _api_answer_failed "nix could not evaluate nixpkgs.${attr} in ${release}"
    fi
    root="${NP}/nix/var/nix/gcroots/cmdfound/${attr}/${release}"
    [ -d "${root}" ] || made="${root}"
    _util_mkdir_p "${root}" || exit 1
    if ! _run_tool nix build --max-jobs 0 --out-link "${root}/result" ${paths} >/dev/null; then
        #nix fails alike for a path the cache lacks and an unreachable cache
        cache="https://cache.nixos.org"
        asked="$(_run_tool nix path-info --store "${cache}" \
                 ${paths} 2>&1)"
        if [ "${?}" -eq "0" ]; then
            _api_answer_failed "nix could not install nixpkgs.${attr} from ${release}, which ${cache} has"
        fi
        case "${asked}" in
            *"is not valid"*)
                printf "unreachable=%s\\n" "nixpkgs.${attr} of ${release} is not in the binary cache, ${cache}, and nothing is compiled here" ;;
            *)
                printf "unreachable=%s\\n" "${cache} could not be asked for nixpkgs.${attr}" ;;
        esac
        exit 2
    fi

    store=""
    for link in "${root}"/result*; do
        target="$(readlink "${link}" 2>/dev/null)" || continue
        case "${target}" in /nix/store/?*) ;; *) continue ;; esac
        for dir in bin sbin; do
            if [ -z "${store}" ] && _in_store "${target}/${dir}/${cmd}"; then
                store="${target}/${dir}/${cmd}"
            fi
        done
    done
    if [ -z "${store}" ] || _api_is_unsafe "${store}"; then
        _api_answer_failed "nix installed nixpkgs.${attr} but it has no program called ${cmd}"
    fi
    run="${CH}/run/${attr}/${release}"
    [ -d "${run}" ] || made_run="${run}"
    _util_mkdir_p "${run}" || exit 1
    if ! _launcher "${run}/${cmd}" "${store}" "${cmd}, from nixpkgs.${attr} of ${release}"; then
        _api_answer_failed "neither bwrap nor proot runs from nix-portable's store here, so nothing it installed can run"
    fi
    made=""; made_run=""

    sizes="${CH}/sizes/${attr}/${release}"
    if [ ! -f "${sizes}" ] && _util_mkdir_p "${sizes%/*}" && bytes="$(_closure_bytes "${root}")"; then
        printf "%s\\n" "${bytes}" | _util_write_aside "${sizes}"
    fi

    printf "program=%s\\n" "${run}/${cmd}"
    store="${store#/nix/store/}"
    printf "asset=%s\\n" "${store%%/*}"
    printf "member=%s\\n" ".nix-portable/nix/var/nix/gcroots/cmdfound/${attr}/${release}" "sizes/${attr}/${release}"
    exit 0
}

_size() {
    #$1 => nixpkgs.ATTR, $2 => the release
    #    _size nixpkgs.htop "${release}"  =>  bytes=41943040
    spec="${1}"; release="${2}"; attr="${spec#nixpkgs.}"
    case "${spec}" in nixpkgs.?*) ;; *) attr="" ;; esac
    case "${attr}/${release}" in
        ?*/?*) case "${attr}${release}" in *..*|*/*) attr="" ;; esac ;;
        *) attr="" ;;
    esac
    if [ -z "${attr}" ]; then
        _api_answer_unreachable "'${spec}@${release}' is not a package of this channel"
    fi
    sizes="${CH}/sizes/${attr}/${release}"
    bytes=""
    [ -f "${sizes}" ] && { read -r bytes < "${sizes}"; } 2>/dev/null
    if _util_is_number "${bytes}"; then
        printf "bytes=%s\\n" "${bytes}"; exit 0
    fi
    root="${NP}/nix/var/nix/gcroots/cmdfound/${attr}/${release}"
    rooted=""
    for link in "${root}"/result*; do
        [ -L "${link}" ] && rooted="1"
    done
    if [ -z "${rooted}" ]; then
        _api_answer_unreachable "nixpkgs.${attr} of ${release} holds nothing in the store here"
    fi
    if [ ! -x "${CMDFOUND_REQUIRED}" ]; then
        _api_answer_unreachable "nix-portable is not here to say what nixpkgs.${attr} holds"
    fi
    _util_trap_exit '_util_removable "${NP}/nix/store"'
    if ! bytes="$(_closure_bytes "${root}")"; then
        _api_answer_unreachable "nix could not say what nixpkgs.${attr} holds"
    fi
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_reclaim() {
    if [ X"${CMDFOUND_RECLAIM}" = X"all" ]; then
        _util_removable "${NP}/nix/store"
        printf "freed=%s\\n" "0"
        exit 0
    fi
    _util_trap_exit '_util_removable "${NP}/nix/store"'
    if [ ! -x "${CMDFOUND_REQUIRED}" ]; then
        _api_answer_unreachable "nix-portable is not here to delete from its store"
    fi
    work="${CH}/tmp/reclaim.$$"; _util_mkdir_p "${CH}/tmp" || exit 1
    #roots the git nix-portable fetched, first on the PATH of its script
    tool="$(readlink "${CMDFOUND_REQUIRED}" 2>/dev/null)" || tool="${CMDFOUND_REQUIRED}"
    own="${NP}/nix/var/nix/gcroots/cmdfound-nix-portable"
    rm -rf "${own}"; _util_mkdir_p "${own}" || exit 1
    for path in $(grep -a -m1 -o 'export PATH="/nix/store/[a-z0-9]\{32\}-git[A-Za-z0-9._+-]*/bin:' "${tool}" | \
                  sed 's|^export PATH="||; s|/bin:$||'); do
        [ -d "${NP}${path}" ] && ln -s "${path}" "${own}/${path##*/}"
    done
    if ! _run_tool nix-store --gc --print-dead > "${work}.dead" 2> "${work}.log" || \
       ! _run_tool nix path-info --all \
         > "${work}.valid" 2>> "${work}.log"; then
        rm -f "${work}.dead" "${work}.valid" "${work}.log"
        _api_answer_unreachable "nix could not say what the packages still here need, so nothing was deleted"
    fi
    doomed="$(LC_ALL=C sort -u "${work}.dead" | awk '/^\/nix\/store\/[^\/]+$/' > "${work}.d"
        LC_ALL=C sort -u "${work}.valid" | LC_ALL=C comm -12 "${work}.d" -)"
    rm -f "${work}.dead" "${work}.valid" "${work}.d"
    freed="0"
    if [ -n "${doomed}" ]; then
        freed="$(for path in ${doomed}; do du -sk "${NP}${path}" 2>/dev/null || printf "%s\\n" "-"; done | \
            awk '$1 !~ /^[0-9]+$/ {unknown = 1} {t += $1} END {if (!unknown) print t * 1024}')"
        if ! _run_tool nix-store --delete ${doomed} \
             >> "${work}.log" 2>&1; then
            printf "unreachable=%s\\n" "nix would not delete what nothing needed a moment ago: $(awk '/error/ {e = $0} END {print e}' "${work}.log")"
            rm -f "${work}.log"
            exit 2
        fi
    fi
    rm -f "${work}.log"
    [ -n "${freed}" ] && printf "freed=%s\\n" "${freed}"
    exit 0
}

case "${1}" in
    meta)    _meta ;;
    index)   _index "${2}" ;;
    search)  shift; _search "${@}" ;;
    probe)   _probe "${2}" "${3}" ;;
    locate)  _locate "${2}" "${3}" "${4}" ;;
    obtain)  _obtain "${2}" "${3}" "${4}" ;;
    size)    _size "${2}" "${3}" ;;
    reclaim) _reclaim ;;
    *) printf "%s\\n" "usage: ${SELF_NAME} meta|index|search|probe|locate|obtain|size|reclaim" >&2; exit 1 ;;
esac
__CMDFOUND_FILE__ 755 pkgx
#!/bin/sh
#description: cmdfound channel - pkgx's pantry, installed and run by pkgx
#usage: pkgx meta | pkgx index [bytes] | pkgx search WORDS...
#       pkgx probe NAME|PROJECT [VER] | pkgx locate PROJECT VER [PROGRAM]
#       pkgx obtain PROJECT VER [PROGRAM]

#laid out the same for pkgx 1 and 2. The user's own PKGX_DIST_URL reaches pkgx,
#so the question is read from there too: what it shows is what pkgx downloads
DIST="${CMDFOUND_PKGX_DIST:-${PKGX_DIST_URL:-https://dist.pkgx.dev}}"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"
#the catalog's first line names the pantry it was read from, so one rename
#puts the pair in place and no reader sees half of each. PANTRY is what
#_pantry reads off that line, index/none before there is a catalog
INDEX="${CH}/index/pkgx.tsv"
PANTRY="${CH}/index/none"
CELLAR="${CH}/cellar"
META="${CH}/cache"

_platform() {
    _util_machine_in
    case "${_util_machine_in__os}/${_util_machine_in__cpu}" in
        Linux/x86_64|Linux/amd64)  printf "%s\\n" "linux/x86-64" ;;
        Linux/aarch64|Linux/arm64) printf "%s\\n" "linux/aarch64" ;;
        *) return 1 ;;
    esac
}

_versions_in() {
    #$1 => project, and its versions in __out, one per line; 2 with why when not asked
    #    _versions_in curl.se  =>  0, 8.9.1
    #                                 8.10.0
    #    _versions_in no.such  =>  1
    _versions_in__out=""
    _versions_in__f="${META}/versions/${1}/versions.txt"
    _api_is_fresh "${_versions_in__f}" && { _versions_in__out="$(cat "${_versions_in__f}")"; return 0; }
    _util_mkdir_p "${_versions_in__f%/*}"
    _api_fetcher_answered "${DIST}/${1}/$(_platform)/versions.txt" "${_versions_in__f}.$$"
    case "${?}" in
        0)  #kept one version per line with the last one ended, so nothing
            #appended after it can fuse with the newest version
            awk 'NF {print $1}' "${_versions_in__f}.$$" > "${_versions_in__f}.$$.n"
            mv "${_versions_in__f}.$$.n" "${_versions_in__f}"; rm -f "${_versions_in__f}.$$"
            _versions_in__out="$(cat "${_versions_in__f}")"; return 0 ;;
        1)  return 1 ;;
        *)  #yesterday's list is still a list of versions that exist
            [ -s "${_versions_in__f}" ] && { _versions_in__out="$(cat "${_versions_in__f}")"; return 0; }
            why="${DIST} could not be asked for the versions of ${1}"
            return 2 ;;
    esac
}

_newest() {
    #$1 => a version to find, optional; of those on stdin, it or the newest, as pkgx does
    #    1.22.1, 2026.8.0        =>  1.22.1  a major of 1996 on is 0.0.0.<date>
    #    1.1.1, 1.1.1w           =>  1.1.1w  a letter is a component, w being 23
    #    2.5.0-rc.1, 2.5         =>  2.5.0   a prerelease is below its release
    #    2.5.0, 2.6.0, with 2.5  =>  2.5.0
    _newest__want="${1}"
    LC_ALL=C awk -v want="${_newest__want}" '
        function parse(s, id,   core, rest, n, i, letter, raw) {
            sub(/^v+/, "", s)
            if (s !~ /^[0-9]+(\.[0-9]+)*[a-z]?(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$/) return 0
            raw = s
            match(s, /^[0-9]+(\.[0-9]+)*/); core = substr(s, 1, RLENGTH); rest = substr(s, RLENGTH + 1)
            n = split(core, c, "."); for (i = 1; i <= n; i++) cc[id, i] = c[i] + 0
            if (rest ~ /^[a-z]/) { cc[id, ++n] = index("abcdefghijklmnopqrstuvwxyz", substr(rest, 1, 1)); rest = substr(rest, 2) }
            cn[id] = n; pre[id] = ""; bld[id] = ""
            if (rest ~ /^-/) { match(rest, /^-[0-9A-Za-z.-]+/); pre[id] = substr(rest, 2, RLENGTH - 1); rest = substr(rest, RLENGTH + 1) }
            if (rest ~ /^\+/) bld[id] = substr(rest, 2)
            if (raw ~ /^[0-9]+(\.[0-9]+)?([-+].*)?$/) {
                raw = cc[id, 1] "." ((n >= 2) ? cc[id, 2] : 0) "." ((n >= 3) ? cc[id, 3] : 0)
                if (pre[id] != "") raw = raw "-" pre[id]
                if (bld[id] != "") raw = raw "+" bld[id]
            }
            out[id] = raw
            return 1
        }
        function list(a, b,   pa, pb, na, nb, n, i) {
            na = (a == "") ? 0 : split(a, pa, "."); nb = (b == "") ? 0 : split(b, pb, ".")
            n = (na > nb) ? na : nb
            for (i = 1; i <= n; i++) {
                if (i > na) return -1
                if (i > nb) return 1
                if ((pa[i] "") > (pb[i] "")) return 1
                if ((pa[i] "") < (pb[i] "")) return -1
            }
            return 0
        }
        function cmp(a, b,   oa, ob, n, i, x, y) {
            oa = (cc[a, 1] >= 1996) ? 3 : 0; ob = (cc[b, 1] >= 1996) ? 3 : 0
            n = (cn[a] + oa > cn[b] + ob) ? cn[a] + oa : cn[b] + ob
            for (i = 1; i <= n; i++) {
                x = (i <= oa || i - oa > cn[a]) ? 0 : cc[a, i - oa]
                y = (i <= ob || i - ob > cn[b]) ? 0 : cc[b, i - ob]
                if (x != y) return (x < y) ? -1 : 1
            }
            if (pre[a] == "" && pre[b] != "") return 1
            if (pre[a] != "" && pre[b] == "") return -1
            i = list(pre[a], pre[b]); if (i) return i
            return list(bld[a], bld[b])
        }
        BEGIN { if (want != "" && !parse(want, "want")) exit }
        NF && parse($1, NR) {
            if (want != "") { if (cmp(NR, "want") == 0) best = NR }
            else if (best == "" || cmp(NR, best) >= 0) best = NR
        }
        END { if (best != "") print out[best] }'
}

_batch() {
    #$1 => questions gone out; waits every sixteen
    [ $(( ${1} % 16 )) -eq 0 ] && wait
    return 0
}

_bottle() {
    printf "%s\\n" "${DIST}/${1}/$(_platform)/v${2}.tar.xz"
}

_bottle_bytes() {
    #$1 => project, $2 => version, and the bottle's size, asked once
    #    _bottle_bytes curl.se 8.10.0  =>  2345678
    _bb__f="${META}/sizes/${1}/v${2}"
    [ -s "${_bb__f}" ] && { cat "${_bb__f}"; return 0; }
    _bb__n="$(_api_fetcher_head_size "$(_bottle "${1}" "${2}")")"
    [ -z "${_bb__n}" ] && return 1
    _util_mkdir_p "${_bb__f%/*}" && printf "%s\\n" "${_bb__n}" > "${_bb__f}"
    printf "%s\\n" "${_bb__n}"
}

_indexer() {
    #package.yml paths on stdin; prints lines a tab apart
    #    .../projects/curl.se/package.yml  =>  name  curl.se  cURL
    #                                          dep   curl.se  openssl.org
    #                                          cmd   curl     curl.se
    while read -r _indexer__f; do
        _indexer__p="${_indexer__f%/package.yml}"
        _indexer__p="${_indexer__p#*/projects/}"
        printf "%s\\t%s\\n" "${_indexer__p}" "${_indexer__f}"
    done | awk -F'\t' '
        function unquote(v) {
            if (v ~ /^"/)      { sub(/^"/, "", v); sub(/"[ \t]*(#.*)?$/, "", v) }
            else if (v ~ /^'\''/) { sub(/^'\''/, "", v); sub(/'\''[ \t]*(#.*)?$/, "", v) }
            else               { sub(/^#.*$/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v) }
            return v
        }
        {
            project = $1; file = $2; sect = ""; sub_key = ""; sub_ind = -1; pend = ""
            while ((getline line < file) > 0) {
                if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) continue
                if (sect == "display-name") {
                    if (line ~ /^ /) {
                        val = line; sub(/^ +/, "", val); val = unquote(val)
                        if (val != "") printf("name\t%s\t%s\n", project, val)
                    }
                    sect = ""
                    if (line ~ /^ /) continue
                }
                #yaml lets a list sit at the same column as its key, so a
                #"- " at column 0 is still an item of provides
                if (sect == "provides" && line ~ /^- /) line = " " line
                if (line ~ /^[^ ]/) {
                    sect = ""; sub_key = ""; sub_ind = -1; pend = ""
                    if (match(line, /^[A-Za-z0-9_-]+:/)) {
                        key = substr(line, 1, RLENGTH - 1)
                        val = substr(line, RLENGTH + 1); sub(/^[ \t]+/, "", val)
                        if (key == "display-name") {
                            val = unquote(val)
                            if (val != "") printf("name\t%s\t%s\n", project, val)
                            else sect = key
                        } else if (key == "provides" || key == "dependencies" || key == "companions") {
                            sect = key
                        }
                    }
                    continue
                }
                if (sect == "") continue
                match(line, /^ +/); ind = RLENGTH; body = substr(line, ind + 1)
                if (sub_ind >= 0 && ind <= sub_ind) { sub_key = ""; sub_ind = -1 }

                if (sect == "provides") {
                    if (body ~ /^[A-Za-z0-9\/_-]+:[ \t]*(#.*)?$/) {
                        sub_key = body; sub(/:.*$/, "", sub_key); sub_ind = ind; continue
                    }
                    if (body !~ /^- /) continue
                    if (sub_ind >= 0 && sub_key != "linux") continue
                    item = body; sub(/^- +/, "", item); item = unquote(item)
                    n = split(item, parts, "/"); prog = parts[n]
                    #a name with a template in it is kept by pkgx as written,
                    #braces and all, and nobody types that
                    if (prog != "" && prog !~ /[{} ]/) printf("cmd\t%s\t%s\n", prog, project)
                    continue
                }

                #dependencies and companions. A project whose constraint is on
                #the lines below it is still a dependency: yaml folds them into
                #its value, and pkgx reads "14" where the file says
                #"gnu.org/gcc:" and then "14" on its own line
                if (pend != "") {
                    if (ind > pend_ind && body !~ /^[^:#]+:/) {
                        if (pend_counts) printf("dep\t%s\t%s\n", project, pend)
                        pend = ""; continue
                    }
                    pend = ""
                }
                if (!match(body, /^[^:#]+:/)) continue
                k = substr(body, 1, RLENGTH - 1); v = substr(body, RLENGTH + 1)
                sub(/^[ \t]+/, "", v); v = unquote(v)
                sub(/^[ \t]+/, "", k); sub(/[ \t]+$/, "", k)
                counts = (sub_ind < 0 || sub_key == "linux")
                if (v == "") {
                    #every project has a dot in its name and no platform key
                    #does, so a key with nothing after it is either a project
                    #whose value comes next, or a block. Only linux is read
                    if (index(k, ".")) { pend = k; pend_ind = ind; pend_counts = counts }
                    else               { sub_key = k; sub_ind = ind }
                    continue
                }
                if (!counts) continue
                if (k == "linux" || k == "darwin" || k == "windows") continue
                printf("dep\t%s\t%s\n", project, k)
            }
            close(file)
        }'
}

_resolve() {
    #$1 => a program or a project, $2 => the program asked for; sets project and cmd
    #    _resolve curl curl     =>  0, curl.se curl
    #    _resolve curl.se jq    =>  0, curl.se curl
    #    _resolve no.such x     =>  1
    _resolve__name="${1}"; _resolve__want="${2}"
    why=""; project=""; cmd=""; cands=""; noindex=""
    if [ ! -s "${INDEX}" ]; then
        why="${NO_INDEX}"; noindex="1"
        return 2
    fi
    cands="$(awk -F'\t' -v n="${_resolve__name}" '$1 == "cmd" && $2 == n {print $3}' "${INDEX}" | LC_ALL=C sort -u)"
    _util_is_one_line "${cands}" && { project="${cands}"; cmd="${_resolve__name}"; return 0; }
    [ -n "${cands}" ] && return 3

    cmd="$(awk -F'\t' -v p="${_resolve__name}" -v want="${_resolve__want}" '
        $1 == "cmd" && $3 == p {
            if ($2 == want) { hit = $2 }
            n = split(p, parts, "/"); if ($2 == parts[n]) own = $2
            if (first == "") first = $2
        }
        $1 == "dep" && $2 == p { known = 1 }
        $1 == "name" && $2 == p { known = 1 }
        END {
            if (hit != "") print hit; else if (own != "") print own
            else if (first != "") print first; else if (known) print "-"
        }' "${INDEX}")"
    [ -z "${cmd}" ] && return 1
    project="${_resolve__name}"
    return 0
}

_closure() {
    #$1 => project; it and all it depends on, companions included
    #    _closure curl.se  =>  curl.se
    #                          openssl.org
    #                          curl.se/ca-certs
    awk -F'\t' -v root="${1}" '
        $1 == "dep" { n = ++count[$2]; dep[$2, n] = $3 }
        END {
            queue[1] = root; seen[root] = 1; head = 1; tail = 1
            while (head <= tail) {
                p = queue[head++]; print p
                for (i = 1; i <= count[p]; i++) {
                    d = dep[p, i]
                    if (!(d in seen)) { seen[d] = 1; queue[++tail] = d }
                }
            }
        }' "${INDEX}"
}

_pantry() {
    #sets PANTRY to the pantry the catalog was read from
    PANTRY="${CH}/index/none"
    { read -r _pa__k _pa__d || :; } 2>/dev/null < "${INDEX}"
    case "${_pa__k}/${_pa__d}" in
        pantry/pantry.*) PANTRY="${CH}/index/${_pa__d}" ;;
    esac
    return 0
}

_run_tool() {
    #$1... => what pkgx is asked, on this channel's cellar and pantry
    if [ -n "${CMDFOUND_PKGX_DIST}" ]; then
        PKGX_DIR="${CELLAR}" PKGX_PANTRY_DIR="${PANTRY}" PKGX_DIST_URL="${DIST}" "${CMDFOUND_REQUIRED}" "${@}"
    else
        PKGX_DIR="${CELLAR}" PKGX_PANTRY_DIR="${PANTRY}" "${CMDFOUND_REQUIRED}" "${@}"
    fi
}

_installed_rows() {
    #pkgx --json=v2 on stdin; prints project and version, a tab apart, per package
    #    {"pkgs":{"curl.se":{"project":"curl.se","version":"8.10.0"}}}  =>  curl.se<TAB>8.10.0
    _util_json 3 | awk -F'\t' '
        {
            n = split($1, p, "/")
            if (n < 3 || p[1] != "pkgs") next
            k = $1; sub(/\/[^\/]*$/, "", k)
            if (p[n] == "project") v[k, "p"] = $2
            else if (p[n] == "version") v[k, "v"] = $2
            else next
            if (!(k in seen)) { seen[k] = 1; order[++m] = k }
        }

        #a package is one once it has both, which the end is when it is known
        END {
            for (i = 1; i <= m; i++) {
                k = order[i]
                if (v[k, "p"] != "" && v[k, "v"] != "")
                    printf("%s\t%s\n", v[k, "p"], v[k, "v"])
            }
        }'
}

_meta() {
    printf "%s\\n" "kind=artifact" "confines=no" "describes=self" "manager=github:pkgxdev/pkgx"
    exit 0
}

_index() {
    #$1 => bytes, to ask only what the pantry weighs
    mode="${1}"
    _platform >/dev/null || _api_answer_unreachable "pkgx builds nothing for ${_util_machine_in__os}/${_util_machine_in__cpu}"
    if [ X"${mode}" = X"bytes" ]; then
        _api_answer_bytes_of "${DIST}/pantry.tar.xz"
    fi
    _util_mkdir_p "${CH}/index" || exit 1
    kept="${CH}/index/pantry.tar.xz.part"; part="${kept}.$$"; new="${CH}/index/pantry.$$"
    _api_catalog_fetch "${DIST}/pantry.tar.xz" "${kept}" pkgx
    bytes="$(wc -c < "${part}" | awk '{print $1}')"
    #stopped from here on, the old pantry could be left half replaced
    trap '' TERM INT HUP
    #a user's TAR_OPTIONS=--to-stdout would leave the pantry empty
    _util_mkdir_p "${new}" && TAR_OPTIONS= tar -xJf "${part}" -C "${new}" 2> "${new}.err"
    rc="${?}"; rm -f "${part}"
    if [ "${rc}" -ne "0" ] || [ ! -d "${new}/projects" ]; then
        said="$(_util_first_line "$(cat "${new}.err" 2>/dev/null)" "tar gave no reason")"
        rm -rf "${new}" "${new}.err"
        if command -v xz >/dev/null 2>&1; then
            printf "unreachable=%s\\n" "pkgx's catalog could not be unpacked: ${said}"
        else
            printf "unreachable=%s\\n" "pkgx's catalog could not be unpacked, which needs xz"
        fi
        exit 2
    fi
    rm -f "${new}.err"
    tsv="${INDEX}.$$"
    printf "pantry\\t%s\\n" "${new##*/}" > "${tsv}" && \
        find "${new}/projects" -name package.yml | LC_ALL=C sort | _indexer | LC_ALL=C sort -u >> "${tsv}"

    _api_catalog_keep "${tsv}" "${INDEX}" "$(awk -F'\t' '$1 == "cmd"' "${tsv}" | awk 'END {print NR}')" "pkgx's catalog" "${new}"
    #a pantry still being built by a live run is left alone
    for old in "${CH}"/index/pantry "${CH}"/index/pantry.*; do
        [ -d "${old}" ] || continue
        [ X"${old}" = X"${new}" ] && continue
        case "${old##*/}" in
            pantry.*) kill -0 "${old##*.}" 2>/dev/null && continue ;;
        esac
        rm -rf "${old}"
    done
    printf "packages=%s\\n" "$(awk -F'\t' '$1 == "cmd" && !seen[$3]++' "${INDEX}" | awk 'END {print NR}')"
    printf "names=%s\\n" "$(awk -F'\t' '$1 == "cmd" && !seen[$2]++' "${INDEX}" | awk 'END {print NR}')"
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_search() {
    #$1... => the words to search
    [ -s "${INDEX}" ] || _api_answer_no_index
    search_words="${*}" awk -F'\t' "${SEARCH_AWK}"'
        $1 == "cmd"  { hay[$3] = hay[$3] " " $2; if (!($3 in first)) first[$3] = $2 }
        $1 == "name" { hay[$2] = hay[$2] " " $3; label[$2] = $3 }
        END {
            for (p in first)
                if (words_in(p " " hay[p])) printf("pkgx:%s\t%s\t%s\n", p, first[p], (p in label) ? label[p] : "provides" hay[p])
        }' "${INDEX}" | LC_ALL=C sort
    exit 0
}

_probe() {
    #$1 => a name or a project, $2 => a version
    name="${1}"; ver="${2}"
    [ -z "${name}" ] && exit 1
    _platform >/dev/null || exit 1
    _resolve "${name}" "${name}"; _api_answer_unresolved "${?}"
    [ X"${cmd}" = X"-" ] && exit 1
    _util_has_word "${CMDFOUND_NO_MANAGER}" "${SELF_NAME}" && exit 1

    _versions_in "${project}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_unreachable "${why}" ;;
    esac
    list="${_versions_in__out}"
    version="$(printf "%s\\n" "${list}" | _newest "${ver}")"
    [ -z "${version}" ] && exit 1

    work="${META}/probe.$$"; _util_mkdir_p "${work}" || exit 1
    i=0
    for member in $(_closure "${project}"); do
        i=$((i + 1))
        (
            if [ X"${member}" = X"${project}" ]; then
                v="${version}"
            else
                v=""
                _versions_in "${member}" && v="$(printf "%s\\n" "${_versions_in__out}" | _newest)"
            fi
            [ -z "${v}" ] && { printf "%s\\n" "none" > "${work}/${i}"; exit 0; }
            [ -d "${CELLAR}/${member}/v${v}" ] && { printf "%s\\n" "0" > "${work}/${i}"; exit 0; }
            s="$(_bottle_bytes "${member}" "${v}")" || s="unknown"
            printf "%s\\n" "${s}" > "${work}/${i}"
        ) &
        _batch "${i}"
    done
    wait
    bytes="$(cat "${work}"/* 2>/dev/null | awk '
        /^[0-9]+$/ {t += $1; next}
        $1 == "unknown" {u = 1}
        END {if (!u) print t + 0}')"
    rm -rf "${work}"

    printf "version=%s\\n" "${version}"
    [ -n "${bytes}" ] && printf "bytes=%s\\n" "${bytes}"
    printf "estimate=%s\\n" "yes"
    printf "package=%s\\n" "${project}"
    printf "requires=%s\\n" "github:pkgxdev/pkgx"
    exit 0
}

_locate() {
    #$1 => a project, $2 => a version, $3 => the program asked for

    #no sum: pkgx checks what it downloads
    [ -z "${1}" ] || [ -z "${2}" ] && exit 1
    _platform >/dev/null || exit 1
    _resolve "${1}" "${3}"; _api_answer_unresolved "${?}"
    [ X"${cmd}" = X"-" ] && exit 1
    printf "url=%s\\n" "$(_bottle "${project}" "${2}")"
    printf "format=%s\\n" "tar.xz"
    printf "bin=%s\\n" "${cmd}"
    exit 0
}

_obtain() {
    #$1 => a project, $2 => a version, $3 => the program asked for
    name="${1}"; ver="${2}"; want="${3}"
    [ -z "${name}" ] || [ -z "${ver}" ] && exit 1
    _pantry
    _resolve "${name}" "${want}"; _api_answer_unresolved "${?}"
    [ X"${cmd}" = X"-" ] && _api_answer_failed "${project} provides no program"
    if [ ! -x "${CMDFOUND_REQUIRED}" ]; then
        _api_answer_unreachable "pkgx is not available to install ${project}"
    fi
    if _api_is_unsafe "${CH}" || _api_is_unsafe "${CMDFOUND_REQUIRED}"; then
        _api_answer_failed "${LAUNCHER_UNSAFE}"
    fi
    _api_is_program_name "${cmd}" || \
        _api_answer_failed "'${cmd}' is not a program this channel will write a launcher for"

    answer="$(_run_tool --json=v2 "+${project}=${ver}")"
    if [ "${?}" -ne "0" ]; then
        _api_answer_failed "pkgx could not install ${project} ${ver}"
    fi
    members="$(printf "%s\\n" "${answer}" | _installed_rows)"
    if [ -z "${members}" ]; then
        _api_answer_failed "pkgx installed ${project} and said nothing this channel could read about it"
    fi
    if printf "%s\\n" "${members}" | awk -F'\t' '($1 "/" $2) ~ /\.\.|^\/|[^A-Za-z0-9._+\/-]/ {bad = 1} END {exit !bad}'; then
        _api_answer_failed "pkgx named a package this channel will not record"
    fi
    if [ ! -x "${CELLAR}/${project}/v${ver}/bin/${cmd}" ] && [ ! -x "${CELLAR}/${project}/v${ver}/sbin/${cmd}" ]; then
        _api_answer_failed "pkgx installed ${project} ${ver} but it has no program called ${cmd}"
    fi

    run="${CH}/run/${project}/${ver}"
    _util_mkdir_p "${run}" || exit 1
    {
        printf "%s\\n" "#!/bin/sh" "#written by cmdfound: ${cmd}, from ${project} ${ver}, run by pkgx"
        #the pantry is read at each run: an update moves it to another directory
        printf 'PKGX_DIR="%s"\nPKGX_PANTRY_DIR="%s/index/none"\n' "${CELLAR}" "${CH}"
        printf 'read -r _k _d 2>/dev/null < "%s"\n' "${INDEX}"
        printf 'case "${_k}/${_d}" in pantry/pantry.*) PKGX_PANTRY_DIR="%s/index/${_d}" ;; esac\n' "${CH}"
        printf 'export PKGX_DIR PKGX_PANTRY_DIR\n'
        [ -n "${CMDFOUND_PKGX_DIST}" ] && ! _api_is_unsafe "${DIST}" && \
            printf 'PKGX_DIST_URL="%s"\nexport PKGX_DIST_URL\n' "${DIST}"
        printf 'exec "%s" "+%s=%s" -- "%s" "$@"\n' "${CMDFOUND_REQUIRED}" "${project}" "${ver}" "${cmd}"
    } | _util_write_aside "${run}/${cmd}" 755

    printf "program=%s\\n" "${run}/${cmd}"
    printf "asset=%s\\n" "${project}/v${ver}"
    printf "%s\\n" "${members}" | awk -F'\t' '{printf("member=cellar/%s/v%s\n", $1, $2)}'
    exit 0
}

case "${1}" in
    meta)   _meta ;;
    index)  _index "${2}" ;;
    search) shift; _search "${@}" ;;
    probe)  _probe "${2}" "${3}" ;;
    locate) _locate "${2}" "${3}" "${4}" ;;
    obtain) _obtain "${2}" "${3}" "${4}" ;;

    *) printf "%s\\n" "usage: ${SELF_NAME} meta|index|search|probe|locate|obtain" >&2; exit 1 ;;
esac
__CMDFOUND_FILE__ 755 udocker
#!/bin/sh
#description: cmdfound channel - udocker, a runtime that runs a catalog's programs in containers without a daemon or root
#usage: udocker meta | udocker probe CATALOG/PACKAGE VER
#       udocker probe udocker [VER] | udocker locate udocker VER
#       udocker obtain CATALOG/PACKAGE VER | udocker reclaim

#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"

#a bare name is asked of every channel on every resolution: answered first
case "${1}" in
    probe)
        case "${2}" in
            */*) [ -n "${CMDFOUND_IMAGE}" ] || exit 1 ;;
            udocker) [ X"${CMDFOUND_NAMED}" = X"${SELF_NAME}" ] || exit 1 ;;
            *) exit 1 ;;
        esac ;;
    meta|locate|obtain|reclaim) ;;
    *) exit 1 ;;
esac

TOOL_NAME="udocker"
PYPI="${CMDFOUND_UDOCKER_PYPI:-https://pypi.org/pypi}"
#the engines udocker 1.3.17 requires and where it gets them, until a udocker
#here can be asked
RELEASE="1.2.11"
ENGINES="${CMDFOUND_UDOCKER_ENGINES:-https://download.a.incd.pt/udocker/udocker-englib-${RELEASE}.tar.gz}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"

_sdist() {
    #$1 => a version, none for the newest. Sets sdist_version, sdist_url, sdist_bytes, sdist_sha256
    #    _sdist 1.3.17  =>  0, sdist_url https://files.pythonhosted.org/.../udocker-1.3.17.tar.gz
    #    _sdist 0.0.0   =>  1  no such release, or no sdist in it
    #    _sdist         =>  2  PyPI out of reach and nothing cached
    _sd__want="${1}"
    sdist_version=""; sdist_url=""; sdist_bytes=""; sdist_sha256=""
    _sd__f="${CH}/cache/pypi.json"
    _util_mkdir_p "${CH}/cache" || return 2
    if ! _api_is_fresh "${_sd__f}"; then
        if _api_fetcher_answered "${PYPI}/${TOOL_NAME}/json" "${_sd__f}.$$"; then
            mv "${_sd__f}.$$" "${_sd__f}" 2>/dev/null
        else
            rm -f "${_sd__f}.$$"
            [ -s "${_sd__f}" ] || return 2
        fi
    fi
    _sd__answer="$(_util_json 5 containers < "${_sd__f}" | awk -F'\t' -v want="${_sd__want}" '
        $1 == "info/version" { newest = $2; next }
        {
            n = split($1, p, "/")
            if (p[1] != "releases" || n < 4) next
            f = (n == 5) ? p[4] "/" p[5] : p[4]
            v[p[2], p[3], f] = $2
            if (p[3] + 1 > count[p[2]]) count[p[2]] = p[3] + 1
        }
        END {
            r = (want != "") ? want : newest
            for (i = 0; i < count[r]; i++) {
                if (v[r, i, "packagetype"] != "sdist") continue
                printf("%s\n%s\n%s\n%s\n", r, v[r, i, "url"], v[r, i, "size"], v[r, i, "digests/sha256"])
                exit
            }
        }')"
    [ -n "${_sd__answer}" ] || return 1
    { IFS= read -r sdist_version; IFS= read -r sdist_url; IFS= read -r sdist_bytes; IFS= read -r sdist_sha256; } <<EOF
${_sd__answer}
EOF
    #a path is a PyPI on this machine, for the tests
    _api_is_version "${sdist_version}" || return 1
    case "${sdist_url}" in
        https://*|/*) ;;
        *) return 1 ;;
    esac
    _util_is_number "${sdist_bytes}" || sdist_bytes=""
    _util_is_sha256 "${sdist_sha256}" || sdist_sha256=""
    return 0
}

_tool_real() {
    #$1 => tool/current
    #    _tool_real "${CH}/tool/current"  =>  0, tool ${CH}/tool/1.3.17/.../maincmd.py

    #the real path: maincmd.py finds its package from the path it was started by
    tool="$(_util_realpath "${1}")"
    [ -f "${tool}" ] && [ ! -L "${tool}" ]
}

_run_tool() {
    #$1 => setup, defaults or none: may udocker set its engines up. Then udocker's arguments
    _util_mkdir_p "${CH}/home"; _util_mkdir_p "${CH}/tmp"; _util_mkdir_p "${CH}/xdg"; _util_mkdir_p "${CH}/ud"
    (
        case "${1}" in
            setup) ;;
            defaults) unset UDOCKER_TARBALL ;;
            *) UDOCKER_TARBALL=""; export UDOCKER_TARBALL ;;
        esac
        shift
        unset CURL_HOME PROOT_TMP_DIR UDOCKER_BIN UDOCKER_LIB UDOCKER_DOC UDOCKER_REPOS UDOCKER_LAYERS UDOCKER_CONTAINERS
        HOME="${CH}/home"; XDG_CONFIG_HOME="${CH}/home/.config"; UDOCKER_DIR="${CH}/ud"
        UDOCKER_KEYSTORE="${CH}/ud/keystore"; UDOCKER_TMP="${CH}/tmp"; XDG_RUNTIME_DIR="${CH}/xdg"
        export HOME XDG_CONFIG_HOME UDOCKER_DIR UDOCKER_KEYSTORE UDOCKER_TMP XDG_RUNTIME_DIR
        exec python3 -E -s "${tool}" ${allow_root:+--allow-root} "${@}"
    )
}

_version_ge() {
    #$1 => a version, $2 => the one it has to reach
    #    _version_ge 1.2.11 1.2.9  =>  0
    #    _version_ge 1.1.9 1.2     =>  1
    _vg__a="${1}."; _vg__b="${2}."
    while [ -n "${_vg__a}${_vg__b}" ]; do
        _vg__x="${_vg__a%%.*}"; _vg__a="${_vg__a#*.}"
        _vg__y="${_vg__b%%.*}"; _vg__b="${_vg__b#*.}"
        _util_is_number "${_vg__x}" || _vg__x="0"
        _util_is_number "${_vg__y}" || _vg__y="0"
        [ "${_vg__x}" -gt "${_vg__y}" ] && return 0
        [ "${_vg__x}" -lt "${_vg__y}" ] && return 1
    done
    return 0
}

_engines() {
    #sets engines_release and engines_url, as udocker's version says, kept per version
    #    _engines  =>  engines_release 1.2.11, engines_url .../udocker-englib-1.2.11.tar.gz
    engines_release="${RELEASE}"; engines_url="${ENGINES}"
    [ -n "${tool}" ] || return 0
    _en__v="${tool#"${CH}/tool/"}"; _en__v="${_en__v%%/*}"
    case "${_en__v}" in
        ''|*[!0-9A-Za-z.+-]*|"${tool}") return 0 ;;
    esac
    _en__f="${CH}/cache/engines.${_en__v}"
    if [ ! -s "${_en__f}" ]; then
        [ X"$(id -u)" = X"0" ] && allow_root="1"
        _en__out="$(_run_tool defaults version 2>/dev/null </dev/null)" \
            || return 0
        _en__rel=""; _en__url=""
        while IFS= read -r _en__line; do
            case "${_en__line}" in
                "tarball_release: "*) _en__rel="${_en__line#tarball_release: }" ;;
                "tarball: "*) _en__url="${_en__line#tarball: }"; _en__url="${_en__url%% *}" ;;
            esac
        done <<EOF
${_en__out}
EOF
        case "${_en__rel}" in
            ''|*[!0-9.]*) return 0 ;;
        esac
        [ -n "${CMDFOUND_UDOCKER_ENGINES}" ] && _en__url="${CMDFOUND_UDOCKER_ENGINES}"
        _util_mkdir_p "${CH}/cache" && \
            printf "%s\\n" "${_en__rel}" "${_en__url:-${ENGINES}}" | _util_write_aside "${_en__f}"
    fi
    { IFS= read -r engines_release; IFS= read -r engines_url; } < "${_en__f}"
    case "${engines_release}" in
        ''|*[!0-9.]*) engines_release="${RELEASE}" ;;
    esac
    [ -n "${engines_url}" ] || engines_url="${ENGINES}"
    return 0
}

_engines_due() {
    #0 when the engines are missing or too old
    _ed__have=""
    [ -f "${CH}/ud/lib/VERSION" ] && IFS= read -r _ed__have < "${CH}/ud/lib/VERSION"
    [ -n "${_ed__have}" ] || return 0
    ! _version_ge "${_ed__have}" "${engines_release}"
}

_engines_bytes() {
    #sets engines_bytes to the engines' download size, empty when unknown
    engines_bytes=""
    _eb__url="${engines_url}"; _eb__f="${CH}/cache/engines-${engines_release}.bytes"
    if [ -n "${UDOCKER_TARBALL}" ]; then
        _eb__url="${UDOCKER_TARBALL%% *}"; _eb__f=""
    fi
    if [ -n "${_eb__f}" ] && [ -s "${_eb__f}" ]; then
        IFS= read -r engines_bytes < "${_eb__f}"
    else
        engines_bytes="$(_api_fetcher_head_size "${_eb__url}")"
        _util_is_number "${engines_bytes}" || { engines_bytes=""; return 0; }
        [ -z "${_eb__f}" ] || { _util_mkdir_p "${CH}/cache" && printf "%s\\n" "${engines_bytes}" > "${_eb__f}"; }
    fi
    _util_is_number "${engines_bytes}" || engines_bytes=""
}

_image_spec() {
    #$1 => repository[:tag][@sha256:<hex>]. Sets image_repo, image_tag, image_spec, image_label
    #    _image_spec alpine                 =>  0, image_spec alpine:latest
    #    _image_spec alpine:3@sha256:<hex>  =>  0, image_spec alpine:sha256:<hex>, image_label alpine:3
    #    _image_spec localhost:5000/alpine  =>  1  udocker splits at the first :
    _is__ref="${1}"; _is__digest=""
    _api_is_image_ref "${_is__ref}" || return 1
    case "${_is__ref}" in
        *@*) _is__digest="${_is__ref#*@}"; _is__ref="${_is__ref%%@*}" ;;
    esac
    image_label="${_is__ref}"; image_repo="${_is__ref}"; image_tag="latest"
    case "${_is__ref##*/}" in
        *:*) image_tag="${_is__ref##*:}"; image_repo="${_is__ref%:*}" ;;
    esac
    case "${image_repo}" in
        ''|[!a-z0-9]*|*[!a-z0-9._/-]*|*..*|*//*|*/) return 1 ;;
    esac
    case "${image_tag}" in
        ''|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    if [ -n "${_is__digest}" ]; then
        _util_is_digest "${_is__digest}" || return 1
        #udocker takes repo@digest only for a bare name, repo:sha256:<hex> for any
        image_tag="${_is__digest}"
    fi
    image_spec="${image_repo}:${image_tag}"
    return 0
}

_image_here() {
    #0 when the image is pulled whole: udocker writes TAG before the layers
    [ -f "${CH}/pulled/${image_repo}/${image_tag}" ] && [ -f "${CH}/ud/repos/${image_repo}/${image_tag}/TAG" ]
}

_placement() {
    #$1 => catalog/package, $2 => version. Sets catalog and package
    #    _placement alpine/figlet 2.2.5-r3  =>  0, catalog alpine, package figlet
    #    _placement figlet 2.2.5-r3         =>  1
    #    _placement alpine/figlet ../x      =>  2
    case "${1}" in
        [a-z0-9]*/[A-Za-z0-9]*) ;;
        *) return 1 ;;
    esac
    catalog="${1%%/*}"; package="${1#*/}"
    _api_is_catalog_package "${catalog}/${package}/${2}" || return 2
}

_placed() {
    #$1 => catalog/package, $2 => version. Sets placed_id to its container, when still here
    #    _placed alpine/figlet 2.2.5-r3  =>  0, placed_id 6d3f...-...-...-...-...
    placed_id=""
    _pl__f="${CH}/containers/${1}/${2}"
    [ -f "${_pl__f}" ] || return 1
    IFS="	" read -r placed_id _pl__spec < "${_pl__f}"
    case "${placed_id}" in
        ''|*[!a-z0-9-]*) placed_id=""; return 1 ;;
    esac
    [ -d "${CH}/ud/containers/${placed_id}/ROOT" ] || { placed_id=""; return 1; }
}

_keystore() {
    #writes udocker's keystore from the user's docker logins, which udocker does not read
    rm -f "${CH}/ud/keystore"
    _ks__config="${DOCKER_CONFIG:-${HOME}/.docker}/config.json"
    [ -f "${_ks__config}" ] && [ -r "${_ks__config}" ] || return 0
    _ks__left="$(
        umask 077
        _util_json 3 containers < "${_ks__config}" | LC_ALL=C awk -F'\t' -v out="${CH}/ud/keystore.$$" '
            #a key of the docker file as the host udocker asks for: the
            #scheme and any path gone, and Docker Hub by the name it pulls from
            function host(k,   h) {
                h = k; sub(/^[A-Za-z]+:\/\//, "", h); sub(/\/.*$/, "", h)
                if (h == "index.docker.io" || h == "docker.io" || h == "registry-1.docker.io" || h == "registry.hub.docker.com") h = "registry-1.docker.io"
                return h
            }
            $1 == "credsStore" && $2 != "" { store = $2; next }
            $1 ~ /^credHelpers\/./ && $2 != "" { helper[host(substr($1, 13))] = 1; next }
            $2 == "{" && $1 ~ /^auths\/./ && !((substr($1, 7)) in seen) { k = substr($1, 7); seen[k] = 1; keys[++n] = k; next }
            $1 ~ /^auths\/.+\/auth$/ { auth[substr($1, 7, length($1) - 11)] = $2; next }
            END {
                m = 0; left = ""
                for (i = 1; i <= n; i++) {
                    h = host(keys[i])
                    if (h !~ /^[A-Za-z0-9.-]+(:[0-9]+)?$/ || (h in written)) continue
                    a = auth[keys[i]]
                    if (a ~ /^[A-Za-z0-9+\/=]+$/) {
                        printf("%s\"%s\": {\"auth\": \"%s\", \"email\": \"\"}", (m++ ? ", " : "{"), h, a) > out
                        written[h] = 1
                    } else if (store != "" || (h in helper)) {
                        if (!(h in said)) { said[h] = 1; left = left (left == "" ? "" : ", ") h }
                    }
                }
                for (h in helper) if (!(h in written) && !(h in said) && h ~ /^[A-Za-z0-9.-]+(:[0-9]+)?$/) { said[h] = 1; left = left (left == "" ? "" : ", ") h }
                if (m) printf("}\n") > out
                print left
            }'
    )"
    if [ -s "${CH}/ud/keystore.$$" ]; then
        chmod 600 "${CH}/ud/keystore.$$" && mv "${CH}/ud/keystore.$$" "${CH}/ud/keystore"
    fi
    rm -f "${CH}/ud/keystore.$$"
    [ -z "${_ks__left}" ] || printf "%s\\n" "cmdfound: udocker: your docker logins for ${_ks__left} are kept by a credential helper, which udocker cannot use; it pulls from there without them" >&2
    return 0
}

_launcher() {
    #$1 => launcher path, $2 => container id, $3 => program, $4 => what it is
    _l__path="${1}"; _l__id="${2}"; _l__program="${3}"; _l__what="${4}"
    {
        printf "%s\\n" "#!/bin/sh"
        printf "%s\\n" "#written by cmdfound: ${_l__what}"
        printf 'ch="%s"; id="%s"; tool="%s"; program="%s"\n' "${CH}" "${_l__id}" "${tool}" "${_l__program}"
        cat <<'LAUNCHER'
#udocker is run by the path of its own maincmd.py, which finds its package
#from it; after an update took that path away, by where tool/current leads
[ -f "${tool}" ] || tool="$(readlink "${ch}/tool/current")"
. "${ch}/lib/confined-launch" || exit 127
_launch_sets || exit 127

#CMDFOUND_UDOCKER_FLAGS, read on every run, is the user's own words for
#udocker run, written as the shell writes words: '...' keeps all, "..." all
#but \" \\ \$ \` and a backslash before a newline, and a backslash outside
#them the next character. Nothing in it is expanded - a $, a backquote, a * is
#that character - and it is never evaluated: confined-launch's split, the one
#docker's launchers use too, reads it a character at a time, and each word
#goes onto the arguments whole, so a word can hold any character, a control
#character too. They go after the arguments cmdfound gives udocker run and
#before the container, so a flag given twice is the user's. A quote left open
#runs nothing.
#
#What a flag of the user's can break: --user or -u, the ids files are written
#with; --containerauth, the names of those ids; -w, where the program starts;
#--novol, HOME or the working directory unmounted; --hostenv, this machine's
#PATH and libraries inside; --bindhome, --nometa and --entrypoint, what runs;
#--location, a container outside this channel, which a purge cannot remove;
#--rm, this placement's container deleted when the program ends; --pull and
#--platform, a pull on a run; --nosysdirs, no /dev, /proc or /sys. docker run
#flags udocker has nothing for: --network, --memory, --cpus (--cpuset-cpus
#only), --cap-add, --cap-drop, --privileged, --read-only, --tmpfs, --mount,
#--add-host, --group-add, --init, -d, --restart, --gpus, --security-opt and
#--ulimit. -i and -t are taken and do nothing, --device works in execution
#mode R1 only, and -p, in P1, only moves a port the program binds: there is
#no network of the container's own

#udocker run's arguments, made here and nowhere else: the container and the
#program before the program's own arguments, the user's flags before them,
#and what confined-launch gives udocker run first. Every variable changed
#below for udocker's own process is handed to the program with the user's
#value, or not at all when the user had none: udocker reads -e NAME from its
#own environment. Everything goes before the program's arguments, the user's
#words one set each, the last first, so no set costs more than the arguments
#are many
_launch_flags_read "${CMDFOUND_UDOCKER_FLAGS}"
_launch_flags_closed udocker || exit 127
set -- "${id}" "${program}" "$@"
while _launch_prev_flag; do
    set -- "${_launch_flag}" "$@"
done
eval "set -- $(_launch_udocker HOME XDG_CONFIG_HOME CURL_HOME PROOT_TMP_DIR UDOCKER_DIR UDOCKER_KEYSTORE UDOCKER_TMP UDOCKER_TARBALL UDOCKER_BIN UDOCKER_LIB UDOCKER_DOC UDOCKER_REPOS UDOCKER_LAYERS UDOCKER_CONTAINERS) \"\$@\""
if [ X"${_launch_uid}" = X"0" ]; then set -- --allow-root --quiet run --nobanner "$@"; else set -- --quiet run --nobanner "$@"; fi

unset CURL_HOME PROOT_TMP_DIR UDOCKER_BIN UDOCKER_LIB UDOCKER_DOC UDOCKER_REPOS UDOCKER_LAYERS UDOCKER_CONTAINERS
PATH="${ch}/needs:${PATH}"; HOME="${ch}/home"; XDG_CONFIG_HOME="${ch}/home/.config"; UDOCKER_DIR="${ch}/ud"
UDOCKER_KEYSTORE="${ch}/ud/keystore"; UDOCKER_TMP="${ch}/tmp"; XDG_RUNTIME_DIR="${ch}/xdg"; UDOCKER_TARBALL=""
export PATH HOME XDG_CONFIG_HOME UDOCKER_DIR UDOCKER_KEYSTORE UDOCKER_TMP XDG_RUNTIME_DIR UDOCKER_TARBALL

#not exec: udocker ends a Ctrl-C with 1, as a program that failed does, and
#the shell stays in the foreground to say which it was. udocker kills proot a
#quarter of a second after a Ctrl-C when the program goes on, and proot then
#leaves the directories it made in the container to mount on, empty and with
#no permissions: they go, or du stops at them, and a placement's size with it
trap "interrupted=1" INT
python3 -E -s "${tool}" "$@"
status="${?}"
if [ -n "${interrupted}" ]; then
    find "${ch}/ud/containers/${id}/ROOT" -type d -perm 000 -exec rmdir {} + 2>/dev/null
    exit 130
fi
exit "${status}"
LAUNCHER
    } | _util_write_aside "${_l__path}" 755
}

_undo() {
    #obtain's EXIT trap: removes the container an unfinished obtain made
    [ -n "${made}" ] || return 0
    _util_removable "${CH}/ud/containers/${made}"
    rm -rf "${CH}/ud/containers/${made}"
}

_meta() {
    printf "%s\\n" "kind=runtime" "confines=yes" "manager=${SELF_NAME}:${TOOL_NAME}" "needs=python3" "reclaims=yes"
    exit 0
}

_probe() {
    #$1 => udocker or catalog/package, $2 => a version
    name="${1}"; ver="${2}"
    if [ X"${name}" = X"${TOOL_NAME}" ]; then
        _sdist "${ver}"
        case "${?}" in
            0) ;;
            1) exit 1 ;;
            *) _api_answer_unreachable "PyPI could not be asked for udocker at ${PYPI}" ;;
        esac
        printf "version=%s\\n" "${sdist_version}"
        [ -n "${sdist_bytes}" ] && printf "bytes=%s\\n" "${sdist_bytes}"
        if [ -n "${sdist_sha256}" ]; then
            printf "badge=%s\\n" "verified"
        else
            printf "badge=%s\\n" "none"
        fi
        exit 0
    fi
    _util_has_word "${CMDFOUND_NO_MANAGER}" "${SELF_NAME}" && \
        _api_answer_unreachable "udocker itself could not be had"
    if ! _image_spec "${CMDFOUND_IMAGE}"; then
        _api_answer_unreachable "udocker cannot name the image ${CMDFOUND_IMAGE}"
    fi
    printf "%s\\n" "run_ms=250" "requires=${SELF_NAME}:${TOOL_NAME}"
    tool=""
    [ -x "${CH}/tool/current" ] && { _tool_real "${CH}/tool/current" || tool=""; }
    _engines
    if _engines_due; then
        _engines_bytes
        printf "once=setup|udocker-englib-%s|%s|none\\n" "${engines_release}" "${engines_bytes:--}"
    fi
    if ! _placed "${name}" "${ver}" && ! _image_here; then
        printf "once=image|%s|%s|via udocker\\n" "${image_label}" "${CMDFOUND_IMAGE_BYTES:--}"
    fi
    exit 0
}

_locate() {
    #$1 => udocker, $2 => a version
    name="${1}"; ver="${2}"
    [ X"${name}" = X"${TOOL_NAME}" ] && [ -n "${ver}" ] || exit 1
    _sdist "${ver}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_unreachable "PyPI could not be asked for udocker at ${PYPI}" ;;
    esac
    printf "url=%s\\n" "${sdist_url}"
    printf "%s\\n" "format=tar.gz" "bin=maincmd.py"
    [ -n "${sdist_sha256}" ] && printf "sha256=%s\\n" "${sdist_sha256}"
    exit 0
}

_obtain() {
    #$1 => catalog/package, $2 => a version
    name="${1}"; ver="${2}"
    _placement "${name}" "${ver}"
    case "${?}" in
        0) ;;
        1) exit 1 ;;
        *) _api_answer_failed "'${name}' '${ver}' is not a package and version this channel will install" ;;
    esac
    [ -n "${ver}" ] || exit 1
    _api_value_in image "${CMDFOUND_RECIPE}"; image="${_api_value_in__out}"
    _api_value_in install "${CMDFOUND_RECIPE}"; install="${_api_value_in__out}"
    _api_value_in bin "${CMDFOUND_RECIPE}"; program="${_api_value_in__out}"
    if [ -z "${image}" ] || [ -z "${install}" ] || [ -z "${program}" ]; then
        _api_answer_failed "the catalog gave no recipe to install ${name} with"
    fi
    _api_is_program_name "${program}" || \
        _api_answer_failed "'${program}' is not a program's name"
    if ! _image_spec "${image}"; then
        _api_answer_failed "udocker cannot name the image ${image}"
    fi
    if [ ! -x "${CMDFOUND_REQUIRED}" ] || ! _tool_real "${CMDFOUND_REQUIRED}"; then
        _api_answer_unreachable "udocker is not here to install ${name} with"
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        _api_answer_unreachable "python3 is not here to run udocker with"
    fi
    if _api_is_unsafe "${CH}" || _api_is_unsafe "${tool}"; then
        _api_answer_failed "a path here cannot be written into a launcher safely"
    fi
    allow_root=""
    [ X"$(id -u)" = X"0" ] && allow_root="1"
    _util_mkdir_p "${CH}/log" && _util_mkdir_p "${CH}/lib" && _util_mkdir_p "${CH}/run/${name}/${ver}" && \
        _util_mkdir_p "${CH}/containers/${catalog}/${package}" || exit 1
    log="${CH}/log/${catalog}-${package}.log"
    : > "${log}"
    _util_write_aside "${CH}/lib/confined-launch" < "$(_api_launch_source)" 2>/dev/null && . "${CH}/lib/confined-launch" || {
        _api_answer_failed "confined-launch, which launchers run by, could not be copied into ${CH}/lib"
    }

    made=""
    _util_trap_exit '_undo'

    if _placed "${name}" "${ver}"; then
        id="${placed_id}"
    else
        _engines
        if _engines_due; then
            _engines_bytes
            t0="$(_util_now_ms)"
            if ! _api_shown "${log}" _run_tool setup install || _engines_due; then
                _api_answer_failed "udocker could not set up its engines$(_api_log_hint "${log}")"
            fi
            printf "timing=setup:%s:%s\\n" "${engines_bytes:--}" "$(( $(_util_now_ms) - t0 ))"
        fi

        if ! _image_here; then
            t0="$(_util_now_ms)"
            _keystore
            _api_shown "${log}" _run_tool none pull "${image_spec}"; rc="${?}"
            rm -f "${CH}/ud/keystore"
            if [ "${rc}" -ne "0" ] || [ ! -f "${CH}/ud/repos/${image_repo}/${image_tag}/TAG" ]; then
                hint=""
                case "${image_repo}" in
                    docker.io/*) command -v docker >/dev/null 2>&1 && \
                        hint="; Docker Hub allows 100 pulls an hour without a login, and docker:${name} pulls with yours" ;;
                esac
                _api_answer_failed "udocker could not pull ${image_label}$(_api_log_hint "${log}")${hint}"
            fi
            _util_mkdir_p "${CH}/pulled/${image_repo}" && _util_mkdir_p "${CH}/cache" && \
                printf "%s\\n" "${image_spec}" > "${CH}/cache/pulled.$$" && \
                mv "${CH}/cache/pulled.$$" "${CH}/pulled/${image_repo}/${image_tag}" || \
                rm -f "${CH}/cache/pulled.$$"
            ibytes="$(_util_json 3 containers < "${CH}/ud/repos/${image_repo}/${image_tag}/manifest" 2>/dev/null | awk -F'\t' '
                { n = split($1, p, "/") }
                n == 3 && p[1] == "layers" && p[3] == "size" && $2 ~ /^[0-9]+$/ { t += $2; k++ }
                END { if (k) printf("%.0f\n", t) }')"
            printf "timing=image:%s:%s\\n" "${ibytes:--}" "$(( $(_util_now_ms) - t0 ))"
        fi

        t0="$(_util_now_ms)"
        id="$(_run_tool none create "${image_spec}" 2>>"${log}" </dev/null | awk '/^[a-z0-9]+-[a-z0-9]+-[a-z0-9]+-[a-z0-9]+-[a-z0-9]+$/ {id = $0} END {print id}')"
        if [ -z "${id}" ] || [ ! -d "${CH}/ud/containers/${id}/ROOT" ]; then
            _api_answer_failed "udocker could not make a container of ${image_label}, its account is in ${log}"
        fi
        made="${id}"
        if ! _run_tool none setup --execmode=P1 "${id}" >> "${log}" 2>&1 </dev/null; then
            _api_answer_failed "udocker could not set container ${id} to run with proot, its account is in ${log}"
        fi
        eval "set -- $(_build_network)"
        ca="${1}"; shift
        if [ -n "${ca}" ]; then
            _util_mkdir_p "${CH}/ud/containers/${id}/ROOT${CONFINED_CA%/*}" && \
                cp "${ca}" "${CH}/ud/containers/${id}/ROOT${CONFINED_CA}" || \
                _api_answer_failed "the CA file ${ca} could not be copied into the container"
        fi
        _api_shown "${log}" _run_tool none run --nobanner --user=root "${@}" "${id}" /bin/sh -c "${install}"; rc="${?}"
        [ -z "${ca}" ] || rm -rf "${CH}/ud/containers/${id}/ROOT${CONFINED_CA%/*}"
        _util_removable "${CH}/ud/containers/${id}"
        if [ "${rc}" -ne "0" ]; then
            _api_answer_failed "${name} ${ver} could not be installed in ${image_label}$(_api_log_hint "${log}")"
        fi
        if _util_is_number "${CMDFOUND_BYTES}"; then ibytes="${CMDFOUND_BYTES}"; else ibytes="-"; fi
        printf "timing=install:%s:%s\\n" "${ibytes}" "$(( $(_util_now_ms) - t0 ))"
    fi

    #-w /: else udocker may start in the user's home, which is not in the image
    t0="$(_util_now_ms)"
    if ! _run_tool none --quiet run --nobanner --hostauth "--user=$(id -u)" -w / "${id}" /bin/sh -c 'command -v "$1"' sh "${program}" >/dev/null 2>>"${log}" </dev/null; then
        _api_answer_failed "${name} ${ver} installed no program called ${program} that udocker could start, its account is in ${log}"
    fi
    printf "timing=run:-:%s\\n" "$(( $(_util_now_ms) - t0 ))"
    if [ -n "${made}" ]; then
        printf "%s\\t%s\\n" "${id}" "${image_spec}" | _util_write_aside "${CH}/containers/${name}/${ver}" || exit 1
        made=""
    fi
    if ! _launcher "${CH}/run/${name}/${ver}/${program}" "${id}" "${program}" \
        "${program}, from ${catalog} ${package} ${ver}, run by udocker in container ${id}"; then
        _api_answer_failed "the launcher of ${program} could not be written"
    fi
    printf "program=%s\\n" "${CH}/run/${name}/${ver}/${program}"
    printf "asset=%s\\n" "${id}"
    printf "member=%s\\n" "run/${name}/${ver}" "containers/${name}/${ver}" "ud/containers/${id}"
    exit 0
}

_reclaim() {
    if [ X"${CMDFOUND_RECLAIM}" = X"all" ]; then
        _util_removable "${CH}/ud"
        printf "freed=%s\\n" "0"
        exit 0
    fi
    named="
$(find "${CH}/containers" -type f -exec cat {} + 2>/dev/null)
"
    doomed="$(find "${CH}/pulled" -type f 2>/dev/null | while IFS= read -r record; do
        IFS= read -r spec < "${record}" || [ -n "${spec}" ] || continue
        case "${named}" in
            *"	${spec}
"*) continue ;;
        esac
        printf "%s\\n" "${record}"
    done)"
    [ -n "${doomed}" ] || { printf "freed=%s\\n" "0"; exit 0; }
    if [ ! -x "${CMDFOUND_REQUIRED}" ] || ! _tool_real "${CMDFOUND_REQUIRED}"; then
        _api_answer_unreachable "udocker is not here to give its images back with"
    fi
    allow_root=""
    [ X"$(id -u)" = X"0" ] && allow_root="1"
    before="$(du -sk "${CH}/ud/layers" 2>/dev/null | awk '{print $1}')"
    while IFS= read -r record; do
        IFS= read -r spec < "${record}"
        rest="${record#"${CH}/pulled/"}"
        if [ -f "${CH}/ud/repos/${rest}/TAG" ]; then
            _run_tool none --quiet rmi "${spec}" </dev/null >/dev/null 2>&1 || continue
        fi
        rm -f "${record}"
        dir="${record%/*}"
        while [ X"${dir}" != X"${CH}/pulled" ] && rmdir "${dir}" 2>/dev/null; do
            dir="${dir%/*}"
        done
    done <<EOF
${doomed}
EOF
    after="$(du -sk "${CH}/ud/layers" 2>/dev/null | awk '{print $1}')"
    #no freed= when du failed or the layers grew meanwhile
    if _util_is_number "${before}" && _util_is_number "${after}" && [ "${before}" -ge "${after}" ]; then
        printf "freed=%s\\n" "$(( (before - after) * 1024 ))"
    fi
    exit 0
}

case "${1}" in
    meta)    _meta ;;
    probe)   _probe "${2}" "${3}" ;;
    locate)  _locate "${2}" "${3}" ;;
    obtain)  _obtain "${2}" "${3}" ;;
    reclaim) _reclaim ;;
esac
exit 1
