#!/bin/sh
#description: run a command that is not installed, through whatever channel can reach it
#usage: cmdfound [OPTION]... [CHANNEL:]PACKAGE[@VERSION] [ARGUMENT]...

#example:
#$ cmdfound github:jqlang/jq --version
#cmdfound: jq 1.8.2 -> github:jqlang/jq  2.2 MB  [verified]  native
#jq-1.8.2

VERSION="2026.09.16-03:40"
SRC_URL="https://raw.githubusercontent.com/javier-lopez/cmdfound/master/"
#./build writes in the sum of the channels it carries; cmdfound.in carries none
BUNDLE_ID=""

COMMAND_NOT_FOUND="127"

_usage() { #reviewed
    printf "%s\\n" "Usage: ${PROGNAME} [OPTION]... [CHANNEL:]PACKAGE[@VERSION] [ARGUMENT]..."
    printf "%s\\n" "Run a command this machine does not have installed."
    printf "\\n"
    printf "%b\\n" "  -n, --dry-run        show the hypothetical route"
    printf "%b\\n" "  -a, --apropos WORDS  search the local catalogs by what a program does"
    printf "%b\\n" "  -i, --index-update [CHANNEL]"
    printf "%b\\n" "                       update the catalogs or one channel's only"
    printf "%b\\n" "  -l, --list           what is placed here already: each package, its size"
    printf "%b\\n" "                       and how it runs, each channel's own tool, and what"
    printf "%b\\n" "                       a channel holds besides"
    printf "%b\\n" "  -b, --bin PROGRAM    which program inside the package to run, when it is"
    printf "%b\\n" "                       not named after the package"
    printf "%b\\n" "  -p, --purge [[CHANNEL:]PACKAGE[@VERSION]]"
    printf "%b\\n" "                       remove what one of them placed; CHANNEL: alone"
    printf "%b\\n" "                       removes that whole channel, no argument everything"
    printf "%b\\n" "  -y, --yes            do not confirm"
    printf "%b\\n" "  -L, --latest         resolve again instead of reusing the cached answer"
    printf "%b\\n" "  -e, --ephemeral      use a throwaway root and remove it on exit"
    printf "%b\\n" "  -U, --update         update this program to latest version"
    printf "%b\\n" "      --hook [bash|zsh]"
    printf "%b\\n" "                       print the shell hook that runs a missing command"
    printf "%b\\n" "                       through this, eval it in your rc"
    printf "%b\\n" "      --channel CHANNEL VERB [ARGUMENT]..."
    printf "%b\\n" "                       for writing or debugging a channel; it prints its"
    printf "%b\\n" "                       own verbs when the verb is wrong"
    printf "%s\\n" "  -V, --version        display version"
    printf "%b\\n" "  -v, --verbose        turn on verbose mode"
    printf "%b\\n" "  -q, --quiet          suppress non-error messages"
    printf "%b\\n" "  -h, --help           show this message and exit"
}

_die() { #@frozen 2026-09-21 m@javier.io 2e226ed
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

_msg() { #@frozen 2026-09-28 m@javier.io 2e226ed
    [ -n "${g_quiet}" ] && return 0
    #everything this tool says goes to stderr: stdout belongs to the program it runs
    printf "%s\\n" "${*}" >&2
}

_verbose() { #@frozen 2026-09-28 m@javier.io 2e226ed
    [ -z "${g_verbose}" ] && return 0
    printf "%s\\n" "${*}" >&2
}

_has_line() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => lines, $2 => a whole line
    #    _has_line "${_p2r__meta}" "confines=no"  =>  0
    #    _has_line "${_p2r__meta}" "confines"     =>  1

    #the newlines make the match whole, and a case, because a grep is a process
    case "${NL}${1}${NL}" in
        *"${NL}${2}${NL}"*) return 0 ;;
    esac
    return 1
}

_value() { #@frozen 2026-10-25 m@javier.io 2e226ed
    _api_value_in "${1}" "${2}" || return 1
    printf "%s\\n" "${_api_value_in__out}"
}

_values() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => a key, $2 => key=value lines, and every value that key is given
    #    _values once "${_rpr__rout}"  =>  setup|udocker-englib-1.2.11|9700000|none
    #                                      image|alpine:3.20|3400000|via udocker
    _values__rest="${2}"
    while [ -n "${_values__rest}" ]; do
        _values__line="${_values__rest%%${NL}*}"
        case "${_values__line}" in
            "${1}="*) printf "%s\\n" "${_values__line#*=}" ;;
        esac
        #the last line carries no newline, and cutting past it would never end
        [ X"${_values__line}" = X"${_values__rest}" ] && break
        _values__rest="${_values__rest#*${NL}}"
    done
    return 0
}

_bytes2human() { #@reviewed 2026-09-27 m@javier.io 2e226ed
    case "${1}" in #bytes as the user reads them, and a dash when the catalog did not say
        ''|-|*[!0-9]*) printf "%s" "-"; return 0 ;;
    esac
    awk -v b="${1}" 'BEGIN {
        if (b < 1024)        { printf("%d B", b) }
        else if (b < 1048576){ printf("%.1f KB", b/1024) }
        else                 { printf("%.1f MB", b/1048576) }
    }'
}

_realdir() { #@frozen 2026-10-25 m@javier.io 2e226ed
    _realdir__real="$(_util_realpath "${1}")"
    printf "%s\\n" "${_realdir__real%/*}"
}

###############################################################################
################################### layout ####################################
###############################################################################

_home() { #@frozen 2026-09-27 m@javier.io 2e226ed
    #one place, so one rm -rf removes all of it
    if [ -n "${CMDFOUND_HOME}" ]; then
        printf "%s\\n" "${CMDFOUND_HOME}"
    else
        printf "%s\\n" "${HOME}/.cmdfound"
    fi
}

_sweep_ephemeral() { #@reviewed 2026-09-28 m@javier.io 2e226ed
    #a throwaway root is named with the pid that made it. Shell built-ins only
    for _se__dir in "${TMPDIR:-/tmp}"/cmdfound-eph.*; do
        [ -d "${_se__dir}" ] || continue
        _se__pid="${_se__dir##*/cmdfound-eph.}"; _se__pid="${_se__pid%%.*}"
        case "${_se__pid}" in ''|*[!0-9]*) continue ;; esac
        [ X"${_se__pid}" = X"$$" ] || ! kill -0 "${_se__pid}" 2>/dev/null || continue
        rm -rf "${_se__dir}" 2>/dev/null
    done
}

_channels_dir_in() { #reviewed
    #performance optimization, avoid forks, same trick for other *_in functions
    [ -n "${_channels_dir_in__out}" ] && return 0
    #an environment variable replaces it outright: the tests answer without a network
    [ -n "${CMDFOUND_CHANNELS}" ] && { _channels_dir_in__out="${CMDFOUND_CHANNELS}"; return 0; }
    #otherwise next to this file, named after the file and not the name it was run
    #by, so a link called sr still finds cmdfound.d, and cmdfound.in does too
    _channels_dir_in__out="$(_util_realpath "${0}")"
    _channels_dir_in__out="${_channels_dir_in__out%.in}.d"
    [ -d "${_channels_dir_in__out}" ] && return 0
    #a built cmdfound with no checkout beside it runs the channels it carries
    _bundle_in && _channels_dir_in__out="${_bundle_in__out}"
    return 0
}

_bundle_in() {
    #the directory the channels this file carries are written to, once a build:
    #    _bundle_in  =>  0, ~/.cmdfound/bundle/<BUNDLE_ID>
    #1 for cmdfound.in, which carries none
    [ -n "${BUNDLE_ID}" ] || return 1
    _bundle_in__out="${g_home:-$(_home)}/bundle/${BUNDLE_ID}"
    [ -d "${_bundle_in__out}" ] && return 0
    #written aside and renamed in, so a run that reads it never finds it half written
    _bi__tmp="${_bundle_in__out}.$$"
    rm -rf "${_bi__tmp}"
    _bi__self="$(_util_realpath "${0}")" && _util_mkdir_p "${_bi__tmp}" || return 1
    #./build appends each channel past the end of the code, a mode and a name before it
    _bi__modes="$(awk -v dir="${_bi__tmp}" '
        $0 == "__CMDFOUND_BUNDLE__" { on = 1; next }
        !on { next }
        index($0, "__CMDFOUND_FILE__ ") == 1 {
            if (f != "") close(f)
            split($0, w, " "); f = dir "/" w[3]; print w[2], w[3]; printf("") > f; next
        }
        f != "" { print > f }
    ' "${_bi__self}")"
    [ -n "${_bi__modes}" ] && printf "%s\\n" "${_bi__modes}" | while read -r _bi__mode _bi__name; do
        chmod "${_bi__mode}" "${_bi__tmp}/${_bi__name}" || exit 1
    done || { rm -rf "${_bi__tmp}"; return 1; }
    mv "${_bi__tmp}" "${_bundle_in__out}" 2>/dev/null
    #another run may have renamed its own in first, and that one is as good
    rm -rf "${_bi__tmp}"
    [ -d "${_bundle_in__out}" ]
}

_channels_dir() { #@frozen 2026-09-27 m@javier.io 2e226ed
    _channels_dir_in #the same directory, printed, for a caller that wants it in a substitution
    printf "%s\\n" "${_channels_dir_in__out}"
}

_channels_conf() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #reads channels.conf, when there is one, and answers in two variables.
    #_channels_from says which decided, 'conf' or 'directory'. _channels_on lists
    #what the file turns on, each as name:position, numbered from 1001 in the
    #order of the file:
    #    _channels_on=" github:1001 aqua:1002 conda-forge:1003 "

    #$1 => 'warn' also reports the lines that name no channel, or name one twice.
    [ -n "${_channels_from}" ] && return 0
    _channels_from="directory"; _channels_on=" "
    #channels.conf and not channels: that name is the directory channels place in
    _cc__conf="${g_home}/channels.conf"
    [ -f "${_cc__conf}" ] || return 0
    _cc__dir="$(_channels_dir)"
    [ -d "${_cc__dir}" ] || return 0
    _channels_from="conf"
    _cc__position="1000"; _cc__named=" "
    #a last line with no newline after it is still a line
    while read -r _cc__line || [ -n "${_cc__line}" ]; do
        #'#' comments the rest of a line and '!' turns a channel off
        _cc__line="${_cc__line%%#*}"
        _cc__off=""
        case "${_cc__line}" in
            '!'*) _cc__off="1"; _cc__line="${_cc__line#!}" ;;
        esac
        while :; do
            case "${_cc__line}" in
                [" ${TAB}"]*) _cc__line="${_cc__line#?}" ;;
                *[" ${TAB}"]) _cc__line="${_cc__line%?}" ;;
                *) break ;;
            esac
        done
        [ -n "${_cc__line}" ] || continue
        if [ ! -f "${_cc__dir}/${_cc__line}" ] || [ ! -x "${_cc__dir}/${_cc__line}" ]; then
            [ X"${1}" = X"warn" ] && \
                _msg "${PROGNAME}: no channel called '${_cc__line}', named in ${_cc__conf}"
            continue
        fi
        #the first line that names a channel decides for it: a later one would have
        #every resolution ask that channel twice
        case "${_cc__named}" in
            *" ${_cc__line} "*)
                [ X"${1}" = X"warn" ] && \
                    _msg "${PROGNAME}: channel '${_cc__line}' named again in ${_cc__conf}, its first line decides"
                continue ;;
        esac
        _cc__named="${_cc__named}${_cc__line} "
        [ -n "${_cc__off}" ] && continue
        #from 1001: a thousand ahead of the count keeps every position four digits
        #wide, and four digits sort as the number they are, where 10 sorted before 9
        [ "${_cc__position}" -lt "1999" ] && _cc__position="$((${_cc__position} + 1))"
        _channels_on="${_channels_on}${_cc__line}:${_cc__position} "
    done < "${_cc__conf}"
}

_channel_position() { #@reviewed 2026-09-28 m@javier.io 2e226ed
    #$1 => channel. _channels_conf leaves what the file turned on in one string:
    #    _channels_on=" github:1001 aqua:1002 conda-forge:1003 "
    #$1 => 'aqua' is 1002
    g_channel_position="1000"
    case "${_channels_on}" in
        *" ${1}:"*) g_channel_position="${_channels_on#* "${1}":}"
                    g_channel_position="${g_channel_position%% *}" ;;
    esac
}

_channels() { #@frozen 2026-09-28 m@javier.io 2e226ed
    #print channels one per row
    _channels_conf
    if [ X"${_channels_from}" = X"directory" ]; then
        _channels__dir="$(_channels_dir)"
        [ -d "${_channels__dir}" ] || return 1
    fi

    if [ X"${_channels_from}" = X"conf" ]; then
        for _channels__on in ${_channels_on}; do
            printf "%s\\n" "${_channels__on%:*}"
        done
    else
        for _channels__file in "${_channels__dir}"/*; do
            [ -f "${_channels__file}" ] || continue
            [ -x "${_channels__file}" ] || continue
            printf "%s\\n" "${_channels__file##*/}"
        done
    fi | while read -r _channels__name; do
        #a channel waiting on a program to read its catalog with is not asked:
        #_obtain_needs sets CMDFOUND_WITHOUT before it resolves
        case " ${CMDFOUND_WITHOUT} " in
            *" ${_channels__name} "*) continue ;;
        esac
        printf "%s\\n" "${_channels__name}"
    done
}

_channel_by_alias() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #a change here means a change in the meta format which should be done with hypercare
    for _cba__channel in $(_channels); do
        _cba__hit="$(_api_channel "${_cba__channel}" meta 2>/dev/null | \
            awk -F= -v want="${1}" '$1 == "aliases" {
                n = split($2, a, ",")
                for (i = 1; i <= n; i++) if (a[i] == want) { print "1"; exit }
            }')"
        [ -n "${_cba__hit}" ] && { printf "%s\\n" "${_cba__channel}"; return 0; }
    done
    return 1
}

_channel_meta_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => key (optional), everything it said. The answer goes
    #in _channel_meta_in__out
    if [ X"${_channel_meta_in__for}" != X"${1}" ]; then
        _channels_dir_in
        _channel_meta_in__said="$(_api_channel "${1}" meta 2>/dev/null)"
        _channel_meta_in__for="${1}"
    fi
    [ -z "${2}" ] && { _channel_meta_in__out="${_channel_meta_in__said}"; return 0; }
    _api_value_in "${2}" "${_channel_meta_in__said}"
    _channel_meta_in__out="${_api_value_in__out}"
    if [ -z "${_channel_meta_in__out}" ]; then
        case "${2}" in
            kind)      _channel_meta_in__out="artifact" ;;
            confines)  _channel_meta_in__out="no"       ;;
            describes) _channel_meta_in__out="self"     ;;
        esac
    fi
    return 0
}

_channel_meta() { #@frozen 2026-09-27 m@javier.io 2e226ed
    _channel_meta_in "${1}" "${2}" #the same, printed, for a caller that wants it in a substitution
    printf "%s\\n" "${_channel_meta_in__out}"
}

###############################################################################
#################################### spec #####################################
###############################################################################

_spec_in() { #reviewed
    #$1 => a spec, eg: aqua:jq@1.7
    _spec_in__channel=""
    _spec_in__package="${1}"
    case "${1}" in
        [a-z0-9]*:*)
            _spec_in__channel="${1%%:*}"
            case "${_spec_in__channel}" in
                *[!a-z0-9-]*) _spec_in__channel="" ;;
                           *) _spec_in__package="${1#*:}" ;;
            esac ;;
    esac

    #aqua:jq@1.7
    #└─┬┘ └┬┘└┬┘
    #  │   │  └── _spec_in__version
    #  │   └───── _spec_in__package
    #  └───────── _spec_in__channel

    _spec_in__version=""
    case "${_spec_in__package}" in
        *@*) _spec_in__version="${_spec_in__package##*@}" ;;
    esac
    _spec_in__package="${_spec_in__package%%@*}"
    return 0
}

###############################################################################
################################## resolution #################################
###############################################################################

_add_timing() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => what was timed, $3 => bytes, $4 => milliseconds.
    #Appends one row to the channel's timings, read by _timings2speed and
    #_estimate_microseconds:
    #    _add_timing aqua fetch 9432104 2211  =>  fetch 9432104 2211
    #    _add_timing am install "" 18004      =>  install - 18004
    _util_is_number "${4}" || return 0
    _at__bytes="${3}"
    if ! _util_is_number "${_at__bytes}" || [ "${_at__bytes}" -eq "0" ]; then
        _at__bytes="-"
    fi
    _at__home="$(_channel_home "${1}")"
    _util_mkdir_p "${_at__home}" || return 0
    printf "%s\\t%s\\t%s\\n" "${2}" "${_at__bytes}" "${4}" >> "${_at__home}/timings"
}

_timings2speed() { #@frozen 2026-09-28 m@javier.io 2e226ed
    #$1 => a channel's timings file, $2 => what was timed. Result in bytes/sec
    #    catalog 1048576 500     _timings2speed <file> catalog => 2097152
    #    catalog 2097152 1000    _timings2speed <file> install => 1048576
    _t2s__file="${1}"
    _t2s__speed=""
    [ -f "${_t2s__file}" ] && _t2s__speed="$(awk -F'\t' -v s="${2}" '
        $1 == s && $2 ~ /^[0-9]+$/ && $2 > 0 { b[++n] = $2; m[n] = $3 }
        END {
            k = (n > 10) ? n - 9 : 1
            for (i = k; i <= n; i++) { tb += b[i]; tm += m[i] }
            if (tb > 0) { if (tm < 1) tm = 1; printf("%d\n", tb * 1000 / tm) }
        }' "${_t2s__file}")"
    printf "%s\\n" "${_t2s__speed:-1048576}"
}

_estimate_microseconds() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => bytes, $2 => channel, $3 => what was timed. Microseconds
    #    _estimate_microseconds 9432104 aqua fetch  =>  2211000
    #    _estimate_microseconds 0 aqua fetch        =>  0, already placed
    #    _estimate_microseconds "" am run           =>  the time alone, or -
    #Least squares and not a division: an install that was mostly fixed cost, read
    #as a speed, had git announced at four minutes for twenty-five seconds of work.
    #Microseconds and not ms: a ms is a thousand bytes at the speed assumed with
    #nothing on record, so 100 and 1000 bytes would both be 0 and sort the same
    if _util_is_number "${1}" && [ "${1}" -eq "0" ]; then
        printf "%s\\n" "0"
        return 0
    fi
    _eu__file="$(_channel_home "${2}")/timings"
    _eu__microseconds=""
    [ -f "${_eu__file}" ] && _eu__microseconds="$(awk -F'\t' -v s="${3}" -v b="${1}" '
        $1 == s && $3 ~ /^[0-9]+$/ { m[++n] = $3 + 0 }
        $1 == s && $2 ~ /^[0-9]+$/ && $2 > 0 { x[++p] = $2 + 0; y[p] = $3 + 0 }
        END {
            if (b !~ /^[0-9]+$/ || !p) {
                if (!n) exit
                k = (n > 10) ? n - 9 : 1
                for (i = k; i <= n; i++) t += m[i]
                printf("%d\n", t * 1000 / (n - k + 1))
                exit
            }
            k = (p > 10) ? p - 9 : 1
            lo = x[k]; hi = x[k]
            for (i = k; i <= p; i++) {
                sx += x[i]; sy += y[i]
                if (x[i] < lo) lo = x[i]
                if (x[i] > hi) hi = x[i]
            }
            #sizes too close to split: the speed, which the shell asks for
            if (hi < 2 * lo) exit
            c = p - k + 1; mx = sx / c; my = sy / c
            for (i = k; i <= p; i++) { d = x[i] - mx; sxx += d * d; sxy += d * (y[i] - my) }
            per = sxy / sxx; fixed = my - per * mx
            if (per < 0) { per = 0; fixed = my }
            else if (fixed < 0) { fixed = 0; per = sy / sx }
            printf("%d\n", (fixed + per * b) * 1000)
        }' "${_eu__file}")"
    [ -n "${_eu__microseconds}" ] && { printf "%s\\n" "${_eu__microseconds}"; return 0; }
    _util_is_number "${1}" || { printf "%s\\n" "-"; return 0; }
    awk -v b="${1}" -v s="$(_timings2speed "${_eu__file}" "${3}")" 'BEGIN { printf("%d\n", b * 1000000 / s) }'
}

_microseconds2human() { #@frozen 2026-09-28 m@javier.io 2e226ed
    #    _microseconds2human 95        =>  <0.01 s
    #    _microseconds2human 900000    =>  ~0.90 s
    #    _microseconds2human 5000000   =>  ~5 s
    #    _microseconds2human 9500000   =>  ~9.5 s
    #Under ten seconds a fraction is shown, because that is where the runtimes
    #live: they cost 100, 250, 900 and 1200 ms, and to whole seconds three of the
    #four read the same while the order puts them apart. A fraction that is all
    #zeros is not shown, saying nothing being all it does
    case "${1}" in
        ''|*[!0-9]*) printf "%s" "time unknown"; return 0 ;;
    esac
    awk -v u="${1}" 'BEGIN {
        if (u < 5000)          { printf("<0.01 s"); exit }
        if (u >= 90000000)     { printf("~%d min", (u + 30000000) / 60000000); exit }
        if (u >= 10000000)     { printf("~%d s", (u + 500000) / 1000000); exit }
        t = sprintf((u < 1000000) ? "%.2f" : "%.1f", u / 1000000)
        sub(/\.0+$/, "", t)
        printf("~%s s", t)
    }'
}

_plus_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #every amount. A dash where one of them is not a number, which is what both
    #a dash and an empty one are:
    #    _plus_in 40 2         =>  42
    #    _plus_in 40 2 600     =>  642
    #    _plus_in 9432104 ""   =>  -
    #    _plus_in 40 - 2       =>  -
    _plus_in__out="0"
    while [ "${#}" -gt "0" ]; do
        _util_is_number "${1}" || { _plus_in__out="-"; return 0; }
        _plus_in__out="$((${_plus_in__out} + ${1}))"
        shift
    done
    return 0
}

_probe2once() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => its probe. The step|label|bytes|badge entries the
    #route has to get once, a runtime's image and its engines, into
    #g_once_entries, g_once_hops, g_once_bytes and g_once_microseconds
    g_once_entries=""; g_once_hops="0"; g_once_bytes="0"; g_once_microseconds="0"
    while IFS= read -r _p2o__line; do
        case "${_p2o__line}" in *'|'*'|'*'|'*) ;; *) continue ;; esac
        _p2o__step="${_p2o__line%%|*}";  _p2o__rest="${_p2o__line#*|}"
        _p2o__label="${_p2o__rest%%|*}"; _p2o__rest="${_p2o__rest#*|}"
        _p2o__bytes="${_p2o__rest%%|*}"; _p2o__badge="${_p2o__rest#*|}"
        case "${_p2o__badge}" in *'|'*) continue ;; esac
        case "${_p2o__step}" in ''|*[!a-z]*) continue ;; esac
        [ -n "${_p2o__label}" ] || continue
        case "${_p2o__label}${_p2o__badge}" in *';'*) continue ;; esac
        _util_is_number "${_p2o__bytes}" || _p2o__bytes="-"
        _p2o__entry="${_p2o__step}|${_p2o__label}|${_p2o__bytes}|${_p2o__badge:-none}"
        _util_replace_in "${_p2o__entry}" " " ":"; _p2o__entry="${_util_replace_in__out}"
        g_once_entries="${g_once_entries:+${g_once_entries};}${_p2o__entry}"
        g_once_hops="$((${g_once_hops} + 1))"
        _plus_in "${g_once_bytes}" "${_p2o__bytes}"; g_once_bytes="${_plus_in__out}"
        _plus_in "${g_once_microseconds}" "$(_estimate_microseconds "${_p2o__bytes}" "${1}" "${_p2o__step}")"
        g_once_microseconds="${_plus_in__out}"
    done <<EOF
$(_values once "${2}")
EOF
}

_why_no_candidate() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => its probe, $3 => its status, which is not 0.
    #Prints the line that says why there is none, and answers what the
    #caller answers: 1 for nobody, 0 or 2 for a shared name nobody can pick
    case "${3}" in
        1) return 1 ;;
        3)  #which program a shared name meant is the user's to say, not ours to pick
            printf "~ambiguous %s %s\\n" "${1}" \
                "$(printf "%s\\n" "${2}" | \
                    awk '/^candidate=/ {sub(/^candidate=/, ""); printf("%s ", $0)}')"
            _channel_meta_in "${1}" confines
            [ X"${_channel_meta_in__out}" = X"yes" ] && return 2
            return 0 ;;
    esac
    #a channel that could not be asked did not say no
    _api_value_in unreachable "${2}"; _wnc__why="${_api_value_in__out}"
    if [ -z "${_wnc__why}" ]; then
        _wnc__why="it exited ${3}"
        [ X"${3}" = X"2" ] && _wnc__why="it gave no reason"
    fi
    printf "~unreachable %s %s\\n" "${1}" "${_wnc__why}"
    return 1
}

_probe2route() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => its probe, $3 => its status, $4 => the package
    #What the channel answered, written as the route line
    #eg: aqua answering version=1.0 bytes=2000 badge=none becomes
    #  000000000000000000000190701000 aqua 1.0 2000 none no self tiny - - 2000 1907 - 0

    #related _route_field_in
    _p2r__channel="${1}"; _p2r__out="${2}"; _p2r__rc="${3}"; _p2r__pkg="${4}"
    if [ "${_p2r__rc}" -ne "0" ]; then
        _why_no_candidate "${_p2r__channel}" "${_p2r__out}" "${_p2r__rc}"
        return "${?}"
    fi

    #read only of a channel that had the name: of every channel it was a process each
    _channel_meta_in "${_p2r__channel}" #optimization trick, avoid forking
    _p2r__meta="${_channel_meta_in__out}"
    #a catalog is never a route by itself, and is handed over whole
    if _has_line "${_p2r__meta}" "kind=catalog"; then
        _routes_per_runtime "${_p2r__channel}" "${_p2r__out}" "${_p2r__pkg}" "${_p2r__meta}"
        return "${?}"
    fi

    _api_value_in version "${_p2r__out}"; _p2r__version="${_api_value_in__out}"
    _api_value_in bytes "${_p2r__out}"; _p2r__bytes="${_api_value_in__out}"
    _api_value_in badge "${_p2r__out}"; _p2r__badge="${_api_value_in__out}"
    [ -z "${_p2r__version}" ] && return 1
    #a catalog that maps a name to a repository says which, and that is what is shown
    _api_value_in package "${_p2r__out}"; _p2r__package="${_api_value_in__out}"
    [ -z "${_p2r__package}" ] && _p2r__package="${_p2r__pkg}"
    #a channel that installs through a tool of its own names that tool as a spec
    _api_value_in requires "${_p2r__out}"; _p2r__requires="${_api_value_in__out}"
    [ -z "${_p2r__requires}" ] && _p2r__requires="-"

    #what a tool installs, the tool checks or does not, and cmdfound cannot tell
    #which: such a route keeps a dash and is shown via its channel, which can only
    #lower that to none. verified is only ever said of what cmdfound checked
    #itself, and via another channel names who never saw the package
    if [ X"${_p2r__requires}" != X"-" ]; then
        [ X"${_p2r__badge}" = X"none" ] || _p2r__badge="-"
    elif [ -z "${_p2r__badge}" ]; then
        _p2r__badge="none"
    fi
    #a size the channel could only estimate is said to be one wherever it is shown
    _api_value_in estimate "${_p2r__out}"; _p2r__estimate="${_api_value_in__out}"
    [ X"${_p2r__estimate}" = X"yes" ] || _p2r__estimate="-"

    _api_value_in confines "${_p2r__meta}"; _p2r__conf="${_api_value_in__out}"
    [ -z "${_p2r__conf}" ] && _p2r__conf="no"
    _api_value_in describes "${_p2r__meta}"; _p2r__desc="${_api_value_in__out}"
    [ -z "${_p2r__desc}" ] && _p2r__desc="self"
    _p2r__class="0"
    [ X"${_p2r__conf}" = X"yes" ] && _p2r__class="1"

    #marginal bytes: what is already placed costs nothing to place again. A fetch
    #and an install are timed apart, since a tool that unpacks takes longer per byte
    _p2r__marginal="${_p2r__bytes}"
    [ -e "$(_channel_home "${_p2r__channel}")/by/${_p2r__package}/${_p2r__version}" ] && _p2r__marginal="0"
    _p2r__step="fetch"; [ X"${_p2r__requires}" != X"-" ] && _p2r__step="install"
    _p2r__ms="$(_estimate_microseconds "${_p2r__marginal}" "${_p2r__channel}" "${_p2r__step}")"

    #and what is still missing includes the tool the channel installs through,
    #which is also the hop
    _p2r__hops="0"
    if [ X"${_p2r__requires}" != X"-" ] && ! _tool_placed "${_p2r__channel}" >/dev/null; then
        _p2r__hops="1"
        _spec_bytes_in "${_p2r__requires}"
        _p2r__requires_bytes="${_spec_bytes_in__out}"
        _plus_in "${_p2r__marginal}" "${_p2r__requires_bytes}"; _p2r__marginal="${_plus_in__out}"
        _plus_in "${_p2r__ms}" \
            "$(_estimate_microseconds "${_p2r__requires_bytes}" "${_p2r__channel}" "tool")"
        _p2r__ms="${_plus_in__out}"
    fi

    #and whatever else the channel says it gets once, each of them a hop
    _probe2once "${_p2r__channel}" "${_p2r__out}"
    _p2r__once="${g_once_entries}"
    if [ -n "${_p2r__once}" ]; then
        _p2r__hops="$((${_p2r__hops} + ${g_once_hops}))"
        [ "${_p2r__hops}" -gt "9" ] && _p2r__hops="9"
        _plus_in "${_p2r__marginal}" "${g_once_bytes}"; _p2r__marginal="${_plus_in__out}"
        _plus_in "${_p2r__ms}" "${g_once_microseconds}"; _p2r__ms="${_plus_in__out}"
    fi

    #a route is quicker by class first, then by what a run of it costs, then by the
    #time it should take here, then by hops. Class before time is the ruling: no
    #saving buys being put inside a container. A time nobody can estimate sorts
    #last within its class. Ties go in the order channels.conf names the channels,
    #four digits closing the key; with no file those digits are equal and the name
    #after the key decides, as it did before there was a file to go by
    case "${_p2r__ms}" in
        ''|*[!0-9]*) _p2r__key="99999999999999" ;;
                  *) _p2r__key="$(printf "%014d" "${_p2r__ms}")" ;;
    esac
    _channel_position "${_p2r__channel}"

    #every field is written, a dash standing for nothing: the line is read back by
    #position, and an empty one would slide every field after it to the left
    printf "%s %s %s %s %s %s %s %s %s %s %s %s %s %s\\n" \
        "${_p2r__class}0000000000${_p2r__key}${_p2r__hops}${g_channel_position}" "${_p2r__channel}" \
        "${_p2r__version}" "${_p2r__bytes:--}" "${_p2r__badge}" \
        "${_p2r__conf}" "${_p2r__desc}" \
        "${_p2r__package}" "${_p2r__requires}" "${_p2r__estimate}" "${_p2r__marginal:--}" "${_p2r__ms:--}" \
        "${_p2r__once:--}" "0"
    [ X"${_p2r__conf}" = X"yes" ] && return 2
    return 0
}

_routes_per_runtime() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a catalog, $2 => its probe, $3 => the package, $4 => what the catalog
    #says of itself. A catalog is never a route by itself: what it has runs
    #inside an image, and each runtime here that can run it is one route to it
    #    a route printed for each runtime  =>  2
    #    nothing here can run the image    =>  3
    #    the catalog did not have it       =>  1
    _rpr__catalog="${1}"; _rpr__out="${2}"
    _rpr__version="$(_value version "${_rpr__out}")"
    [ -z "${_rpr__version}" ] && return 1
    _rpr__bytes="$(_value bytes "${_rpr__out}")"
    _rpr__package="$(_value package "${_rpr__out}")"
    [ -z "${_rpr__package}" ] && _rpr__package="${3}"
    _rpr__est="$(_value estimate "${_rpr__out}")"
    [ X"${_rpr__est}" = X"yes" ] || _rpr__est="-"
    _rpr__describes="$(_value describes "${4}")"
    [ -z "${_rpr__describes}" ] && _rpr__describes="self"
    _rpr__image="$(_value image "${_rpr__out}")"
    _rpr__image_bytes="$(_value image_bytes "${_rpr__out}")"
    if [ -z "${_rpr__image}" ]; then
        printf "~unrunnable %s %s\\n" "${_rpr__catalog}" "it named no image to run it in"
        return 3
    fi

    #a runtime that requires deps not available locally is last, and only when no other alternative exists
    _rpr__ready=""; _rpr__later=""
    for _rpr__runtime in $(_channels); do
        [ -n "${CMDFOUND_RUNTIME}" ] && [ X"${CMDFOUND_RUNTIME}" != X"${_rpr__runtime}" ] && continue
        [ X"$(_value kind "$(_api_channel "${_rpr__runtime}" meta 2>/dev/null)")" = X"runtime" ] || continue
        if _needs_here "${_rpr__runtime}"; then
            _rpr__ready="${_rpr__ready} ${_rpr__runtime}"
        else
            _rpr__later="${_rpr__later} +${_rpr__runtime}"
        fi
    done

    _rpr__any=""; _rpr__why=""
    for _rpr__entry in ${_rpr__ready} ${_rpr__later}; do
        _rpr__runtime="${_rpr__entry#+}"
        if [ X"${_rpr__runtime}" != X"${_rpr__entry}" ]; then
            [ -n "${_rpr__any}" ] && break
            if ! _obtain_needs "${_rpr__runtime}" "runtime"; then
                _rpr__missing=""
                for _rpr__need in $(_needs "${_rpr__runtime}"); do
                    [ -x "$(_channel_home "${_rpr__runtime}")/needs/${_rpr__need}" ] && continue
                    command -v "${_rpr__need}" >/dev/null 2>&1 && continue
                    _rpr__missing="${_rpr__missing} ${_rpr__need}"
                done
                _and_in ${_rpr__missing}; _rpr__missing="${_and_in__out}"
                if [ -z "${_rpr__missing}" ]; then
                    _rpr__rwhy="what it runs programs with could not be had"
                elif [ -n "${g_dry_run}" ]; then
                    _rpr__rwhy="${_rpr__missing} is not here, and a dry run does not get it"
                else
                    _rpr__rwhy="${_rpr__missing} could not be had"
                fi
                printf "~unavailable %s %s\\n" "${_rpr__runtime}" "${_rpr__rwhy}"
                _rpr__why="${_rpr__why:+${_rpr__why}; }${_rpr__runtime}: ${_rpr__rwhy}"
                continue
            fi
        fi

        #the image is also what tells the runtime that the resolver is asking and not a
        #user: a package of a catalog is answered only then
        _rpr__rout="$(PATH="$(_channel_home "${_rpr__runtime}")/needs:${PATH}" \
            CMDFOUND_IMAGE="${_rpr__image}" CMDFOUND_IMAGE_BYTES="${_rpr__image_bytes}" \
            _api_channel "${_rpr__runtime}" probe "${_rpr__catalog}/${_rpr__package}" "${_rpr__version}" 2>/dev/null)"
        case "${?}" in
            0) ;;
            2)  #a runtime that is not there hides a way to run the program and
                #not the program, and is said apart from a channel not asked
                _rpr__rwhy="$(_value unreachable "${_rpr__rout}")"
                printf "~unavailable %s %s\\n" "${_rpr__runtime}" "${_rpr__rwhy:-it gave no reason}"
                _rpr__why="${_rpr__why:+${_rpr__why}; }${_rpr__runtime}: ${_rpr__rwhy:-it gave no reason}"
                continue ;;
            *)  _rpr__why="${_rpr__why:+${_rpr__why}; }${_rpr__runtime}: it cannot run it"
                continue ;;
        esac

        _rpr__req="$(_value requires "${_rpr__rout}")"
        [ -z "${_rpr__req}" ] && _rpr__req="-"
        _rpr__marginal="${_rpr__bytes}"
        [ -e "$(_channel_home "${_rpr__runtime}")/by/${_rpr__catalog}/${_rpr__package}/${_rpr__version}" ] && _rpr__marginal="0"
        _rpr__ms="$(_estimate_microseconds "${_rpr__marginal}" "${_rpr__runtime}" "install")"
        _rpr__hops="0"
        if [ X"${_rpr__req}" != X"-" ] && ! _tool_placed "${_rpr__runtime}" >/dev/null; then
            _rpr__hops="1"
            _spec_bytes_in "${_rpr__req}"
            _rpr__requires_bytes="${_spec_bytes_in__out}"
            _plus_in "${_rpr__marginal}" "${_rpr__requires_bytes}"; _rpr__marginal="${_plus_in__out}"
            _plus_in "${_rpr__ms}" "$(_estimate_microseconds "${_rpr__requires_bytes}" "${_rpr__runtime}" "tool")"
            _rpr__ms="${_plus_in__out}"
        fi
        _probe2once "${_rpr__runtime}" "${_rpr__rout}"
        _rpr__once="${g_once_entries}"
        _rpr__hops="$((${_rpr__hops} + ${g_once_hops}))"
        _plus_in "${_rpr__marginal}" "${g_once_bytes}"; _rpr__marginal="${_plus_in__out}"
        _plus_in "${_rpr__ms}" "${g_once_microseconds}"; _rpr__ms="${_plus_in__out}"
        [ "${_rpr__hops}" -gt "9" ] && _rpr__hops="9"

        #what a run costs before the program starts. It sorts before the time getting
        #there takes, which is paid once, while a decision remembered runs for ever
        _rpr__run="$(_estimate_microseconds "" "${_rpr__runtime}" "run")"
        if ! _util_is_number "${_rpr__run}"; then
            _rpr__run="-"
            _rpr__run_ms="$(_value run_ms "${_rpr__rout}")"
            _util_is_number "${_rpr__run_ms}" && _rpr__run="$((${_rpr__run_ms} * 1000))"
        fi
        _rpr__run_key="${_rpr__run}"; _rpr__time_key="${_rpr__ms}"
        { _util_is_number "${_rpr__run_key}" && [ "${_rpr__run_key}" -le "9999999999" ]; } || _rpr__run_key="9999999999"
        _util_is_number "${_rpr__time_key}" || _rpr__time_key="99999999999999"
        #the order inside the dockerized class, and the one place it is set: what a run
        #costs first, then the time getting there, then hops, so the quickest to run
        #wins however much it has to fetch once.
        _rpr__first="${_rpr__run_key}"
        _rpr__key="$(awk -v r="${_rpr__first}" -v t="${_rpr__time_key}" 'BEGIN {printf("%010d%014d", r, t)}')"
        _channel_position "${_rpr__runtime}"

        printf "%s %s %s %s %s %s %s %s %s %s %s %s %s %s\\n" \
            "1${_rpr__key}${_rpr__hops}${g_channel_position}" "${_rpr__runtime}" \
            "${_rpr__version}" "${_rpr__bytes:--}" "via:${_rpr__catalog}" \
            "yes" "${_rpr__describes}" \
            "${_rpr__catalog}/${_rpr__package}" "${_rpr__req}" "${_rpr__est}" "${_rpr__marginal:--}" "${_rpr__ms:--}" \
            "${_rpr__once:--}" "${_rpr__run}"
        _rpr__any="1"
    done

    [ -n "${_rpr__any}" ] && return 2
    printf "~unrunnable %s %s\\n" "${_rpr__catalog}" "${_rpr__why:-no runtime channel is here}"
    return 3
}

_needs() { #@frozen 2026-09-28 m@javier.io 2e226ed
    #$1 => channel. Each program its index runs, one a line, from meta's needs=
    _channel_meta "${1}" needs | tr ',' '\n' | awk 'NF'
}

_needs_here() { #@reviewed 2026-09-28 m@javier.io 2e226ed
    #$1 => channel. Answers 0 when every program its index depends on is available.
    for _nh__need in $(_needs "${1}"); do
        [ -x "$(_channel_home "${1}")/needs/${_nh__need}" ] && continue
        command -v "${_nh__need}" >/dev/null 2>&1 && continue
        return 1
    done
    return 0
}

_obtain_needs() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => runtime
    #check if a channel meta needs= parameter is locally available, if not
    #uses cmdfound to retrieve it. eg: nix-portable needs=sqlite3
    if [ X"${2}" = X"runtime" ]; then
        _obn__uses="runs programs with"; _obn__not="so it is not asked"
        _obn__cannot="so it cannot run anything"
    else
        _obn__uses="reads its catalog with"; _obn__not="so its catalog is not read"
        _obn__cannot="so its catalog cannot be read"
    fi
    for _obn__need in $(_needs "${1}"); do
        if ! _api_is_program_name "${_obn__need}"; then
            _msg "${PROGNAME}: ${1} needs '${_obn__need}', which is not a program's name"
            return 1
        fi
        _obn__link="$(_channel_home "${1}")/needs/${_obn__need}"
        [ -x "${_obn__link}" ] && continue
        command -v "${_obn__need}" >/dev/null 2>&1 && continue
        #one already got, for this channel or by name, is taken without a word
        _obn__program="$(_remembered_program "${_obn__need}" "${_obn__need}")" || _obn__program=""
        if [ -z "${_obn__program}" ]; then
            _msg "${PROGNAME}: ${1} ${_obn__uses} ${_obn__need}, which is not here"
            if [ -n "${g_dry_run}" ]; then
                _msg "${PROGNAME}: ${1}: ${_obn__need} is not got in a dry run, ${_obn__not}"
                return 1
            fi
            _obn__program="$(CMDFOUND_WITHOUT="${CMDFOUND_WITHOUT:+${CMDFOUND_WITHOUT} }${1}"
                export CMDFOUND_WITHOUT
                _obtained "${_obn__need}" "${_obn__need}" "${_obn__need}" "")" && \
                [ -n "${_obn__program}" ] || {
                _msg "${PROGNAME}: ${1}: ${_obn__need} could not be had, ${_obn__cannot}"
                return 1
            }
        fi
        _util_mkdir_p "${_obn__link%/*}" && rm -f "${_obn__link}" && \
            ln -s "${_obn__program}" "${_obn__link}" 2>/dev/null || return 1
    done
    return 0
}

_catalog_bytes() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a channel whose catalog is about to be fetched. Sets g_catalog_bytes
    g_catalog_bytes="$(PATH="$(_channel_home "${1}")/needs:${PATH}" \
        _api_channel "${1}" index bytes 2>/dev/null | \
        awk -F= '$1 == "bytes" {print $2; exit}')"
    _util_is_number "${g_catalog_bytes}" || g_catalog_bytes=""
}

_fetching_says() { #@reviewed 2026-09-28 m@javier.io 2e226ed
    #$1 => how the sentence begins, $2 => how it ends, $3 => "of" to name them as
    #"the catalog of x", then every catalog about to be fetched. Says what is being
    #fetched and how much each downloads where that can be asked:
    #    _fetching_says "fetching " "" "" aqua        =>  fetching aqua's catalog (1.4 MB)
    #    _fetching_says "fetching " "" "" aqua pkgx   =>  fetching the catalogs of aqua (1.4 MB) and pkgx
    #    _fetching_says "getting " " first" "of" aqua =>  getting catalog of aqua (1.4 MB) first
    [ -n "${g_quiet}" ] && return 0
    _fs__head="${1}"; _fs__tail="${2}"; _fs__of="${3}"; shift 3
    _fs__count="${#}"
    #each channel is taken out of the arguments and put back with its size, so
    #that what is left in them is the list the sentence names
    for _fs__channel in "${@}"; do
        shift
        _catalog_bytes "${_fs__channel}"
        _fs__size="${g_catalog_bytes:+ ($(_bytes2human "${g_catalog_bytes}"))}"
        _fs__item="${_fs__channel}${_fs__size}"
        #one catalog is its channel's, and several are the catalogs of them
        [ "${_fs__count}" -eq "1" ] && [ -z "${_fs__of}" ] && \
            _fs__item="${_fs__channel}'s catalog${_fs__size}"
        set -- "${@}" "${_fs__item}"
    done
    _and_in "${@}"; _fs__out="${_and_in__out}"
    #where the sentence put an adjective before the noun, the article is the sentence's
    if [ -n "${_fs__of}" ]; then
        _fs__plural="s"; [ "${_fs__count}" -eq "1" ] && _fs__plural=""
        _fs__out="catalog${_fs__plural} of ${_fs__out}"
    elif [ "${_fs__count}" -gt "1" ]; then
        _fs__out="the catalogs of ${_fs__out}"
    fi
    _msg "${PROGNAME}: ${_fs__head}${_fs__out}${_fs__tail}"
}

_confines() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => a channel. _confines docker => 0, _confines aqua => 1
    _channel_meta_in "${1}" confines
    [ X"${_channel_meta_in__out}" = X"yes" ]
}

_first_catalogs() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => package, $2 => version, $3 => 1 when a catalog that confines has the
    #name already, then the channels whose catalog is not here. Answers 0 when
    #one of them has it

    #the ones whose catalog reads with a program already here go first, all at
    #once: one of them may have the name and make fetching another's program
    #needless. An answer from a catalog that confines does not end it
    _fc__pkg="${1}"; _fc__version="${2}"; _fc__confined="${3}"; shift 3
    _fc__ready=""; _fc__waiting=""
    for _fc__channel in "${@}"; do
        [ -n "${_fc__confined}" ] && _confines "${_fc__channel}" && continue
        if _needs_here "${_fc__channel}"; then
            _fc__ready="${_fc__ready} ${_fc__channel}"
        else
            _fc__waiting="${_fc__waiting} ${_fc__channel}"
        fi
    done

    #the ones that can go now go together
    if [ -n "${_fc__ready}" ]; then
        if [ -n "${_fc__confined}" ]; then
            _fetching_says "'${_fc__pkg}' is only in a dockerized local catalog; fetching the native " \
                " first" "of" ${_fc__ready}
        else
            _fetching_says "no local catalog has '${_fc__pkg}'; fetching " "" "" ${_fc__ready}
        fi
        for _fc__channel in ${_fc__waiting}; do
            _msg "${PROGNAME}: ${_fc__channel} goes after them, its catalog is read with a program not here yet"
        done
        _race_catalogs "${_fc__pkg}" "${_fc__version}" ${_fc__ready}
        case "${?}" in
            0) return 0 ;;
            2) _fc__confined="1" ;;
        esac
    fi

    #and then, one at a time, the ones whose program has to be got first
    for _fc__channel in ${_fc__waiting}; do
        if [ -n "${_fc__confined}" ] && _confines "${_fc__channel}"; then
            _msg "${PROGNAME}: ${_fc__channel} is not read after all: it confines, and one that confines has '${_fc__pkg}' already"
            continue
        fi
        if ! _obtain_needs "${_fc__channel}"; then
            printf "~unreachable %s %s\\n" "${_fc__channel}" "a program its catalog is read with could not be had"
            continue
        fi
        _fetching_says "fetching " "" "" "${_fc__channel}"
        _race_catalogs "${_fc__pkg}" "${_fc__version}" "${_fc__channel}"
        case "${?}" in
            0) return 0 ;;
            2) _fc__confined="1" ;;
        esac
    done
    [ -n "${_fc__confined}" ]
}

_and_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #A loop, because awk is a process:
    #    _and_in aqua pkgx nix-portable  =>  aqua, pkgx and nix-portable
    _and_in__out=""
    [ "${#}" -eq "0" ] && return 0
    _and_in__out="${1}"; shift
    while [ "${#}" -gt "1" ]; do
        _and_in__out="${_and_in__out}, ${1}"; shift
    done
    [ "${#}" -eq "1" ] && _and_in__out="${_and_in__out} and ${1}"
    return 0
}

_catalog_fetch_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #$1 => a catalog fetch in flight, written channel:pid:milliseconds:
    #    _catalog_fetch_in aqua:31424:1759178400123  =>  aqua, 31424, 1759178400123
    _catalog_fetch_in__channel="${1%%:*}"
    _cfi__rest="${1#*:}"
    _catalog_fetch_in__pid="${_cfi__rest%%:*}"
    _catalog_fetch_in__started="${_cfi__rest#*:}"
    return 0
}

_after_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #$1 => a list, $2 => one of its items. A loop, because awk is a process:
    #    _after_in "aqua pkgx am" pkgx  =>  am
    #    _after_in "aqua pkgx am" am    =>
    _after_in__out=""
    _ai__seen=""
    for _ai__item in ${1}; do
        [ -n "${_ai__seen}" ] && \
            _after_in__out="${_after_in__out:+${_after_in__out} }${_ai__item}"
        [ X"${_ai__item}" = X"${2}" ] && _ai__seen="1"
    done
    return 0
}

_index2oneline_in() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => its key=value lines. A loop, because awk is a process:
    #    packages=41231 updated=2026-09-01  =>  41231 packages, 2026-09-01 updated
    _index2oneline_in__out=""
    _i2o__rest="${1}"
    while [ -n "${_i2o__rest}" ]; do
        _i2o__line="${_i2o__rest%%${NL}*}"
        case "${_i2o__line}" in
            #the bytes were said before the fetch, and a line with a second = is
            #a value whose shape only the channel knows
            bytes=*|*=*=*) ;;
            *=*) _i2o__pair="${_i2o__line#*=} ${_i2o__line%%=*}"
                 _index2oneline_in__out="${_index2oneline_in__out:+${_index2oneline_in__out}, }${_i2o__pair}" ;;
        esac
        [ X"${_i2o__line}" = X"${_i2o__rest}" ] && break
        _i2o__rest="${_i2o__rest#*${NL}}"
    done
    return 0
}

_pause_others() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => _probe2route status, then the fetches still in flight. Stops each
    #and keeps whatever arrived, so the next run does not fetch it again.

    #When the channel winner is dockerized, the native channels are not paused,
    #otherwise it stops as a native bin wins always
    #  WINNER             native (0)    dockerized (2)
    #                 ┌──────────────┬───────────────┐
    #  this channel   │    paused    │  left going   │
    #  is native      │              │               │
    #                 ├──────────────┼───────────────┤
    #  this channel   │    paused    │    paused     │
    #  confines       │              │               │
    #                 └──────────────┴───────────────┘
    _pause_others__paused=""; _pause_others__going=""; _pause_others__native=""
    _po__had="${1}"; shift
    for _po__entry in "${@}"; do
        _catalog_fetch_in "${_po__entry}"
        _po__channel="${_catalog_fetch_in__channel}"
        _po__pid="${_catalog_fetch_in__pid}"
        _po__started="${_catalog_fetch_in__started}"
        if [ "${_po__had}" -eq "2" ] && ! _confines "${_po__channel}"; then
            _pause_others__going="${_pause_others__going:+${_pause_others__going} }${_po__entry}"
            _pause_others__native="${_pause_others__native:+${_pause_others__native} }${_po__channel}"
            continue
        fi
        if kill -0 "${_po__pid}" 2>/dev/null; then
            kill "${_po__pid}" 2>/dev/null
            wait "${_po__pid}" 2>/dev/null
            _pause_others__paused="${_pause_others__paused:+${_pause_others__paused}, }${_po__channel}"
        elif wait "${_po__pid}" 2>/dev/null; then
            #one that arrived meanwhile is kept, and what it took written down
            _po__said="$(cat "${g_home}/tmp/index.$$.${_po__channel}" 2>/dev/null)"
            _api_value_in bytes "${_po__said}"
            _add_timing "${_po__channel}" "catalog" "${_api_value_in__out}" \
                "$(( $(_util_now_ms) - ${_po__started} ))"
        fi
        rm -f "${g_home}/tmp/index.$$.${_po__channel}"
    done
    return 0
}

_race_catalogs() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => package, $2 => version, then channels whose catalogs can be fetched now
    #    a native catalog had the name     =>  0
    #    only one that confines had it     =>  2
    #    none of them had it               =>  1
    _rc__pkg="${1}"; _rc__version="${2}"; shift 2
    _util_mkdir_p "${g_home}/tmp" || return 1
    _rc__confined=""

    #every catalog is asked for at once, each writing into a slot of its own
    _rc__run=""
    for _rc__channel in "${@}"; do
        #the channel itself runs in the background, not a shell around it, so
        #that stopping it stops the download
        PATH="$(_channel_home "${_rc__channel}")/needs:${PATH}" \
            _api_channel "${_rc__channel}" index > "${g_home}/tmp/index.$$.${_rc__channel}" 2>/dev/null &
        _rc__run="${_rc__run} ${_rc__channel}:${!}:$(_util_now_ms)"
    done

    #and they are read in whatever order they arrive
    while [ -n "${_rc__run}" ]; do
        _rc__left=""
        for _rc__entry in ${_rc__run}; do
            _catalog_fetch_in "${_rc__entry}"
            _rc__channel="${_catalog_fetch_in__channel}"
            _rc__pid="${_catalog_fetch_in__pid}"
            _rc__started="${_catalog_fetch_in__started}"
            if kill -0 "${_rc__pid}" 2>/dev/null; then
                _rc__left="${_rc__left} ${_rc__entry}"
                continue
            fi

            wait "${_rc__pid}"; _rc__rc="${?}"
            _rc__said="$(cat "${g_home}/tmp/index.$$.${_rc__channel}" 2>/dev/null)"
            rm -f "${g_home}/tmp/index.$$.${_rc__channel}"
            if [ "${_rc__rc}" -ne "0" ]; then
                _api_value_in unreachable "${_rc__said}"; _rc__why="${_api_value_in__out}"
                _msg "${PROGNAME}: ${_rc__channel}'s catalog was not fetched, ${_rc__why:-it gave no reason}"
                printf "~unreachable %s %s\\n" "${_rc__channel}" "${_rc__why:-its catalog could not be fetched}"
                continue
            fi

            #what the catalog cost is kept for the estimator alone: by the time
            #there is a question those bytes are gone either way
            _api_value_in bytes "${_rc__said}"; _rc__bytes="${_api_value_in__out}"
            _add_timing "${_rc__channel}" "catalog" "${_rc__bytes}" "$(( $(_util_now_ms) - ${_rc__started} ))"
            _index2oneline_in "${_rc__said}"
            _msg "${PROGNAME}: ${_rc__channel}: ${_index2oneline_in__out}"

            #${?} is the probe's own status, which tells a channel that said no
            #from one that could not be asked, so nothing comes between the two
            _rc__probe="$(_api_channel "${_rc__channel}" probe "${_rc__pkg}" "${_rc__version}" 2>/dev/null)"
            _probe2route "${_rc__channel}" "${_rc__probe}" "${?}" "${_rc__pkg}"
            _rc__had="${?}"
            case "${_rc__had}" in
                1)  _msg "${PROGNAME}: ${_rc__channel} has nothing called '${_rc__pkg}'"
                    continue ;;
                #a catalog that has it with nothing here to run it is no answer either
                3)  _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}', and nothing here can run it"
                    continue ;;
            esac

            #the answer is here: the ones this pass passed over and the ones it
            #has not reached yet are stopped, keeping what arrived
            _after_in "${_rc__run}" "${_rc__entry}"
            _pause_others "${_rc__had}" ${_rc__left} ${_after_in__out}
            _rc__paused="${_pause_others__paused}"
            _rc__native="${_pause_others__native}"
            if [ "${_rc__had}" -eq "0" ]; then
                [ -n "${_rc__paused}" ] && \
                    _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}'; ${_rc__paused} paused, to go on when needed"
                return 0
            fi
            _and_in ${_rc__native}
            _msg "${PROGNAME}: ${_rc__channel} has '${_rc__pkg}', dockerized${_rc__paused:+; ${_rc__paused} paused, to go on when needed}${_rc__native:+; reading the native ${_and_in__out} first}"
            #what is left is native; the ones not read this time are read the next
            _rc__confined="1"
            _rc__left="${_pause_others__going}"
            break
        done
        _rc__run="${_rc__left}"
        [ -n "${_rc__run}" ] && { sleep 0.1 2>/dev/null || sleep 1; }
    done
    [ -n "${_rc__confined}" ] && return 2
    return 1
}

_runtime_spec_in() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #$1 => a spec's channel, $2 => its package. Answers runtime, channel, package:
    #    _runtime_spec_in udocker alpine/jq  =>  udocker  alpine   jq
    #    _runtime_spec_in aqua jqlang/jq     =>           aqua     jqlang/jq
    #    _runtime_spec_in udocker udocker    =>           udocker  udocker
    _runtime_spec_in__runtime=""
    _runtime_spec_in__channel="${1}"
    _runtime_spec_in__package="${2}"
    case "${2}" in
        ?*/?*) [ -n "${1}" ] || return 0 ;;
            *) return 0 ;;
    esac
    _channel_meta_in "${1}" kind
    [ X"${_channel_meta_in__out}" = X"runtime" ] || return 0
    _runtime_spec_in__runtime="${1}"
    _runtime_spec_in__channel="${2%%/*}"
    _runtime_spec_in__package="${2#*/}"
    return 0
}

_probe_all() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #_probe_all jq 1.7 aqua
    #           └┬┘└┬┘ └─┬┘
    #             │  │    └── ask only this one, empty to ask every channel
    #             │  └─────── version
    #             └────────── package

    #the group is piped into sort, so it is a subshell: what is exported in it
    #reaches the probes below and nothing after this function
    _pa__package="${1}"; _pa__version="${2}"; _pa__only="${3}"
    {
        #udocker:alpine/jq is run by that runtime and no other. Cleared
        #otherwise, so no variable left in the environment narrows a resolution
        unset CMDFOUND_RUNTIME
        _runtime_spec_in "${_pa__only}" "${_pa__package}"
        if [ -n "${_runtime_spec_in__runtime}" ]; then
            CMDFOUND_RUNTIME="${_runtime_spec_in__runtime}"; export CMDFOUND_RUNTIME
            _pa__only="${_runtime_spec_in__channel}"
            _pa__package="${_runtime_spec_in__package}"
        fi

        #a channel is told when the spec named it: conda-forge, with no map from
        #a command to its package, answers only then
        if [ -n "${_pa__only}" ]; then
            CMDFOUND_NAMED="${_pa__only}"; export CMDFOUND_NAMED
        else
            unset CMDFOUND_NAMED
        fi

        #each channel in turn, and what it answered handed to _probe2route
        _pa__catalog=""; _pa__native=""; _pa__confined=""; _pa__missing=""
        for _pa__channel in $(_channels); do
            [ -n "${_pa__only}" ] && \
                [ X"${_pa__only}" != X"${_pa__channel}" ] && continue
            #a runtime was named, so only the catalogs it can run are worth asking
            if [ -n "${CMDFOUND_RUNTIME}" ]; then
                _channel_meta_in "${_pa__channel}" kind
                [ X"${_channel_meta_in__out}" = X"catalog" ] || continue
                _pa__catalog="1"
            fi
            _pa__said="$(_api_channel "${_pa__channel}" probe \
                "${_pa__package}" "${_pa__version}" 2>/dev/null)"
            _pa__rc="${?}"

            #read in the shell alone: a grep here is two more processes for
            #every channel with no catalog
            if [ "${_pa__rc}" -eq "2" ] && \
               _has_line "${_pa__said}" "needs=index"; then
                _pa__missing="${_pa__missing} ${_pa__channel}"
                continue
            fi

            _probe2route "${_pa__channel}" "${_pa__said}" "${_pa__rc}" \
                "${_pa__package}"
            case "${?}" in
                0) _pa__native="1" ;;
                2) _pa__confined="1" ;;
            esac
        done

        #a catalog the spec named that is not here is nothing to ask, not a failed ask
        if [ -n "${CMDFOUND_RUNTIME}" ] && [ -z "${_pa__catalog}" ]; then
            printf "~nocatalog %s %s\\n" "${CMDFOUND_RUNTIME}" "${_pa__only}"
        fi

        #the catalogs with no index race for one, each an argument of its own,
        #and only where nothing native turned up: an index costs to fetch
        if [ -z "${_pa__native}" ] && [ -n "${_pa__missing}" ]; then
            _first_catalogs "${_pa__package}" "${_pa__version}" \
                "${_pa__confined}" ${_pa__missing}
        fi
    } | LC_ALL=C sort
}

_spec_bytes_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => any spec that names its channel, its bytes or nothing.
    #    _spec_bytes_in aqua:aquaproj/aqua@2.53.1  =>  7340032
    _spec_bytes_in__out=""
    case "${_spec_bytes_memo}" in
        *"${NL}${1} "*) _sbi__remembered="${_spec_bytes_memo#*"${NL}${1} "}"
                 _sbi__remembered="${_sbi__remembered%%${NL}*}"
                 [ X"${_sbi__remembered}" = X"-" ] || _spec_bytes_in__out="${_sbi__remembered}"
                 return 0 ;;
    esac

    #the spec names its channel, and the channel is told so, as in _probe_all
    _spec_in "${1}"
    _sbi__channel="${_spec_in__channel}"; _sbi__package="${_spec_in__package}"
    _sbi__said="$(CMDFOUND_NAMED="${_sbi__channel}" _api_channel "${_sbi__channel}" probe \
        "${_sbi__package}" "" 2>/dev/null)"
    _api_value_in bytes "${_sbi__said}"; _sbi__bytes="${_api_value_in__out}"
    _util_is_number "${_sbi__bytes}" || _sbi__bytes=""

    _spec_bytes_memo="${_spec_bytes_memo}${NL}${1} ${_sbi__bytes:--}"
    _spec_bytes_in__out="${_sbi__bytes}"
    return 0
}

_tty() { #@frozen 2026-10-01 m@javier.io 2e226ed
    ( : > /dev/tty ) 2>/dev/null
}

_confirm() { #@reviewed 2026-09-28 m@javier.io 2e226ed
    #the question goes to the terminal: stdin belongs to the program being resolved
    [ -n "${g_assume_yes}" ] && return 0

    if _tty; then
        printf "%s" "${1} [y/N] " > /dev/tty
        read -r _confirm__answer < /dev/tty || return 1
        case "${_confirm__answer}" in
            y|Y|yes|YES) return 0 ;;
            *) return 1 ;;
        esac
    fi

    #spending bytes without being able to say so is the one thing this must not do
    _msg "${PROGNAME}: no terminal to ask on, and nothing was downloaded"
    _msg "${PROGNAME}: pass --yes if this is meant to run unattended"
    return 1
}

_ask_which() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the name, $2 => one channel:package per line. Prints the choice
    _tty || return 1
    [ -n "${g_assume_yes}" ] && return 1

    printf "%s\\n" "${PROGNAME}: '${1}' is the name of more than one program:" > /dev/tty
    printf "%s\\n" "${2}" | awk 'NF {printf("  %d) %s\n", NR, $0)}' > /dev/tty
    printf "%s" "which one? [number, anything else cancels] " > /dev/tty
    read -r _ask_which__answer < /dev/tty || return 1
    _util_is_number "${_ask_which__answer}" || return 1
    _ask_which__pick="$(printf "%s\\n" "${2}" | awk -v n="${_ask_which__answer}" 'NF && NR == n {print; exit}')"
    [ -z "${_ask_which__pick}" ] && return 1
    printf "%s\\n" "${_ask_which__pick}"
}

_find_program() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a store directory, $2 => the name asked for.
    #    _find_program store jq  =>  store/jq-1.7/bin/jq
    [ -x "${1}/${2}" ] && { printf "%s\\n" "${1}/${2}"; return 0; }

    #the first one find walks to. Cut in the shell, since head is a process
    _fp__named="$(find "${1}" -type f -name "${2}" -perm -u+x 2>/dev/null)"
    if [ -n "${_fp__named}" ]; then
        printf "%s\\n" "${_fp__named%%${NL}*}"
        return 0
    fi

    #one executable and no name to go by: it can only be the program. Two, with
    #neither named for it, is a guess worth less than saying nothing
    _fp__all="$(find "${1}" -type f -perm -u+x 2>/dev/null)"
    _util_is_one_line "${_fp__all}" || return 1
    printf "%s\\n" "${_fp__all}"
    return 0
}

_channel_home() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => channel. Everything a channel has here lives under one directory.
    #Removing it removes the channel
    printf "%s\\n" "${g_home}/channels/${1}"
}

_inventory_add() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #    2026-10-01T09:14:02  aqua:jqlang/jq@1.7  9f2cd8...  verified  https://...
    printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$(date +%Y-%m-%dT%H:%M:%S)" \
        "${2}" "${3}" "${4}" "${5}" >> "${1}/inventory"
}

_fetcher_timed() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => what a timing calls this one, $3 => url, $4 => its sha256 (optional).
    _ft__started="$(_util_now_ms)"
    _api_fetcher_verified "${3}" "${4}" || return 1
    _add_timing "${1}" "${2}" "$(wc -c < "${g_fetched}" | awk '{print $1}')" \
        "$(( $(_util_now_ms) - _ft__started ))"
    return 0
}

_where_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a locate answer, $2 => the package
    #    url=https://h/jq.gz format=gz bin=jq sha256=9f2c  =>  https://h/jq.gz, gz, jq, 9f2c, verified
    _api_value_in url    "${1}"; _where_in__url="${_api_value_in__out}"
    _api_value_in format "${1}"; _where_in__format="${_api_value_in__out}"
    _api_value_in bin    "${1}"; _where_in__bin="${_api_value_in__out}"
    _where_sum "${1}" ""
    _where_in__sum="${g_where_sum}"; _where_in__badge="${g_where_badge}"
    [ -n "${_where_in__url}" ] || return 1
    [ -n "${_where_in__bin}" ] || _where_in__bin="${2##*/}"
    return 0
}

_placed() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version, $4 => the program asked for:
    #    _placed aqua mikefarah/jq 1.7.1 jq  =>  ~/.cmdfound/channels/aqua/store/6f2ab1.../jq
    #related _tool_placed, the same question about the tool a channel installs with
    _pd__where="${g_home}/channels/${1}/by/${2}/${3}"
    [ -d "${_pd__where}" ] || return 1
    #where it points: the find in _find_program does not follow a link
    _pd__points="$(readlink "${_pd__where}" 2>/dev/null)"
    [ -n "${_pd__points}" ] && _pd__where="${_pd__points}"
    _find_program "${_pd__where}" "${4}"
}

_tool_placed() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => channel
    #    _tool_placed aqua  =>  ${g_home}/channels/aqua/tool/current
    _tp__current="$(_channel_home "${1}")/tool/current"
    [ -x "${_tp__current}" ] || return 1
    printf "%s\\n" "${_tp__current}"
}

_tool_version() { #@reviewed 2026-10-01 m@javier.io 2e226ed
    #$1 => channel. current is a link into tool/<version>/, so no file is read
    #    _tool_version aqua  =>  2.51.2
    #    _tool_version pkgx  =>  nothing, answers 1: no tool here
    _tv__home="$(_channel_home "${1}")"
    _tv__program="$(readlink "${_tv__home}/tool/current" 2>/dev/null)" || return 1
    #quoted, a home carrying a bracket or a star is a plain string and not a pattern
    case "${_tv__program}" in
        "${_tv__home}/tool/"?*) _tv__program="${_tv__program#"${_tv__home}/tool/"}" ;;
        *) _is_member_path "${_tv__program}" || return 1 ;;
    esac
    printf "%s\\n" "${_tv__program%%/*}"
}

_unpack() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => artifact, $2 => format, $3 => destination, $4 => target name
    _util_mkdir_p "${3}" || return 1
    case "${2}" in
        tar.gz|tgz)  TAR_OPTIONS= GZIP= tar -xzf "${1}" -C "${3}" 2>/dev/null ;;
        tar.xz|txz)  TAR_OPTIONS= tar -xJf "${1}" -C "${3}" 2>/dev/null ;;
        tar.bz2|tbz) TAR_OPTIONS= BZIP2= BZIP= tar -xjf "${1}" -C "${3}" 2>/dev/null ;;
        tar)         TAR_OPTIONS= tar -xf  "${1}" -C "${3}" 2>/dev/null ;;
        zip)         command -v unzip >/dev/null 2>&1 || return 1
                     UNZIP= UNZIPOPT= unzip -qq -o "${1}" -d "${3}" 2>/dev/null ;;
        raw|*)       cp "${1}" "${3}/${4:-program}" && chmod 755 "${3}/${4:-program}" ;;
    esac
}

_unpack_into() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => artifact, $2 => format, $3 => destination, $4 => target name
    #unpacked beside the artifact and moved whole: mv is one step, so no half
    #tree ever stands under $3 for the next run to find and take for placed
    #related _relink
    if ! _unpack "${1}" "${2}" "${1}.d" "${4}"; then
        rm -rf "${1}" "${1}.d"
        _msg "${PROGNAME}: could not unpack the ${2:-raw} artifact"
        return 1
    fi
    rm -f "${1}"
    _util_mkdir_p "${3%/*}" && mv "${1}.d" "${3}" 2>/dev/null || {
        rm -rf "${1}.d"
        return 1
    }
    return 0
}

_relink() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => a symbolic link, $2 => what it is to point at
    #mv replaces a link in one step
    [ X"$(readlink "${1}" 2>/dev/null)" = X"${2}" ] && return 0
    rm -f "${1}.$$"
    ln -s "${2}" "${1}.$$" 2>/dev/null && mv -f "${1}.$$" "${1}" || return 1
    return 0
}

_place() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #a placement is how cmdfound installs a loose binary itself

    #$1 => channel, $2 => package, $3 => version, $4 => what locate answered.
    #Prints the store directory.

    _place__channel="${1}"; _place__package="${2}"; _place__version="${3}"
    _place__where="${4}"
    _place__home="$(_channel_home "${_place__channel}")"

    _where_in "${_place__where}" "${_place__package}" || return 1
    _place__format="${_where_in__format}"; _place__bin="${_where_in__bin}"

    _fetcher_timed "${_place__channel}" "fetch" \
        "${_where_in__url}" "${_where_in__sum}" || return 1
    _place__artifact="${g_fetched}"; _place__digest="${g_fetched_digest}"

    #named for the digest, so the same bytes unpack once. That name is not known
    #until they are here, so a fetch is paid even where they already were:
    #_place_tool, which knows its version beforehand, asks before it fetches
    _place__store="${_place__home}/store/${_place__digest}"
    [ -d "${_place__store}" ] || \
        _unpack_into "${_place__artifact}" "${_place__format}" "${_place__store}" \
            "${_place__bin}" || return 1
    rm -f "${_place__artifact}"

    _place__link="${_place__home}/by/${_place__package}/${_place__version}"
    _util_mkdir_p "${_place__link%/*}" || return 1
    rm -f "${_place__link}"
    ln -s "${_place__store}" "${_place__link}" 2>/dev/null || return 1

    _inventory_add "${_place__home}" \
        "${_place__channel}:${_place__package}@${_place__version}" \
        "${_place__digest}" "${_where_in__badge}" "${_where_in__url}"

    printf "%s\\n" "${_place__store}"
}

_place_tool() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => spec, $3 => version, $4 => what the channel's locate answered
    #Installs a channel tool, and prints the link, eg: ${g_home}/channels/aqua/tool/current

    #one directory a version: an update moves current, and no launcher is rewritten
    _pt__home="$(_channel_home "${1}")"
    #a version is a directory name here, and current is the link's own name
    _api_is_version "${3}" || return 1
    [ X"${3}" = X"current" ] && return 1

    #a channel that does not say which program is inside means the spec's own name
    _spec_in "${2}"
    _where_in "${4}" "${_spec_in__package}" || return 1
    _pt__format="${_where_in__format}"; _pt__bin="${_where_in__bin}"

    #a version already here is already placed, and only the link may have to move
    _pt__version_dir="${_pt__home}/tool/${3}"
    if [ ! -d "${_pt__version_dir}" ]; then
        _fetcher_timed "${1}" "tool" "${_where_in__url}" "${_where_in__sum}" || return 1
        _unpack_into "${g_fetched}" "${_pt__format}" "${_pt__version_dir}" "${_pt__bin}" || return 1
        _inventory_add "${_pt__home}" "${2}@${3}" "${g_fetched_digest}" \
            "${_where_in__badge}" "${_where_in__url}"
    fi

    _pt__program="$(_find_program "${_pt__version_dir}" "${_pt__bin}")" || return 1
    _pt__link="${_pt__home}/tool/current"
    _relink "${_pt__link}" "${_pt__program}" || return 1
    printf "%s\\n" "${_pt__link}"
}

###############################################################################
################################ cache ########################################
###############################################################################

_key_in() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a spec
    _util_replace_in "${1}" "/:@" "_"; _key_in__out="${_util_replace_in__out}"
    return 0
}

_cache_key() { #@frozen 2026-09-22 m@javier.io 2e226ed
    #the same name, printed, for a caller that wants it in a substitution
    _key_in "${1}"
    printf "%s\\n" "${_key_in__out}"
}

#a decision is the program a spec runs, on its first line, and on its second
#the placement that program was placed as: channel, package and version

_cache_get() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => spec
    #    a decision is remembered  =>  0, printing the program it runs
    #    none is                   =>  1
    #read and not head: this is on the way of every run of a remembered program
    _key_in "${1}"
    _cg__file="${g_home}/cache/${_key_in__out}"
    [ -f "${_cg__file}" ] || return 1
    _cg__program=""
    #read answers 1 on a last line with no newline after it, which is still a line
    IFS= read -r _cg__program < "${_cg__file}" || [ -n "${_cg__program}" ] || return 1
    printf "%s\\n" "${_cg__program}"
}

_cache_put() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => spec, $2 => the program its decision runs, $3 => the placement
    _util_mkdir_p "${g_home}/cache" || return 0
    _key_in "${1}"
    #unquoted, ${3:+...} drops out whole, where "${3}" would leave an empty line
    printf "%s\\n" "${2}" ${3:+"${3}"} > "${g_home}/cache/${_key_in__out}"
}

###############################################################################
#################################### lock #####################################
###############################################################################

#two runs in one home have one thing to fight over: installing the same package,
#of the same channel, at the same version. Anything else is another directory.

_lock_path() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version. Sets g_lock_path to the directory
    #that stands for that placement, see _key_in. A package with a slash is one
    #directory, and no name can reach out of locks/
    _key_in "${1}:${2}@${3}"
    g_lock_path="${g_home}/locks/${_key_in__out}"
}

_lock_pid() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a lock. Sets g_lock_pid to the pid it names
    g_lock_pid=""
    [ -f "${1}/pid" ] || return 1
    IFS= read -r g_lock_pid 2>/dev/null < "${1}/pid"
    #a pid half written, or a file something else left there, holds nobody
    _util_is_number "${g_lock_pid}" || { g_lock_pid=""; return 1; }
    return 0
}

_is_lock_held() { #@frozen 2026-10-01 m@javier.io 2e226ed
    #$1 => a lock. Sets g_lock_pid to the run it found:
    #    a pid still there  =>  0
    #    a pid gone         =>  1, g_lock_pid still naming that run
    #    no pid at all      =>  1, g_lock_pid empty
    _lock_pid "${1}" && kill -0 "${g_lock_pid}" 2>/dev/null
}

_lock_steal() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => a lock whose pid names a run that is gone. Takes it over, and answers
    #1 where another run got there first. $$ is this run's own pid inside the
    #subshell, which POSIX says a subshell does not change
    #
    #Where there is a flock, the kernel decides which of two runs that both
    #found it dead goes on, and the one that loses sees the winner's pid on the
    #next look. Where there is none, the directory is moved out of its name,
    #which is narrower than removing it and still two steps. flock is not POSIX
    #and is missing from some busybox builds; it is there on Linux and on alpine
    #
    #What is flocked is the locks directory itself, read-only, so the takeover
    #leaves no file of its own and a steal cannot delete what another run holds.
    #The descriptor is opened by the subshell and not by exec: exec is a special
    #builtin, and a redirection that fails on one ends a posix shell, as _tty says
    if command -v flock >/dev/null 2>&1; then
        ( flock -n 9 || exit 1
          #asked again inside the lock: the answer that brought this run here was
          #read before waiting for it, and another run may have taken over since
          _is_lock_held "${1}" && exit 1
          rm -rf "${1}" && mkdir "${1}" 2>/dev/null && printf "%s\\n" "$$" > "${1}/pid"
        ) 9<"${g_home}/locks" 2>/dev/null
        return "${?}"
    fi
    _is_lock_held "${1}" && return 1
    mv "${1}" "${1}.dead.$$" 2>/dev/null && rm -rf "${1}.dead.$$" && \
        mkdir "${1}" 2>/dev/null
}

_lock_take() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version
    #    the lock is free       =>  0, g_lock_held naming it
    #    another run holds it   =>  1, g_lock_pid naming that run
    #    this home cannot lock  =>  1, g_lock_pid empty, so install without one

    #mkdir is what POSIX gives that two runs cannot both do. A lock whose pid is gone
    #is a lock nobody holds, and the next run takes it over: see _sweep_ephemeral
    _lock_path "${1}" "${2}" "${3}"
    _lt__lock="${g_lock_path}"
    g_lock_pid=""
    if mkdir "${_lt__lock}" 2>/dev/null; then
        :
    elif [ ! -d "${g_home}/locks" ] && _util_mkdir_p "${g_home}/locks" && \
         mkdir "${_lt__lock}" 2>/dev/null; then
        #never mkdir -p on the lock itself: -p answers 0 for a directory already there
        :
    elif _is_lock_held "${_lt__lock}"; then
        return 1
    elif _lock_steal "${_lt__lock}"; then
        :
    else
        #another run took the dead one's over first, and there is nobody to wait for
        _is_lock_held "${_lt__lock}" || g_lock_pid=""
        return 1
    fi

    #a lock that cannot say its pid is given back
    printf "%s\\n" "$$" > "${_lt__lock}/pid" 2>/dev/null || {
        rm -rf "${_lt__lock}"
        return 1
    }
    printf "%s\\n" "${1}:${2}@${3}" > "${_lt__lock}/placement" 2>/dev/null
    g_lock_held="${_lt__lock}"

    #and it goes however this run ends, Ctrl-C included: see _lock_free
    trap '_lock_free' EXIT
    trap '_lock_free; exit 130' INT
    trap '_lock_free; exit 143' TERM HUP
    return 0
}

_lock_free() { #@frozen 2026-10-05 m@javier.io 2e226ed
    [ -n "${g_lock_held}" ] || return 0
    _lf__lock="${g_lock_held}"; g_lock_held=""
    rm -rf "${_lf__lock}"
    return 0
}

_lock_wait() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => what the run in g_lock_pid is installing
    _msg "${PROGNAME}: ${1} is being installed by pid ${g_lock_pid}, waiting for it"
    while kill -0 "${g_lock_pid}" 2>/dev/null; do
        #a tenth of a second, and a whole one where sleep takes no fraction
        sleep 0.1 2>/dev/null || sleep 1
    done
    return 0
}

_lock_live() { #@frozen 2026-10-09 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version (all optional), and
    #$4 => a placement taken whatever the other three say:
    #    _lock_live "" jq "" ""            =>  4172  aqua:mikefarah/jq@1.7.1
    #    _lock_live nix-portable "" "" ""  =>  1

    #Shell built-ins only: a home installing nothing starts no process
    _ll__found=""
    for _ll__lock in "${g_home}"/locks/*; do
        [ -d "${_ll__lock}" ] || continue
        _is_lock_held "${_ll__lock}" || continue
        _ll__placement=""
        [ -f "${_ll__lock}/placement" ] && \
            IFS= read -r _ll__placement 2>/dev/null < "${_ll__lock}/placement"
        [ -n "${_ll__placement}" ] || continue

        #$4 names one placement outright, whatever its package is called there
        if [ -z "${4}" ] || [ X"${4}" != X"${_ll__placement}" ]; then
            _spec_in "${_ll__placement}"
            [ -z "${1}" ] || [ X"${1}" = X"${_spec_in__channel}" ] || continue
            [ -z "${3}" ] || [ X"${3}" = X"${_spec_in__version}" ] || continue
            [ -z "${2}" ] || [ X"${2}" = X"${_spec_in__package}" ] || \
                [ X"${2}" = X"${_spec_in__package##*/}" ] || continue
        fi
        printf "%s\\t%s\\n" "${g_lock_pid}" "${_ll__placement}"
        _ll__found="1"
    done
    [ -n "${_ll__found}" ] || return 1
    return 0
}

###############################################################################
############################## list and purge #################################
###############################################################################

_du_bytes() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => paths, one a line, $2 => paths a placement still holds (optional).
    #One du over $1, in bytes. $2 is there only so that a file the two share
    #counts for $2 and not for $1
    #    _du_bytes by/curl ""      =>  0, g_du_bytes 1581056: every byte curl reaches
    #    _du_bytes by/curl by/git  =>  0, g_du_bytes  532480: curl without the
    #                                  libssl.so it shares with git
    #    _du_bytes "" ""           =>  1, there was nothing to read

    #what there is to measure, split at newlines only and never as a pattern
    g_du_bytes=""
    _db__held=""; _db__counted=""
    _db__ifs="${IFS}"; IFS="${NL}"; set -f
    for _db__path in ${2}; do
        [ -e "${_db__path}" ] || [ -L "${_db__path}" ] || continue
        _db__held="${_db__held}${_db__path}${NL}"
    done
    for _db__path in ${1}; do
        [ -e "${_db__path}" ] || [ -L "${_db__path}" ] || continue
        _has_line "${_db__held}${_db__counted}" "${_db__path}" && continue
        _db__counted="${_db__counted}${_db__path}${NL}"
    done
    if [ -z "${_db__counted}" ]; then
        set +f; IFS="${_db__ifs}"
        g_du_bytes="0"
        return 0
    fi

    #the one du, the held paths first so that du reaches the shared files there
    _db__said="$(du -sk ${_db__held} ${_db__counted} 2>/dev/null)"
    _db__status="${?}"
    set +f; IFS="${_db__ifs}"
    [ "${_db__status}" -eq "0" ] || return 1

    #the total for what is going. du says kilobytes and the path, a tab apart
    _db__total="0"; _db__rest="${_db__said}${NL}"
    while [ -n "${_db__rest}" ]; do
        _db__line="${_db__rest%%${NL}*}"; _db__rest="${_db__rest#*${NL}}"
        _db__kilobytes="${_db__line%%${TAB}*}"; _db__path="${_db__line#*${TAB}}"
        _util_is_number "${_db__kilobytes}" || continue
        _has_line "${_db__counted}" "${_db__path}" && \
            _db__total="$((_db__total + _db__kilobytes))"
    done
    g_du_bytes="$((_db__total * 1024))"
}

_rmdir_emptied() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what a purge just removed, $2 => its channel's directory, which stays
    #    by/jqlang/jq/1.7.1 went, 1.8.0 is still there  =>  nothing to climb
    #    1.8.0 went too                                 =>  jq/ and jqlang/ go
    #    the last of by/ went                           =>  by/ goes, the channel stays

    #rmdir -p would climb out of the channel, so the directories are gathered
    #first and one rmdir removes them all, deepest first
    _rde__below="${1}"; _rde__dir="${1%/*}"; _rde__gone=""
    while :; do
        case "${_rde__dir}" in
            "${2}"/?*) ;;
            *) break ;;
        esac
        _util_is_empty_but "${_rde__dir}" "${_rde__below}" || break
        _rde__gone="${_rde__gone}${NL}${_rde__dir}"
        _rde__below="${_rde__dir}"; _rde__dir="${_rde__dir%/*}"
    done
    [ -n "${_rde__gone}" ] || return 0
    #split at newlines only, and never as a pattern
    (IFS="${NL}"; set -f; exec rmdir ${_rde__gone}) 2>/dev/null
    return 0
}

_reclaim() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a channel whose tool keeps a store of its own, $2 => the word all, when
    #nothing of this home is named any more. Sets g_reclaimed to the bytes given back
    _re__home="${g_home}/channels/${1}"
    _re__said="$(PATH="${_re__home}/needs:${PATH}"
        if [ -x "${_re__home}/tool/current" ]; then
            CMDFOUND_REQUIRED="${_re__home}/tool/current"; export CMDFOUND_REQUIRED
        else
            unset CMDFOUND_REQUIRED
        fi
        if [ X"${2}" = X"all" ]; then
            CMDFOUND_RECLAIM="all"; export CMDFOUND_RECLAIM
        else
            unset CMDFOUND_RECLAIM
        fi
        _api_channel "${1}" reclaim)"
    if [ "${?}" -ne "0" ]; then
        _api_value_in unreachable "${_re__said}" || _api_value_in__out="it gave no reason"
        _msg "${PROGNAME}: ${1} could not give back what it held: ${_api_value_in__out}"
        g_reclaimed="0"
        return 1
    fi

    #no freed= is an amount nobody can name, and not zero bytes given back
    _api_value_in freed "${_re__said}"; g_reclaimed="${_api_value_in__out}"
    _util_is_number "${g_reclaimed}" || g_reclaimed=""
    return 0
}

_remembered_programs_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #every program a remembered decision names and can still run, one a line:
    #    ~/.cmdfound/channels/github/store/6f2ab1.../jq

    #the program is on a decision's first line, so a thousand cost no process
    _remembered_programs_in__out=""
    for _rpi__decision in "${g_home}"/cache/*; do
        [ -f "${_rpi__decision}" ] || continue
        _rpi__program=""
        IFS= read -r _rpi__program 2>/dev/null < "${_rpi__decision}"
        [ -f "${_rpi__program}" ] && [ -x "${_rpi__program}" ] || continue
        _has_line "${_remembered_programs_in__out}" "${_rpi__program}" && continue
        _remembered_programs_in__out="${_remembered_programs_in__out}${_rpi__program}${NL}"
    done
    return 0
}

_programs_under_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a directory, $2 => programs, one a line. Those under it, a space apart:
    #    _programs_under_in ~/.cmdfound/channels/github/store/6f2ab1... "${programs}"
    #        =>  ~/.cmdfound/channels/github/store/6f2ab1.../jq
    _programs_under_in__out=""
    _pui__under=""
    _pui__left="${2}"
    while [ -n "${1}" ] && [ -n "${_pui__left}" ]; do
        _pui__program="${_pui__left%%${NL}*}"
        case "${_pui__program}" in
            "${1}/"?*) _pui__under="${_pui__under:+${_pui__under} }${_pui__program}" ;;
        esac
        [ X"${_pui__program}" = X"${_pui__left}" ] && break
        _pui__left="${_pui__left#*${NL}}"
    done
    _programs_under_in__out="${_pui__under}"
    return 0
}

_placement_bytes_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => package, $3 => version, $4 => where the link points

    #a tool with a store of its own is what knows the size: docker's images are
    #not in this directory. Asked, the tool either says bytes= or answers 1,
    #which is "not mine, count it here". This function always answers 0
    _placement_bytes_in__out=""
    _pbi__home="${g_home}/channels/${1}"
    _pbi__count="1"
    _channel_meta_in "${1}"
    if _has_line "${_channel_meta_in__out}" "reclaims=yes"; then
        _pbi__said="$(PATH="${_pbi__home}/needs:${PATH}"
            if [ -x "${_pbi__home}/tool/current" ]; then
                CMDFOUND_REQUIRED="${_pbi__home}/tool/current"; export CMDFOUND_REQUIRED
            else
                unset CMDFOUND_REQUIRED
            fi
            _api_channel "${1}" size "${2}" "${3}" </dev/null 2>/dev/null)"
        case "${?}" in
            0) _pbi__count=""
               _api_value_in bytes "${_pbi__said}"
               _placement_bytes_in__out="${_api_value_in__out}"
               _util_is_number "${_placement_bytes_in__out}" || _placement_bytes_in__out="" ;;
            1) ;;
            *) _pbi__count="" ;;
        esac
    fi

    #the rest is one du: a file two of the placement's paths link to is one file
    if [ -n "${_pbi__count}" ]; then
        _pbi__plan="${_pbi__home}/members/${2}/${3}"
        if [ -f "${_pbi__plan}" ]; then
            _pbi__paths=""
            #a last line with no newline after it is still a line
            while IFS= read -r _pbi__member || [ -n "${_pbi__member}" ]; do
                _is_member_path "${_pbi__member}" || continue
                _pbi__paths="${_pbi__paths}${_pbi__home}/${_pbi__member}${NL}"
            done < "${_pbi__plan}"
            _du_bytes "${_pbi__paths}" "" && _placement_bytes_in__out="${g_du_bytes}"
        else
            [ -e "${4}" ] && _du_bytes "${4}" "" && _placement_bytes_in__out="${g_du_bytes}"
        fi
    fi
    return 0
}

_list() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => part of a package name (optional), all of them
    #Three kinds of row. A placement is what was asked for. A tool is what
    #installed it, was never asked for, and stays when the placement goes. A
    #channel is those two and the catalog and whatever else it keeps, and is
    #the only row that says where the size of a home really went
    #    _list      =>  pkgx, its tool, v2.11.0             9.8 MB  tool
    #                   pkgx:stedolan.github.io/jq@1.8.2    3.3 MB  native  …/jq
    #                   pkgx, all of it                    33.0 MB  channel
    #    _list jq   =>  those three, with aqua and the rest left out
    #    _list zzz  =>  nothing at all
    #
    #A channel row is the whole channel and not what the rows above leave over:
    #a channel that counts a placement itself answers with bytes and not with
    #where they are, so a remainder would count those twice. It is what purging
    #the channel gives back, and more where its tool holds a store elsewhere
    [ -d "${g_home}/channels" ] || { _msg "${PROGNAME}: nothing placed yet"; return 0; }

    _remembered_programs_in
    _list__programs="${_remembered_programs_in__out}"

    for _list__home in "${g_home}"/channels/*; do
        [ -d "${_list__home}" ] || continue
        _list__channel="${_list__home##*/}"
        _list__kind="native"
        _confines "${_list__channel}" && _list__kind="dockerized"

        #the links are read before the tool row and not after: a tool is listed
        #where its channel has a placement to list, and $1 may leave it none
        _list__links="$(find "${_list__home}/by" -type l 2>/dev/null | sort)"
        _list__shows=""
        [ -n "${1}" ] || _list__shows="1"
        _list__left="${_list__links}${NL}"
        while [ -z "${_list__shows}" ] && [ -n "${_list__left}" ]; do
            _list__link="${_list__left%%${NL}*}"; _list__left="${_list__left#*${NL}}"
            #quoted in the braces: a home holding * ? or [ is not a pattern
            _list__rest="${_list__link#"${_list__home}"/by/}"
            case "${_list__rest%/*}" in *"${1}"*) _list__shows="1" ;; esac
        done
        [ -n "${_list__shows}" ] || continue

        #a current pointing at a version that is gone reaches no tool, and no row
        if [ -L "${_list__home}/tool/current" ] && [ -e "${_list__home}/tool/current" ]; then
            #empty, not 0: what du could not read is unknown, and is shown so
            _list__tool_bytes=""
            _du_bytes "${_list__home}/tool" "" && _list__tool_bytes="${g_du_bytes}"
            printf "  %-34s %10s  %s\\n" "${_list__channel}, its tool, $(_tool_version "${_list__channel}")" \
                "$(_bytes2human "${_list__tool_bytes}")" "tool"
        fi

        #channels/pkgx/by/stedolan.github.io/jq/1.8.2
        #         └─┬┘    └─────────┬─────────┘ └─┬─┘
        #           │               │             └── _list__version
        #           │               └──────────────── _list__package, slashes and all
        #           └──────────────────────────────── _list__channel
        #
        #read back as pkgx:stedolan.github.io/jq@1.8.2

        printf "%s\\n" "${_list__links}" | while read -r _list__link; do
            [ -n "${_list__link}" ] || continue
            #quoted in the braces: a home holding * ? or [ is not a pattern
            _list__rest="${_list__link#"${_list__home}"/by/}"
            _list__version="${_list__rest##*/}"
            _list__package="${_list__rest%/*}"
            [ -n "${1}" ] && case "${_list__package}" in *"${1}"*) ;; *) continue ;; esac
            _list__points="$(readlink "${_list__link}" 2>/dev/null)"

            _placement_bytes_in "${_list__channel}" "${_list__package}" "${_list__version}" \
                "${_list__points}"
            _programs_under_in "${_list__points}" "${_list__programs}"
            printf "  %-34s %10s  %-10s  %s\\n" "${_list__channel}:${_list__package}@${_list__version}" \
                "$(_bytes2human "${_placement_bytes_in__out}")" "${_list__kind}" \
                "${_programs_under_in__out:--}"
        done

        #why the whole channel and not a remainder: see the head of this function
        _du_bytes "${_list__home}" "" || continue
        printf "  %-34s %10s  %s\\n" "${_list__channel}, all of it" \
            "$(_bytes2human "${g_du_bytes}")" "channel"
    done
}

_purge() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a spec (optional)
    #    _purge              =>  the whole home
    #    _purge aqua:        =>  the aqua channel, all of it
    #    _purge aqua:jq@1.7  =>  the one placement
    [ -z "${1}" ] && { _purge_home; return "${?}"; }
    _spec_in "${1}"
    [ -n "${_spec_in__channel}" ] && [ -z "${_spec_in__package}" ] && \
        { _purge_channel "${_spec_in__channel}"; return "${?}"; }
    _purge_spec "${1}"
}

_purge_refused() { #reviewed
    #$1 => a channel, or nothing for the whole home. 0 when something there is
    #being installed, having said what, by which pid, and that nothing was removed
    _pr__live="$(_lock_live "${1}")" || return 1
    printf "%s\\n" "${_pr__live}" | while IFS="${TAB}" read -r _pr__pid _pr__installing; do
        [ -n "${_pr__installing}" ] && \
            _msg "${PROGNAME}: ${_pr__installing} is being installed by pid ${_pr__pid}"
    done
    _msg "${PROGNAME}: nothing was removed; purge again when that is done"
    return 0
}

_purge_removed() { #reviewed
    #$1 => a directory to remove whole, read-only ones in it included. 1 when
    #some of it stays, having said so
    _util_removable "${1}"
    rm -rf "${1}" && return 0
    _msg "${PROGNAME}: ${1} could not be removed entirely"
    return 1
}

_purge_home() { #reviewed
    #this refuses while anything is being installed, where _purge_spec waits:
    #waiting for every install in the home, with more free to start, has no end
    _purge_refused && return 1
    _confirm "${PROGNAME}: remove ${g_home} entirely?" || return 1

    #what a channel keeps outside this directory does not go with it: docker's
    #images live in docker, so a channel that reclaims gives all of it back first
    _channels_dir_in
    for _ph__home in "${g_home}"/channels/*; do
        _ph__channel="${_ph__home##*/}"
        [ -d "${_ph__home}" ] && [ -x "${_channels_dir_in__out}/${_ph__channel}" ] || continue
        _channel_meta_in "${_ph__channel}" reclaims
        [ X"${_channel_meta_in__out}" = X"yes" ] && _reclaim "${_ph__channel}" all
    done
    _purge_removed "${g_home}" || return 1
    _msg "${PROGNAME}: removed ${g_home}"
    return 0
}

_purge_channel() { #reviewed
    #$1 => a channel, and everything it has here: its tool, its placements and
    #what it holds besides, which --list shows as the channel's own row
    #
    #No decision is swept. One that ran from this channel names a program that
    #is gone now, which _remembered_program answers 1 to, and that run resolves again
    _pc__home="${g_home}/channels/${1}"
    [ -d "${_pc__home}" ] || { _msg "${PROGNAME}: ${1} has nothing here"; return 1; }

    #refused while anything of this channel is being installed, as _purge_home
    #is for the whole home, and for its reason: waiting for one has no end
    _purge_refused "${1}" && return 1
    _confirm "${PROGNAME}: remove everything ${1} has in ${g_home}?" || return 1

    #what the channel keeps outside this directory does not go with it: its own
    #tool is asked for all of it first, the way a whole purge asks
    _pc__given="0"
    _channel_meta_in "${1}" reclaims
    [ X"${_channel_meta_in__out}" = X"yes" ] && _reclaim "${1}" all && \
        _pc__given="${g_reclaimed}"

    _du_bytes "${_pc__home}" "" || g_du_bytes=""
    _plus_in "${g_du_bytes}" "${_pc__given}"; _pc__freed="${_plus_in__out}"
    _purge_removed "${_pc__home}" || return 1

    _pc__amount="an unknown amount"
    [ X"${_pc__freed}" != X"-" ] && _pc__amount="$(_bytes2human "${_pc__freed}")"
    _msg "${PROGNAME}: removed ${1}, freed ${_pc__amount}"
    return 0
}

_placement_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a placement: channel, package and version, a tab apart. Anything else
    #leaves both answers empty, with a status of 0 either way
    _placement_in__link=""; _placement_in__spec=""
    #a fourth field is no placement, and a '..' of its own reaches out of the
    #home: matched wrapped in slashes and tabs, so a version like 1..2 stands
    case "/${1}/" in
        *"${TAB}"*"${TAB}"*"${TAB}"*|*["/${TAB}"]..["/${TAB}"]*) return 0 ;;
    esac
    case "${1}" in
        ?*"${TAB}"?*"${TAB}"?*) ;;
        *) return 0 ;;
    esac
    _pi__channel="${1%%${TAB}*}"
    #a channel is one name: a slash in it would place the link somewhere else
    case "${_pi__channel}" in
        */*) return 0 ;;
    esac

    #aqua  jqlang/jq  1.7
    #  └───────┴───────┴──>  _placement_in__link  ${g_home}/channels/aqua/by/jqlang/jq/1.7
    #                        _placement_in__spec  aqua:jqlang/jq@1.7

    _pi__rest="${1#*${TAB}}"
    _pi__package="${_pi__rest%%${TAB}*}"; _pi__version="${_pi__rest#*${TAB}}"
    _placement_in__link="${g_home}/channels/${_pi__channel}/by/${_pi__package}/${_pi__version}"
    _placement_in__spec="${_pi__channel}:${_pi__package}@${_pi__version}"
    return 0
}

_store_entry_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => the program a decision runs
    #    ${g_home}/channels/aqua/store/6f2ab1.../jq  =>  .../aqua/store/6f2ab1...
    #    ${g_home}/channels/am/opt/figlet/figlet     =>  .../am/opt/figlet
    #    /usr/bin/jq                                 =>
    case "${1}" in
        "${g_home}/channels/"*/store/*)
            _sei__rest="${1#"${g_home}"/channels/}"
            _sei__channel="${_sei__rest%%/*}"; _sei__rest="${_sei__rest#*/store/}"
            _store_entry_in__out="${g_home}/channels/${_sei__channel}/store/${_sei__rest%%/*}" ;;
        "${g_home}/channels/"*/*) _store_entry_in__out="${1%/*}" ;;
        *) _store_entry_in__out="" ;;
    esac
    return 0
}

_wait_for_installs() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a channel, $2 => a package, $3 => a version, $4 => a placement (all
    #optional), as _lock_live reads them

    #removing a placement while it is being made leaves half of it behind
    while _wfi__live="$(_lock_live "${1}" "${2}" "${3}" "${4}")"; do
        _wfi__first="${_wfi__live%%${NL}*}"
        g_lock_pid="${_wfi__first%%${TAB}*}"
        _lock_wait "${_wfi__first#*${TAB}}"
    done
    return 0
}

_links_to_purge() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => channel directory, $2 => package, $3 => version (optional)
    #$4 => placement's link , $5 => store
    #    _links_to_purge CH jq 1.7  "" ""  =>  CH/by/jqlang/jq/1.7
    #    _links_to_purge CH jq 9.9  "" ""  =>  nothing
    _links_to_purge__out=""
    _ltp__other=""
    _ltp__left="$(find "${1}/by" -type l 2>/dev/null | sort)"
    [ -n "${_ltp__left}" ] && _ltp__left="${_ltp__left}${NL}"

    #${1}/by/jqlang/jq/1.7
    #        └───┬───┘ └┬┘
    #            │      └── _ltp__version
    #            └───────── _ltp__package, which $2 matches whole or after its /

    while [ -n "${_ltp__left}" ]; do
        _ltp__link="${_ltp__left%%${NL}*}"; _ltp__left="${_ltp__left#*${NL}}"
        #quoted inside the braces, so a * in the directory is a character here
        _ltp__rest="${_ltp__link#"${1}"/by/}"
        _ltp__version="${_ltp__rest##*/}"
        _ltp__package="${_ltp__rest%/*}"

        if [ X"${_ltp__link}" = X"${4}" ]; then
            _links_to_purge__out="${_links_to_purge__out}${_ltp__link}${NL}"
            continue
        fi
        [ -n "${3}" ] && [ X"${3}" != X"${_ltp__version}" ] && continue
        if [ X"${2}" = X"${_ltp__package}" ] || [ X"${2}" = X"${_ltp__package##*/}" ]; then
            _links_to_purge__out="${_links_to_purge__out}${_ltp__link}${NL}"
        else
            #an older decision has no placement written down: it runs from
            #whatever its link points at
            case "${5}" in
                "${1}/"?*) _ltp__other="${_ltp__other}${_ltp__link}${NL}" ;;
            esac
        fi
    done
    [ -n "${_ltp__other}" ] || return 0

    #every placement of the same file shares one store entry, so a link of the
    #spec's own name pointing there leaves the rest to their own packages
    _ltp__found=""; _ltp__rest="${_links_to_purge__out}"
    while [ -n "${_ltp__rest}" ]; do
        _ltp__link="${_ltp__rest%%${NL}*}"; _ltp__rest="${_ltp__rest#*${NL}}"
        [ X"$(readlink "${_ltp__link}" 2>/dev/null)" = X"${5}" ] || continue
        _ltp__found="1"
        break
    done
    _ltp__rest="${_ltp__other}"
    while [ -z "${_ltp__found}" ] && [ -n "${_ltp__rest}" ]; do
        _ltp__link="${_ltp__rest%%${NL}*}"; _ltp__rest="${_ltp__rest#*${NL}}"
        [ X"$(readlink "${_ltp__link}" 2>/dev/null)" = X"${5}" ] && \
            _links_to_purge__out="${_links_to_purge__out}${_ltp__link}${NL}"
    done
    return 0
}

_is_member_path() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => a path a channel wrote for what its tool installed
    #    _is_member_path bin/jq       =>  0
    #    _is_member_path /usr/bin/jq  =>  1
    #    _is_member_path ../../etc    =>  1
    case "${1}" in
        ''|*..*|/*) return 1 ;;
    esac
    return 0
}

_unplace() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => channel's directory, $2 => links it placed, one a line.
    #Each goes, with the record of what installing it put in the channel;
    #_unplace__count counts them and _unplace__members lists the paths those
    #records named, each once

    #what they name is freed later, by _free_members: what else names a file is
    #known only once every link that goes has gone
    _unplace__members=""; _unplace__count="0"
    _un__left="${2}"
    while [ -n "${_un__left}" ]; do
        _un__link="${_un__left%%${NL}*}"; _un__left="${_un__left#*${NL}}"
        #quoted inside the braces, so a * in the directory is a character here
        _un__rest="${_un__link#"${1}"/by/}"
        _un__version="${_un__rest##*/}"
        _un__package="${_un__rest%/*}"

        _un__plan="${1}/members/${_un__package}/${_un__version}"
        if [ -f "${_un__plan}" ]; then
            #a last line with no newline after it is still a line
            while IFS= read -r _un__member || [ -n "${_un__member}" ]; do
                _is_member_path "${_un__member}" || continue
                _has_line "${_unplace__members}" "${_un__member}" || \
                    _unplace__members="${_unplace__members}${_un__member}${NL}"
            done < "${_un__plan}"
            #the launcher too, when it is one the channel wrote in run/
            _un__member="$(readlink "${_un__link}" 2>/dev/null)"
            case "${_un__member}" in
                "${1}/run/"?*)
                    _un__member="${_un__member#"${1}/"}"
                    _is_member_path "${_un__member}" && \
                    { _has_line "${_unplace__members}" "${_un__member}" || \
                          _unplace__members="${_unplace__members}${_un__member}${NL}"; } ;;
            esac
            rm -f "${_un__plan}" "${_un__link}"
            _rmdir_emptied "${_un__plan}" "${1}"
        else
            rm -f "${_un__link}"
        fi
        _rmdir_emptied "${_un__link}" "${1}"
        _unplace__count="$((${_unplace__count} + 1))"
    done
    return 0
}

_free_members() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => channel's directory, $2 => the members of the placement that just
    #went, one a line, as _unplace read them. What no other placement of this
    #channel still names is removed; the rest is left standing
    #    curl and git both name lib/libssl.so, and curl is the one that went:
    #    run/curl/1.0 is removed, lib/libssl.so stays because git names it
    #    _free_members__kept   =>  1, the members another placement still names
    #    _free_members__freed  =>  the bytes the removed ones took, and nothing
    #                              where du could not read them
    #
    #Every members file of this channel is read to know that: a member belongs
    #to a placement, and two placements may name the same one
    _free_members__kept="0"; _free_members__freed="0"
    _fm__held=""
    [ -d "${1}/members" ] && \
        _fm__held="$(find "${1}/members" -type f -exec cat {} + 2>/dev/null)"
    _fm__still=""; _fm__rest="${_fm__held}${NL}"
    while [ -n "${_fm__rest}" ]; do
        _fm__member="${_fm__rest%%${NL}*}"; _fm__rest="${_fm__rest#*${NL}}"
        _is_member_path "${_fm__member}" || continue
        _fm__still="${_fm__still}${1}/${_fm__member}${NL}"
    done

    _fm__doomed=""; _fm__rest="${2}"
    while [ -n "${_fm__rest}" ]; do
        _fm__member="${_fm__rest%%${NL}*}"; _fm__rest="${_fm__rest#*${NL}}"
        if _has_line "${_fm__held}" "${_fm__member}"; then
            _free_members__kept="$((${_free_members__kept} + 1))"
            continue
        fi
        #a member may be a directory, a file or a link: AM holds all three
        [ -e "${1}/${_fm__member}" ] || [ -L "${1}/${_fm__member}" ] || continue
        _fm__doomed="${_fm__doomed}${1}/${_fm__member}${NL}"
    done
    [ -n "${_fm__doomed}" ] || return 0

    #one du over what goes, after what stays: the openssl curl shares with git
    #is not counted as freed
    if _du_bytes "${_fm__doomed}" "${_fm__still}"; then
        _free_members__freed="${g_du_bytes}"
    else
        _free_members__freed=""
    fi
    #a path is split out of the list at newlines only, and is never a pattern
    (IFS="${NL}"; set -f; exec rm -rf ${_fm__doomed})

    #pkgx points v1 and v* at a version: once it is gone they point nowhere
    _fm__rest="${_fm__doomed}"
    while [ -n "${_fm__rest}" ]; do
        _fm__member="${_fm__rest%%${NL}*}"; _fm__rest="${_fm__rest#*${NL}}"
        for _fm__beside in "${_fm__member%/*}"/* "${_fm__member%/*}"/.[!.]*; do
            [ -L "${_fm__beside}" ] && [ ! -e "${_fm__beside}" ] && rm -f "${_fm__beside}"
        done
        _rmdir_emptied "${_fm__member}" "${1}"
    done
    return 0
}

_free_store() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #Sweeps the store entries no by/ link points at any more
    #$1 => what another run is installing (optional): its entry is written and
    #not linked yet, so any value here calls the whole sweep off
    #    _free_store ""           =>  __kept 1, __freed 8192, huerfana removed
    #    _free_store aqua:jq@1.7  =>  __kept 2, __freed 0, nothing removed
    _free_store__kept="0"; _free_store__freed="0"
    _fst__linked=""
    while IFS= read -r _fst__link; do
        [ -n "${_fst__link}" ] || continue
        _fst__to="$(readlink "${_fst__link}" 2>/dev/null)" || continue
        _has_line "${_fst__linked}" "${_fst__to}" && continue
        _fst__linked="${_fst__linked}${_fst__to}${NL}"
    done <<EOF
$(find "${g_home}"/channels/*/by -type l 2>/dev/null)
EOF
    #a link's target is absolute: an entry is named when a target is its path
    _fst__doomed=""
    for _fst__dir in "${g_home}"/channels/*/store/*; do
        [ -d "${_fst__dir}" ] || continue
        #a run installing keeps what nothing names yet: an entry of the same
        #bytes is the one it is about to link to
        _fst__keep="${1}"
        _has_line "${_fst__linked}" "${_fst__dir}" && _fst__keep="yes"
        if [ -n "${_fst__keep}" ]; then
            _free_store__kept="$((${_free_store__kept} + 1))"
        else
            _fst__doomed="${_fst__doomed}${_fst__dir}${NL}"
        fi
    done
    [ -n "${_fst__doomed}" ] || return 0

    if _du_bytes "${_fst__doomed}" ""; then
        _free_store__freed="${g_du_bytes}"
    else
        _free_store__freed=""
    fi
    #a path is split out of the list at newlines only, and is never a pattern
    (IFS="${NL}"; set -f; exec rm -rf ${_fst__doomed})
    _fst__rest="${_fst__doomed}"
    while [ -n "${_fst__rest}" ]; do
        _fst__dir="${_fst__rest%%${NL}*}"; _fst__rest="${_fst__rest#*${NL}}"
        _rmdir_emptied "${_fst__dir}" "${_fst__dir%/store/*}"
    done
    return 0
}

_purge_spec() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a spec, eg: aqua:jq@1.7. Answers 1 when it doesnt matches anything
    _spec_in "${1}"
    _ps__spec_channel="${_spec_in__channel}"
    _ps__spec_package="${_spec_in__package}"
    _ps__spec_version="${_spec_in__version}"
    _ps__gone="0"; _ps__kept="0"; _ps__freed="0"; _ps__touched=""

    #a catalog places nothing: a runtime that ran one of its packages placed
    #it as <catalog>/<package>, so alpine:figlet is alpine/figlet in a runtime
    _ps__runtimes=""
    if [ -n "${_ps__spec_channel}" ] && [ ! -d "${g_home}/channels/${_ps__spec_channel}/by" ]; then
        _channel_meta_in "${_ps__spec_channel}" kind
        if [ X"${_channel_meta_in__out}" = X"catalog" ]; then
            _ps__spec_package="${_ps__spec_channel}/${_ps__spec_package}"
            _ps__spec_channel=""; _ps__runtimes="1"
        fi
    fi

    #the two lines of the spec's decision: the program it runs, and under it
    #the placement it was made as, which finds it whatever its name
    _key_in "${1}"
    _ps__cache="${g_home}/cache/${_key_in__out}"
    _ps__program=""; _ps__placed=""
    if [ -f "${_ps__cache}" ]; then
        { IFS= read -r _ps__program; IFS= read -r _ps__placed; } < "${_ps__cache}"
    fi
    _placement_in "${_ps__placed}"
    _ps__link="${_placement_in__link}"; _ps__placement="${_placement_in__spec}"

    _wait_for_installs "${_ps__spec_channel}" "${_ps__spec_package}" \
        "${_ps__spec_version}" "${_ps__placement}"

    #only a decision too old to name its placement has its store guessed
    [ -n "${_ps__link}" ] && _ps__program=""
    _store_entry_in "${_ps__program}"
    _ps__store="${_store_entry_in__out}"

    for _ps__home in "${g_home}"/channels/*; do
        [ -d "${_ps__home}/by" ] || continue
        _ps__channel="${_ps__home##*/}"
        [ -n "${_ps__spec_channel}" ] && [ X"${_ps__spec_channel}" != X"${_ps__channel}" ] && continue
        if [ -n "${_ps__runtimes}" ]; then
            if [ ! -d "${_ps__home}/by/${_ps__spec_package}" ]; then
                case "${_ps__link:-${_ps__store}}" in
                    "${_ps__home}/"*) ;;
                    *) continue ;;
                esac
            fi
            _channel_meta_in "${_ps__channel}" kind
            [ X"${_channel_meta_in__out}" = X"runtime" ] || continue
        fi

        _links_to_purge "${_ps__home}" "${_ps__spec_package}" "${_ps__spec_version}" \
            "${_ps__link}" "${_ps__store}"
        _unplace "${_ps__home}" "${_links_to_purge__out}"
        if [ "${_unplace__count}" -gt "0" ]; then
            _ps__gone="$((${_ps__gone} + ${_unplace__count}))"
            _ps__touched="${_ps__touched} ${_ps__channel}"
        fi
        [ -n "${_unplace__members}" ] || continue
        _free_members "${_ps__home}" "${_unplace__members}"
        _ps__kept="$((${_ps__kept} + ${_free_members__kept}))"
        _plus_in "${_ps__freed}" "${_free_members__freed}"; _ps__freed="${_plus_in__out}"
    done

    [ X"${_ps__gone}" = X"0" ] && { _msg "${PROGNAME}: nothing matched '${1}'"; return 1; }

    #what another run is installing, which is kept rather than given back
    _ps__busy=""
    _ps__live="$(_lock_live)" && _ps__busy="${_ps__live%%${NL}*}"
    _ps__busy="${_ps__busy#*${TAB}}"
    _free_store "${_ps__busy}"
    _ps__kept="$((${_ps__kept} + ${_free_store__kept}))"
    _plus_in "${_ps__freed}" "${_free_store__freed}"; _ps__freed="${_plus_in__out}"

    #a store its tool keeps is not cmdfound's to delete from: a channel that
    #says reclaims=yes has its own tool give back what nothing holds, and not
    #while a run is installing, whose files nothing holds yet
    [ -n "${_ps__busy}" ] && _ps__touched=""
    for _ps__channel in ${_ps__touched}; do
        _channel_meta_in "${_ps__channel}" reclaims
        [ X"${_channel_meta_in__out}" = X"yes" ] || continue
        _reclaim "${_ps__channel}" || continue
        _plus_in "${_ps__freed}" "${g_reclaimed}"; _ps__freed="${_plus_in__out}"
    done

    rm -f "${_ps__cache}"
    [ -n "${_ps__busy}" ] && \
        _msg "${PROGNAME}: ${_ps__busy} is being installed, so what nothing here names was kept rather than given back"
    _ps__amount="freed an unknown amount"
    [ X"${_ps__freed}" != X"-" ] && _ps__amount="freed $(_bytes2human "${_ps__freed}")"
    _msg "${PROGNAME}: removed ${_ps__gone} placement(s), ${_ps__amount}, ${_ps__kept} still referenced"
}

###############################################################################
############################## indexes and apropos ############################
###############################################################################

_index_one() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel
    #    aqua     =>  0, 41231 packages, 2026-09-01 updated
    #    github   =>  1, not updated, it timed out
    #    udocker  =>  2, a runtime keeps no catalog

    _channel_meta_in "${1}" kind
    [ X"${_channel_meta_in__out}" = X"runtime" ] && return 2
    _obtain_needs "${1}" || return 1

    #timed, so the next catalog of this channel can be estimated
    _io__started="$(_util_now_ms)"
    _io__said="$(PATH="$(_channel_home "${1}")/needs:${PATH}" _api_channel "${1}" index 2>/dev/null)"
    case "${?}" in
        0)  #bytes= is for the timing, the rest is the line the user is told
            _api_value_in bytes "${_io__said}"
            _io__spent="$(( $(_util_now_ms) - _io__started ))"
            _add_timing "${1}" "catalog" "${_api_value_in__out}" "${_io__spent}"
            _index2oneline_in "${_io__said}"
            _msg "${PROGNAME}: ${1}: ${_index2oneline_in__out}"
            return 0 ;;
        2)  _api_value_in unreachable "${_io__said}"
            _msg "${PROGNAME}: ${1}: not updated, ${_api_value_in__out}"
            return 1 ;;
    esac
    return 2
}

_unreachable_why_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => what the channels answered, notes and routes together. The answer is
    #why the first channel that could not be asked said so:
    #    ~unreachable aqua it timed out    =>  0, it timed out
    #    ~unreachable aqua                 =>  0, and nothing to give
    #    000000000000000000019 aqua 1.0    =>  1
    _unreachable_why_in__out=""
    _uwi__rest="${1}"
    while [ -n "${_uwi__rest}" ]; do
        _uwi__line="${_uwi__rest%%${NL}*}"
        case "${_uwi__line}" in
            '~unreachable '*)
                _uwi__why="${_uwi__line#* }"
                case "${_uwi__why}" in
                    *' '*) _unreachable_why_in__out="${_uwi__why#* }" ;;
                esac
                return 0 ;;
        esac
        #the last line carries no newline, and cutting past it would never end
        [ X"${_uwi__line}" = X"${_uwi__rest}" ] && break
        _uwi__rest="${_uwi__rest#*${NL}}"
    done
    return 1
}

_manager_update() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => the spec of the tool it installs through:
    #    _manager_update aqua github:aquaproj/aqua  =>  0, 2.51.2 is the newest
    #    _manager_update pkgx github:pkgxdev/pkgx   =>  1, could not be placed

    _spec_in "${2}"
    _mu__channel="${_spec_in__channel}"; _mu__package="${_spec_in__package}"
    _mu__name="${_mu__package##*/}"
    if ! _tool_placed "${1}" >/dev/null; then
        _msg "${PROGNAME}: ${1}: ${_mu__name} is not here yet, it is fetched the first time ${1} is needed"
        return 0
    fi

    #CMDFOUND_REFRESH, so a catalog read earlier in this run is read again
    _mu__probed="$(CMDFOUND_REFRESH="1"; export CMDFOUND_REFRESH; _probe_all "${_mu__package}" "" "${_mu__channel}")"
    _routes_in "${_mu__probed}"
    _mu__route="${_routes_in__out%%${NL}*}"
    if [ -z "${_mu__route}" ]; then
        _unreachable_why_in "${_mu__probed}"
        _msg "${PROGNAME}: ${1}: ${_mu__name} could not be checked for a newer release: ${_unreachable_why_in__out}"
        return 1
    fi
    _route_field_in "${_mu__route}" version; _mu__version="${_route_field_in__out}"
    _mu__here="$(_tool_version "${1}")"
    if [ X"${_mu__here}" = X"${_mu__version}" ]; then
        _msg "${PROGNAME}: ${1}: ${_mu__name} ${_mu__version} is the newest"
        return 0
    fi

    #the move is said before it is made: what fails is said right after it
    _mu__where="$(_api_channel "${_mu__channel}" locate "${_mu__package}" "${_mu__version}" 2>/dev/null)" || _mu__where=""
    _route_field_in "${_mu__route}" bytes; _mu__bytes="${_route_field_in__out}"
    _msg "${PROGNAME}: ${1}: ${_mu__name} ${_mu__here} -> ${_mu__version}, $(_bytes2human "${_mu__bytes}")"
    if [ -z "${_mu__where}" ] || ! _place_tool "${1}" "${2}" "${_mu__version}" "${_mu__where}" >/dev/null; then
        _msg "${PROGNAME}: ${1}: ${_mu__name} ${_mu__version} could not be placed, the one here stays"
        return 1
    fi

    #a directory a version, and current now points at the new one
    _mu__home="$(_channel_home "${1}")"
    for _mu__dir in "${_mu__home}"/tool/*; do
        [ -d "${_mu__dir}" ] && [ ! -L "${_mu__dir}" ] || continue
        [ X"${_mu__dir##*/}" = X"${_mu__version}" ] && continue
        rm -rf "${_mu__dir}"
    done
    return 0
}

_index_update() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a channel (optional), all of them. Answers 1 when any fails

    #a name that is no channel file can still be an alias of one
    _iu__only=""
    if [ -n "${1}" ]; then
        _iu__only="${1}"
        if [ ! -x "$(_channels_dir)/${_iu__only}" ]; then
            _iu__only="$(_channel_by_alias "${1}")" || {
                _msg "${PROGNAME}: no channel called '${1}'"
                return 1
            }
        fi
    fi

    #a channel has a catalog, a tool, both or neither: whichever it has is work
    _iu__had_work=""; _iu__failed=""
    for _iu__channel in $(_channels); do
        [ -n "${_iu__only}" ] && [ X"${_iu__channel}" != X"${_iu__only}" ] && continue
        _index_one "${_iu__channel}"
        case "${?}" in
            0) _iu__had_work="1" ;;
            1) _iu__had_work="1"; _iu__failed="1" ;;
        esac
        _channel_meta_in "${_iu__channel}" manager
        _iu__manager="${_channel_meta_in__out}"
        if [ -n "${_iu__manager}" ]; then
            _iu__had_work="1"
            _manager_update "${_iu__channel}" "${_iu__manager}" || _iu__failed="1"
        fi
    done

    if [ -z "${_iu__had_work}" ]; then
        if [ -n "${_iu__only}" ]; then
            _msg "${PROGNAME}: ${_iu__only} keeps no catalog and installs through no tool"
        else
            _msg "${PROGNAME}: no channel keeps a catalog"
        fi
    fi
    [ -z "${_iu__failed}" ]
}

_apropos() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1... => what to look for, as every channel's search takes it. One line a match
    #    some channel matched  =>  0
    #    none did              =>  1, having said so
    #      jq                 native      Command-line JSON processor

    [ -z "${1}" ] && _die "${PROGNAME}: --apropos needs something to look for"
    _ap__found=""
    for _ap__channel in $(_channels); do
        _ap__out="$(_api_channel "${_ap__channel}" search "${@}" 2>/dev/null)"
        case "${?}" in
            0)  [ -z "${_ap__out}" ] && continue
                _ap__found="1"
                _ap__kind="native"
                _confines "${_ap__channel}" && _ap__kind="dockerized"
                #one awk for the whole answer, however many names it matched
                printf "%s\\n" "${_ap__out}" | awk -F'\t' -v k="${_ap__kind}" \
                    'NF {printf("  %-36s %-10s %s\n", $1, k, $3)}' ;;
            2)  _api_value_in unreachable "${_ap__out}"
                _msg "${PROGNAME}: ${_ap__channel} could not be searched: ${_api_value_in__out}" ;;
        esac
    done
    #a catalog nobody has refreshed answers for the day it was fetched
    if [ -n "$(find "${g_home}/channels" -path '*/index/*' -type f -mtime +7 2>/dev/null)" ]; then
        _msg "${PROGNAME}: a local catalog is more than a week old, --index-update refreshes it"
    fi
    [ -n "${_ap__found}" ] || { _msg "${PROGNAME}: nothing matched '${*}'"; return 1; }
}

###############################################################################
################################### update ####################################
###############################################################################

_update() { #reviewed
    #unset, because cd prints where it went when CDPATH finds the directory
    _u__current_file="$(unset CDPATH; cd "$(_realdir "${0}")" && pwd)/${PROGNAME}"

    if [ -L "${_u__current_file}" ]; then
        printf "%s\\n" "${PROGNAME}: ${_u__current_file} is a link, update its repository instead" >&2
        return 1
    fi
    #what is published is the built cmdfound, and cmdfound.in is the source of one
    case "${PROGNAME}" in
        *.in) printf "%s\\n" "${PROGNAME}: this is the source, update its repository instead" >&2
              return 1 ;;
    esac

    _u__remote="$(_api_fetcher "${SRC_URL}cmdfound")" || return 1
    _u__remote_version="$(printf "%s\\n" "${_u__remote}" | \
        awk -F'"' '/^VERSION=/ {print $2; exit}')"
    [ -z "${_u__remote_version}" ] && return 1

    if [ X"${_u__remote_version}" = X"${VERSION}" ]; then
        _msg "${PROGNAME} is already up to date"
        return 0
    fi

    printf "%s\\n" "${_u__remote}" > "${_u__current_file}" || return 1
    chmod 755 "${_u__current_file}"
    _msg "${PROGNAME}: updated to ${_u__remote_version}"
}

###############################################################################
##################################### run #####################################
###############################################################################

#running what was asked for is a sequence of steps, and main reads as that
#sequence. A step is given what it needs and prints what it found: key=value
#lines read with _value and _values, a route's fields with _route_field_in,
#all of them within the shell avoid forks

_route_field_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => route, $2 => one of its field names
    #    _route_field_in "${route}" channel   =>  0, aqua
    #    _route_field_in "${route}" requires  =>  0, nothing, for the dash
    #    _route_field_in "${route}" hops      =>  1

    case "${2}" in
        key)       _route_field_in__at="1"  ;;
        channel)   _route_field_in__at="2"  ;;
        version)   _route_field_in__at="3"  ;;
        bytes)     _route_field_in__at="4"  ;;
        badge)     _route_field_in__at="5"  ;;
        confines)  _route_field_in__at="6"  ;;
        describes) _route_field_in__at="7"  ;;
        package)   _route_field_in__at="8"  ;;
        requires)  _route_field_in__at="9"  ;;
        estimate)  _route_field_in__at="10" ;;
        marginal)  _route_field_in__at="11" ;;
        ms)        _route_field_in__at="12" ;;
        once)      _route_field_in__at="13" ;;
        run)       _route_field_in__at="14" ;;
        *) _route_field_in__out=""; return 1 ;;
    esac
    #one space at a time, because cut and awk are processes
    _route_field_in__rest="${1} "
    while [ "${_route_field_in__at}" -gt "1" ]; do
        _route_field_in__rest="${_route_field_in__rest#* }"
        _route_field_in__at="$((${_route_field_in__at} - 1))"
    done
    _route_field_in__out="${_route_field_in__rest%% *}"
    [ X"${_route_field_in__out}" = X"-" ] && _route_field_in__out=""
    return 0
}

_route_catalog() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => route. Prints the catalog its program is from:
    #    ... via:conda-forge ... conda-forge/jq ...  =>  conda-forge
    #    ... none ... jq ...                         =>  1

    #both have to name it, or a via: badge alone would answer for another catalog
    _route_field_in "${1}" badge
    case "${_route_field_in__out}" in
        via:?*) _rtc__catalog="${_route_field_in__out#via:}" ;;
        *) return 1 ;;
    esac
    _route_field_in "${1}" package
    case "${_route_field_in__out}" in
        "${_rtc__catalog}/"?*) printf "%s\\n" "${_rtc__catalog}" ;;
        *) return 1 ;;
    esac
}

_where_sum() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a locate answer, $2 => what its lines are prefixed with (optional):
    #    sha256=9f86d… in it  =>  g_where_sum=9f86d…, g_where_badge=verified
    #    no sum in it         =>  g_where_sum=, g_where_badge=none

    #one place, so what is shown and what the download checks cannot disagree
    g_where_badge="none"
    _api_value_in "${2}sha256" "${1}"; g_where_sum="${_api_value_in__out}"
    [ -n "${g_where_sum}" ] && g_where_badge="verified"
    return 0
}

_route_badge() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a route, $2 => the catalog whose program it runs (optional):
    #    any route, $2=conda-forge        =>  0, g_route_badge=via conda-forge
    #    a route aqua's tool installs     =>  0, g_route_badge=via aqua
    #    a route cmdfound fetches itself  =>  1, g_route_badge=
    g_route_badge=""
    if [ -n "${2}" ]; then
        g_route_badge="via ${2}"
        return 0
    fi

    #000000 aqua 1.7 9432104 - no self jqlang/jq github:aquaproj/aqua
    #       └─┬┘             ┬                   └────────┬─────────┘
    #         │              │                            └── _rtb__requires
    #         │              └── _rtb__badge
    #         └── _rtb__channel

    #one pass down the fields, rather than three walks through _route_field_in
    _rtb__rest="${1#* }";                _rtb__channel="${_rtb__rest%% *}"
    _rtb__rest="${_rtb__rest#* * * }";   _rtb__badge="${_rtb__rest%% *}"
    _rtb__rest="${_rtb__rest#* * * * }"; _rtb__requires="${_rtb__rest%% *}"
    [ X"${_rtb__requires}" = X"-" ] && return 1
    g_route_badge="via ${_rtb__channel}"
    [ X"${_rtb__badge}" = X"-" ] || g_route_badge="${_rtb__badge}"
    return 0
}

_canonical_spec() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => spec. Prints it with its channel under the channel's real
    #name, so two spellings of one request share one cached decision
    #    _canonical_spec jq              =>  jq
    #    _canonical_spec aqua:jqlang/jq  =>  aqua:jqlang/jq
    #    _canonical_spec gh:jqlang/jq    =>  github:jqlang/jq
    #    _canonical_spec nope:jq         =>  1, having said no channel goes by nope

    #kept now, because _channel_by_alias runs channels that use _spec_in too
    _spec_in "${1}"
    _cs__channel="${_spec_in__channel}"
    _cs__package="${_spec_in__package}"
    _cs__version="${_spec_in__version}"

    _channels_dir_in
    if [ -z "${_cs__channel}" ] || [ -x "${_channels_dir_in__out}/${_cs__channel}" ]; then
        printf "%s\\n" "${1}"
        return 0
    fi
    _cs__real="$(_channel_by_alias "${_cs__channel}")" || {
        _msg "${PROGNAME}: no channel called '${_cs__channel}'"
        return 1
    }
    printf "%s\\n" "${_cs__real}:${_cs__package}${_cs__version:+@${_cs__version}}"
}

_remembered_program() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => spec, $2 => the program asked for
    #    a decision is remembered and its program is there  =>  0, printing it
    #    there is none, or what it ran is gone              =>  1
    _rp__program="$(_cache_get "${1}")" || return 1
    if [ -f "${_rp__program}" ] && [ -x "${_rp__program}" ]; then
        printf "%s\\n" "${_rp__program}"
    elif [ -d "${_rp__program}" ]; then
        _find_program "${_rp__program}" "${2}"
    else
        return 1
    fi
}

_route_choice() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a route. Prints the channel:package it offers when the name has to be
    #chosen between. A runtime's route offers the catalog's program, one program
    #however many runtimes can run it:
    #    000000 udocker 1.0 - via:alpine ... alpine/jq  =>  alpine:jq
    #    000000 aqua    1.7 - none       ... jqlang/jq  =>  aqua:jqlang/jq
    _route_field_in "${1}" package; _route_choice__package="${_route_field_in__out}"
    if _route_choice__catalog="$(_route_catalog "${1}")"; then
        printf "%s:%s\\n" "${_route_choice__catalog}" "${_route_choice__package#*/}"
    else
        _route_field_in "${1}" channel; _route_choice__channel="${_route_field_in__out}"
        printf "%s:%s\\n" "${_route_choice__channel}" "${_route_choice__package}"
    fi
}

_pick_program() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => package, $2 => what the channels answered.
    #Prints the channel:package when the name is more than one program
    _pp__ambiguous="$(printf "%s\\n" "${2}" | \
        awk '$1 == "~ambiguous" {for (i = 3; i <= NF; i++) print $2 ":" $i}')"
    [ -z "${_pp__ambiguous}" ] && return 0
    _pp__choices="$( { printf "%s\\n" "${_pp__ambiguous}"
                       printf "%s\\n" "${2}" | awk 'NF && $1 !~ /^~/' | \
                           while read -r _pp__route; do _route_choice "${_pp__route}"; done
                     } | awk 'NF && !seen[$0]++')"
    _ask_which "${1}" "${_pp__choices}" && return 0

    #nobody to ask: running the wrong program is worse than running none
    _msg "${PROGNAME}: '${1}' is the name of more than one program, and none was guessed:"
    printf "%s\\n" "${_pp__choices}" | while read -r _pp__choice; do _msg "    ${_pp__choice}"; done
    _msg "${PROGNAME}: run one of them by its full name"
    return 1
}

_routes_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => what the channels answered, notes and routes together, kept in the
    #order they came:
    #    ~unreachable aqua it timed out   =>  dropped, a note starts with ~
    #    000000000000000000019 aqua 1.0   =>  kept
    #A loop, because an awk over the same few dozen lines is a process
    _routes_in__out=""
    _routes_in__rest="${1}"
    while [ -n "${_routes_in__rest}" ]; do
        _routes_in__line="${_routes_in__rest%%${NL}*}"
        case "${_routes_in__line}" in
            '~'*)           ;;
            *[![:space:]]*) _routes_in__out="${_routes_in__out}${_routes_in__out:+${NL}}${_routes_in__line}" ;;
        esac
        [ X"${_routes_in__line}" = X"${_routes_in__rest}" ] && break
        _routes_in__rest="${_routes_in__rest#*${NL}}"
    done
    return 0
}

_tool_for() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => route. Prints what installing through its channel's tool needs
    #    no tool to install through  =>  0, nothing printed
    #    its tool is here            =>  0, tool=…/aqua/tool/current
    #    its tool is not             =>  0, tool_version=, tool_bytes=, tool_where=
    #    the tool cannot be had      =>  1, unreachable=<why>

    #looked up now, so the tool's cost is part of the question, not a surprise
    _route_field_in "${1}" requires; _tf__requires="${_route_field_in__out}"
    [ -z "${_tf__requires}" ] && return 0
    _route_field_in "${1}" channel; _tf__route_channel="${_route_field_in__out}"
    if _tf__tool="$(_tool_placed "${_tf__route_channel}")"; then
        printf "tool=%s\\n" "${_tf__tool}"
        return 0
    fi

    _spec_in "${_tf__requires}"
    _tf__channel="${_spec_in__channel}"
    _tf__package="${_spec_in__package}"
    _tf__probed="$(_probe_all "${_tf__package}" "" "${_tf__channel}")"
    _routes_in "${_tf__probed}"
    _tf__route="${_routes_in__out%%${NL}*}"
    #a channel that could not be asked did not say the tool is gone
    if [ -z "${_tf__route}" ]; then
        printf "%s\\n" "${_tf__probed}" | \
            awk '$1 == "~unreachable" {$1 = ""; $2 = ""; sub(/^ +/, ""); print "unreachable=" $0; exit}'
        return 1
    fi

    _route_field_in "${_tf__route}" version; _tf__version="${_route_field_in__out}"
    _route_field_in "${_tf__route}" bytes; _tf__bytes="${_route_field_in__out}"
    _tf__where="$(_api_channel "${_tf__channel}" locate "${_tf__package}" "${_tf__version}" 2>/dev/null)"
    [ -n "${_tf__where}" ] || return 1
    printf "tool_version=%s\\n" "${_tf__version}"
    printf "tool_bytes=%s\\n" "${_tf__bytes}"
    printf "%s\\n" "${_tf__where}" | awk 'NF {print "tool_where=" $0}'
}

_say_unreachable() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => the channels that could not be asked
    printf "%s\\n" "${1}" | while read -r _su__channel _su__why; do
        [ -n "${_su__channel}" ] && _msg "${PROGNAME}: ${_su__channel} could not be asked: ${_su__why}"
    done
    return 0
}

_why_no_route() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => what the channels answered, $2 => package, $3 => 'channel why' a line
    #    ~nocatalog udocker alpine  =>  no catalog called 'alpine'
    #    ~unrunnable alpine why     =>  alpine has it, and nothing can run it: why
    #    neither, and no $3         =>  no channel provides 'jq'

    case "${1}" in
        *"~nocatalog "*)
            _wnr__nocatalog="${1#*~nocatalog * }"
            _msg "${PROGNAME}: no catalog called '${_wnr__nocatalog%%${NL}*}'"
            return 1 ;;
    esac

    case "${1}" in
        *"~unrunnable "*) _wnr__unrunnable="$(printf "%s\\n" "${1}" | \
                              awk '$1 == "~unrunnable" {$1 = ""; sub(/^ /, ""); print}')" ;;
        *) _wnr__unrunnable="" ;;
    esac
    if [ -n "${_wnr__unrunnable}" ]; then
        _say_unreachable "${3}"
        printf "%s\\n" "${_wnr__unrunnable}" | while read -r _wnr__catalog _wnr__why; do
            _msg "${PROGNAME}: ${_wnr__catalog} has '${2#"${_wnr__catalog}"/}', and nothing here can run it: ${_wnr__why}"
        done
        return 1
    fi

    #with a channel that could not be asked, saying the package is not here is a lie
    if [ -z "${3}" ]; then
        _msg "${PROGNAME}: no channel provides '${2}'"
        return 1
    fi
    _say_unreachable "${3}"
    _msg "${PROGNAME}: so whether anything provides '${2}' is not known"
    return 1
}

_resolve() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a spec, eg: aqua:jq@1.7. Answers 1 when there is no route

    #what was asked for
    _spec_in "${1}"
    _resolve__channel="${_spec_in__channel}"
    _resolve__package="${_spec_in__package}"
    _resolve__version="${_spec_in__version}"

    #the channels, asked again when a shared name turned out to mean one program
    _resolve__probed="$(_probe_all "${_resolve__package}" "${_resolve__version}" "${_resolve__channel}")"
    _resolve__picked="$(_pick_program "${_resolve__package}" "${_resolve__probed}")" || return 1
    if [ -n "${_resolve__picked}" ]; then
        _resolve__channel="${_resolve__picked%%:*}"
        _resolve__package="${_resolve__picked#*:}"
        _resolve__probed="$(_probe_all "${_resolve__package}" "${_resolve__version}" "${_resolve__channel}")"
    fi

    #the routes, and the two kinds of note that are shown beside them
    _routes_in "${_resolve__probed}"; _resolve__routes="${_routes_in__out}"
    _resolve__unreachable="$(printf "%s\\n" "${_resolve__probed}" | \
        awk '$1 == "~unreachable" {$1 = ""; sub(/^ /, ""); print}')"
    #a case first, because awk is a process and most resolutions list nothing here
    _resolve__unavailable=""
    case "${_resolve__probed}" in
        *"~unavailable "*) _resolve__unavailable="$(printf "%s\\n" "${_resolve__probed}" | \
                               awk '$1 == "~unavailable" && !seen[$0]++ {$1 = ""; sub(/^ /, ""); print}')" ;;
    esac

    #nothing to take, and which of the reasons that is
    if [ -z "${_resolve__routes}" ]; then
        _why_no_route "${_resolve__probed}" "${_resolve__package}" "${_resolve__unreachable}"
        return "${?}"
    fi

    #a tool that cannot be had is not a missing package - a rate limit is not - so
    #the reason is said and the channels asked again with that channel left out
    _resolve__taken="${_resolve__routes%%${NL}*}"
    while ! _resolve__tool="$(_tool_for "${_resolve__taken}")"; do
        _route_field_in "${_resolve__taken}" channel; _resolve__lost="${_route_field_in__out}"
        _route_field_in "${_resolve__taken}" requires; _resolve__requires="${_route_field_in__out}"
        _api_value_in unreachable "${_resolve__tool}"; _resolve__why="${_api_value_in__out}"
        if [ -n "${_resolve__why}" ]; then
            _msg "${PROGNAME}: ${_resolve__requires} could not be fetched: ${_resolve__why}"
        else
            _msg "${PROGNAME}: ${_resolve__requires} could not be had"
        fi
        CMDFOUND_NO_MANAGER="${CMDFOUND_NO_MANAGER:+${CMDFOUND_NO_MANAGER} }${_resolve__lost}"
        export CMDFOUND_NO_MANAGER
        _resolve__probed="$(_probe_all "${_resolve__package}" "${_resolve__version}" "${_resolve__channel}")"
        _routes_in "${_resolve__probed}"; _resolve__routes="${_routes_in__out}"
        if [ -z "${_resolve__routes}" ]; then
            if [ -n "${_resolve__why}" ]; then
                _msg "${PROGNAME}: so whether anything provides '${_resolve__package}' is not known"
            else
                _msg "${PROGNAME}: and without it, nothing provides '${_resolve__package}'"
            fi
            return 1
        fi
        _resolve__taken="${_resolve__routes%%${NL}*}"
        _route_field_in "${_resolve__taken}" channel; _resolve__taken_channel="${_route_field_in__out}"
        _route_field_in "${_resolve__taken}" package; _resolve__taken_package="${_route_field_in__out}"
        _msg "${PROGNAME}: ${_resolve__lost} goes without it; ${_resolve__taken_channel}:${_resolve__taken_package} instead"
    done

    #whoever has docker and finds udocker used has to know why, so the swap is said
    #as the decision is made, and only then: a decision remembered says nothing
    if [ -n "${_resolve__unavailable}" ]; then
        case "${_resolve__taken}" in
            *" via:"*)
                _route_field_in "${_resolve__taken}" channel; _resolve__runtime="${_route_field_in__out}"
                printf "%s\\n" "${_resolve__unavailable}" | while read -r _resolve__absent _resolve__absent_why; do
                    _msg "${PROGNAME}: ${_resolve__absent} is not available, using ${_resolve__runtime}"
                done ;;
        esac
    fi

    #the resolution itself, every key a line
    printf "package=%s\\n" "${_resolve__package}"
    printf "%s\\n" "${_resolve__routes}" | awk 'NF {print "route=" $0}'
    printf "%s\\n" "${_resolve__unreachable}" | awk 'NF {print "unreachable=" $0}'
    [ -n "${_resolve__unavailable}" ] && printf "%s\\n" "${_resolve__unavailable}" | awk 'NF {print "unavailable=" $0}'
    printf "%s\\n" "${_resolve__tool}" | awk 'NF'
}

_route_kind() { #@frozen 2026-10-05 m@javier.io 2e226ed
    #$1 => route. Sets _route_kind__out:
    #    a route through docker or udocker  =>  dockerized
    #    any other route                    =>  native

    #confines rides in the route from _probe2route, so saying this loads no channel
    _route_kind__out="native"
    _route_field_in "${1}" confines
    [ X"${_route_field_in__out}" = X"yes" ] && _route_kind__out="dockerized"
    return 0
}

_why_taken() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => routes, one a line and in the order the sort left them, $2 => the
    #one taken. What goes after "because:" in the dry run's last line
    #    the only route there is       =>  native, the only one
    #    it beat the next on its run   =>  dockerized, the quickest per run
    #    the sort put another first    =>  native, though not the quickest

    #read off the key the sort read, and not worked out again from the fields:
    #an order that changes and an explanation that does not is a lie nothing
    #can catch, since the choice stays right
    _wt__first="${1%%${NL}*}"
    _route_kind "${2}"; _wt__kind="${_route_kind__out}"

    if [ X"${_wt__first}" != X"${2}" ]; then
        printf "%s\\n" "${_wt__kind}, though not the quickest"
        return 0
    fi
    #stripping past the first line answers the whole of a list that has no
    #second one, so the case asks whether there is a line break at all
    case "${1}" in
        *"${NL}"*) _wt__rival="${1#*${NL}}"; _wt__rival="${_wt__rival%%${NL}*}" ;;
                *) _wt__rival="" ;;
    esac
    if [ -z "${_wt__rival}" ]; then
        printf "%s\\n" "${_wt__kind}, the only one"
        return 0
    fi

    #the key, as _probe2route and _routes_per_runtime write it:
    #    0 0000000000 00000000000500 0 03
    #    1 2       11 12          25 26 27
    _route_field_in "${2}" key;           _wt__mine="${_route_field_in__out}"
    _route_field_in "${_wt__rival}" key;  _wt__theirs="${_route_field_in__out}"
    _wt__slice="$(awk -v a="${_wt__mine}" -v b="${_wt__theirs}" 'BEGIN {
        if (substr(a, 1, 1)   != substr(b, 1, 1))   { print "class"; exit }
        if (substr(a, 2, 10)  != substr(b, 2, 10))  { print "run";   exit }
        if (substr(a, 12, 14) != substr(b, 12, 14)) { print "time";  exit }
        if (substr(a, 26, 1)  != substr(b, 26, 1))  { print "hops";  exit }
        if (substr(a, 27)     != substr(b, 27))     { print "order"; exit }
        print "tie" }')"

    case "${_wt__slice}" in
        class) printf "%s\\n" "${_wt__kind}, before any container" ;;
        run)   printf "%s\\n" "${_wt__kind}, the quickest per run" ;;
        time)  printf "%s\\n" "${_wt__kind}, the quickest to get" ;;
        hops)  printf "%s\\n" "${_wt__kind}, the fewest steps" ;;
        order) printf "%s\\n" "${_wt__kind}, first in channels.conf" ;;
        *)     printf "%s\\n" "${_wt__kind}, the quickest" ;;
    esac
}

_show_routes() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the resolution, $2 => the program asked for

    #the route taken, which the table marks, and the program, a package's last name
    _sr__routes="$(_values route "${1}")"
    _sr__taken="$(_value route "${1}")"
    _route_field_in "${_sr__taken}" channel; _sr__taken_channel="${_route_field_in__out}"
    _route_field_in "${_sr__taken}" package; _sr__taken_package="${_route_field_in__out}"
    _route_field_in "${_sr__taken}" version; _sr__taken_version="${_route_field_in__out}"
    _sr__package="$(_value package "${1}")"
    printf "%s\\n" "${_sr__package##*/}"

    #a line a route
    printf "%s\\n" "${_sr__routes}" | while read -r _sr__route; do
        _route_field_in "${_sr__route}" channel; _sr__channel="${_route_field_in__out}"
        _route_field_in "${_sr__route}" version; _sr__version="${_route_field_in__out}"
        _route_field_in "${_sr__route}" package; _sr__package="${_route_field_in__out}"
        _route_kind "${_sr__route}"; _sr__kind="${_route_kind__out}"
        _catalog_in "${_sr__route}"; _sr__catalog="${_catalog_in__out}"
        if _route_badge "${_sr__route}" "${_sr__catalog}"; then
            #what a runtime runs or a tool installs, someone else answers for
            _sr__badge="${g_route_badge}"
        else
            #what cmdfound fetches itself: the sum that locate gives, or the probe's word
            _sr__where="$(_api_channel "${_sr__channel}" locate "${_sr__package}" "${_sr__version}" "${2}" 2>/dev/null)"
            if [ "${?}" -ne "2" ] && [ -n "${_sr__where}" ]; then
                _where_sum "${_sr__where}" ""
                _sr__badge="${g_where_badge}"
            else
                _route_field_in "${_sr__route}" badge; _sr__badge="${_route_field_in__out}"
            fi
        fi
        _sr__mark=""
        [ X"${_sr__channel}" = X"${_sr__taken_channel}" ] && \
            [ X"${_sr__version}" = X"${_sr__taken_version}" ] && _sr__mark="  <- taken"
        _route_field_in "${_sr__route}" bytes; _sr__route_bytes="${_route_field_in__out}"
        _sr__size="$(_bytes2human "${_sr__route_bytes}")"
        _route_field_in "${_sr__route}" estimate; _sr__estimate="${_route_field_in__out}"
        [ -n "${_sr__estimate}" ] && _sr__size="~${_sr__size}"
        _sr__run=""
        if [ -n "${_sr__catalog}" ]; then
            _route_field_in "${_sr__route}" run; _sr__run="${_route_field_in__out}"
            if _util_is_number "${_sr__run}" && [ "${_sr__run}" -gt "0" ]; then
                _sr__run="  $(_microseconds2human "${_sr__run}") a run"
            else
                _sr__run=""
            fi
        fi
        _route_field_in "${_sr__route}" ms; _sr__ms="${_route_field_in__out}"
        printf "  %-32s %10s %8s  %-10s  [%s]%s%s\\n" "${_sr__channel}:${_sr__package}@${_sr__version}" \
            "${_sr__size}" "$(_microseconds2human "${_sr__ms}")" "${_sr__kind}" "${_sr__badge}" \
            "${_sr__run}" "${_sr__mark}"
    done

    _values unreachable "${1}" | while read -r _sr__lost _sr__why; do
        _msg "  ${_sr__lost}: could not be asked, ${_sr__why}"
    done
    #a case first, because the pipe is a process and most resolutions have none
    case "${1}" in
        *"unavailable="*)
            _values unavailable "${1}" | while read -r _sr__lost _sr__why; do
                _msg "  ${_sr__lost}: not available, ${_sr__why}"
            done ;;
    esac

    #the tool the channel installs through, where this run is the one fetching it
    _route_field_in "${_sr__taken}" requires; _sr__requires="${_route_field_in__out}"
    if [ -n "${_sr__requires}" ] && [ -z "$(_value tool "${1}")" ]; then
        _where_sum "${1}" "tool_where="
        printf "  %-32s %10s  %s\\n" "+ tool ${_sr__requires}@$(_value tool_version "${1}")" \
            "$(_bytes2human "$(_value tool_bytes "${1}")")" "needed once, to install through [${g_where_badge}]"
    fi

    #and what the route taken gets once: an image to pull, an engine to set up
    _route_field_in "${_sr__taken}" once; _sr__once="${_route_field_in__out}"
    if [ -n "${_sr__once}" ]; then
        printf "%s\\n" "${_sr__once}" | tr ';' '\n' | while IFS='|' read -r _sr__step _sr__label _sr__bytes _sr__badge; do
            #the badge carries colons where it has spaces, so joining could not split it
            _util_replace_in "${_sr__badge}" ":" " "; _sr__badge="${_util_replace_in__out}"
            printf "  %-32s %10s  %s\\n" "+ ${_sr__step} ${_sr__label}" "$(_bytes2human "${_sr__bytes}")" \
                "needed once [${_sr__badge}]"
        done
    fi

    #jq
    #  aqua:jq@1.7                          2.0 MB    1.9ms  native      [verified]  <- taken
    #  docker:alpine/jq@1.7                45.0 MB   40.0ms  dockerized  [via alpine]  0.3ms a run
    #  + tool github:aquaproj/aqua@2.53.0   9.8 MB  needed once, to install through [verified]
    #  + image alpine:3.20                  3.4 MB  needed once [via docker]
    #taken: aqua:jq@1.7   because: native, the quickest
    printf "taken: %s:%s@%s   because: %s\\n" "${_sr__taken_channel}" \
        "${_sr__taken_package}" "${_sr__taken_version}" \
        "$(_why_taken "${_sr__routes}" "${_sr__taken}")"
}

_locate() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the resolution, $2 => the program asked for.
    #Prints where the artifact of the route taken lives
    _lc__route="$(_value route "${1}")"
    _route_field_in "${_lc__route}" channel; _lc__channel="${_route_field_in__out}"
    _route_field_in "${_lc__route}" package; _lc__package="${_route_field_in__out}"
    _route_field_in "${_lc__route}" version; _lc__version="${_route_field_in__out}"
    _lc__verb="locate"

    #a runtime runs a catalog's program, so it is the catalog that has the recipe
    if _catalog_in "${_lc__route}"; then
        _lc__catalog="${_catalog_in__out}"
        _lc__channel="${_lc__catalog}"; _lc__verb="recipe"
        _lc__package="${_lc__package#"${_lc__catalog}"/}"
    fi

    _lc__where="$(_api_channel "${_lc__channel}" "${_lc__verb}" "${_lc__package}" \
        "${_lc__version}" "${2}" 2>/dev/null)"
    _lc__rc="${?}"
    if [ "${_lc__rc}" -eq "2" ]; then
        _msg "${PROGNAME}: ${_lc__channel} could not be asked where '$(_value package "${1}")' lives: $(_value unreachable "${_lc__where}")"
        return 1
    fi

    #a catalog that gives no reason for having no recipe has answered nothing
    if [ X"${_lc__verb}" = X"recipe" ] && [ "${_lc__rc}" -ne "0" ]; then
        _api_value_in failed "${_lc__where}"; _lc__why="${_api_value_in__out}"
        if [ -n "${_lc__why}" ]; then
            _msg "${PROGNAME}: ${_lc__channel}: ${_lc__why}"
            return 1
        fi
        _lc__where=""
    fi
    if [ -z "${_lc__where}" ]; then
        _msg "${PROGNAME}: ${_lc__channel} knows '$(_value package "${1}")' but cannot say where it lives"
        return 1
    fi

    printf "%s\\n" "${_lc__where}"
}

_catalog_in() { #@reviewed 2026-10-05 m@javier.io 2e226ed
    #$1 => a route
    #    ... via:conda-forge ... conda-forge/jq ...  =>  conda-forge
    #    a route to a channel's own program          =>  1

    #only a runtime's route carries via:, so the case turns the rest away, no fork
    _catalog_in__out=""
    case "${1}" in
        *" via:"*) _catalog_in__out="$(_route_catalog "${1}")" || _catalog_in__out="" ;;
        *) return 1 ;;
    esac
    [ -n "${_catalog_in__out}" ]
}

_size_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => bytes, $2 => non-empty when the channel could only estimate them
    #    _size_in 9432104 ""    =>  9.0 MB
    #    _size_in 9432104 yes   =>  about 9.0 MB
    #    _size_in - ""          =>  size unknown
    _size_in__out="size unknown"
    _util_is_number "${1}" || return 0
    _size_in__out="$(_bytes2human "${1}")"
    [ -n "${2}" ] && _size_in__out="about ${_size_in__out}"
    return 0
}

_add_first_cost() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #Adds what one "first ..." line costs to the total the confirmation prints
    #$1 => its bytes, $2 => its microseconds
    #    from the 4.9 KB and 1000 microseconds the package seeded:
    #    _add_first_cost 295000 2000  =>  total 293.0 KB, <0.01 s
    #    _add_first_cost "" 2000      =>  total at least 4.9 KB, <0.01 s
    #    _add_first_cost 295000 ""    =>  total 293.0 KB, time unknown

    #a size nobody can say still leaves a floor, a time nobody can say leaves none
    if _util_is_number "${1}"; then
        g_first_bytes="$((${g_first_bytes} + ${1}))"
    else
        g_first_unknown="1"
    fi
    if _util_is_number "${g_first_microseconds}" && _util_is_number "${2}"; then
        g_first_microseconds="$((${g_first_microseconds} + ${2}))"
    else
        g_first_microseconds="-"
    fi
    g_first_summed="1"
    return 0
}

_ask_proceed() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => resolution, $2 => where the artifact lives, $3 => spec
    #Says what the route taken costs this run, and asks once

    #the route taken, and the name the program is going to be run under
    _ak__route="$(_value route "${1}")"
    _route_field_in "${_ak__route}" channel;  _ak__channel="${_route_field_in__out}"
    _route_field_in "${_ak__route}" version;  _ak__version="${_route_field_in__out}"
    _route_field_in "${_ak__route}" package;  _ak__package="${_route_field_in__out}"
    _route_field_in "${_ak__route}" bytes;    _ak__bytes="${_route_field_in__out}"
    _route_field_in "${_ak__route}" estimate; _ak__estimate="${_route_field_in__out}"
    _route_field_in "${_ak__route}" requires; _ak__requires="${_route_field_in__out}"
    _ak__bin="$(_value bin "${2}")"
    [ -z "${_ak__bin}" ] && _ak__bin="${_ak__package##*/}"
    _route_kind "${_ak__route}"; _ak__kind="${_route_kind__out}"
    _catalog_in "${_ak__route}"; _ak__catalog="${_catalog_in__out}"

    #verified is only ever said of what cmdfound fetched itself
    if _route_badge "${_ak__route}" "${_ak__catalog}"; then
        _ak__badge="${g_route_badge}"
    else
        _where_sum "${2}" ""
        _ak__badge="${g_where_badge}"
    fi

    #the route's own line, and the channels that could not offer a quicker one
    _size_in "${_ak__bytes}" "${_ak__estimate}"; _ak__size="${_size_in__out}"
    _ak__step="fetch"
    if [ -n "${_ak__requires}" ] || [ -n "${_ak__catalog}" ]; then
        _ak__step="install"
    fi
    _ak__microseconds="$(_estimate_microseconds "${_ak__bytes}" "${_ak__channel}" "${_ak__step}")"
    #the line names the repository, so an unexpected mapping is caught by a person
    _msg "${PROGNAME}: ${_ak__bin} ${_ak__version} -> ${_ak__channel}:${_ak__package}  ${_ak__size}, $(_microseconds2human "${_ak__microseconds}")  [${_ak__badge}]  ${_ak__kind}"
    _values unreachable "${1}" | while read -r _ak__lost_channel _ak__why; do
        _msg "            (${_ak__lost_channel} could not be asked, a quicker route may exist: ${_ak__why})"
    done

    #the package seeds the total without being something got first, so it alone is
    #no reason to write one. A part nobody can size makes the total a floor
    g_first_bytes="0"; g_first_unknown=""
    if _util_is_number "${_ak__bytes}"; then
        g_first_bytes="${_ak__bytes}"
    else
        g_first_unknown="1"
    fi
    g_first_microseconds="${_ak__microseconds}"; g_first_summed=""

    #the tool the channel installs through, where this run is the one fetching it
    if [ -n "${_ak__requires}" ] && [ -z "$(_value tool "${1}")" ]; then
        _ak__tool_bytes="$(_value tool_bytes "${1}")"
        _ak__tool_microseconds="$(_estimate_microseconds "${_ak__tool_bytes}" "${_ak__channel}" "tool")"
        _where_sum "${1}" "tool_where="
        _ak__tool_badge="${g_where_badge}"
        _msg "            first tool ${_ak__requires} $(_value tool_version "${1}"), $(_bytes2human "${_ak__tool_bytes}"), $(_microseconds2human "${_ak__tool_microseconds}"), fetched once and kept up to date [${_ak__tool_badge}]"
        _add_first_cost "${_ak__tool_bytes}" "${_ak__tool_microseconds}"
    fi

    #and what the route gets once: an image to pull, an engine to set up
    _route_field_in "${_ak__route}" once; _ak__once_rest="${_route_field_in__out}"
    while [ -n "${_ak__once_rest}" ]; do
        _ak__entry="${_ak__once_rest%%;*}"
        case "${_ak__once_rest}" in
            *";"*) _ak__once_rest="${_ak__once_rest#*;}" ;;
                *) _ak__once_rest="" ;;
        esac
        _ak__once_step="${_ak__entry%%|*}";  _ak__entry="${_ak__entry#*|}"
        _ak__once_label="${_ak__entry%%|*}"; _ak__entry="${_ak__entry#*|}"
        _ak__once_bytes="${_ak__entry%%|*}"; _ak__once_badge="${_ak__entry#*|}"
        #the badge holds colons where it has spaces: joined entries cannot split
        _util_replace_in "${_ak__once_badge}" ":" " "; _ak__once_badge="${_util_replace_in__out}"
        _size_in "${_ak__once_bytes}" ""; _ak__once_size="${_size_in__out}"
        _ak__once_microseconds="$(_estimate_microseconds "${_ak__once_bytes}" "${_ak__channel}" "${_ak__once_step}")"
        _msg "            first ${_ak__once_step} ${_ak__once_label}, ${_ak__once_size}, $(_microseconds2human "${_ak__once_microseconds}"), once [${_ak__once_badge}]"
        _add_first_cost "${_ak__once_bytes}" "${_ak__once_microseconds}"
    done

    #a route with nothing to get first costs what its own line says
    if [ -n "${g_first_summed}" ]; then
        if [ -z "${g_first_unknown}" ]; then
            _size_in "${g_first_bytes}" "${_ak__estimate}"; _ak__total="${_size_in__out}"
        elif [ "${g_first_bytes}" -gt "0" ]; then
            _size_in "${g_first_bytes}" ""; _ak__total="at least ${_size_in__out}"
        else
            _ak__total="size unknown"
        fi
        _msg "            total ${_ak__total}, $(_microseconds2human "${g_first_microseconds}")"
    fi

    #a decision already agreed to when it was made is not asked about twice
    [ -n "$(_cache_get "${3}")" ] && return 0
    _confirm "${PROGNAME}: proceed?"
}

_obtain() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => resolution, $2 => where the artifact lives, $3 => the program asked for
    #$4 => the name given with --bin. Prints the program to run
    _ob__route="$(_value route "${1}")"
    _route_field_in "${_ob__route}" requires; _ob__requires="${_route_field_in__out}"

    #neither a channel's own tool nor a catalog hands cmdfound a file to place
    if [ -n "${_ob__requires}" ] || _catalog_in "${_ob__route}"; then
        _obtain_through_tool "${1}" "${3}" "${2}"
        return "${?}"
    fi
    _obtain_itself "${_ob__route}" "${2}" "${4}"
}

_reason_in() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => what a channel answered
    #    failed=no recipe for 'jq'      =>  no recipe for 'jq'
    #    unreachable=the hub timed out  =>  the hub timed out
    #    neither line in it             =>  1

    #whichever comes first, not failed before unreachable: first said, first happened
    _reason_in__out=""
    _reason_in__rest="${1}"
    while [ -n "${_reason_in__rest}" ]; do
        _reason_in__line="${_reason_in__rest%%${NL}*}"
        case "${_reason_in__line%%=*}" in
            failed|unreachable) _reason_in__out="${_reason_in__line#*=}"; return 0 ;;
        esac
        #the last line carries no newline, and cutting past it would never end
        [ X"${_reason_in__line}" = X"${_reason_in__rest}" ] && break
        _reason_in__rest="${_reason_in__rest#*${NL}}"
    done
    return 1
}

_add_reported_timings() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => channel, $2 => what it answered
    #    timing=pull:3400000:9120  =>  _add_timing udocker pull 3400000 9120
    #    timing=install:-:18004    =>  _add_timing udocker install - 18004
    #    program=/usr/bin/jq       =>  nothing, and 1
    _art__added=""
    #A case, because walking an answer that names no step buys nothing
    case "${2}" in
        "timing="*|*"${NL}timing="*) ;;
        *) return 1 ;;
    esac
    _art__rest="${2}"
    while [ -n "${_art__rest}" ]; do
        _art__line="${_art__rest%%${NL}*}"
        case "${_art__rest}" in
            *"${NL}"*) _art__rest="${_art__rest#*${NL}}" ;;
            *) _art__rest="" ;;
        esac
        #timing=<step>:<bytes or ->:<ms>, the step a word of letters
        case "${_art__line}" in
            timing=*:*:*) _art__line="${_art__line#timing=}" ;;
            *) continue ;;
        esac
        _art__step="${_art__line%%:*}"; _art__line="${_art__line#*:}"
        _art__bytes="${_art__line%%:*}"; _art__milliseconds="${_art__line#*:}"
        case "${_art__step}" in ''|*[!a-z]*) continue ;; esac
        _util_is_number "${_art__milliseconds}" || continue
        _add_timing "${1}" "${_art__step}" "${_art__bytes}" "${_art__milliseconds}"
        _art__added="1"
    done
    [ -n "${_art__added}" ]
}

_obtain_through_tool() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => resolution, $2 => the program asked for, $3 => where it lives
    #Installs through the tool the channel needs, placing that tool first when
    #this run is the one that places it. As _obtain calls it for jq:
    #    _obtain_through_tool "package=jq
    #        route=<key> am latest - - no self jq am:APP-MANAGER - - - - 0
    #        tool_version=10.6-2
    #        tool_bytes=119411
    #        tool_where=url=https://.../ivan-hc/AM/main/APP-MANAGER
    #        tool_where=format=raw
    #        tool_where=bin=appman"
    #        jq
    #        "url=https://.../programs/x86_64/jq format=raw bin=jq"
    #    =>  0, printing channels/am/run/jq/jq, and leaving by/jq/latest,
    #        members/jq/latest, an inventory row and a timing behind
    #    =>  1, "APP-MANAGER could not be placed, and nothing was installed"
    #    =>  1, "binstall could not install 'bibad': ..."
    #    =>  1, "docker reported no program for 'jq'"

    #the route taken, and the badge it was shown with
    _ot__route="$(_value route "${1}")"
    _route_field_in "${_ot__route}" channel;  _ot__channel="${_route_field_in__out}"
    _route_field_in "${_ot__route}" package;  _ot__package="${_route_field_in__out}"
    _route_field_in "${_ot__route}" version;  _ot__version="${_route_field_in__out}"
    _route_field_in "${_ot__route}" requires; _ot__requires="${_route_field_in__out}"
    _route_field_in "${_ot__route}" bytes;    _ot__bytes="${_route_field_in__out}"
    _ot__home="$(_channel_home "${_ot__channel}")"
    _catalog_in "${_ot__route}"; _ot__catalog="${_catalog_in__out}"
    _route_badge "${_ot__route}" "${_ot__catalog}"
    _ot__badge="${g_route_badge}"

    #the tool the channel installs through, placed now if this run places it
    _ot__tool=""
    if [ -n "${_ot__requires}" ]; then
        _ot__tool="$(_value tool "${1}")"
        if [ -z "${_ot__tool}" ]; then
            _ot__tool_version="$(_value tool_version "${1}")"
            _spec_in "${_ot__requires}"; _ot__tool_name="${_spec_in__package}"
            _msg "${PROGNAME}: fetching ${_ot__tool_name##*/} ${_ot__tool_version}, to install ${_ot__package} with"
            _ot__tool="$(_place_tool "${_ot__channel}" "${_ot__requires}" "${_ot__tool_version}" \
                "$(_values tool_where "${1}")")" && [ -n "${_ot__tool}" ] || {
                _msg "${PROGNAME}: ${_ot__requires} could not be placed, and nothing was installed"
                return 1
            }
        fi
    fi

    #the install itself, in a subshell. The bytes told are the route's, never a
    #user's CMDFOUND_BYTES: a timing with no size teaches no cost per byte
    _msg "${PROGNAME}: ${_ot__channel} is installing ${_ot__package} ${_ot__version}"
    _ot__t0="$(_util_now_ms)"
    _ot__out="$(PATH="${_ot__home}/needs:${PATH}"
        if [ -n "${_ot__tool}" ]; then
            CMDFOUND_REQUIRED="${_ot__tool}"; export CMDFOUND_REQUIRED
        else
            unset CMDFOUND_REQUIRED
        fi
        if [ -n "${_ot__catalog}" ]; then
            CMDFOUND_RECIPE="${3}"; export CMDFOUND_RECIPE
        fi
        CMDFOUND_BYTES="${_ot__bytes}"; export CMDFOUND_BYTES
        _api_channel "${_ot__channel}" obtain "${_ot__package}" "${_ot__version}" "${2}")" || {
        _reason_in "${_ot__out}"
        _msg "${PROGNAME}: ${_ot__channel} could not install '${_ot__package}': ${_reason_in__out}"
        return 1
    }

    #what it took, as the channel counted it, or whole when it counted nothing
    _add_reported_timings "${_ot__channel}" "${_ot__out}" || \
        _add_timing "${_ot__channel}" "install" "${_ot__bytes}" "$(( $(_util_now_ms) - _ot__t0 ))"

    #the program it installed, and the link that placement is reached by
    _ot__program="$(_value program "${_ot__out}")"
    [ -x "${_ot__program}" ] || {
        _msg "${PROGNAME}: ${_ot__channel} reported no program for '${_ot__package}'"
        return 1
    }
    _ot__link="${_ot__home}/by/${_ot__package}/${_ot__version}"
    _util_mkdir_p "${_ot__link%/*}" && rm -f "${_ot__link}" && ln -s "${_ot__program%/*}" "${_ot__link}" 2>/dev/null

    #what the tool holds, so purging takes what nothing else uses. Only the
    #channel's own relative paths are kept; _is_member_path reads them back
    _ot__members="$(_values member "${_ot__out}" | awk '
        $0 != "" && index($0, "..") == 0 && $0 !~ /^\// && $0 !~ /[^A-Za-z0-9._+\/-]/')"
    if [ -n "${_ot__members}" ]; then
        _ot__record="${_ot__home}/members/${_ot__package}/${_ot__version}"
        _util_mkdir_p "${_ot__record%/*}" && printf "%s\\n" "${_ot__members}" > "${_ot__record}"
    fi
    printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$(date +%Y-%m-%dT%H:%M:%S)" \
        "${_ot__channel}:${_ot__package}@${_ot__version}" "-" "${_ot__badge}" \
        "${_ot__channel}:$(_value asset "${_ot__out}")" >> "${_ot__home}/inventory"

    printf "%s\\n" "${_ot__program}"
}

_obtain_itself() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => route, $2 => where the artifact is, $3 => name
    #with --bin (optional). Prints the program inside the artifact
    _route_field_in "${1}" channel; _oi__channel="${_route_field_in__out}"
    _route_field_in "${1}" package; _oi__package="${_route_field_in__out}"
    _route_field_in "${1}" version; _oi__version="${_route_field_in__out}"
    _oi__store="$(_place "${_oi__channel}" "${_oi__package}" "${_oi__version}" "${2}")" || return 1

    #the name: --bin, then the channel's locate, then the package's last part
    _oi__bin="${3:-$(_value bin "${2}")}"
    [ -z "${_oi__bin}" ] && _oi__bin="${_oi__package##*/}"
    _find_program "${_oi__store}" "${_oi__bin}" && return 0
    _msg "${PROGNAME}: nothing executable called '${_oi__bin}' inside the artifact"
    return 1
}

_remember() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => program, $2 => spec, $3 => spec under the channel's real name
    #$4 => channel, package and version a tab apart.
    #Both spelling gets its own copy, which _store_entry_in and _placement_in read:
    #    ${g_home}/channels/aqua/store/6f2ab1.../jq
    #    aqua jqlang/jq 1.7
    _cache_put "${2}" "${1}" "${4}"
    [ X"${2}" != X"${3}" ] && _cache_put "${3}" "${1}" "${4}"
    return 0
}

_obtained() { #@reviewed 2026-10-09 m@javier.io 2e226ed
    #$1 => the canonical spec, $2 => the spec as typed, $3 => the program asked for
    #$4 => the name given with --bin.
    #Prints the program, resolved, agreed to and obtained. As main calls it:
    #    cmdfound jq         =>  _obtained jq jq jq ""
    #    cmdfound gh:cli/cli =>  _obtained github:cli/cli gh:cli/cli cli ""
    #    cmdfound -b sh alpine:busybox
    #                        =>  _obtained alpine:busybox alpine:busybox sh sh
    #    and when another run holds the lock, what that run left is printed
    #    without a word of what it would have cost

    #the placement the route names, locked before the question is put: a run that
    #will only wait for another one's install must not ask the user to agree to a
    #download it will not make
    _od__resolution="$(_resolve "${1}")" || return 1
    _od__route="$(_value route "${_od__resolution}")"
    _route_field_in "${_od__route}" channel; _od__channel="${_route_field_in__out}"
    _route_field_in "${_od__route}" package; _od__package="${_route_field_in__out}"
    _route_field_in "${_od__route}" version; _od__version="${_route_field_in__out}"
    _od__placement="${_od__channel}${TAB}${_od__package}${TAB}${_od__version}"

    while ! _lock_take "${_od__channel}" "${_od__package}" "${_od__version}"; do
        #a home this run cannot lock installs as it always did: nobody to wait for
        [ -n "${g_lock_pid}" ] || break
        _lock_wait "${_od__channel}:${_od__package}@${_od__version}"
        #what the run that held the lock left is what this run runs, and
        #remembers too. One that left nothing failed, and this run installs
        _od__program="$(_placed "${_od__channel}" "${_od__package}" \
            "${_od__version}" "${3}")" && [ -n "${_od__program}" ] && {
            _remember "${_od__program}" "${2}" "${1}" "${_od__placement}"
            printf "%s\\n" "${_od__program}"
            return 0
        }
    done

    #the lock is held through locating, asking and installing, and freed after
    _od__where="$(_locate "${_od__resolution}" "${3}")" || { _lock_free; return 1; }
    _ask_proceed "${_od__resolution}" "${_od__where}" "${1}" || { _lock_free; return 1; }
    _od__program="$(_obtain "${_od__resolution}" "${_od__where}" "${3}" "${4}")" || { _lock_free; return 1; }
    _remember "${_od__program}" "${2}" "${1}" "${_od__placement}"
    _lock_free
    printf "%s\\n" "${_od__program}"
}

_hook() { #reviewed
    #$1 => bash (the default) or zsh. Prints the function that hands a missing
    #command to cmdfound, for the rc file:
    #    eval "$(cmdfound --hook bash)"
    _hook__function="command_not_found_handle"
    case "${1}" in
        ''|bash) ;;
        zsh) _hook__function="command_not_found_handler" ;;
        *) _die "${PROGNAME}: no hook for '${1}', known shells are bash and zsh" ;;
    esac

    #only the name differs between the two shells
    printf "%s() {\\n" "${_hook__function}"
    cat <<'EOF'
    #generated by 'cmdfound --hook', edit the tool and not this copy
    local _h__status=127

    #interactive sessions only: a script or a cron job fails as it would
    #without the hook. The shell's flag and not stdin, which is the command's
    case ${-} in
        *i*) if [ -z "${CMDFOUND_HOOK:-}" ] && command -v cmdfound >/dev/null 2>&1; then
                 #what cmdfound runs inherits the marker, and starts no second resolution
                 CMDFOUND_HOOK=1 cmdfound -- "$@"
                 _h__status=${?}
             fi ;;
    esac

    #with this function defined the shell prints nothing itself
    [ "${_h__status}" -eq 127 ] &&
        printf '%s: %s: command not found\n' "${0##*/}" "${1}" >&2

    return "${_h__status}"
}
EOF
}

###############################################################################
##################################### api #####################################
###############################################################################
#Written once for whoever needs it, this and its channels. A channel is loaded
#inside a subshell of cmdfound's, so it inherits all of it and carries no copy

_api_value_in() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a key, $2 => key=value lines. The first value that key is given, whole
    #    _api_value_in version "${_p2r__out}"  =>  0, 1.7
    #    _api_value_in badge "${_p2r__out}"    =>  1
    _api_value_in__out=""
    _api_value_in__rest="${2}"
    while [ -n "${_api_value_in__rest}" ]; do
        _api_value_in__line="${_api_value_in__rest%%${NL}*}"
        case "${_api_value_in__line}" in
            "${1}="*) _api_value_in__out="${_api_value_in__line#*=}"; return 0 ;;
        esac
        #the last line carries no newline, and cutting past it would never end
        [ X"${_api_value_in__line}" = X"${_api_value_in__rest}" ] && break
        _api_value_in__rest="${_api_value_in__rest#*${NL}}"
    done
    return 1
}

_api_channel() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a channel. Loads the channel instead of starting it as a program, so
    #that it inherits the channel api and carries no copy of it.
    case "${1}" in
        #a path, for a channel being written that is not in the directory yet
        */*) _api_channel__file="${1}" ;;
          *) _channels_dir_in; _api_channel__file="${_channels_dir_in__out}/${1}" ;;
    esac
    shift
    CMDFOUND_CHANNEL_FILE="${_api_channel__file}"; export CMDFOUND_CHANNEL_FILE
    . "${_api_channel__file}"
}

_api_format_of() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a file's name.
    #    _api_format_of jq-1.8-linux.TAR.GZ  =>  tar.gz
    #    _api_format_of jq-linux-amd64       =>  raw
    case "$(_util_lower "${1}")" in
        *.tar.gz|*.tgz)   printf "%s\\n" "tar.gz"  ;;
        *.tar.xz|*.txz)   printf "%s\\n" "tar.xz"  ;;
        *.tar.bz2|*.tbz2) printf "%s\\n" "tar.bz2" ;;
        *.tar)            printf "%s\\n" "tar"     ;;
        *.zip)            printf "%s\\n" "zip"     ;;
        *)                printf "%s\\n" "raw"     ;;
    esac
}

_api_is_program_name() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #    _api_is_program_name jq-1.8  =>  0
    #    _api_is_program_name -rf     =>  1  it would read as an option
    #    _api_is_program_name ..      =>  1  it would read as a hidden file
    case "${1}" in
        ''|.*|-*|*[!${ALNUM}._+-]*) return 1 ;;
    esac
    return 0
}

_api_is_version() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$2 => a character it may carry besides letters, digits and . _ + -
    #    _api_is_version 2.2.5-r3   =>  0
    #    _api_is_version 1!2.0      =>  1
    #    _api_is_version 1!2.0 "!"  =>  0  conda's epoch
    case "${1}" in
        ''|[!${ALNUM}]*|*[!${ALNUM}._+${2}-]*) return 1 ;;
    esac
    return 0
}

_api_is_catalog_package() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => catalog/package/version, as a runtime is told to install it and as it becomes a directory
    #    _api_is_catalog_package alpine/figlet/2.2.5-r3  =>  0
    #    _api_is_catalog_package alpine/../2.2.5-r3      =>  1
    #    _api_is_catalog_package alpine/figlet/          =>  1
    case "${1}" in
        *[!${ALNUM}._+/-]*|*..*|*/*/*/*) return 1 ;;
        ?*/?*/?*) return 0 ;;
    esac
    return 1
}

_api_is_image_ref() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => an image as a catalog names it, repository[:tag][@sha256:<hex>]
    #    _api_is_image_ref docker.io/library/alpine:3.22  =>  0
    #    _api_is_image_ref -rf                            =>  1
    #A runtime may still turn down what passes here: udocker splits at the first colon
    case "${1}" in
        ''|-*|*[!${ALNUM}._/:@-]*) return 1 ;;
    esac
    return 0
}

#what a channel says when a path or a name it was about to write into a
#launcher cannot be one. It is one sentence and not three because it promises
#what _api_is_unsafe refuses, and a channel that checks only paths says its own
LAUNCHER_UNSAFE="a path or a name here cannot be written into a launcher safely"

_api_is_unsafe() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a string a channel is about to write into a launcher, inside double quotes
    #    _api_is_unsafe jq-1.8.1         =>  1
    #    _api_is_unsafe 'jq$(rm -rf /)'  =>  0
    #    _api_is_unsafe 'say "hi"'       =>  0
    case "${1}" in
        *'"'*|*'$'*|*'`'*|*'\'*|*'
'*) return 0 ;;
    esac
    return 1
}

_api_reads_no() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what the user set a variable to, eg "${CMDFOUND_GITHUB_API}"
    #    _api_reads_no no       =>  0
    #    _api_reads_no " off "  =>  0
    #    _api_reads_no Off      =>  1
    _util_trimmed_in "${1}"
    case "${_util_trimmed_in__out}" in
        off|OFF|no|NO|0|false|FALSE) return 0 ;;
    esac
    return 1
}

_api_reads_yes() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what the user set a variable to, eg "${CMDFOUND_AQUA_ATTESTATIONS}"
    #    _api_reads_yes yes  =>  0
    #    _api_reads_yes ON   =>  0
    #    _api_reads_yes ""   =>  1
    #Not the opposite of _api_reads_no: an unwritten setting spells neither
    _util_trimmed_in "${1}"
    case "${_util_trimmed_in__out}" in
        on|ON|yes|YES|1|true|TRUE) return 0 ;;
    esac
    return 1
}

_api_is_fresh() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a file a channel left a cached answer in
    [ -s "${1}" ] || return 1
    #--latest is what sets CMDFOUND_REFRESH
    [ -n "${CMDFOUND_REFRESH}" ] && return 1
    #find, because no shell built-in reads an mtime; -1440 minutes is the day
    [ -n "$(find "${1}" -mmin -1440 2>/dev/null)" ]
}

_api_program_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the programs a package installs, a line each, $2 => the one asked
    #for, or nothing. Leaves in __out the one asked for, or the only one there
    #is: a name nobody asked for is not run on a guess. 1 with the reason in
    #why, said after the package's name
    #    _api_program_in "one${NL}two" two  =>  0, __out two
    #    _api_program_in "rg" ""            =>  0, __out rg
    #    _api_program_in "one${NL}two" jq   =>  1, why has no program called jq,
    #                                       it has one and two; name one with --bin
    _api_program_in__out=""
    if [ -n "${2}" ] && _has_line "${1}" "${2}"; then
        _api_program_in__out="${2}"; return 0
    elif _util_is_one_line "${1}"; then
        _api_program_in__out="${1}"; return 0
    elif [ -z "${1}" ]; then
        why="installs no program"; return 1
    fi
    _api_program_in__list="$(printf "%s\\n" "${1}" | awk 'NF {a[++n] = $0} END {for (i = 1; i <= n; i++) printf("%s%s", (i == 1 ? "" : (i == n ? " and " : ", ")), a[i])}')"
    if [ -n "${2}" ]; then
        why="has no program called ${2}, it has ${_api_program_in__list}; name one with --bin"
    else
        why="has more than one program, ${_api_program_in__list}; name one with --bin"
    fi
    return 1
}

_api_tool_home() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #HOME, the XDG directories and TMPDIR in this channel's directory, and
    #exported, so that a tool reads no setting of the user's and leaves nothing
    #outside the channel. A subshell's to call, before it runs the tool
    _util_mkdir_p "${CH}/home"; _util_mkdir_p "${CH}/tmp"
    HOME="${CH}/home"; XDG_CACHE_HOME="${CH}/home/.cache"; XDG_CONFIG_HOME="${CH}/home/.config"
    XDG_DATA_HOME="${CH}/home/.local/share"; XDG_STATE_HOME="${CH}/home/.local/state"
    TMPDIR="${CH}/tmp"
    export HOME XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME TMPDIR
}

_api_shown() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => this channel's log, $2... => a command. Runs it where what it says
    #while it works is seen: the terminal when there is one, else the end of
    #the log. Never on stdout, which is the channel's answer to cmdfound
    _sh__log="${1}"; shift
    if [ -t 2 ]; then
        "${@}" </dev/null >&2
    else
        "${@}" </dev/null >> "${_sh__log}" 2>&1
    fi
}

_api_log_hint() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => this channel's log. see _api_shown
    [ -t 2 ] || printf ", its account is in %s" "${1}"
}

_api_launch_source() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    printf "%s\\n" "$(_realdir "${SELF}")/confined-launch"
}

_api_latest_release() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #the version of the newest release of this channel's tool, at its RELEASES
    #on github, kept a day under its TOOL_NAME: the tag after a v, or the tag
    #as it is when it starts with the version, as micromamba's do
    _api_latest_tag_in "${RELEASES}" "${CH}/cache/${TOOL_NAME}.latest" || return 1
    case "${_api_latest_tag_in__out}" in
        v[0-9]*) printf "%s\\n" "${_api_latest_tag_in__out#v}" ;;
        [0-9]*) printf "%s\\n" "${_api_latest_tag_in__out}" ;;
        *) return 1 ;;
    esac
}

_api_export_network_settings() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #exports the proxy, no-proxy and certificate variables curl, wget and most
    #tools read, out of the user's own ~/.curlrc and ~/.wgetrc, which are handed to
    #no download (see _api_fetcher). One the user already set, in any spelling, is
    #left alone. With neither file this costs no process. Where there is no curl,
    #which wget this one is gets settled here too, before any channel runs
    command -v curl >/dev/null 2>&1 || ! command -v wget >/dev/null 2>&1 || _api_wget_options
    _nw__curlrc=""
    if [ -n "${CURL_HOME}" ] && [ -f "${CURL_HOME}/.curlrc" ]; then
        _nw__curlrc="${CURL_HOME}/.curlrc"
    elif [ -n "${XDG_CONFIG_HOME}" ] && [ -f "${XDG_CONFIG_HOME}/curlrc" ]; then
        _nw__curlrc="${XDG_CONFIG_HOME}/curlrc"
    elif [ -n "${HOME}" ] && [ -f "${HOME}/.curlrc" ]; then
        _nw__curlrc="${HOME}/.curlrc"
    fi
    _nw__wgetrc="${WGETRC:-${HOME:+${HOME}/.wgetrc}}"
    [ -n "${_nw__wgetrc}" ] && [ -f "${_nw__wgetrc}" ] || _nw__wgetrc=""
    [ -z "${_nw__curlrc}${_nw__wgetrc}" ] && return 0

    #one line a setting: name, a space, the value. A proxy carries the user it is
    #reached as, percent encoded, since no variable holds that apart
    _nw__out="$(_NW_CURLRC="${_nw__curlrc}" _NW_WGETRC="${_nw__wgetrc}" LC_ALL=C awk '
        function unslash(s,   out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\"") break
                if (c == "\\") {
                    c = substr(s, ++i, 1)
                    if (c == "t") c = "\t"; else if (c == "n") c = "\n"
                    else if (c == "r") c = "\r"; else if (c == "v") c = "\v"
                }
                out = out c
            }
            return out
        }
        #what curl does with a line of its config: a name, ended by a blank
        #or, without dashes, by = or :, then blanks and separators, then a
        #value that is quoted, with backslash escapes, or ends at a blank
        function curlrc(f,   line, name, rest, dashed, value) {
            while ((getline line < f) > 0) {
                sub(/^[ \t\r\n\v\f]+/, "", line)
                if (line == "" || line ~ /^[#\/*]/) continue
                dashed = (substr(line, 1, 1) == "-")
                if (dashed) match(line, /^[^ \t\r\n\v\f]+/)
                else        match(line, /^[^ \t\r\n\v\f=:]+/)
                name = substr(line, 1, RLENGTH); rest = substr(line, RLENGTH + 2)
                if (dashed) sub(/^[ \t\r\n\v\f]+/, "", rest)
                else        sub(/^[ \t\r\n\v\f=:]+/, "", rest)
                if (substr(rest, 1, 1) == "\"") value = unslash(substr(rest, 2))
                else { match(rest, /^[^ \t\r\n\v\f]*/); value = substr(rest, 1, RLENGTH) }
                if (!dashed) name = "--" name
                if (name ~ /^-[xU]./) { value = substr(name, 3); name = substr(name, 1, 2) }
                if (name == "--proxy" || name == "-x") c["proxy"] = value
                else if (name == "--proxy-user" || name == "-U") c["user"] = value
                else if (name == "--noproxy") c["noproxy"] = value
                else if (name == "--cacert") c["cacert"] = value
                else if (name == "--capath") c["capath"] = value
                else if (name == "--proxy-cacert") c["proxycacert"] = value
            }
            close(f)
        }
        #and what wget does with a line of its own: name = value, the name
        #read in any case and without its _ and -
        function wgetrc(f,   line, name, value) {
            while ((getline line < f) > 0) {
                sub(/^[ \t\r\n\v\f]+/, "", line); sub(/[ \t\r\n\v\f]+$/, "", line)
                if (line == "" || substr(line, 1, 1) == "#") continue
                match(line, /^[A-Za-z0-9_-]*/)
                name = tolower(substr(line, 1, RLENGTH)); gsub(/[_-]/, "", name)
                value = substr(line, RLENGTH + 1)
                if (!sub(/^[ \t\r\n\v\f]*=[ \t\r\n\v\f]*/, "", value)) continue
                if (name == "httpproxy") w["http"] = value
                else if (name == "httpsproxy") w["https"] = value
                else if (name == "noproxy") w["noproxy"] = value
                else if (name == "cacertificate") w["cacert"] = value
                else if (name == "cadirectory") w["capath"] = value
                else if (name == "proxyuser") w["user"] = value
                else if (name == "proxypassword" || name == "proxypasswd") w["password"] = value
                else if (name == "useproxy") w["use"] = tolower(value)
            }
            close(f)
        }
        function pct(s,   out, i, ch) {
            if (!ord["A"]) for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
            out = ""
            for (i = 1; i <= length(s); i++) {
                ch = substr(s, i, 1)
                out = out ((ch ~ /[A-Za-z0-9._~-]/) ? ch : sprintf("%%%02X", ord[ch]))
            }
            return out
        }
        #a proxy with no scheme is http, as it is to curl and to wget, and a
        #user given apart takes the place of one written into it
        function proxy(p, user, password,   scheme, rest, auth) {
            if (p !~ /^[A-Za-z][A-Za-z0-9+.-]*:\/\//) p = "http://" p
            if (user == "") return p
            match(p, /^[A-Za-z][A-Za-z0-9+.-]*:\/\//)
            scheme = substr(p, 1, RLENGTH); rest = substr(p, RLENGTH + 1)
            auth = rest; sub(/[\/?#].*$/, "", auth)
            if (match(auth, /.*@/)) rest = substr(rest, RLENGTH + 1)
            return scheme pct(user) (password != "" ? ":" pct(password) : "") "@" rest
        }
        function put(name, value) {
            if (value != "") printf("%s %s\n", name, value)
        }
        BEGIN {
            if (ENVIRON["_NW_CURLRC"] != "") curlrc(ENVIRON["_NW_CURLRC"])
            if (ENVIRON["_NW_WGETRC"] != "") wgetrc(ENVIRON["_NW_WGETRC"])
            u = c["user"]; pw = ""
            if (index(u, ":")) { pw = substr(u, index(u, ":") + 1); u = substr(u, 1, index(u, ":") - 1) }
            if (c["proxy"] != "") {
                put("http_proxy", proxy(c["proxy"], u, pw)); put("https_proxy", proxy(c["proxy"], u, pw))
            } else if (w["use"] !~ /^(off|no|0)$/) {
                if (w["http"] != "") put("http_proxy", proxy(w["http"], w["user"], w["password"]))
                if (w["https"] != "") put("https_proxy", proxy(w["https"], w["user"], w["password"]))
            }
            put("no_proxy", (c["noproxy"] != "") ? c["noproxy"] : w["noproxy"])
            put("cacert", (c["cacert"] != "") ? c["cacert"] : w["cacert"])
            put("capath", (c["capath"] != "") ? c["capath"] : w["capath"])
            #the certificates of a proxy reached over https have no variable
            #of their own: curl checks the proxy against the same ones as
            #everything else, and so does every tool. Said, when it matters
            if (c["proxycacert"] != "" && c["proxycacert"] != c["cacert"] && c["proxy"] ~ /^https:\/\//)
                put("proxycacert", c["proxycacert"])
        }')"

    _nw__rest="${_nw__out}"; _nw__said=""
    while [ -n "${_nw__rest}" ]; do
        _nw__line="${_nw__rest%%${NL}*}"
        _nw__value="${_nw__line#* }"
        case "${_nw__line}" in
            "http_proxy "*)
                #all_proxy is a proxy for every protocol, and would take this one's place
                [ -n "${http_proxy+1}${HTTP_PROXY+1}${all_proxy+1}${ALL_PROXY+1}" ] || {
                    http_proxy="${_nw__value}"; HTTP_PROXY="${_nw__value}"
                    export http_proxy HTTP_PROXY
                } ;;
            "https_proxy "*)
                [ -n "${https_proxy+1}${HTTPS_PROXY+1}${all_proxy+1}${ALL_PROXY+1}" ] || {
                    https_proxy="${_nw__value}"; HTTPS_PROXY="${_nw__value}"
                    export https_proxy HTTPS_PROXY
                    _nw__said="1"
                } ;;
            "no_proxy "*)
                [ -n "${no_proxy+1}${NO_PROXY+1}" ] || {
                    no_proxy="${_nw__value}"; NO_PROXY="${_nw__value}"
                    export no_proxy NO_PROXY
                } ;;
            #curl reads CURL_CA_BUNDLE before SSL_CERT_FILE, so both are set together
            "cacert "*)
                [ -n "${SSL_CERT_FILE+1}${CURL_CA_BUNDLE+1}" ] || {
                    SSL_CERT_FILE="${_nw__value}"; CURL_CA_BUNDLE="${_nw__value}"
                    export SSL_CERT_FILE CURL_CA_BUNDLE
                } ;;
            "capath "*)
                [ -n "${SSL_CERT_DIR+1}" ] || { SSL_CERT_DIR="${_nw__value}"; export SSL_CERT_DIR; } ;;
            "proxycacert "*)
                [ -n "${_nw__said}" ] && \
                    _msg "${PROGNAME}: proxy-cacert in ${_nw__curlrc} has no variable to go in, so the proxy is checked against the certificates everything else is" ;;
        esac
        [ X"${_nw__line}" = X"${_nw__rest}" ] && break
        _nw__rest="${_nw__rest#*${NL}}"
    done
    return 0
}

_api_wget_options() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #busybox's wget - Alpine's - refuses both options, and a GNU wget older than
    #1.17 refuses --no-hsts, so what this one takes is asked once. --no-hsts also
    #keeps wget from writing ~/.wget-hsts, a file of the user's
    [ -n "${CMDFOUND_WGET_OPTIONS+1}" ] && return 0
    case "$(wget --help 2>&1)" in
        *BusyBox*) CMDFOUND_WGET_OPTIONS="" ;;
        *hsts*) CMDFOUND_WGET_OPTIONS="--no-config --no-hsts" ;;
        *) CMDFOUND_WGET_OPTIONS="--no-config" ;;
    esac
    export CMDFOUND_WGET_OPTIONS
}

_api_fetcher_bin() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #Leaves in g_fetcher_bin the downloader this machine has, curl before wget
    #    a machine with curl     =>  0, g_fetcher_bin curl
    #    one with wget only      =>  0, g_fetcher_bin wget, CMDFOUND_WGET_OPTIONS set
    #    one with neither        =>  1, and the caller says so its own way

    #asked once: a run fetches many times, and the answer cannot change under it.
    #wget's options are settled here too, so that a caller reading them inside a
    #pipeline is not the one who has to export them
    [ -n "${g_fetcher_bin}" ] && return 0
    if command -v "curl" >/dev/null 2>&1; then
        g_fetcher_bin="curl"
    elif command -v "wget" >/dev/null 2>&1; then
        g_fetcher_bin="wget"; _api_wget_options
    else
        return 1
    fi
    return 0
}

_api_fetcher() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => url, $2 => destination file, absent means stdout
    _api_fetcher_bin || {
        printf "%s\\n" "${PROGNAME}: install either 'curl' or 'wget'" >&2
        return 1
    }

    if _util_is_local "${1}"; then
        _api_fetcher__src="${1#file://}"
        [ -z "${2}" ] && { cat "${_api_fetcher__src}"; return "${?}"; }
        cp "${_api_fetcher__src}" "${2}" 2>/dev/null
        return "${?}"
    fi

    #curl's -q keeps ~/.curlrc out, and curl heeds it only as its very first
    #argument; wget's --no-config, from _api_wget_options, keeps ~/.wgetrc out. The
    #network they set up still arrives: see _api_export_network_settings
    case "${g_fetcher_bin}" in
        curl) [ -z "${2}" ] && { curl -q -fsSL "${1}"; return "${?}"; }
              curl -q -fsSL -o "${2}" "${1}" ;;
        wget) [ -z "${2}" ] && { wget ${CMDFOUND_WGET_OPTIONS} -q -O- "${1}"; return "${?}"; }
              wget ${CMDFOUND_WGET_OPTIONS} -q -O "${2}" "${1}" ;;
    esac
}

_api_fetcher_verified() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => url, $2 => its published sha256 (optional). 0 leaves the file at
    #g_fetched and its sha256 in g_fetched_digest
    g_fetched="${g_home}/tmp/artifact.$$"; g_fetched_digest=""
    _util_mkdir_p "${g_home}/tmp" || return 1
    rm -rf "${g_fetched}" "${g_fetched}.d"

    _verbose "${PROGNAME}: fetching ${1}"
    _api_fetcher "${1}" "${g_fetched}" || {
        rm -f "${g_fetched}"
        _msg "${PROGNAME}: could not fetch ${1}"
        return 1
    }

    g_fetched_digest="$(_util_checksum "${g_fetched}")" || {
        rm -f "${g_fetched}"
        _msg "${PROGNAME}: no sha256 program here, cannot name what was downloaded"
        return 1
    }

    #verification is a badge and not a gate, with one exception: a published
    #checksum that does not match is a different file from the one meant
    if [ -n "${2}" ] && [ X"${2}" != X"${g_fetched_digest}" ]; then
        rm -f "${g_fetched}"
        _msg "${PROGNAME}: published checksum does not match what arrived"
        _msg "${PROGNAME}: wanted ${2}"
        _msg "${PROGNAME}: got    ${g_fetched_digest}"
        return 1
    fi
}

#what a channel says when a catalog download stopped. It is one sentence and
#not six because it promises what _api_fetcher_resumable does - the part stays,
#with its etag, and the next run goes on from it - so a change there would
#otherwise leave six channels saying something that is no longer true
CATALOG_STOPPED="could not be downloaded; what arrived is kept, and the next try goes on from there"

#how few rows is too few for a catalog to be one this reader still understands.
#A number every channel checks against, so that moving it is one edit
CATALOG_FLOOR="100"

#what a channel says when a question needs the catalog it has not fetched yet
NO_INDEX="there is no local catalog yet, run: cmdfound --index-update"

#how a channel's _search matches: each word asked for, in any case and order,
#is somewhere in the text the channel's own awk hands words_in. Put in front of
#that awk, which says what the text is and prints the lines. The words come
#as search_words through the environment, since awk -v reads a backslash in
#them as an escape
SEARCH_AWK='
    BEGIN { _sw_n = split(tolower(ENVIRON["search_words"]), _sw_w, " ") }
    function words_in(hay,    i) {
        hay = tolower(hay)
        for (i = 1; i <= _sw_n; i++) if (index(hay, _sw_w[i]) == 0) return 0
        return 1
    }
'

_api_fetcher_resumable() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => url or path, $2 => the name a stopped download is left under.
    #0 complete, 1 not there, 2 could not be had
    #the fetching goes to a name of this run's own, $2.<pid>
    _fr__kept="${2}"; _fr__part="${2}.$$"
    if [ -f "${_fr__kept}" ] && mv "${_fr__kept}" "${_fr__part}" 2>/dev/null; then
        [ -f "${_fr__kept}.etag" ] && mv "${_fr__kept}.etag" "${_fr__part}.etag" 2>/dev/null
    fi
    if _util_is_local "${1}"; then
        [ -f "${1#file://}" ] || { _api_fetcher_leave_partial; return 1; }
        cp "${1#file://}" "${_fr__part}" 2>/dev/null || { _api_fetcher_leave_partial; return 2; }
        return 0
    fi
    _api_fetcher_bin || { _api_fetcher_leave_partial; return 2; }
    if [ X"${g_fetcher_bin}" != X"curl" ]; then
        #wget cannot ask whether the file is still the same one, so it starts over
        rm -f "${_fr__part}" "${_fr__part}.etag"
        wget ${CMDFOUND_WGET_OPTIONS} -q -O "${_fr__part}" "${1}" 2>/dev/null
        case "${?}" in
            0) return 0 ;;
            8) rm -f "${_fr__part}"; return 1 ;;
        esac
        _api_fetcher_leave_partial; return 2
    fi
    _fr__etag=""
    [ -s "${_fr__part}" ] && IFS= read -r _fr__etag 2>/dev/null < "${_fr__part}.etag"
    [ -z "${_fr__etag}" ] && rm -f "${_fr__part}" "${_fr__part}.etag"
    if [ -n "${_fr__etag}" ]; then
        curl -q -sSL -C - -H "If-Range: ${_fr__etag}" -D "${_fr__part}.headers" -o "${_fr__part}" \
            -w '%{http_code}' "${1}" > "${_fr__part}.code" 2>/dev/null &
    else
        curl -q -sSL -D "${_fr__part}.headers" -o "${_fr__part}" -w '%{http_code}' "${1}" > "${_fr__part}.code" 2>/dev/null &
    fi
    _fr__pid="${!}"
    #stopped from outside, the download stops with it and what arrived stays,
    #with the etag it came with: a part with no etag is started over
    trap 'kill "${_fr__pid}" 2>/dev/null; wait "${_fr__pid}" 2>/dev/null
          _api_fetcher_keep_etag; rm -f "${_fr__part}.code" "${_fr__part}.headers"
          _api_fetcher_leave_partial; exit 143' TERM INT HUP
    wait "${_fr__pid}"; _fr__rc="${?}"
    trap - TERM INT HUP
    _fr__code=""; IFS= read -r _fr__code 2>/dev/null < "${_fr__part}.code"
    rm -f "${_fr__part}.code"
    _api_fetcher_keep_etag
    rm -f "${_fr__part}.headers"
    if [ -n "${_fr__etag}" ] && [ X"${_fr__rc}" = X"33" ]; then
        rm -f "${_fr__part}" "${_fr__part}.etag"
        _api_fetcher_resumable "${1}" "${_fr__kept}"
        return "${?}"
    fi
    case "${_fr__code}" in
        200|206) [ "${_fr__rc}" -eq "0" ] && [ -s "${_fr__part}" ] && { rm -f "${_fr__part}.etag"; return 0; } ;;
        #asked to go on past the end: there was nothing left to fetch
        416) [ -s "${_fr__part}" ] && { rm -f "${_fr__part}.etag"; return 0; } ;;
        403|404|410) rm -f "${_fr__part}" "${_fr__part}.etag"; return 1 ;;
    esac
    _api_fetcher_leave_partial; return 2
}

_api_catalog_fetch() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the catalog's url or path, $2 => the name a stopped download is left
    #under, $3 => whose catalog it is, as the messages name it. Says why and
    #exits 2 when the catalog is not there or did not all arrive
    #    _api_catalog_fetch "${DIST}/pantry.tar.xz" "${kept}" pkgx
    _api_fetcher_resumable "${1}" "${2}"
    case "${?}" in
        0) return 0 ;;
        1) printf "unreachable=%s\\n" "there is no ${3} catalog at ${1}" ;;
        *) printf "unreachable=%s\\n" "${3}'s catalog ${CATALOG_STOPPED}" ;;
    esac
    exit 2
}

_api_catalog_keep() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => the catalog just made, $2 => where it goes, $3 => how many it lists,
    #$4 => the catalog as the messages name it, $5... => what else was made for
    #it. Moves it in, or, when it lists fewer than CATALOG_FLOOR or cannot be
    #moved, removes it and the rest, says the old catalog is kept and exits 2
    #    _api_catalog_keep "${new}" "${INDEX}" "${n}" "AM's catalog"
    _ck__new="${1}"; _ck__index="${2}"; _ck__count="${3}"; _ck__what="${4}"
    shift 4
    if ! _util_is_number "${_ck__count}" || [ "${_ck__count}" -lt "${CATALOG_FLOOR}" ]; then
        _ck__said="came back in a shape this channel cannot read"
    elif ! mv "${_ck__new}" "${_ck__index}"; then
        _ck__said="could not be put in place"
    else
        return 0
    fi
    rm -rf "${_ck__new}" "${@}"
    printf "unreachable=%s, the old catalog is kept\\n" "${_ck__what} ${_ck__said}"
    exit 2
}

_api_fetcher_keep_etag() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #the etag _api_fetcher_resumable's part arrived with, kept beside it for the
    #next run's If-Range, which takes only a strong one
    [ -n "${_fr__etag}" ] && return 0
    tr -d '\r' < "${_fr__part}.headers" 2>/dev/null | \
        awk 'tolower($1) == "etag:" && $2 ~ /^"/ {e = $2} END {if (e != "") print e}' > "${_fr__part}.etag"
}

_api_fetcher_leave_partial() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #what _api_fetcher_resumable got of a download, left under the name the next
    #run looks for
    if [ -s "${_fr__part}" ]; then
        #an etag left over from bytes nobody has any more resumes the wrong file
        if [ -f "${_fr__part}.etag" ]; then
            mv "${_fr__part}.etag" "${_fr__kept}.etag" 2>/dev/null
        else
            rm -f "${_fr__kept}.etag"
        fi
        mv "${_fr__part}" "${_fr__kept}" 2>/dev/null
    fi
    rm -f "${_fr__part}" "${_fr__part}.etag"
    return 0
}

_api_fetcher_answered() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url or a path, $2 => the file to write it into, then each header to
    #send. 0 fetched, 1 there is no such thing, 2 could not be had
    #    _api_fetcher_answered "${REGISTRY}/v2/jq/manifests/1" "${f}"  =>  0
    #    _api_fetcher_answered "${REGISTRY}/v2/jq/manifests/9" "${f}"  =>  1
    #    a third argument and any after it is a header: "Accept: ${ACCEPT}"
    #-q and --no-config keep the user's own rc files out, as in _api_fetcher
    _fa__url="${1}"; _fa__to="${2}"; shift 2
    if _util_is_local "${_fa__url}"; then
        [ -f "${_fa__url#file://}" ] || return 1
        cp "${_fa__url#file://}" "${_fa__to}" 2>/dev/null || return 2
        return 0
    fi

    _api_fetcher_bin || return 2
    _fa__bin="${g_fetcher_bin}"

    #each header goes back onto the end of $@ with its program's flag: sh has no
    #array, and one string would split on the space in a header
    _fa__unflagged="${#}"
    while [ "${_fa__unflagged}" -gt "0" ]; do
        case "${_fa__bin}" in
            curl) set -- "${@}" -H "${1}" ;;
            wget) set -- "${@}" "--header=${1}" ;;
        esac
        shift; _fa__unflagged="$((_fa__unflagged - 1))"
    done

    case "${_fa__bin}" in
        curl) #a 200 whose body could not be written down is not a fetch
              _fa__code="$(curl -q -sSL "${@}" -o "${_fa__to}" -w '%{http_code}' "${_fa__url}" 2>/dev/null)"
              _fa__rc="${?}"
              case "${_fa__code}" in
                  200) [ "${_fa__rc}" -eq "0" ] && [ -f "${_fa__to}" ] && return 0 ;;
                  403|404|410) rm -f "${_fa__to}"; return 1 ;;
              esac
              rm -f "${_fa__to}"; return 2 ;;
        wget) wget ${CMDFOUND_WGET_OPTIONS} -q "${@}" -O "${_fa__to}" "${_fa__url}" 2>/dev/null
              #8 is wget's own: the server answered, and said no
              case "${?}" in
                  0) return 0 ;;
                  8) rm -f "${_fa__to}"; return 1 ;;
              esac
              rm -f "${_fa__to}"; return 2 ;;
    esac
}

_api_fetcher_code_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url or a path, $2 => the file its body goes into, then each header
    #to send. Leaves the status in __out, 000 when nobody answered
    #    _api_fetcher_code_in "${API}/rate_limit" "${f}"  =>  __out 200
    #    a rate limit                                 =>  __out 403, and in ${f} the
    #                                                     page that says so
    #
    #The headers reach curl as its configuration, on stdin: on its command line
    #any account here reads them out of ps, and a token is a header. wget takes
    #one only on its command line, so it is sent no Authorization, and keeps no
    #body but a 200's
    _fci__url="${1}"; _fci__to="${2}"; shift 2
    _api_fetcher_code_in__out="000"
    if _util_is_local "${_fci__url}"; then
        _api_fetcher_code_in__out="404"
        cp "${_fci__url#file://}" "${_fci__to}" 2>/dev/null && _api_fetcher_code_in__out="200"
        return 0
    fi
    _api_fetcher_bin || return 1

    case "${g_fetcher_bin}" in
        curl) _api_fetcher_code_in__out="$(for _fci__h in "${@}"; do
                      printf 'header = "%s"\n' "${_fci__h}"
                  done | curl -q -sSL -K - -o "${_fci__to}" -w '%{http_code}' "${_fci__url}" 2>/dev/null)" ;;
        wget) #each header goes back onto the end of $@ with its flag, as in
              #_api_fetcher_answered, all but the one that would show a token
              _fci__unflagged="${#}"
              while [ "${_fci__unflagged}" -gt "0" ]; do
                  case "${1}" in
                      [Aa]uthorization:*) ;;
                      *) set -- "${@}" "--header=${1}" ;;
                  esac
                  shift; _fci__unflagged="$((_fci__unflagged - 1))"
              done
              _api_fetcher_code_in__out="$(wget ${CMDFOUND_WGET_OPTIONS} -S "${@}" -O "${_fci__to}" \
                  "${_fci__url}" 2>&1 | awk '/^ *HTTP\// {c = $2} END {print c}')" ;;
    esac
    [ -n "${_api_fetcher_code_in__out}" ] || _api_fetcher_code_in__out="000"
    return 0
}

_api_github_token_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    _api_github_token_in__out="${GITHUB_TOKEN:-${GH_TOKEN}}"
    [ -n "${_api_github_token_in__out}" ]
}

_api_fetcher_github_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url of github's api, $2 => the file its body goes into. Answers as
    #_api_fetcher_code_in, asking in github's own json and with the user's token,
    #when there is one: the token goes to github's api and nowhere else
    #    _api_fetcher_github_in "${API}/rate_limit" "${f}"  =>  __out 200
    if _api_github_token_in; then
        _api_fetcher_code_in "${1}" "${2}" "Accept: application/vnd.github+json" \
            "Authorization: Bearer ${_api_github_token_in__out}"
    else
        _api_fetcher_code_in "${1}" "${2}" "Accept: application/vnd.github+json"
    fi
    _fgi__rc="${?}"
    _api_fetcher_github_in__out="${_api_fetcher_code_in__out}"
    return "${_fgi__rc}"
}

_api_fetcher_head_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url, $2 => the header to read, $3 => any value to follow redirects
    #    _api_fetcher_head_in "${u}" content-length on  =>  __out 3600000, __code 200
    #    _api_fetcher_head_in "${u}/latest" location ""  =>  __out the url it points
    #                                                   at, __code 302
    #    nobody answers                              =>  both empty
    #
    #A redirect is an answer to some callers and a detour to others, which is
    #why following it is asked for and not assumed: the tag of a release is
    #read out of the Location github sends, and is gone once it is followed
    _fhi__url="${1}"; _fhi__want="${2}"; _fhi__follow="${3}"; shift 3
    _api_fetcher_head_in__out=""; _api_fetcher_head_in__code=""
    _api_fetcher_bin || return 1

    #each header goes back onto the end of $@ with its program's flag, as in
    #_api_fetcher_answered: sh has no array, and one string would split on the
    #space inside a header
    _fhi__unflagged="${#}"
    while [ "${_fhi__unflagged}" -gt "0" ]; do
        case "${g_fetcher_bin}" in
            curl) set -- "${@}" -H "${1}" ;;
            wget) set -- "${@}" "--header=${1}" ;;
        esac
        shift; _fhi__unflagged="$((_fhi__unflagged - 1))"
    done

    #curl is told to follow and wget is told not to, because following is
    #curl's no and wget's yes
    _fhi__curl=""; _fhi__wget="--max-redirect=0"
    [ -n "${_fhi__follow}" ] && { _fhi__curl="-L"; _fhi__wget=""; }

    #wget says its headers on stderr, and only while refusing to fetch the body
    _fhi__both="$(case "${g_fetcher_bin}" in
        curl) curl -q -sSI ${_fhi__curl} "${@}" "${_fhi__url}" 2>/dev/null ;;
        wget) wget ${CMDFOUND_WGET_OPTIONS} -S --spider ${_fhi__wget} \
                  "${@}" "${_fhi__url}" 2>&1 ;;
    esac | tr -d '\r' | awk -v want="${_fhi__want}:" '
        toupper(substr($1, 1, 5)) == "HTTP/" {code = $2; v = ""}
        tolower($1) == tolower(want) {v = $2}
        END {printf("%s %s\n", code, v)}')"
    _api_fetcher_head_in__code="${_fhi__both%% *}"
    _api_fetcher_head_in__out="${_fhi__both#* }"
    return 0
}

_api_fetcher_head_size() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url or a path. Prints what fetching it would transfer, without
    #transferring it, and nothing when nobody can say: the length a 404 comes
    #with is the page's, not the file's
    #    _api_fetcher_head_size "${REPO}/jq-1.7.tar.gz"  =>  1258291
    if _util_is_local "${1}"; then
        #awk, because a wc that pads its count would print the size unreadable
        [ -f "${1#file://}" ] && wc -c < "${1#file://}" | awk '{print $1}'
        return 0
    fi
    _api_fetcher_head_in "${1}" content-length follow || return 0
    case "${_api_fetcher_head_in__out}" in ''|*[!0-9]*) return 0 ;; esac
    [ X"${_api_fetcher_head_in__code}" = X"200" ] && \
        printf "%s\\n" "${_api_fetcher_head_in__out}"
    return 0
}

_api_latest_tag_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a repository's releases on github, a url or a path, $2 => a file the
    #answer is kept in for a day (optional). Leaves in __out the tag of its
    #latest release. 0 a tag, 1 no release, 2 github could not be asked
    #    _api_latest_tag_in https://github.com/jqlang/jq/releases  =>  0, __out jq-1.8.2
    #    a repository with no release                          =>  1
    #
    #read from where releases/latest redirects, and not from github's api, which
    #counts every question. With no release github sends it to the list of
    #releases, which names no tag, or says it is not there, and that is kept
    #too, as a dash. A path is a directory holding the tag in a file latest
    _api_latest_tag_in__out=""; _lti__kept="${2}"
    if [ -n "${_lti__kept}" ] && _api_is_fresh "${_lti__kept}"; then
        IFS= read -r _api_latest_tag_in__out < "${_lti__kept}"
        [ X"${_api_latest_tag_in__out}" = X"-" ] && { _api_latest_tag_in__out=""; return 1; }
        return 0
    fi
    _lti__tag=""; _lti__code=""
    if _util_is_local "${1}"; then
        IFS= read -r _lti__tag 2>/dev/null < "${1#file://}/latest"
        [ -n "${_lti__tag}" ] || return 1
    else
        _api_fetcher_head_in "${1}/latest" location ""
        _lti__code="${_api_fetcher_head_in__code}"
        case "${_api_fetcher_head_in__out}" in
            */tag/?*) _lti__tag="${_api_fetcher_head_in__out##*/}" ;;
        esac
    fi
    case "${_lti__tag}" in
        ''|*[!${ALNUM}._+-]*)
            case "${_lti__code}" in
                302|404) [ -n "${_lti__kept}" ] && _util_mkdir_p "${_lti__kept%/*}" && \
                             printf "%s\\n" "-" > "${_lti__kept}"
                         return 1 ;;
            esac
            #yesterday's latest is still a release that exists
            [ -n "${_lti__kept}" ] && [ -s "${_lti__kept}" ] || return 2
            IFS= read -r _api_latest_tag_in__out < "${_lti__kept}"
            [ X"${_api_latest_tag_in__out}" = X"-" ] && { _api_latest_tag_in__out=""; return 1; }
            return 0 ;;
    esac
    [ -n "${_lti__kept}" ] && _util_mkdir_p "${_lti__kept%/*}" && \
        printf "%s\\n" "${_lti__tag}" > "${_lti__kept}"
    _api_latest_tag_in__out="${_lti__tag}"
    return 0
}

_api_answer_failed() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1... => why this channel cannot place what it was asked for
    printf "failed=%s\\n" "${*}"
    exit 1
}

_api_answer_unreachable() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1... => why this channel could not ask, or be asked: the question stays
    #open, where failed= closes it
    printf "unreachable=%s\\n" "${*}"
    exit 2
}

_api_answer_no_index() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #what a channel answers when a question needs the catalog it has not fetched
    #yet. _probe_all holds it back for _first_catalogs, which offers to fetch it
    printf "%s\\n" "unreachable=${NO_INDEX}" "needs=index"
    exit 2
}

_api_answer_bytes_of() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a url or a path. What fetching it would download, as bytes=
    _api_answer_bytes_of__n="$(_api_fetcher_head_size "${1}")"
    [ -n "${_api_answer_bytes_of__n}" ] && printf "bytes=%s\\n" "${_api_answer_bytes_of__n}"
    exit 0
}

_api_answer_unresolved() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what the channel's own _resolve answered, $2 => what goes in front of
    #each candidate's name. why, noindex and cands are _resolve's to set
    #    _api_answer_unresolved 1 ""        =>  exits 1, nobody has the name
    #    _api_answer_unresolved 2 ""        =>  unreachable=${why}, exits 2
    #    _api_answer_unresolved 3 nixpkgs.  =>  candidate=nixpkgs.jq, exits 3
    case "${1}" in
        0) return 0 ;;
        1) exit 1 ;;
        2) printf "unreachable=%s\\n" "${why}"
           #see _api_answer_no_index, which is this pair on its own
           [ -n "${noindex}" ] && printf "needs=%s\\n" "index"
           exit 2 ;;
        3) printf "%s\\n" "${cands}" | awk -v p="${2}" 'NF {print "candidate=" p $0}'; exit 3 ;;
        #going on with repo and cmd unset is worse than saying it was not asked
        *) printf "unreachable=%s\\n" \
               "this channel's _resolve answered ${1}, which is no answer"
           exit 2 ;;
    esac
}

###############################################################################
#################################### util #####################################
###############################################################################

_util_has_word() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => words, $2 => a whole word
    #    _util_has_word "aqua pkgx" "pkgx"  =>  0
    #    _util_has_word "aqua pkgx" "pkg"   =>  1

    #the spaces make the match whole, as the newlines do in _has_line, and a
    #case, because a grep is a process
    case " ${1} " in
        *" ${2} "*) return 0 ;;
    esac
    return 1
}

_util_replace_in() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => text, $2 => each character to replace, $3 => what goes in its place
    #    _util_replace_in "aqua:jqlang/jq@1.7" "/:@" "_"  =>  aqua_jqlang_jq_1.7
    #    _util_replace_in "via docker hub" " " ":"        =>  via:docker:hub
    _util_replace_in__out=""
    _util_replace_in__rest="${1}"
    while case "${_util_replace_in__rest}" in *[${2}]*) ;; *) false ;; esac; do
        _util_replace_in__out="${_util_replace_in__out}${_util_replace_in__rest%%[${2}]*}${3}"
        _util_replace_in__rest="${_util_replace_in__rest#*[${2}]}"
    done
    _util_replace_in__out="${_util_replace_in__out}${_util_replace_in__rest}"
    return 0
}

_util_checksum() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    [ -f "${1}" ] || return 1

    if command -v "sha256sum" >/dev/null 2>&1; then
        sha256sum "${1}" | awk '{print $1; exit}'
    elif command -v "shasum" >/dev/null 2>&1; then
        shasum -a 256 "${1}" | awk '{print $1; exit}'
    elif command -v "openssl" >/dev/null 2>&1; then
        openssl dgst -sha256 "${1}" | awk '{print $NF; exit}'
    else
        return 1
    fi
}

_util_mkdir_p() { #@frozen 2026-10-25 m@javier.io 2e226ed
    [ -z "${1}" ] && return 1
    [ -d "${1}" ] && return 0
    mkdir -p "${1}" 2>/dev/null
}

_util_realpath() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #where this file really lives: the plugin manager exposes every tool as a link
    #on the PATH, so ${0%/*} is that directory and the channels are not next to it
    _realdir__path="${1}"
    _realdir__hops="0"
    while [ -L "${_realdir__path}" ] && [ "${_realdir__hops}" -lt "16" ]; do
        _realdir__link="$(readlink "${_realdir__path}" 2>/dev/null)" || break
        case "${_realdir__link}" in
            /*) _realdir__path="${_realdir__link}" ;;
             *) _realdir__path="${_realdir__path%/*}/${_realdir__link}" ;;
        esac
        _realdir__hops="$((${_realdir__hops} + 1))"
    done
    case "${_realdir__path}" in
        */*) printf "%s\\n" "${_realdir__path}" ;;
          *) printf "%s\\n" "./${_realdir__path}" ;;
    esac
}

_util_machine_in() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #the kernel and the processor, in uname's own two words, asked once: a run
    #cannot move to another machine under it. Each channel names them its way
    #    _util_machine_in  =>  __os Linux, __cpu x86_64
    [ -n "${_util_machine_in__os}" ] && return 0
    _util_machine_in__os="$(uname -s 2>/dev/null)"
    _util_machine_in__cpu="$(uname -m 2>/dev/null)"
    return 0
}

_util_is_number() { #@frozen 2026-10-25 m@javier.io 2e226ed
    case "${1}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

_util_now_ms() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #milliseconds, where date can say them, and whole seconds where it cannot
    _nm__nanos="$(date +%s%N 2>/dev/null)"
    case "${_nm__nanos}" in
        ''|*[!0-9]*) printf "%s\\n" "$(( $(date +%s) * 1000 ))" ;;
        *) printf "%s\\n" "$(( _nm__nanos / 1000000 ))" ;;
    esac
}

_util_is_empty_but() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a directory, $2 => one path in it that is on its way out:
    #    _util_is_empty_but by/jq by/jq/1.7.1  =>  0, when 1.7.1 is all by/jq holds
    #    _util_is_empty_but by/jq by/jq/1.7.1  =>  1, when 1.8.0 is there too
    #    _util_is_empty_but by/jq by/jq/1.7.1  =>  0, when by/jq holds nothing: every
    #                                         caller removes $2 before it asks

    #Three globs because one does not see all of a directory: * misses .cache,
    #.[!.]* misses ..private. A glob that matches nothing stands as itself
    for _ieb__entry in "${1}"/* "${1}"/.[!.]* "${1}"/..?*; do
        [ -e "${_ieb__entry}" ] || [ -L "${_ieb__entry}" ] || continue
        [ X"${_ieb__entry}" = X"${2}" ] && continue
        return 1
    done
    return 0
}

#a newline and a tab, so that one inside a pattern is a word: a line break no
#longer splits the line it is written on, and three tabs can be counted
NL="
"
TAB="	"

#the alphabet written out: POSIX leaves A-Z unspecified outside the C locale
ALNUM="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

_util_is_one_line() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #    _util_is_one_line store/jq-1.7/bin/jq  =>  0
    #    _util_is_one_line ""                   =>  1
    #    _util_is_one_line "one${NL}two"        =>  1
    case "${1}" in
        ''|*"${NL}"*) return 1 ;;
    esac
    return 0
}

_util_is_url() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a url about to be written into the command line of a program this runs
    #    _util_is_url https://dl-cdn.alpinelinux.org/alpine  =>  0
    #    _util_is_url ftp://dl-cdn.alpinelinux.org/alpine    =>  0
    #    _util_is_url "https://dl-cdn.alpinelinux.org/a b"   =>  1
    case "${1}" in
        ''|*[!${ALNUM}._~:/%+@=-]*) return 1 ;;
    esac
    return 0
}

_util_is_sha256() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => checksum
    [ "${#1}" -eq "64" ] || return 1
    case "${1}" in
        *[!0-9a-f]*) return 1 ;;
    esac
    return 0
}

_util_is_digest() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => a digest, the sha256: a registry names an image by and its checksum
    case "${1}" in
        sha256:*) _util_is_sha256 "${1#sha256:}" ;;
        *) return 1 ;;
    esac
}

_util_is_local() { #@frozen 2026-10-25 m@javier.io 2e226ed
    case "${1}" in
        file://?*|/*|./*) return 0 ;;
    esac
    return 1
}

_util_trimmed_in() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a string as someone typed it
    #    _util_trimmed_in "  off "  =>  off
    #    _util_trimmed_in " a b "   =>  a b

    #A loop, because sed is a process
    _util_trimmed_in__out="${1}"
    while :; do
        case "${_util_trimmed_in__out}" in
            [" ${TAB}"]*) _util_trimmed_in__out="${_util_trimmed_in__out#?}" ;;
            *[" ${TAB}"]) _util_trimmed_in__out="${_util_trimmed_in__out%?}" ;;
            *) break ;;
        esac
    done
    return 0
}

_util_first_line() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what a command said, $2 => what to say when it said nothing. Its
    #first line, which is where a tool puts its reason, and the one an answer
    #has room for
    #    _util_first_line "error: no such host${NL}  at ..." "no reason"  =>  error: no such host
    #    _util_first_line "" "it gave no reason"                          =>  it gave no reason
    _fl__line="${1%%"${NL}"*}"
    printf "%s\\n" "${_fl__line:-${2}}"
}

_util_lower() { #@frozen 2026-10-25 m@javier.io 2e226ed
    printf "%s\\n" "${1}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz'
}

_util_write_aside() { #@frozen 2026-10-25 m@javier.io 2e226ed
    #$1 => a file, $2 => its mode (optional). Writes what comes on stdin beside
    #it and moves it in, so that whoever reads it never sees it half written.
    #What was written aside goes when it cannot be moved in
    #    printf "%s\\n" "${ref}" | _util_write_aside "${idx}.ref"
    #    { ...a launcher... } | _util_write_aside "${run}/${cmd}" 755
    cat > "${1}.$$" && { [ -z "${2}" ] || chmod "${2}" "${1}.$$"; } && \
        mv -f "${1}.$$" "${1}" && return 0
    rm -f "${1}.$$"
    return 1
}

_util_removable() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1... => trees. Gives their owner back write permission on each directory
    #in them, which nix and apk take away: without it rm -rf cannot unlink what
    #is inside. Files stay as they are, since rm does not need them writable
    for _rm__tree in "${@}"; do
        [ -d "${_rm__tree}" ] || continue
        find "${_rm__tree}" -type d ! -perm -u+w -exec chmod u+w {} + 2>/dev/null
    done
    return 0
}

_util_trap_exit() { #@reviewed 2026-10-25 m@javier.io 2e226ed
    #$1 => what to run when this process ends. HUP, INT and TERM end it with
    #the status the shell gives a signal, 128 and its number, through exit,
    #since a signal left to its default ends the shell without the EXIT trap
    trap "${1}" EXIT
    trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
}

#json is read with awk and not matched with patterns, so these read a string
#the way json writes one: \uXXXX becomes utf-8, a surrogate pair included, and
#a control escape becomes a space, the output being one line a record
JSON_STRINGS='
 function hex(h,   i, n) {
    n = 0; h = tolower(h)
    for (i = 1; i <= length(h); i++) n = n * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1
    return n
 }
 function utf8(n) {
    if (n < 128) return sprintf("%c", n)
    if (n < 2048) return sprintf("%c%c", 192 + int(n / 64), 128 + n % 64)
    if (n < 65536) return sprintf("%c%c%c", 224 + int(n / 4096), 128 + int(n / 64) % 64, 128 + n % 64)
    return sprintf("%c%c%c%c", 240 + int(n / 262144), 128 + int(n / 4096) % 64, 128 + int(n / 64) % 64, 128 + n % 64)
 }
 function unesc(s,   out, i, c, n, lo) {
    if (index(s, "\\") == 0) return s
    out = ""
    while ((i = index(s, "\\")) > 0) {
        out = out substr(s, 1, i - 1)
        c = substr(s, i + 1, 1)
        if (c == "u") {
            n = hex(substr(s, i + 2, 4)); s = substr(s, i + 6)
            if (n >= 55296 && n < 56320 && substr(s, 1, 2) == "\\u") {
                lo = hex(substr(s, 3, 4))
                if (lo >= 56320 && lo < 57344) { n = 65536 + (n - 55296) * 1024 + (lo - 56320); s = substr(s, 7) }
            }
            out = out utf8(n)
            continue
        }
        if (c == "n" || c == "t" || c == "r" || c == "f" || c == "b") out = out " "
        else out = out c
        s = substr(s, i + 2)
    }
    return out s
 }'

_util_json() { #@reviewed 2026-10-25 m@javier.io 2e226ed
#$1 => the deepest level worth printing (99), $2 => any value to also print
#an object or array that opens above it. Reads json on stdin and prints a
#line per value: its path, keys and array positions joined by /, a tab, and
#the value
#    {"a":{"b":1}}   with 9     =>  a/b<TAB>1
#    {"a":{}}        with 9     =>  nothing: the object is empty
#    {"a":{}}        with 9 on  =>  a<TAB>{   , which is how a docker login
#                                   a credential helper keeps is still seen
    LC_ALL=C awk -v maxd="${1:-99}" -v shown="${2}" "${JSON_STRINGS}"'
    function path(   p, i) {
        p = ""
        for (i = 1; i <= depth; i++) p = p (i > 1 ? "/" : "") (kind[i] == "o" ? key[i] : idx[i])
        return p
    }
    function flush() {
        if (tok != "") { if (depth <= maxd) printf("%s\t%s\n", path(), tok); tok = "" }
    }
    function structure(seg,   i, n, c) {
        n = length(seg)
        for (i = 1; i <= n; i++) {
            c = substr(seg, i, 1)
            if (c == "{" || c == "[") {
                if (shown != "" && depth >= 1 && depth < maxd) printf("%s\t%s\n", path(), c)
                depth++; kind[depth] = (c == "{") ? "o" : "a"; idx[depth] = 0; key[depth] = ""
                expect = (c == "{") ? "key" : "value"
            }
            else if (c == "}" || c == "]") { flush(); depth--; expect = "" }
            else if (c == ":") expect = "value"
            else if (c == ",") { flush(); if (kind[depth] == "o") expect = "key"; else { idx[depth]++; expect = "value" } }
            else if (c != " " && c != "\t" && c != "\n" && c != "\r") tok = tok c
        }
    }
    BEGIN { RS = "\""; depth = 0; instr = 0; buf = ""; tok = "" }
    {
        if (!instr) { structure($0); instr = 1; buf = ""; next }
        buf = buf $0
        if (match(buf, /\\+$/) && RLENGTH % 2 == 1) { buf = buf "\""; next }
        instr = 0
        if (expect == "key") { key[depth] = unesc(buf); next }
        if (depth <= maxd) printf("%s\t%s\n", path(), unesc(buf))
    }'
}

###############################################################################
#################################### main #####################################
###############################################################################

PROGNAME="$(expr "${0}" : '.*/\([^/]*\)')"
[ -z "${PROGNAME}" ] && PROGNAME="cmdfound"

#unset cmdfound vars
g_ifs="${IFS}"; set -f; IFS="${NL}"
for g_line in $(export -p); do
    case "${g_line}" in
        "export "*)     g_line="${g_line#export }" ;;
        "declare -x "*) g_line="${g_line#declare -x }" ;;
        *) continue ;;
    esac
    case "${g_line%%=*}" in
        *[!a-z0-9_]*) ;;
        _[a-z]*|g_*) unset "${g_line%%=*}" ;;
    esac
done
set +f; IFS="${g_ifs}"; unset g_ifs g_line

#options are read only until the spec appears; everything after it belongs to
#the program being run
while [ "${#}" -gt "0" ]; do
    case "${1}" in
        -h|--help)      _usage; exit 0 ;;
        -V|--version)   printf "%s\\n" "${PROGNAME} ${VERSION}"; exit 0 ;;
        -v|--verbose)   g_verbose="1";   shift ;;
        -q|--quiet)     g_quiet="1";     shift ;;
        -n|--dry-run)   g_dry_run="1";   shift ;;
        -y|--yes)       g_assume_yes="1"; shift ;;
        -L|--latest)    g_latest="1"; CMDFOUND_REFRESH="1"; export CMDFOUND_REFRESH; shift ;;
        -e|--ephemeral) g_ephemeral="1"; shift ;;
        -l|--list)      g_list="1";      shift ;;
        -i|--index-update) g_index_update="1"; shift ;;
        -a|--apropos)   g_apropos="1";   shift ;;
        -b|--bin)       shift; g_bin_name="${1}"; [ -n "${1}" ] && shift ;;
        --bin=*)        g_bin_name="${1#--bin=}"; shift ;;
        -p|--purge)     g_purge="1";     shift ;;
        -U|--update)    g_do_update="1"; shift ;;
        --hook)         shift; _hook "${1}"; exit "${?}" ;;
        --hook=*)       _hook "${1#--hook=}"; exit "${?}" ;;
        --channel)      shift; [ -n "${1}" ] || _die "${PROGNAME}: --channel takes a channel"
                        _api_channel "${@}"; exit "${?}" ;;
        --)             shift; break ;;
        -*)             _die "${PROGNAME}: unrecognized option '${1}'" ;;
        *)              break ;;
    esac
done

#every run clears a throwaway root that outlived the run that made it, and
#does it before this one makes its own: see _sweep_ephemeral
_sweep_ephemeral

if [ -n "${g_ephemeral}" ]; then
    #named with this run's pid, so the next run tells one in use from one left behind
    CMDFOUND_HOME="$(mktemp -d "${TMPDIR:-/tmp}/cmdfound-eph.$$.XXXXXX" 2>/dev/null)" || \
        _die "${PROGNAME}: could not make a throwaway root"
    #and every channel is told: what one keeps outside that root would outlive it
    CMDFOUND_EPHEMERAL="1"
    export CMDFOUND_HOME CMDFOUND_EPHEMERAL
    trap 'rm -rf "${CMDFOUND_HOME}"' EXIT HUP INT TERM
fi

g_home="$(_home)"
export CMDFOUND_HOME="${g_home}"

#the network the user gave curl and wget reaches every download and every tool
#from here on, and not the program run at the end, which gets the environment
#as the user has it
[ -n "${g_do_update}${g_index_update}${g_apropos}${g_list}${g_purge}" ] && \
    _api_export_network_settings
[ -n "${g_do_update}" ]    && { _update; exit "${?}"; }
#channels.conf is read here, once; names in it that are no channel are warned once
[ -n "${g_index_update}${g_apropos}" ] && _channels_conf warn
[ -n "${g_index_update}" ] && { _index_update "${1}"; exit "${?}"; }
[ -n "${g_apropos}" ]      && { _apropos "${@}"; exit "${?}"; }
[ -n "${g_list}" ]         && { _list "${1}"; exit 0; }
[ -n "${g_purge}" ]        && { _purge "${1}"; exit "${?}"; }

[ -z "${1}" ] && _die "${PROGNAME}: nothing asked for"
g_asked="${1}"; shift
_spec_in "${g_asked}"; g_package="${_spec_in__package}"
[ -z "${g_package}" ] && _die "${PROGNAME}: '${g_asked}' names no package"
g_spec="$(_canonical_spec "${g_asked}")" || exit "${COMMAND_NOT_FOUND}"
#the program that was asked for, which a channel is told whenever it is asked
#where something lives or to install it: typing wat2wasm once ran
#spectest-interp, another program of the same package, with the user's arguments
g_want="${g_bin_name:-${g_package##*/}}"

#the cheapest answer first: the second run of a command has to be
#indistinguishable from having it installed
if [ -z "${g_latest}" ] && [ -z "${g_dry_run}" ]; then
    g_program="$(_remembered_program "${g_spec}" "${g_want}")" && exec "${g_program}" "${@}"
fi

_channels_conf warn

if [ -n "${g_dry_run}" ]; then
    _api_export_network_settings
    g_resolution="$(_resolve "${g_spec}")" || exit "${COMMAND_NOT_FOUND}"
    _show_routes "${g_resolution}" "${g_want}"
    exit 0
fi

g_program="$(_api_export_network_settings; _obtained "${g_spec}" "${g_asked}" "${g_want}" "${g_bin_name}")" || exit "${COMMAND_NOT_FOUND}"
exec "${g_program}" "${@}"
