#!/bin/sh
#description: cmdfound channel - Alpine packages, installed by apk inside the image
#usage: alpine meta | alpine index [bytes] | alpine search WORDS...
#       alpine probe NAME [VER] | alpine recipe PACKAGE VER [PROGRAM]

RELEASE="3.22"
MIRROR="${CMDFOUND_ALPINE_MIRROR:-https://dl-cdn.alpinelinux.org/alpine}"
HUB="https://registry-1.docker.io"
REGISTRY="${CMDFOUND_ALPINE_REGISTRY:-${HUB}}"
REPOSITORY="library/alpine"
IMAGE="docker.io/${REPOSITORY}:${RELEASE}"
ALPINE="Alpine ${RELEASE}"
#what the image has, with all it depends on: alpine-minirootfs's /etc/apk/world
#and what busybox wget needs to fetch over https. libc-utils is no package but
#a name musl-utils provides
BASE="alpine-baselayout alpine-keys alpine-release apk-tools busybox busybox-binsh ca-certificates-bundle libc-utils ssl_client"
ACCEPT="application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json"
#CMDFOUND_CHANNEL_FILE and not $0: the resolver sources this, and $0 is its own
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
#all the channel has is under it, so one rm -rf removes the channel whole
CH="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"
#cmd   COMMAND  PACKAGE
#pkg   PACKAGE  VERSION  SIZE  INSTALLED-SIZE  main|community  DESCRIPTION
#prov  TOKEN    PACKAGE   so:, pc:, cmd:, a path or a name the package provides
#dep   PACKAGE  TOKEN     a dependency, its version dropped; no conflict (!name)
#inst  PACKAGE  TOKEN     its install_if, versions dropped and a !name kept
INDEX="${CH}/index/alpine.tsv"
token=""

_platform() {
    #sets apkarch as Alpine names this cpu, goarch and govariant as an image index does
    #    x86_64  =>  x86_64, amd64, ''
    #    armv7l  =>  armv7, arm, v7
    _util_machine_in
    case "${_util_machine_in__cpu}" in
        x86_64|amd64)            apkarch="x86_64";  goarch="amd64";   govariant="" ;;
        aarch64|arm64)           apkarch="aarch64"; goarch="arm64";   govariant="" ;;
        armv7l|armv7)            apkarch="armv7";   goarch="arm";     govariant="v7" ;;
        i386|i486|i586|i686|x86) apkarch="x86";     goarch="386";     govariant="" ;;
        ppc64le)                 apkarch="ppc64le"; goarch="ppc64le"; govariant="" ;;
        s390x)                   apkarch="s390x";   goarch="s390x";   govariant="" ;;
        riscv64)                 apkarch="riscv64"; goarch="riscv64"; govariant="" ;;
        *) return 1 ;;
    esac
    return 0
}

_indexer() {
    #$1 => the index to write, then the APKINDEX of main and of community
    #    P:figlet V:2.2.5-r3 p:cmd:figlet  =>  cmd   figlet      figlet
    #                                          pkg   figlet      2.2.5-r3  ...  main  ...
    #                                          prov  cmd:figlet  figlet

    #cmd and pkg lines first: whoever asks only what a name is stops there
    _ix__out="${1}"; shift
    LC_ALL=C awk -v out="${_ix__out}" '
    function flush(   n, i, t, a) {
        if (name != "") {
            if (size !~ /^[0-9]+$/) size = 0
            if (isize !~ /^[0-9]+$/) isize = 0
            gsub(/\t/, " ", desc)
            printf("pkg\t%s\t%s\t%s\t%s\t%s\t%s\n", name, ver, size, isize, repo, desc) > (out ".pkg")
            n = split(provides, a, " ")
            for (i = 1; i <= n; i++) {
                t = a[i]; sub(/=.*$/, "", t)
                if (t == "") continue
                printf("prov\t%s\t%s\n", t, name) > (out ".prov")
                if (substr(t, 1, 4) == "cmd:" && length(t) > 4) printf("cmd\t%s\t%s\n", substr(t, 5), name) > (out ".cmd")
            }
            n = split(deps, a, " ")
            for (i = 1; i <= n; i++) {
                #a conflict is not something to install, and which version
                #is apk'\''s to pick
                t = a[i]
                if (substr(t, 1, 1) == "!") continue
                sub(/[<>=~].*$/, "", t)
                if (t != "") printf("dep\t%s\t%s\n", name, t) > (out ".dep")
            }
            n = split(installif, a, " ")
            for (i = 1; i <= n; i++) {
                #here a ! is kept: it asks for a name not to be there
                t = a[i]; neg = ""
                if (substr(t, 1, 1) == "!") { neg = "!"; t = substr(t, 2) }
                sub(/[<>=~].*$/, "", t)
                if (t != "") printf("inst\t%s\t%s%s\n", name, neg, t) > (out ".inst")
            }
        }
        name = ""; ver = ""; size = ""; isize = ""; desc = ""; deps = ""; provides = ""; installif = ""
    }
    FNR == 1 { flush(); repo = (++files == 1) ? "main" : "community" }
    { sub(/\r$/, "") }
    $0 == "" { flush(); next }
    {
        k = substr($0, 1, 2); v = substr($0, 3)
        if (k == "P:") name = v
        else if (k == "V:") ver = v
        else if (k == "S:") size = v
        else if (k == "I:") isize = v
        else if (k == "T:") desc = v
        else if (k == "D:") deps = v
        else if (k == "p:") provides = v
        else if (k == "i:") installif = v
    }
    END {
        flush()
        #every kind has a file, even an empty one, so that joining them
        #does not fail over a kind nothing had
        printf("") > (out ".cmd"); printf("") > (out ".pkg"); printf("") > (out ".prov"); printf("") > (out ".dep"); printf("") > (out ".inst")
    }' "${@}" && \
    cat "${_ix__out}.cmd" "${_ix__out}.pkg" "${_ix__out}.prov" "${_ix__out}.dep" "${_ix__out}.inst" > "${_ix__out}"
    _ix__rc="${?}"
    rm -f "${_ix__out}.cmd" "${_ix__out}.pkg" "${_ix__out}.prov" "${_ix__out}.dep" "${_ix__out}.inst"
    return "${_ix__rc}"
}

_valid() {
    #$1 => package, $2 => version
    #    _valid figlet 2.2.5-r3   =>  0
    #    _valid -figlet 2.2.5-r3  =>  1
    case "${1}" in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*) return 1 ;;
    esac
    _api_is_version "${2}" || return 1
    return 0
}

_is_token() {
    case "${1}" in
        ''|*[!${ALNUM}._-]*) return 1 ;;
    esac
    return 0
}

_token() {
    #a Docker Hub pull token in token, none for another registry
    _util_is_local "${REGISTRY}" && return 0
    [ X"${REGISTRY}" = X"${HUB}" ] || return 0
    [ -n "${token}" ] && return 0
    _tk__f="${CH}/tmp/token.$$"
    _api_fetcher_answered "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${REPOSITORY}:pull" "${_tk__f}" || {
        rm -f "${_tk__f}"
        return 1
    }
    token="$(_util_json 1 < "${_tk__f}" | awk -F'\t' '$1 == "token" {print $2; exit}')"
    rm -f "${_tk__f}"
    _is_token "${token}" || { token=""; return 1; }
    return 0
}

_ask_digest() {
    #the image's digest in asked, from the registry or a file:// copy of it
    #    _ask_digest  =>  0, sha256:4bcff6...
    asked=""
    if _util_is_local "${REGISTRY}"; then
        _ad__f="${REGISTRY#file://}/v2/${REPOSITORY}/manifests/${RELEASE}"
        [ -f "${_ad__f}" ] || return 1
        asked="sha256:$(_util_checksum "${_ad__f}")"
        _util_is_digest "${asked}"
        return "${?}"
    fi
    _token || return 1
    _ad__url="${REGISTRY}/v2/${REPOSITORY}/manifests/${RELEASE}"
    #no redirect is followed: a manifest is answered where it is asked for
    set -- "Accept: ${ACCEPT}"
    [ -n "${token}" ] && set -- "${@}" "Authorization: Bearer ${token}"
    _api_fetcher_head_in "${_ad__url}" docker-content-digest "" "${@}" || return 1
    [ X"${_api_fetcher_head_in__code}" = X"200" ] && asked="${_api_fetcher_head_in__out}"
    _util_is_digest "${asked}"
}

_manifest() {
    #$1 => a digest, $2 => the file its manifest goes into
    if _util_is_local "${REGISTRY}"; then
        _api_fetcher_answered "${REGISTRY#file://}/v2/${REPOSITORY}/manifests/${1}" "${2}"
        return "${?}"
    fi
    _token || return 2
    if [ -n "${token}" ]; then
        _api_fetcher_answered "${REGISTRY}/v2/${REPOSITORY}/manifests/${1}" "${2}" "Accept: ${ACCEPT}" "Authorization: Bearer ${token}"
    else
        _api_fetcher_answered "${REGISTRY}/v2/${REPOSITORY}/manifests/${1}" "${2}" "Accept: ${ACCEPT}"
    fi
}

_layers() {
    #a manifest's _util_json lines on stdin; what its layers weigh, compressed
    #    layers/0/size 3640000, layers/1/size 12  =>  3640012
    awk -F'\t' '
        { n = split($1, p, "/") }
        n == 3 && p[1] == "layers" && p[3] == "size" && $2 ~ /^[0-9]+$/ { t += $2; k++ }
        END { if (k) printf("%.0f\n", t) }'
}

_ask_image_bytes() {
    #$1 => a digest, and in asked what the image weighs on this platform
    #    _ask_image_bytes sha256:4bcff6...  =>  0, 3640012
    asked=""
    _ab__f="${CH}/tmp/manifest.$$"
    _manifest "${1}" "${_ab__f}" || { rm -f "${_ab__f}"; return 1; }
    _ab__rows="$(_util_json 4 < "${_ab__f}")"
    rm -f "${_ab__f}"
    asked="$(printf "%s\\n" "${_ab__rows}" | _layers)"
    [ -n "${asked}" ] && return 0
    _ab__d="$(printf "%s\\n" "${_ab__rows}" | awk -F'\t' -v a="${goarch}" -v v="${govariant}" '
        { n = split($1, p, "/") }
        n == 3 && p[1] == "manifests" && p[3] == "digest" { d[p[2]] = $2 }
        n == 4 && p[1] == "manifests" && p[3] == "platform" { plat[p[2], p[4]] = $2 }
        END {
            for (i = 0; (i "") in d; i++)
                if (plat[i, "os"] == "linux" && plat[i, "architecture"] == a && (v == "" || plat[i, "variant"] == v)) { print d[i]; exit }
        }')"
    _util_is_digest "${_ab__d}" || return 1
    _manifest "${_ab__d}" "${_ab__f}" || { rm -f "${_ab__f}"; return 1; }
    asked="$(_util_json 3 < "${_ab__f}" | _layers)"
    rm -f "${_ab__f}"
    [ -n "${asked}" ]
}

_image() {
    #$1 => bytes, to weigh it too; sets image_ref, by digest when known, and image_bytes
    #    _image        =>  docker.io/library/alpine:3.22@sha256:4bcff6...
    #    _image bytes  =>  docker.io/library/alpine:3.22@sha256:4bcff6..., 3640012

    #never fails: out of reach, the digest kept is used however old
    _im__mode="${1}"
    image_ref="${IMAGE}"; image_bytes=""
    _util_mkdir_p "${CH}/cache/manifests"; _util_mkdir_p "${CH}/tmp"
    _im__f="${CH}/cache/image.digest"
    if _api_is_fresh "${_im__f}"; then
        IFS= read -r _im__d < "${_im__f}"
    elif _ask_digest; then
        _im__d="${asked}"
        printf "%s\\n" "${_im__d}" | _util_write_aside "${_im__f}" 2>/dev/null
    else
        _im__d=""; IFS= read -r _im__d 2>/dev/null < "${_im__f}"
    fi
    _util_is_digest "${_im__d}" || return 0
    image_ref="${IMAGE}@${_im__d}"
    [ X"${_im__mode}" = X"bytes" ] || return 0

    _im__b="${CH}/cache/manifests/${_im__d#sha256:}.${apkarch}"
    if [ ! -s "${_im__b}" ]; then
        _ask_image_bytes "${_im__d}" || return 0
        printf "%s\\n" "${asked}" | _util_write_aside "${_im__b}" 2>/dev/null
        image_bytes="${asked}"
        return 0
    fi
    IFS= read -r image_bytes < "${_im__b}"
    _util_is_number "${image_bytes}" || image_bytes=""
    return 0
}

_meta() {
    printf "%s\\n" "kind=catalog" "confines=yes" "describes=environment"
    exit 0
}

_index() {
    #$1 => "bytes" to weigh the catalog instead of fetching it
    mode="${1}"
    _platform || _api_answer_unreachable "${ALPINE} is not built for ${_util_machine_in__cpu}"
    if [ X"${mode}" = X"bytes" ]; then
        _ib__t="0"
        for _ib__repo in main community; do
            _ib__b="$(_api_fetcher_head_size "${MIRROR}/v${RELEASE}/${_ib__repo}/${apkarch}/APKINDEX.tar.gz")"
            [ -n "${_ib__b}" ] || { _ib__t=""; break; }
            _ib__t="$((_ib__t + _ib__b))"
        done
        [ -n "${_ib__t}" ] && printf "bytes=%s\\n" "${_ib__t}"
        exit 0
    fi
    _util_mkdir_p "${CH}/index" || exit 1
    new="${INDEX}.$$"; bytes="0"
    for repo in main community; do
        part="${CH}/index/${repo}.part.$$"
        _api_fetcher_resumable "${MIRROR}/v${RELEASE}/${repo}/${apkarch}/APKINDEX.tar.gz" "${CH}/index/${repo}.part"
        case "${?}" in
            0) ;;
            1) _api_answer_unreachable "there is no ${repo} catalog for ${ALPINE} on ${apkarch} at ${MIRROR}" ;;
            *) _api_answer_unreachable "Alpine's ${repo} catalog ${CATALOG_STOPPED}" ;;
        esac
        bytes="$((bytes + $(wc -c < "${part}")))"
    done
    #not cut short from here, or what was fetched stays behind under this pid
    trap '' TERM INT HUP
    #the signature is apk's to check, in the image
    #TAR_OPTIONS and GZIP emptied: either set would change what comes out
    for repo in main community; do
        if ! TAR_OPTIONS= GZIP= tar -xzOf "${CH}/index/${repo}.part.$$" APKINDEX > "${new}.${repo}" 2>/dev/null; then
            rm -f "${new}.main" "${new}.community" "${CH}/index/main.part.$$" "${CH}/index/community.part.$$"
            _api_answer_unreachable "Alpine's ${repo} catalog could not be unpacked, the old catalog is kept"
        fi
    done
    _indexer "${new}" "${new}.main" "${new}.community"
    rc="${?}"
    rm -f "${new}.main" "${new}.community" "${CH}/index/main.part.$$" "${CH}/index/community.part.$$"
    rows="0"
    [ "${rc}" -ne "0" ] || rows="$(awk -F'\t' '$1 == "pkg" {n++} END {print n + 0}' "${new}" 2>/dev/null)"
    _api_catalog_keep "${new}" "${INDEX}" "${rows}" "Alpine's catalog"
    printf "packages=%s\\n" "$(awk -F'\t' '$1 == "pkg" {n++} END {print n + 0}' "${INDEX}")"
    printf "names=%s\\n" "$(awk -F'\t' '$1 == "cmd" && !seen[$2]++ {n++} END {print n + 0}' "${INDEX}")"
    printf "bytes=%s\\n" "${bytes}"
    exit 0
}

_search() {
    #$1... => the words to look for
    [ -s "${INDEX}" ] || _api_answer_no_index
    search_words="${*}" LC_ALL=C awk -F'\t' -v ch="${SELF_NAME}" "${SEARCH_AWK}"'
        #mawk makes c[$3] before it asks whether c has it, so the question
        #is an if of its own and not part of the assignment
        $1 == "cmd" { if (($3) in c) c[$3] = c[$3] "," $2; else c[$3] = $2; next }
        $1 == "pkg" {
            cmds = (($2) in c) ? c[$2] : "-"
            if (!words_in($2 " " cmds " " $7)) next
            if (!seen[$2]++) printf("%s:%s\t%s\t%s\n", ch, $2, cmds, $7)
            next
        }
        { exit }' "${INDEX}" | LC_ALL=C sort
    exit 0
}

_probe() {
    #$1 => a command or a package, $2 => a version when one was asked for
    name="${1}"; ver="${2}"
    [ -z "${name}" ] && exit 1
    _platform || exit 1
    [ -s "${INDEX}" ] || _api_answer_no_index
    #grep first: most names are not here, and grep says so ten times faster than awk
    grep -F -q -e "cmd${TAB}${name}${TAB}" -e "pkg${TAB}${name}${TAB}" "${INDEX}" 2>/dev/null || exit 1
    answer="$(ap_name="${name}" ap_ver="${ver}" ap_base="${BASE}" LC_ALL=C awk -F'\t' '
        function decide(   i) {
            decided = 1
            if (nc > 1) { for (i = 1; i <= nc; i++) print "candidate=" cand[i]; rc = 3; return }
            target = (nc == 1) ? cand[1] : name
            if (!(target in ver)) { rc = 1; return }
            if (want != "" && want != ver[target]) { rc = 1; return }
            rc = 0
        }
        #a token is the package of that name, else a provider already
        #had, else the first provider the index lists
        function pick(t,   i, k) {
            if (t in ver) return t
            k = np[t]
            for (i = 1; i <= k; i++) if (prv[t, i] in have) return prv[t, i]
            return (k > 0) ? prv[t, 1] : ""
        }
        #from the packages queued and not walked yet, everything they pull
        #in. With base set, what it reaches is had; without, what it
        #reaches that is not had is summed
        function walk(base,   p, i, d, total) {
            total = 0
            while (head <= tail) {
                p = queue[head++]
                if (!base) {
                    if (p in have) continue
                    total += size[p]
                }
                for (i = 1; i <= nd[p]; i++) {
                    d = pick(dp[p, i])
                    if (d == "" || (d in queued)) continue
                    queued[d] = 1; queue[++tail] = d
                    if (base) have[d] = 1
                }
            }
            return total
        }
        function enqueue(p) { if (p != "" && !(p in queued)) { queued[p] = 1; queue[++tail] = p } }
        #a token is there when the image or the closure has the package of
        #that name, or one that provides it
        function there(t,   i, k) {
            if ((t in have) || (t in queued)) return 1
            k = np[t]
            for (i = 1; i <= k; i++) if ((prv[t, i] in have) || (prv[t, i] in queued)) return 1
            return 0
        }
        #install_if is met when every name it lists is there, and every
        #name it negates is not
        function met(q,   i, t) {
            for (i = 1; i <= ni[q]; i++) {
                t = ip[q, i]
                if (substr(t, 1, 1) == "!") { if (there(substr(t, 2))) return 0 }
                else if (!there(t)) return 0
            }
            return 1
        }
        BEGIN { name = ENVIRON["ap_name"]; want = ENVIRON["ap_ver"]; nroots = split(ENVIRON["ap_base"], roots, " ") }
        !decided && $1 == "cmd" { if ($2 == name && !(($3) in iscand)) { iscand[$3] = 1; cand[++nc] = $3 }; next }
        !decided && $1 == "pkg" { if (!(($2) in ver)) { ver[$2] = $3; size[$2] = $4 }; next }
        !decided { decide(); if (rc != 0) exit }
        $1 == "prov" { k = ++np[$2]; prv[$2, k] = $3; next }
        $1 == "dep"  { k = ++nd[$2]; dp[$2, k] = $3; next }
        $1 == "inst" { if (!(($2) in ni)) cond[++nc_if] = $2; k = ++ni[$2]; ip[$2, k] = $3; next }
        END {
            if (!decided) decide()
            if (rc != 0) exit rc
            tail = 0
            #a root is a name like any dependency: libc-utils is one
            #musl-utils provides. All of them are had before any is walked,
            #so that /bin/sh is busybox-binsh and not whatever is listed first
            for (i = 1; i <= nroots; i++) { r = pick(roots[i]); if (r != "") have[r] = 1 }
            for (i = 1; i <= nroots; i++) enqueue(pick(roots[i]))
            head = 1
            walk(1)
            split("", queued); head = 1; tail = 0
            enqueue(target)
            total = walk(0)
            #what comes along may make more come along, and a package
            #listed early may be met only by one listed after it
            do {
                more = 0
                for (j = 1; j <= nc_if; j++) {
                    q = cond[j]
                    if ((q in have) || (q in queued) || !(q in ver) || !met(q)) continue
                    enqueue(q); total += walk(0); more = 1
                }
            } while (more)
            printf("version=%s\nbytes=%.0f\npackage=%s\n", ver[target], total, target)
        }' "${INDEX}")"
    case "${?}" in
        0) ;;
        3) printf "%s\\n" "${answer}" | LC_ALL=C sort; exit 3 ;;
        *) exit 1 ;;
    esac
    package="$(printf "%s\\n" "${answer}" | awk -F= '$1 == "package" {print $2; exit}')"
    version="$(printf "%s\\n" "${answer}" | awk -F= '$1 == "version" {print $2; exit}')"
    _valid "${package}" "${version}" || exit 1
    _image bytes
    printf "version=%s\\n" "${version}"
    printf "%s\\n" "${answer}" | awk -F= '$1 == "bytes"'
    printf "estimate=%s\\n" "yes"
    printf "package=%s\\n" "${package}"
    printf "image=%s\\n" "${image_ref}"
    [ -n "${image_bytes}" ] && printf "image_bytes=%s\\n" "${image_bytes}"
    exit 0
}

_recipe() {
    #$1 => a package, $2 => its version, $3 => the program asked for
    name="${1}"; ver="${2}"; want="${3}"
    if ! _valid "${name}" "${ver}"; then
        _api_answer_failed "'${name}' '${ver}' is not an Alpine package and version this channel will install"
    fi
    if ! _util_is_url "${MIRROR}"; then
        _api_answer_failed "the mirror '${MIRROR}' has characters this channel will not write into apk's command line"
    fi
    [ -s "${INDEX}" ] || _api_answer_no_index
    found="$(ap_name="${name}" LC_ALL=C awk -F'\t' '
        BEGIN { name = ENVIRON["ap_name"] }
        $1 == "cmd" { if ($3 == name) print "cmd=" $2; next }
        $1 == "pkg" { if ($2 == name) { print "version=" $3; exit }; next }
        { exit }' "${INDEX}")"
    indexed="$(printf "%s\\n" "${found}" | awk -F= '$1 == "version" {print $2; exit}')"
    if [ X"${indexed}" != X"${ver}" ]; then
        _api_answer_failed "alpine's catalog has no ${name} ${ver}$( [ -n "${indexed}" ] && printf ", it has %s" "${indexed}")"
    fi
    programs="$(printf "%s\\n" "${found}" | awk -F= '$1 == "cmd" {print $2}')"
    _api_program_in "${programs}" "${want}" || _api_answer_failed "${name} ${why}"
    program="${_api_program_in__out}"
    if ! _api_is_program_name "${program}"; then
        _api_answer_failed "${name} names a program this channel will not hand a runtime"
    fi
    _image
    printf "image=%s\\n" "${image_ref}"
    printf "install=%s\\n" "apk add --no-cache --repositories-file /dev/null -X ${MIRROR}/v${RELEASE}/main -X ${MIRROR}/v${RELEASE}/community ${name}=${ver}"
    printf "bin=%s\\n" "${program}"
    exit 0
}

case "${1}" in
    meta)   _meta ;;
    index)  _index "${2}" ;;
    search) shift; _search "${@}" ;;
    probe)  _probe "${2}" "${3}" ;;
    recipe) _recipe "${2}" "${3}" "${4}" ;;

    *) printf "%s\\n" "usage: ${SELF_NAME} meta|index|search|probe|recipe" >&2; exit 1 ;;
esac
