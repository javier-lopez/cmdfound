#!/bin/sh
#a channel whose index is quick to fetch. It only has names that start with
#"cat", so no test that asks for another name ever sees it want an index

#this file's own name: $0 is not this file when the resolver sources a
#channel, and CMDFOUND_CHANNEL_FILE is what says which file it is in
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
h="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"

case "${1}" in
    meta)  printf "%s\n" "kind=artifact" "confines=no" "describes=self" ;;
    index) #asked for bytes it weighs the catalog and fetches nothing
           [ X"${2}" = X"bytes" ] && { printf "%s\n" "bytes=10"; exit 0; }
           mkdir -p "${h}/index" && printf "%s\n" "catname" > "${h}/index/names"
           printf "%s\n" "packages=1" "bytes=10" ;;
    probe) case "${2}" in cat*) ;; *) exit 1 ;; esac
           [ -f "${h}/index/names" ] || { printf "%s\n" "unreachable=no local catalog yet" "needs=index"; exit 2; }
           grep -x "${2}" "${h}/index/names" >/dev/null || exit 1
           printf "%s\n" "version=1.0" "bytes=10" ;;
    *) exit 1 ;;
esac
