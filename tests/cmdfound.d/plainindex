#!/bin/sh
#a native channel whose index takes a while to arrive, a byte at a time, and
#has one of the names boxcat has and not the other. It only has names that
#start with "class"

#this file's own name: $0 is not this file when the resolver sources a
#channel, and CMDFOUND_CHANNEL_FILE is what says which file it is in
SELF="${CMDFOUND_CHANNEL_FILE:-${0}}"
SELF_NAME="${SELF##*/}"
h="${CMDFOUND_HOME:-/tmp}/channels/${SELF_NAME}"

case "${1}" in
    meta)  printf "%s\n" "kind=artifact" "confines=no" "describes=self" ;;
    index) [ X"${2}" = X"bytes" ] && { printf "%s\n" "bytes=12"; exit 0; }
           mkdir -p "${h}/index"; part="${h}/index/names.part"
           while [ "$(cat "${part}" 2>/dev/null | wc -c | awk '{print $1}')" -lt "12" ]; do
               printf "%s" "x" >> "${part}"; sleep 0.05
           done
           printf "%s\n" "classname" > "${h}/index/names" && rm -f "${part}"
           printf "%s\n" "packages=1" "bytes=12" ;;
    probe) case "${2}" in class*) ;; *) exit 1 ;; esac
           [ -f "${h}/index/names" ] || { printf "%s\n" "unreachable=no local catalog yet" "needs=index"; exit 2; }
           grep -x "${2}" "${h}/index/names" >/dev/null || exit 1
           printf "%s\n" "version=1.0" "bytes=10" ;;
    *) exit 1 ;;
esac
