#cmdfound's test block, run by tools.sh in this directory
@begin{cmdfound}
#@section{setup}
#this block writes nothing in the home of whoever runs it: cmdfound modifies no
#file of its user's, and its tests are no exception. A mutation that had the
#core ignore CMDFOUND_HOME had this block write a resolution into the real
#~/.cmdfound. So everything runs with a HOME of its own, and nothing the runner
#exported can still name a place in the real one: the XDG base directories are
#unset, and so is every variable that tells a channel's tool where to keep its
#things. A test that wants one sets it itself.
#The real home is only looked at. What cmdfound and the tools its channels
#start would make in it is noted before anything runs, and any of it made, gone
#or changed when the block ends fails the block, named. Only a place nothing
#but such a tool writes is held to its time; what the machine's own tools write
#as well is held only to being there or not. Each place is looked at with the
#shell's own test, nothing is walked or started, and since a file's time moves
#by clock ticks the snapshot waits for the tick after the mark's to begin
realhome="${HOME:-$(awk -F: -v u="$(id -u)" '$3 == u {print $6; exit}' /etc/passwd)}"; homeref="${PWD}/homeref"
homeowned=".cmdfound .cmdfound/cache .cmdfound/channels .cmdfound/tmp .local/share/aquaproj-aqua .sigstore micromamba .local/share/mamba .mamba .conda .conda/environments.txt .cache/mamba .nix-portable .cache/nix .local/state/nix .local/share/nix .nix-profile .nix-defexpr .nix-channels .cargo .cargo/bin .udocker .pkgx .cache/pkgx .local/share/pkgx .config/appman"; homeshared=".docker .wget-hsts .config/gh .local/state/gh .cache/gh"
homelook() { homel=""; homen=""; for homep in ${homeowned} ${homeshared}; do if [ -e "${realhome}/${homep}" ] || [ -L "${realhome}/${homep}" ]; then homel="${homel} ${homep}"; case " ${homeshared} " in *" ${homep} "*) ;; *) [ "${realhome}/${homep}" -nt "${homeref}" ] && homen="${homen} ${homep}" ;; esac; fi; done; return 0; }
homecheck() { homerc="${?}"; homelook; [ X"${homel}" = X"${homewas}" ] && [ -z "${homen}" ] && exit "${homerc}"; printf '%s\n' "the block touched ${realhome}: there before:${homewas:- nothing}; there after:${homel:- nothing}; changed since it began:${homen:- nothing}" >&2; exit 1; }
: > "${homeref}" && until [ "${homeref}.tick" -nt "${homeref}" ]; do : > "${homeref}.tick"; done && homelook && homewas="${homel}" && trap homecheck EXIT
HOME="${PWD}/userhome"; export HOME; mkdir -p "${HOME}"
#cmdfound is cmdfound.in, which reads the cmdfound.d beside it, so a change
#is tested as it is written; what ./build makes of the two is held to them in
#the last section, bundle, at the end of a cycle
mkdir -p inbin && ln -s "$(cd ../.. && pwd)/cmdfound.in" inbin/cmdfound && PATH="$(pwd)/inbin:${PATH}" && export PATH
unset XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_BIN_HOME CURL_HOME WGETRC ZDOTDIR APPSDB APPSLISTDB AQUA_ROOT_DIR AQUA_CONFIG AQUA_GLOBAL_CONFIG AQUA_POLICY_CONFIG TUF_ROOT GH_CONFIG_DIR CARGO_HOME CARGO_INSTALL_ROOT MAMBA_ROOT_PREFIX MAMBARC CONDARC MAMBA_OVERRIDE_RC_FILES CONDA_PKGS_DIRS CONDA_ENVS_DIRS CONDA_ENVS_PATH MAMBA_DEFAULT_ROOT_PREFIX MAMBA_TARGET_PREFIX CONDA_PREFIX CONDA_DEFAULT_ENV NP_LOCATION NP_CONF_STORE NIX_REMOTE NIX_STORE NIX_STORE_DIR NIX_STATE_DIR NIX_LOG_DIR NIX_DATA_DIR NIX_CONF_DIR NIX_DAEMON_SOCKET_PATH NIX_BIN_DIR NIX_LIBEXEC_DIR NIX_CONFIG NIX_USER_CONF_FILES NIX_CACHE_HOME NIX_CONFIG_HOME NIX_DATA_HOME NIX_STATE_HOME PROOT_TMP_DIR UDOCKER_DIR UDOCKER_KEYSTORE UDOCKER_TMP UDOCKER_BIN UDOCKER_LIB UDOCKER_DOC UDOCKER_REPOS UDOCKER_LAYERS UDOCKER_CONTAINERS UDOCKER_TARBALL DOCKER_CONFIG PKGX_DIR PKGX_PANTRY_DIR PKGX_PANTRY_DB_FILE PKGX_DIST_URL
cmdfound -h; test X"${?}"                        = X"0"
cmdfound --help; test X"${?}"                    = X"0"
cmdfound -V | grep "cmdfound" >/dev/null
cmdfound >/dev/null 2>&1; test X"${?}"           = X"1"
cmdfound --nonsense x >/dev/null 2>&1; test X"${?}" = X"1"
#@section{fixtures}
#everything below answers without a network, which is why the channel directory
#is a variable. The fake-* files there are not channels: they stand in for aqua,
#pkgx and AM, and are not executable, which is how the resolver tells them apart
CMDFOUND_CHANNELS="$(cd .. && pwd)/cmdfound.d"; export CMDFOUND_CHANNELS
CMDFOUND_HOME="$(pwd)/home"; export CMDFOUND_HOME
#the machine the block runs on is one it sets up: channels pick their assets by
#uname, and the fixtures below are named for one machine. Its sqlite3 refuses
#the stand-in databases, as a real one does, so nix-portable races with the
#other catalogs in every first fetch below and fails there; its git is what
#nix-portable is handed; its docker is fake-docker with no daemon to reach, so
#no resolution below asks this machine's docker anything
mkdir -p hostbin && printf '%s\n' '#!/bin/sh' 'case "${1}" in -m) echo x86_64 ;; *) echo Linux ;; esac' > hostbin/uname
printf '%s\n' '#!/bin/sh' 'printf "%s\n" "Error: in prepare, file is not a database (26)" >&2' 'exit 1' > hostbin/sqlite3 && printf '%s\n' '#!/bin/sh' 'exit 0' > hostbin/git && chmod 755 hostbin/uname hostbin/sqlite3 hostbin/git
printf '%s\n' '#!/bin/sh' "exec sh '$(cd .. && pwd)/cmdfound.d/fake-docker' \"\$@\"" > hostbin/docker && chmod 755 hostbin/docker
PATH="$(pwd)/hostbin:${PATH}"; export PATH
#AM's catalog comes from a repository here and not from github: the first time,
#a channel with no catalog fetches it, and that must never mean a network
amarch="$(uname -m | sed 's/^amd64$/x86_64/; s/^arm64$/aarch64/')"
mkdir -p amrepo/programs && cp ../cmdfound.d/fake-appman amrepo/APP-MANAGER
{ printf '%s\n' 'some header line that is not a program' '◆ amtool : A tool for the tests. #itsdesktopapp' '◆ amother : Another one.'; i=0; while [ ${i} -lt 110 ]; do printf '◆ amfill%s : filler\n' "${i}"; i=$((i+1)); done; } > "amrepo/programs/${amarch}-apps"
CMDFOUND_AM_REPO="$(pwd)/amrepo"; export CMDFOUND_AM_REPO
#and nix-portable's from a directory here, which only its own tests fill: its
#catalog is fetched in every first race below and must fail without a network
CMDFOUND_NIX_PORTABLE_CHANNEL="$(pwd)/nixch"; export CMDFOUND_NIX_PORTABLE_CHANNEL
#Alpine's catalog too: an APKINDEX of main and of community on a mirror here,
#built as Alpine builds one, and an image registry laid out as its urls are.
#The same files serve every architecture
apfix="$(pwd)/apfix"; apmir="$(pwd)/apmir"; apreg="$(pwd)/apreg"; apsig=".SIGN.RSA.alpine-devel@lists.alpinelinux.org-6165ee59.rsa.pub"
mkdir -p apfix/main apfix/community apfix/small apfix/dup
printf '%s\n' 'musl|1.2.5-r10|411323||so:libc.musl-x86_64.so.1=1|the musl c library' 'busybox|1.37.0-r18|521000|so:libc.musl-x86_64.so.1|cmd:busybox=1.37.0-r18|Size optimized toolbox' 'dash-binsh|0.5.12-r3|1500|dash|/bin/sh cmd:sh=0.5.12-r3|dash as /bin/sh' 'dash|0.5.12-r3|90000|so:libc.musl-x86_64.so.1|cmd:dash=0.5.12-r3|Small and fast POSIX shell' 'busybox-binsh|1.37.0-r18|1600|busybox=1.37.0-r18|/bin/sh cmd:sh=1.37.0-r18|busybox as /bin/sh' 'alpine-baselayout-data|3.7.0-r0|12000|||Alpine base dir structure' 'alpine-baselayout|3.7.0-r0|9000|alpine-baselayout-data=3.7.0-r0 /bin/sh||Alpine base dir structure and init scripts' 'alpine-keys|2.5-r0|13000|||Public keys for Alpine Linux packages' 'ca-certificates-bundle|20250619-r0|140000|||Pre generated bundle of Mozilla certificates' 'zlib|1.3.1-r2|53000|so:libc.musl-x86_64.so.1|so:libz.so.1=1.3.1|A compression library' 'libcrypto3|3.5.1-r0|1800000|so:libc.musl-x86_64.so.1|so:libcrypto.so.3=3|Crypto library from openssl' 'libssl3|3.5.1-r0|350000|so:libc.musl-x86_64.so.1 so:libcrypto.so.3|so:libssl.so.3=3|SSL shared libraries' 'apk-tools|2.14.9-r2|120000|musl>=1.2.3_git20230424 ca-certificates-bundle so:libc.musl-x86_64.so.1 so:libcrypto.so.3 so:libssl.so.3 so:libz.so.1|so:libapk.so.2.14.0=2.14.0 cmd:apk=2.14.9-r2|Alpine Package Keeper' 'scanelf|1.3.8-r1|36000|so:libc.musl-x86_64.so.1|cmd:scanelf=1.3.8-r1|Scan ELF binaries' 'musl-utils|1.2.5-r10|40000|scanelf so:libc.musl-x86_64.so.1|cmd:getconf=1.2.5-r10 cmd:getent=1.2.5-r10 cmd:iconv=1.2.5-r10 cmd:ldconfig=1.2.5-r10 cmd:ldd=1.2.5-r10 libc-utils=1.2.5-r10|the musl c library utilities' 'alpine-release|3.22.5-r0|2096|alpine-keys||Alpine release data' 'alpine-conf|3.20.0-r0|40000|alpine-release scanelf|cmd:setup-alpine=3.20.0-r0|Alpine configuration scripts' 'ssl_client|1.37.0-r18|5000|so:libc.musl-x86_64.so.1 so:libcrypto.so.3 so:libssl.so.3|cmd:ssl_client=1.37.0-r18|EXternal ssl_client for busybox wget' 'oniguruma|6.9.10-r0|200000|so:libc.musl-x86_64.so.1|so:libonig.so.5=5.4.0|a regular expressions library' 'jq|1.8.0-r0|150000|so:libc.musl-x86_64.so.1 so:libonig.so.5|cmd:jq=1.8.0-r0|A lightweight and flexible command-line JSON processor' 'jq-extra-more|1.8.0-r0|5000|||what jq-extra brings in turn|jq-extra' 'jq-extra|1.8.0-r0|3000|jq-extra-libs||extras that come with jq|jq' 'jq-extra-libs|1.0-r0|4000|||what jq-extra needs|' 'jq-doc|1.8.0-r0|6000|||jq documentation|docs jq' 'jq-nobusybox|1.8.0-r0|8000|||only where busybox is not|jq !busybox' 'jq-nodash|1.8.0-r0|9000|||only where dash is not|jq !dash' 'jq-onig|1.8.0-r0|2000|||comes with jq and whatever provides libonig|so:libonig.so.5 jq' 'pcre2|10.45-r0|260000|so:libc.musl-x86_64.so.1|so:libpcre2-8.so.0=10.45|Perl-compatible regular expression library' 'brotli-libs|1.1.0-r2|330000|so:libc.musl-x86_64.so.1|so:libbrotlicommon.so.1=1.1.0 so:libbrotlidec.so.1=1.1.0|Generic lossless compressor (libraries)' 'nghttp2-libs|1.65.0-r0|70000|so:libc.musl-x86_64.so.1|so:libnghttp2.so.14=14.28.4|Experimental HTTP/2 client, server and proxy (libraries)' 'libcurl|8.14.1-r1|390000|so:libbrotlidec.so.1 so:libc.musl-x86_64.so.1 so:libcrypto.so.3 so:libnghttp2.so.14 so:libssl.so.3 so:libz.so.1|so:libcurl.so.4=4.8.0|The multiprotocol file transfer library' 'libexpat|2.7.1-r0|80000|so:libc.musl-x86_64.so.1|so:libexpat.so.1=1.10.2|XML Parser library written in C' 'git-init-template|2.49.1-r0|7000|git||Git init template|git=2.49.1-r0' 'git|2.49.1-r0|6500000|/bin/sh pcre2>=10 so:libc.musl-x86_64.so.1 so:libcurl.so.4 libexpat>=2.7 so:libpcre2-8.so.0 so:libz.so.1 so:libnothere.so.9 !git-big|cmd:git=2.49.1-r0 cmd:git-receive-pack=2.49.1-r0 cmd:git-shell=2.49.1-r0 cmd:scalar=2.49.1-r0|Distributed version control system' 'git-big|1.0-r0|99000000|||conflicts with git' 'nvi|1.81.6-r10|200000|so:libc.musl-x86_64.so.1|cmd:nvi=1.81.6-r10 cmd:vi=1.81.6-r10|A vi clone' 'vim|9.1.1-r0|1700000|so:libc.musl-x86_64.so.1|cmd:vi=9.1.1-r0 cmd:vim=9.1.1-r0 cmd:xxd=9.1.1-r0|Improved vi-style text editor' > apfix/main.spec
{ printf '%s\n' 'figlet|2.2.5-r3|154521|so:libc.musl-x86_64.so.1|cmd:chkfont=2.2.5-r3 cmd:figlet=2.2.5-r3 cmd:figlist=2.2.5-r3 cmd:showfigfonts=2.2.5-r3|Program for making large letters out of ordinary text' 'evil$(id)|1.0-r0|1000||cmd:evil=1.0-r0|a name no shell should read' 'evilver|1.0-r0$(id)|1000||cmd:evilver=1.0-r0|a version no shell should read' '-evil|1.0-r0|1000||cmd:dashevil=1.0-r0|a name apk would read as an option' 'R|4.5.1-r0|30000000|so:libc.musl-x86_64.so.1|cmd:R=4.5.1-r0 cmd:Rscript=4.5.1-r0|Language and environment for statistical computing'; i=0; while [ ${i} -lt 100 ]; do printf 'apfill%s|1.0-r0|1000|so:libc.musl-x86_64.so.1|cmd:apfill%s=1.0-r0|filler\n' "${i}" "${i}"; i=$((i+1)); done; } > apfix/community.spec
printf '%s\n' 'lonely|1.0-r0|1000|||the only one' > apfix/small.spec
printf '%s\n' 'twice|8.0.1-r0|1000||cmd:twice=8.0.1-r0|listed first, the older' 'twice|9.0.1-r0|1000||cmd:twice=9.0.1-r0|listed again, the newer' | cat apfix/community.spec - > apfix/dup.spec
for r in main community small dup; do awk -F'|' '{printf("C:Q1fixture=\nP:%s\nV:%s\nA:x86_64\nS:%s\nI:%s\nT:%s\nU:https://example.invalid\nL:MIT\no:%s\n", $1, $2, $3, $3 * 3, $6, $1); if ($4 != "") printf("D:%s\n", $4); if ($5 != "") printf("p:%s\n", $5); if ($7 != "") printf("i:%s\n", $7); printf("\n")}' "apfix/${r}.spec" > "apfix/${r}/APKINDEX" && printf '%s' 'not a real signature' > "apfix/${r}/${apsig}" && printf '%s\n' "fixture ${r}" > "apfix/${r}/DESCRIPTION" && (cd "apfix/${r}" && tar -cf sig.tar "${apsig}" && { dd if=sig.tar bs=512 count=2 2>/dev/null | gzip -n; tar -cf - DESCRIPTION APKINDEX | gzip -n; } > APKINDEX.tar.gz); done
for r in main community; do mkdir -p "apmir/v3.22/${r}/x86_64" && cp "apfix/${r}/APKINDEX.tar.gz" "apmir/v3.22/${r}/x86_64/" && for a in aarch64 armv7 x86 ppc64le s390x riscv64; do ln -s x86_64 "apmir/v3.22/${r}/${a}"; done; done
mkdir -p apreg/v2/library/alpine/manifests
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:3333333333333333333333333333333333333333333333333333333333333333","size":840,"platform":{"architecture":"unknown","os":"unknown"}},{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:1111111111111111111111111111111111111111111111111111111111111111","size":1022,"platform":{"architecture":"amd64","os":"linux"}},{"mediaType":"application/vnd.oci.image.manifest.v1+json","digest":"sha256:2222222222222222222222222222222222222222222222222222222222222222","size":1022,"platform":{"architecture":"arm64","os":"linux","variant":"v8"}}]}' > apreg/v2/library/alpine/manifests/3.22
cp apreg/v2/library/alpine/manifests/3.22 "apreg/v2/library/alpine/manifests/sha256:$(sha256sum apreg/v2/library/alpine/manifests/3.22 | awk '{print $1}')"
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","config":{"mediaType":"application/vnd.oci.image.config.v1+json","digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","size":581},"layers":[{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","digest":"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","size":3000000},{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","digest":"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc","size":642132}]}' > apreg/v2/library/alpine/manifests/sha256:1111111111111111111111111111111111111111111111111111111111111111
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","config":{"mediaType":"application/vnd.oci.image.config.v1+json","digest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","size":581},"layers":[{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","digest":"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd","size":4000000}]}' > apreg/v2/library/alpine/manifests/sha256:2222222222222222222222222222222222222222222222222222222222222222
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","config":{"mediaType":"application/vnd.in-toto+json","digest":"sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee","size":167},"layers":[{"mediaType":"application/vnd.in-toto+json","digest":"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff","size":900}]}' > apreg/v2/library/alpine/manifests/sha256:3333333333333333333333333333333333333333333333333333333333333333
CMDFOUND_ALPINE_MIRROR="${apmir}"; CMDFOUND_ALPINE_REGISTRY="${apreg}"; export CMDFOUND_ALPINE_MIRROR CMDFOUND_ALPINE_REGISTRY
#Wolfi's as well: one repository, os, that keeps every version it ever built, in
#no order, and an image of several layers whose index names no variant
wofix="$(pwd)/wofix"; womir="$(pwd)/womir"; woreg="$(pwd)/woreg"; wosig=".SIGN.RSA256.wolfi-signing.rsa.pub"
mkdir -p wofix/os && { printf '%s\n' 'wolfi-baselayout|20230201-r30|9000|||Wolfi base dir structure' 'wolfi-keys|1-r14|5000|||Wolfi signing keys' 'ca-certificates-bundle|20260909-r3|140000|||Mozilla certificates' 'glibc-2.44|2.44-r9|2600000|wolfi-baselayout|so:libc.so.6=6 so:ld-linux-x86-64.so.2=2|the GNU C library' 'busybox|1.38.0-r3|900000|so:libc.so.6|cmd:busybox=1.38.0-r3 cmd:sh=1.38.0-r3|busybox' 'apk-tools|2.14.10-r17|300000|so:libc.so.6 ca-certificates-bundle|cmd:apk=2.14.10-r17|apk' 'wolfi-base|1-r7|1000|apk-tools busybox wolfi-keys||Wolfi base' 'oniguruma|6.9.10-r2|200000|so:libc.so.6|so:libonig.so.5=5|a regular expressions library' 'jq|1.7.1-r4|150000|so:libc.so.6 so:libonig.so.5|cmd:jq=1.7.1-r4 cmd:jq-old=1.7.1-r4|an old jq' 'jq|1.8.2-r3|160000|so:libc.so.6 so:libonig.so.5|cmd:jq=1.8.2-r3|lightweight and flexible JSON processor' 'jq|1.6-r2|140000|so:libc.so.6|cmd:jq=1.6-r2|an older jq' 'jq|1.8.2_rc1-r9|155000|so:libc.so.6|cmd:jq=1.8.2_rc1-r9|a candidate jq' 'vt|1.2_rc1-r0|1000||cmd:vt=1.2_rc1-r0|order' 'vt|1.2-r0|1000||cmd:vt=1.2-r0|order' 'vp|1.2-r0|1000||cmd:vp=1.2-r0|order' 'vp|1.2_p1-r0|1000||cmd:vp=1.2_p1-r0|order' 'vl|1.2_p1-r0|1000||cmd:vl=1.2_p1-r0|order' 'vl|1.2a-r0|1000||cmd:vl=1.2a-r0|order' 'vn|1.9-r3|1000||cmd:vn=1.9-r3|order' 'vn|1.10-r0|1000||cmd:vn=1.10-r0|order'; i=0; while [ ${i} -lt 100 ]; do printf 'wofill%s|1.0-r0|1000|so:libc.so.6|cmd:wofill%s=1.0-r0|filler\n' "${i}" "${i}"; i=$((i+1)); done; } > wofix/os.spec
awk -F'|' '{printf("C:Q1fixture=\nP:%s\nV:%s\nA:x86_64\nS:%s\nI:%s\nT:%s\nL:MIT\no:%s\nt:0\n", $1, $2, $3, $3 * 3, $6, $1); if ($4 != "") printf("D:%s\n", $4); if ($5 != "") printf("p:%s\n", $5); printf("\n")}' wofix/os.spec > wofix/os/APKINDEX && printf '%s' 'not a real signature' > "wofix/os/${wosig}" && : > wofix/os/DESCRIPTION && (cd wofix/os && tar -cf sig.tar "${wosig}" && { dd if=sig.tar bs=512 count=2 2>/dev/null | gzip -n; tar -cf - APKINDEX DESCRIPTION | gzip -n; } > APKINDEX.tar.gz)
mkdir -p womir/os/x86_64 && cp wofix/os/APKINDEX.tar.gz womir/os/x86_64/ && ln -s x86_64 womir/os/aarch64
mkdir -p woreg/v2/chainguard/wolfi-base/manifests && printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.index.v1+json","manifests":[{"mediaType":"application/vnd.oci.image.manifest.v1+json","size":2503,"digest":"sha256:5555555555555555555555555555555555555555555555555555555555555555","platform":{"architecture":"amd64","os":"linux"}},{"mediaType":"application/vnd.oci.image.manifest.v1+json","size":2503,"digest":"sha256:6666666666666666666666666666666666666666666666666666666666666666","platform":{"architecture":"arm64","os":"linux"}}]}' > woreg/v2/chainguard/wolfi-base/manifests/latest && cp woreg/v2/chainguard/wolfi-base/manifests/latest "woreg/v2/chainguard/wolfi-base/manifests/sha256:$(sha256sum woreg/v2/chainguard/wolfi-base/manifests/latest | awk '{print $1}')"
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","layers":[{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","size":3357067},{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","size":2938749},{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","size":513556}]}' > woreg/v2/chainguard/wolfi-base/manifests/sha256:5555555555555555555555555555555555555555555555555555555555555555
printf '%s' '{"schemaVersion":2,"mediaType":"application/vnd.oci.image.manifest.v1+json","layers":[{"mediaType":"application/vnd.oci.image.layer.v1.tar+gzip","size":7000000}]}' > woreg/v2/chainguard/wolfi-base/manifests/sha256:6666666666666666666666666666666666666666666666666666666666666666
CMDFOUND_WOLFI_MIRROR="${womir}"; CMDFOUND_WOLFI_REGISTRY="${woreg}"; export CMDFOUND_WOLFI_MIRROR CMDFOUND_WOLFI_REGISTRY
#Ubuntu's too: an archive with the release and its -updates, each with the four
#components' Commands and Packages, the hashes in an InRelease that is not
#signed. The release says Acquire-By-Hash, and its files by name are those of a
#mirror half way through an update, so only fetching by hash reads it right.
#A spec line is package|version|size|depends|pre-depends|provides|commands|description,
#with OR for a | between alternatives
ubfix="$(pwd)/ubfix"; ubmir="$(pwd)/ubmir"; ubreg="$(pwd)/ubreg"; mkdir -p ubfix
